ALTER PROCEDURE [dbo].[usp_LlenarBandejaECTCJson_OPT]
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @FechaCorte VARCHAR(10)

    SELECT @FechaCorte = FechaCorte 
    FROM ParametrosCorte 
    WHERE Estado = '1';

    TRUNCATE TABLE BandejaEstadoCuentaJson;

    ;WITH tcEstados AS (
        SELECT 
            et.NumeroTarjeta AS No_Tarjeta,
            CONVERT(VARCHAR, ISNULL(et.EstadoTarjeta, 0)) AS Estado
        FROM Tarjetas et
        INNER JOIN (
            SELECT NumeroTarjeta, MAX(FechaCarga) FechaCarga
            FROM Tarjetas
            GROUP BY NumeroTarjeta
        ) ult 
            ON ult.NumeroTarjeta = et.NumeroTarjeta 
           AND ult.FechaCarga = et.FechaCarga
    )

    INSERT INTO BandejaEstadoCuentaJson
    SELECT 
        hc.Fecha_Corte,
        hc.No_Tarjeta,
        hc.No_Cuenta,
        hc.Correo,
        '2',

        (
            SELECT
                -- ENCABEZADO
                (
                    SELECT 
                        hc.*,
                        tce.Estado
                    FOR JSON PATH, WITHOUT_ARRAY_WRAPPER
                ) AS Encabezado,

                -- DETALLE (MISMO FILTRO ORIGINAL)
                (
                    SELECT 
                        d.Fecha_Consumo,
                        d.Tipo_Reg,
                        d.Descripcion_Mov,
                        d.DebitosMN,
                        d.CreditosMN,
                        d.DebitosME,
                        d.CreditosME
                    FROM (
                        SELECT
                            a.Fecha_Consumo,
                            1 Tipo_Reg,
                            a.Descripcion_Mov,
                            CASE WHEN a.Moneda_Mov = 'HN' AND b.TipoMovimiento='D' THEN a.Monto_Mov ELSE 0 END DebitosMN,
                            CASE WHEN a.Moneda_Mov = 'HN' AND b.TipoMovimiento='C' THEN a.Monto_Mov ELSE 0 END CreditosMN,
                            CASE WHEN a.Moneda_Mov = 'DO' AND b.TipoMovimiento='D' THEN a.Monto_Mov ELSE 0 END DebitosME,
                            CASE WHEN a.Moneda_Mov = 'DO' AND b.TipoMovimiento='C' THEN a.Monto_Mov ELSE 0 END CreditosME
                        FROM BandejaDetalle a
                        INNER JOIN TiposMovimientos b
                            ON b.CodMovimiento = a.Codigo_Mov
                        WHERE a.EC_DetalleNo_Cuenta = hc.No_Cuenta
                          AND a.Fecha_Corte = hc.Fecha_Corte
                    ) d
                    FOR JSON PATH
                ) AS Detalle,

                -- FINANCIAMIENTOS (FILTROS RESTAURADOS)
                (
                    SELECT 
                        f.Tipo,
                        f.Fecha,
                        f.Monto,
                        f.Moneda,
                        f.Cuota,
                        f.Plazo,
                        f.CuotaAplicada,
                        f.Tasa,
                        f.Saldo
                    FROM (
                        SELECT
                            'Intrafinanciamientos' Tipo,
                            f.FechaOtorgamiento Fecha,
                            f.ImporteTotalPlan Monto,
                            f.MonedaMovimiento Moneda,
                            f.Importe Cuota,
                            f.CantidadCuotasPlan Plazo,
                            f.NoCuotaLiquidada CuotaAplicada,
                            CASE WHEN f.PlanExtraTasa = 0 THEN '0%' 
                                 ELSE CAST(f.PlanExtraTasa AS VARCHAR) + '%' END Tasa,
                            f.PlanCuotaCapitalPend Saldo
                        FROM BandejaFinanciamientos f
                        WHERE f.NumeroCuenta = hc.No_Cuenta
                          AND f.FechaCierre = hc.Fecha_Corte
                          AND f.PlanCuotaCapitalPend > 0
                          AND f.EsIntra = 1

                        UNION ALL

                        SELECT
                            'Extrafinanciamientos',
                            f.FechaOtorgamiento,
                            f.ImporteTotalPlan,
                            f.MonedaMovimiento,
                            f.Importe,
                            f.CantidadCuotasPlan,
                            f.NoCuotaLiquidada,
                            CASE WHEN f.PlanExtraTasa = 0 THEN '0%' 
                                 ELSE CAST(f.PlanExtraTasa AS VARCHAR) + '%' END,
                            f.PlanCuotaCapitalPend
                        FROM BandejaFinanciamientos f
                        WHERE f.NumeroCuenta = hc.No_Cuenta
                          AND f.FechaCierre = hc.Fecha_Corte
                          AND f.PlanCuotaCapitalPend > 0
                          AND f.EsExtra = 1
                    ) f
                    FOR JSON PATH
                ) AS Financiamientos

            FOR JSON PATH, WITHOUT_ARRAY_WRAPPER
        ) AS Json

    FROM BandejaEncabezado hc
    INNER JOIN tcEstados tce 
        ON tce.No_Tarjeta = hc.No_Tarjeta

    WHERE hc.Fecha_Corte = @FechaCorte;

    SELECT COUNT(*) AS cantidad 
    FROM BandejaEstadoCuentaJson;

END