USE [EstadosCuentaJSONProcesador]
GO

ALTER PROCEDURE [dbo].[usp_LlenarBandejaECTCJson6]
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @FechaCorte VARCHAR(10);

    SELECT @FechaCorte = FechaCorte
    FROM ParametrosCorte
    WHERE Estado = '1';

    TRUNCATE TABLE dbo.BandejaEstadoCuentaJson;

    ;WITH tcEstados AS (
        SELECT 
            et.NumeroTarjeta AS No_Tarjeta,
            CONVERT(VARCHAR, ISNULL(et.EstadoTarjeta, 0)) AS Estado
        FROM Tarjetas et
        WHERE CONVERT(VARCHAR(10), et.FechaCarga, 103) + et.NumeroTarjeta IN (
            SELECT 
                CONVERT(VARCHAR(10), MAX(etfc.FechaCarga), 103) + etfc.NumeroTarjeta
            FROM Tarjetas etfc
            WHERE etfc.NumeroTarjeta IN (
                SELECT No_Tarjeta FROM BandejaEstadoCuenta
            )
            GROUP BY etfc.NumeroTarjeta
        )
    )

    INSERT INTO dbo.BandejaEstadoCuentaJson
    (
        Fecha_Corte,
        No_Tarjeta,
        No_Cuenta,
        Correo,
        Estado,
        Json
    )
    SELECT 
        hc.Fecha_Corte,
        hc.No_Tarjeta,
        hc.No_Cuenta,
        hc.Correo,
        '2',

        -- ================= JSON FINAL =================
        JSON_QUERY((
            SELECT 

                -- ================= ENCABEZADO =================
                JSON_QUERY((
                    SELECT 
                        hc.Origen,
                        hc.Emisor,
                        hc.No_Cuenta,
                        hc.Nombre_TH_Tit,
                        hc.Emisor_Madre,
                        hc.Cuenta_Madre,
                        hc.Nombre_Empresa,
                        hc.Tipo_Tarjeta,
                        hc.No_Tarjeta,
                        hc.Fecha_Pago,
                        hc.Fecha_Corte,

                        hc.Pago_Contado_MN,
                        hc.Pago_Minimo_MN,
                        hc.Saldo_Vencido_MN,
                        hc.Saldo_Anterior_MN,
                        hc.Saldo_Final_MN,
                        hc.Compras_Deb_MN,
                        hc.Pagos_Cred_MN,

                        hc.Compras_Deb_ME,
                        hc.Pagos_Cred_ME,

                        hc.Limite_Credito,
                        hc.Disponible_Cta_MN,
                        hc.Disponible_Cta_ME,

                        hc.Correo,
                        tce.Estado

                    FOR JSON PATH, WITHOUT_ARRAY_WRAPPER
                )) AS Encabezado,

                -- ================= DETALLE =================
                JSON_QUERY((
                    SELECT 
                        d.Fecha_Consumo,
                        d.Tipo_Reg,
                        d.Descripcion_Mov,
                        d.DebitosMN,
                        d.CreditosMN,
                        d.DebitosME,
                        d.CreditosME
                    FROM (
                        SELECT
                            a.Fecha_Consumo,
                            1 AS Tipo_Reg,
                            a.Descripcion_Mov,
                            CASE WHEN a.Moneda_Mov = 'HN' AND b.TipoMovimiento = 'D' THEN a.Monto_Mov ELSE 0 END DebitosMN,
                            CASE WHEN a.Moneda_Mov = 'HN' AND b.TipoMovimiento = 'C' THEN a.Monto_Mov ELSE 0 END CreditosMN,
                            CASE WHEN a.Moneda_Mov = 'DO' AND b.TipoMovimiento = 'D' THEN a.Monto_Mov ELSE 0 END DebitosME,
                            CASE WHEN a.Moneda_Mov = 'DO' AND b.TipoMovimiento = 'C' THEN a.Monto_Mov ELSE 0 END CreditosME
                        FROM BandejaDetalle a
                        INNER JOIN TiposMovimientos b 
                            ON b.CodMovimiento = a.Codigo_Mov
                        WHERE 
                            a.Fecha_Corte = hc.Fecha_Corte
                            AND a.EC_DetalleNo_Cuenta = hc.No_Cuenta

                        UNION ALL

                        SELECT
                            hc.Fecha_Corte,
                            2,
                            'Subtotal',
                            SUM(CASE WHEN a.Moneda_Mov='HN' THEN a.Monto_Mov ELSE 0 END),
                            0,
                            SUM(CASE WHEN a.Moneda_Mov='DO' THEN a.Monto_Mov ELSE 0 END),
                            0
                        FROM BandejaDetalle a
                        WHERE 
                            a.Fecha_Corte = hc.Fecha_Corte
                            AND a.EC_DetalleNo_Cuenta = hc.No_Cuenta
                        GROUP BY a.Fecha_Corte

                        UNION ALL

                        SELECT
                            hc.Fecha_Corte,
                            3,
                            'Total',
                            SUM(a.Monto_Mov),
                            0,
                            0,
                            0
                        FROM BandejaDetalle a
                        WHERE 
                            a.Fecha_Corte = hc.Fecha_Corte
                            AND a.EC_DetalleNo_Cuenta = hc.No_Cuenta
                        GROUP BY a.Fecha_Corte

                    ) d
                    FOR JSON PATH
                )) AS Detalle,

                -- ================= FINANCIAMIENTOS =================
                JSON_QUERY((
                    SELECT
                        f.Tipo,
                        f.Fecha,
                        f.Monto,
                        f.Moneda,
                        f.Cuota,
                        f.Plazo,
                        f.CuotaAplicada,
                        f.Tasa,
                        f.Saldo
                    FROM (
                        -- INTRA
                        SELECT
                            'Intrafinanciamientos' AS Tipo,
                            f.FechaOtorgamiento AS Fecha,
                            f.ImporteTotalPlan AS Monto,
                            f.MonedaMovimiento AS Moneda,
                            f.Importe AS Cuota,
                            f.CantidadCuotasPlan AS Plazo,
                            f.NoCuotaLiquidada AS CuotaAplicada,
                            CAST(f.PlanExtraTasa AS VARCHAR) + '%' AS Tasa,
                            f.PlanCuotaCapitalPend AS Saldo
                        FROM BandejaFinanciamientos f
                        WHERE 
                            f.NumeroCuenta = hc.No_Cuenta
                            AND f.FechaCierre = hc.Fecha_Corte
                            AND f.PlanCuotaCapitalPend > 0
                            AND f.EsIntra = 1

                        UNION ALL

                        -- EXTRA
                        SELECT
                            'Extrafinanciamientos',
                            f.FechaOtorgamiento,
                            f.ImporteTotalPlan,
                            f.MonedaMovimiento,
                            f.Importe,
                            f.CantidadCuotasPlan,
                            f.NoCuotaLiquidada,
                            CAST(f.PlanExtraTasa AS VARCHAR) + '%',
                            f.PlanCuotaCapitalPend
                        FROM BandejaFinanciamientos f
                        WHERE 
                            f.NumeroCuenta = hc.No_Cuenta
                            AND f.FechaCierre = hc.Fecha_Corte
                            AND f.PlanCuotaCapitalPend > 0
                            AND f.EsExtra = 1

                    ) f
                    FOR JSON PATH
                )) AS Financiamientos

            FOR JSON PATH, WITHOUT_ARRAY_WRAPPER
        ))

    FROM BandejaEncabezado hc
    INNER JOIN tcEstados tce 
        ON tce.No_Tarjeta = hc.No_Tarjeta

    WHERE hc.Fecha_Corte = @FechaCorte;

    -- RESULTADO
    SELECT COUNT(*) AS cantidad
    FROM BandejaEstadoCuentaJson;

END
GO