ALTER PROCEDURE [dbo].[usp_LlenarBandejaECTCJson_OPT]
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @FechaCorte VARCHAR(10)

    SELECT @FechaCorte = FechaCorte 
    FROM ParametrosCorte 
    WHERE Estado = '1';

    TRUNCATE TABLE BandejaEstadoCuentaJson;

    ;WITH tcEstados AS (
        SELECT 
            et.NumeroTarjeta AS No_Tarjeta,
            CONVERT(VARCHAR, ISNULL(et.EstadoTarjeta, 0)) AS Estado
        FROM Tarjetas et
        INNER JOIN (
            SELECT NumeroTarjeta, MAX(FechaCarga) FechaCarga
            FROM Tarjetas
            GROUP BY NumeroTarjeta
        ) ult 
            ON ult.NumeroTarjeta = et.NumeroTarjeta 
           AND ult.FechaCarga = et.FechaCarga
    )

    INSERT INTO BandejaEstadoCuentaJson
    SELECT 
        hc.Fecha_Corte,
        hc.No_Tarjeta,
        hc.No_Cuenta,
        hc.Correo,
        '2',

        (
            SELECT
                -- =======================
                -- ENCABEZADO
                -- =======================
                (
                    SELECT 
                        hc.Origen,
                        hc.Emisor,
                        hc.No_Cuenta,
                        hc.Nombre_TH_Tit,
                        hc.No_Tarjeta,
                        hc.Fecha_Pago,
                        hc.Fecha_Corte,
                        hc.Saldo_Final_MN,
                        hc.Saldo_Final_ME,
                        hc.Limite_Credito,
                        hc.Correo,
                        tce.Estado
                    FOR JSON PATH, WITHOUT_ARRAY_WRAPPER
                ) AS Encabezado,

                -- =======================
                -- DETALLE
                -- =======================
                (
                    SELECT 
                        d.Fecha_Consumo,
                        d.Tipo_Reg,
                        d.Descripcion_Mov,
                        d.DebitosMN,
                        d.CreditosMN,
                        d.DebitosME,
                        d.CreditosME
                    FROM (
                        SELECT
                            a.Fecha_Consumo,
                            1 Tipo_Reg,
                            a.Descripcion_Mov,
                            CASE WHEN a.Moneda_Mov = 'HN' THEN a.Monto_Mov ELSE 0 END DebitosMN,
                            0 CreditosMN,
                            CASE WHEN a.Moneda_Mov = 'DO' THEN a.Monto_Mov ELSE 0 END DebitosME,
                            0 CreditosME
                        FROM BandejaDetalle a
                        WHERE a.EC_DetalleNo_Cuenta = hc.No_Cuenta
                          AND a.Fecha_Corte = hc.Fecha_Corte
                    ) d
                    FOR JSON PATH
                ) AS Detalle,

                -- =======================
                -- FINANCIAMIENTOS
                -- =======================
                (
                    SELECT 
                        f.Tipo,
                        f.Fecha,
                        f.Monto,
                        f.Moneda,
                        f.Cuota,
                        f.Plazo,
                        f.Saldo
                    FROM (
                        SELECT
                            'Intrafinanciamiento' Tipo,
                            FechaOtorgamiento Fecha,
                            ImporteTotalPlan Monto,
                            MonedaMovimiento Moneda,
                            Importe Cuota,
                            CantidadCuotasPlan Plazo,
                            PlanCuotaCapitalPend Saldo
                        FROM BandejaFinanciamientos
                        WHERE NumeroCuenta = hc.No_Cuenta
                          AND FechaCierre = hc.Fecha_Corte
                          AND EsIntra = 1

                        UNION ALL

                        SELECT
                            'Extrafinanciamiento',
                            FechaOtorgamiento,
                            ImporteTotalPlan,
                            MonedaMovimiento,
                            Importe,
                            CantidadCuotasPlan,
                            PlanCuotaCapitalPend
                        FROM BandejaFinanciamientos
                        WHERE NumeroCuenta = hc.No_Cuenta
                          AND FechaCierre = hc.Fecha_Corte
                          AND EsExtra = 1
                    ) f
                    FOR JSON PATH
                ) AS Financiamientos

            FOR JSON PATH, WITHOUT_ARRAY_WRAPPER
        ) AS Json

    FROM BandejaEncabezado hc
    INNER JOIN tcEstados tce 
        ON tce.No_Tarjeta = hc.No_Tarjeta

    WHERE hc.Fecha_Corte = @FechaCorte;

    SELECT COUNT(*) AS cantidad 
    FROM BandejaEstadoCuentaJson;

END










CREATE INDEX IX_BandejaDetalle_CuentaFecha 
ON BandejaDetalle (EC_DetalleNo_Cuenta, Fecha_Corte);

CREATE INDEX IX_BandejaFinanciamientos_CuentaFecha 
ON BandejaFinanciamientos (NumeroCuenta, FechaCierre);

CREATE INDEX IX_BandejaEncabezado_Fecha 
ON BandejaEncabezado (Fecha_Corte);