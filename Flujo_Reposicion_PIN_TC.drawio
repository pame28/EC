    <mxCell id="arr_crm_db" value="Almacena&lt;br&gt;solicitud" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDx=0;entryDy=0;strokeColor=#9673a6;strokeWidth=1.5;dashed=1;fontStyle=0;fontSize=9;" edge="1" source="crm_icon" target="crm_db" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ==================== FIN ==================== -->
    <mxCell id="fin" value="FIN" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e4d78;strokeColor=#1e4d78;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="110" y="730" width="110" height="40" as="geometry" />
    </mxCell>

    <!-- CRM → FIN (confirmación al cliente) -->
    <mxCell id="arr_fin" value="Confirmación&lt;br&gt;al cliente" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#00a000;strokeWidth=2;fontStyle=0;fontSize=9;fontColor=#006600;" edge="1" source="crm_icon" target="fin" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ==================== DESCRIPTION BOX ==================== -->
    <mxCell id="desc_title" value="DESCRIPCIÓN" style="text;html=1;strokeColor=#000000;fillColor=#1e4d78;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1634" y="155" width="200" height="30" as="geometry" />
    </mxCell>

    <mxCell id="desc1" value="① El usuario solicita la reposición de PIN TC a través de uno de los canales habilitados: App Móvil, App Web, Correo Electrónico o WhatsApp (Bot SAM)." style="text;html=1;strokeColor=#d0d0d0;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=5;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1634" y="185" width="200" height="80" as="geometry" />
    </mxCell>
    <mxCell id="desc2" value="② La solicitud llega al CRM almacenado en Guatemala, que registra la petición y la almacena en su base de datos local." style="text;html=1;strokeColor=#d0d0d0;fillColor=#f5f5f5;align=left;verticalAlign=top;spacingLeft=5;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1634" y="265" width="200" height="80" as="geometry" />
    </mxCell>
    <mxCell id="desc3" value="③ El CRM consume el Microservicio enviando la solicitud de cambio de PIN mediante TLS 1.2+." style="text;html=1;strokeColor=#d0d0d0;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=5;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1634" y="345" width="200" height="70" as="geometry" />
    </mxCell>
    <mxCell id="desc4" value="④ El Microservicio construye y envía una trama al AS400 para iniciar el proceso de autorización de cambio de PIN." style="text;html=1;strokeColor=#d0d0d0;fillColor=#f5f5f5;align=left;verticalAlign=top;spacingLeft=5;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1634" y="415" width="200" height="70" as="geometry" />
    </mxCell>
    <mxCell id="desc5" value="⑤ AS400 envía la trama al Broker MQ en formato ISO 8583 para ser enrutada hacia el autorizador AZ7." style="text;html=1;strokeColor=#d0d0d0;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=5;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1634" y="485" width="200" height="70" as="geometry" />
    </mxCell>
    <mxCell id="desc6" value="⑥ AZ7 procesa y autoriza la transacción. La respuesta retorna por la misma ruta: AZ7 → Broker MQ → AS400 → Microservicio → CRM." style="text;html=1;strokeColor=#d0d0d0;fillColor=#f5f5f5;align=left;verticalAlign=top;spacingLeft=5;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1634" y="555" width="200" height="80" as="geometry" />
    </mxCell>
    <mxCell id="desc7" value="⑦ El Microservicio envía el nuevo PIN al cliente a través de Correo Electrónico o SMS, según el canal preferido." style="text;html=1;strokeColor=#d0d0d0;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=5;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1634" y="635" width="200" height="80" as="geometry" />
    </mxCell>
    <mxCell id="desc8" value="⑧ El CRM recibe la confirmación y notifica al cliente la finalización exitosa del proceso de Reposición de PIN TC." style="text;html=1;strokeColor=#d0d0d0;fillColor=#f5f5f5;align=left;verticalAlign=top;spacingLeft=5;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1634" y="715" width="200" height="80" as="geometry" />
    </mxCell>

