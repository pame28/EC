# =========================
# BUILD STAGE
# =========================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY *.csproj ./
COPY nuget.config ./

COPY proxy-root.crt /usr/local/share/ca-certificates/
RUN update-ca-certificates || true

ENV DOTNET_SYSTEM_NET_HTTP_USESOCKETSHTTPHANDLER=0
ENV DOTNET_SYSTEM_NET_HTTP_SSL_CERTIFICATE_PATH=/usr/local/share/ca-certificates/proxy-root.crt

RUN dotnet restore

# Copiar libs ODBC offline
COPY odbc-libraries/*.deb /tmp/odbc/

# 🔥 INSTALACIÓN CORRECTA (orden IMPORTANTE)
RUN dpkg -i /tmp/odbc/dpkg*.deb || true && \
    dpkg -i /tmp/odbc/ca-certificates*.deb || true && \
    dpkg -i /tmp/odbc/libltdl7*.deb || true && \
    dpkg -i /tmp/odbc/libodbc*.deb || true && \
    dpkg -i /tmp/odbc/libodbcinst*.deb || true && \
    dpkg -i /tmp/odbc/unixodbc*.deb || true && \
    dpkg -i /tmp/odbc/odbcinst*.deb || true && \
    dpkg -i /tmp/odbc/wget*.deb || true && \
    dpkg -i /tmp/odbc/ibm-iaccess*.deb || true

# IBM libs
ENV LD_LIBRARY_PATH=/opt/ibm/iaccess/lib64

COPY . .
RUN dotnet publish -c Release -o /app/publish

# =========================
# RUNTIME STAGE
# =========================
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

# 🔥 AQUÍ ESTÁ LA CLAVE (instalar runtime también)
COPY odbc-libraries/*.deb /tmp/odbc/

RUN dpkg -i /tmp/odbc/libltdl7*.deb || true && \
    dpkg -i /tmp/odbc/libodbc*.deb || true && \
    dpkg -i /tmp/odbc/libodbcinst*.deb || true && \
    dpkg -i /tmp/odbc/unixodbc*.deb || true && \
    dpkg -i /tmp/odbc/odbcinst*.deb || true

# Copiar app
COPY --from=build /app/publish .

# Copiar IBM driver
COPY --from=build /opt/ibm/iaccess /opt/ibm/iaccess

# Permisos OpenShift
RUN chmod -R a+r /opt/ibm || true

# Config ODBC
RUN mkdir -p /etc && \
    printf '%s\n' '[iSeries Access ODBC Driver]' \
    'Description=IBM i Access for Linux ODBC Driver' \
    'Driver=/opt/ibm/iaccess/lib64/libcwbodbc.so' \
    'FileUsage=1' > /etc/odbcinst.ini

# Variables entorno
ENV LD_LIBRARY_PATH=/opt/ibm/iaccess/lib64:/usr/lib/x86_64-linux-gnu
ENV ODBCSYSINI=/etc
ENV ODBCINI=/etc/odbc.ini

ENTRYPOINT ["dotnet", "Criptografia.dll"]
