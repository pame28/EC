ALTER procedure [dbo].[usp_LimpiarTablaHistoricoReporteEC](@Tipo varchar(20))

AS
BEGIN
	if(@Tipo='COMPLETA')
	BEGIN
		--Limpia todo el historico de reporte
		TRUNCATE TABLE BPTarjetas.dbo.HistoricoCorreosECTC;
	END
		if(@Tipo='NOVALIDOS')
	BEGIN
		--Limpia solo los no validos
		delete from BPTarjetas.dbo.HistoricoCorreosECTC where CorreoCliente in (select Correo From CorreosNoValidos where Estado=1) and Estado=0;

	END
END


