USE [EstadosCuentaJSONProcesador]
GO
/****** Object:  StoredProcedure [dbo].[usp_ConsultarCorreosInvalidosEstadoCuenta]    Script Date: 23/3/2026 09:00:52 ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
ALTER PROCEDURE [dbo].[usp_ConsultarCorreosInvalidosEstadoCuenta]
AS
BEGIN

SET NOCOUNT ON;

DECLARE @FechaCorte DATE

SELECT @FechaCorte = FechaCorte
FROM dbo.ParametrosCorte
WHERE Estado = 1


SELECT
    h.FechaCorte,
    TRIM(h.NoTarjeta) AS NoTarjeta,
    TRIM(h.NoCuenta) AS NoCuenta,
    TRIM(h.Correo) AS Correo

FROM dbo.BandejaEncabezado h

INNER JOIN dbo.FechaCarga fc
    ON h.Origen = fc.Origen

WHERE

    h.FechaCorte = @FechaCorte

    AND h.Correo <> ''

    AND h.Correo IN
    (
        SELECT Correo
        FROM dbo.CorreosNoValidos
        WHERE Estado = 1
    )

    AND
    (
        EXISTS
        (
            SELECT 1
            FROM dbo.BandejaDetalle d
            WHERE d.ECDetalleNoCuenta = h.NoCuenta
            AND d.FechaCorte = h.FechaCorte
        )

        OR h.PagoContadoMN <> 0
        OR h.PagoContadoME <> 0
    )

ORDER BY h.Correo

END




