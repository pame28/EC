using System.Data.SqlClient;

namespace EstadosCuentaTC.Data
{
    public class SqlExecutor
    {
        private readonly string _connectionString;

        public SqlExecutor(string connectionString)
        {
            _connectionString = connectionString;
        }

        public SqlConnection GetConnection()
        {
            var conn = new SqlConnection(_connectionString);
            conn.Open();
            return conn;
        }
    }
}







using EstadosCuentaTC.Models;
using System.Data.SqlClient;

namespace EstadosCuentaTC.Repositories
{
    public class ParametroCorteRepository
    {
        private readonly SqlExecutor _sql;

        public ParametroCorteRepository(SqlExecutor sql)
        {
            _sql = sql;
        }

        public ParametroCorte ObtenerActivo()
        {
            using var conn = _sql.GetConnection();
            var cmd = new SqlCommand(
                "SELECT TOP 1 * FROM ParametrosCorte WHERE Estado='1' ORDER BY FechaCorte DESC", conn);

            using var reader = cmd.ExecuteReader();
            if (reader.Read())
            {
                return new ParametroCorte
                {
                    Id = (int)reader["Id"],
                    FechaCorte = (DateTime)reader["FechaCorte"],
                    Destinatario = reader["Destinatario"].ToString(),
                    Remitente = reader["Remitente"].ToString(),
                    Estado = Convert.ToChar(reader["Estado"])
                };
            }
            return null;
        }
    }
}














using EstadosCuentaTC.Models;
using System.Collections.Generic;
using System.Data.SqlClient;

namespace EstadosCuentaTC.Repositories
{
    public class CorreosNoValidosRepository
    {
        private readonly SqlExecutor _sql;

        public CorreosNoValidosRepository(SqlExecutor sql)
        {
            _sql = sql;
        }

        public HashSet<string> ObtenerActivos()
        {
            var correos = new HashSet<string>();
            using var conn = _sql.GetConnection();
            var cmd = new SqlCommand("SELECT Correo FROM CorreosNoValidos WHERE Estado='1'", conn);

            using var reader = cmd.ExecuteReader();
            while (reader.Read())
            {
                correos.Add(reader["Correo"].ToString().Trim().ToLower());
            }

            return correos;
        }
    }
}









using EstadosCuentaTC.Models;
using System;
using System.Collections.Generic;
using System.Data.SqlClient;

namespace EstadosCuentaTC.Repositories
{
    public class BandejaDetalleRepository
    {
        private readonly SqlExecutor _sql;
        private readonly HashSet<string> _correosNoValidos;

        public BandejaDetalleRepository(SqlExecutor sql, HashSet<string> correosNoValidos)
        {
            _sql = sql;
            _correosNoValidos = correosNoValidos;
        }

        public List<BandejaDetalle> ObtenerCuentas(DateTime fechaCorte)
        {
            var cuentas = new List<BandejaDetalle>();
            using var conn = _sql.GetConnection();
            var cmd = new SqlCommand(@"
                SELECT *
                FROM BandejaDetalle
                WHERE FechaCorte = @FechaCorte
                  AND Correo <> ''
            ", conn);

            cmd.Parameters.AddWithValue("@FechaCorte", fechaCorte);

            using var reader = cmd.ExecuteReader();
            while (reader.Read())
            {
                var correo = reader["Correo"].ToString().Trim().ToLower();
                if (_correosNoValidos.Contains(correo)) continue;

                cuentas.Add(new BandejaDetalle
                {
                    IdRow = (int)reader["idRow"],
                    FechaCorte = (DateTime)reader["FechaCorte"],
                    ECDetalleNoCuenta = reader["ECDetalleNoCuenta"].ToString(),
                    ECDetalleNoTarjeta = reader["ECDetalleNoTarjeta"].ToString(),
                    NombreTHP = reader["NombreTHP"].ToString(),
                    NoCuentaClaro = reader["NoCuentaClaro"].ToString(),
                    Correo = correo
                    // ... agregar los demás campos según necesidad
                });
            }

            return cuentas;
        }
    }
}













using EstadosCuentaTC.Data;
using EstadosCuentaTC.Repositories;

var builder = new ConfigurationBuilder()
    .AddJsonFile("appsettings.json");
var config = builder.Build();
var connectionString = config.GetConnectionString("DefaultConnection");

var sqlExecutor = new SqlExecutor(connectionString);

var parametroRepo = new ParametroCorteRepository(sqlExecutor);
var corteActivo = parametroRepo.ObtenerActivo();
if (corteActivo == null)
{
    Console.WriteLine("No hay corte activo.");
    return;
}

var correosRepo = new CorreosNoValidosRepository(sqlExecutor);
var correosNoValidos = correosRepo.ObtenerActivos();

var bandejaRepo = new BandejaDetalleRepository(sqlExecutor, correosNoValidos);
var cuentas = bandejaRepo.ObtenerCuentas(corteActivo.FechaCorte);

Console.WriteLine($"Cuentas a procesar: {cuentas.Count}");