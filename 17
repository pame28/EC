        private static readonly object _lockFile = new();
        private static readonly object _lockPrimer = new();

        private bool _primerFragmento = true;

        public GeneracionLoteService(
            EstadoCuentaRepository repo,
            ILogger<GeneracionLoteService> logger)
        {
            _repo = repo;
            _logger = logger;
        }

        /// <param name="rutaBase">Ruta base donde se crea la carpeta por fecha.</param>
        /// <param name="nombreArchivoBase">
        ///     Prefijo parametrizado del archivo, p.ej. "EstadoCuenta_".
        ///     El nombre final queda: {nombreArchivoBase}{yyyyMMdd}.json
        /// </param>
        /// <param name="fechaCorte">Fecha de corte del proceso.</param>
        /// <param name="cantidadHilos">Número de workers paralelos.</param>
        public int Ejecutar(
            string rutaBase,
            string nombreArchivoBase,
            DateTime fechaCorte,
            int cantidadHilos)
        {
            int totalProcesados = 0;
            var ruta = Path.Combine(rutaBase, fechaCorte.ToString("yyyy-MM-dd"));
            Directory.CreateDirectory(ruta);

            // ── Nombre de archivo parametrizado ──────────────────────────
            // nombreArchivoBase viene de ParametrosGeneracionECDto.NombreArchivo
            // que a su vez se lee de la tabla de parámetros en SQL.
            var archivoJson = Path.Combine(
                ruta,
                $"{nombreArchivoBase}{fechaCorte.Day}.json"
            );

            File.WriteAllText(archivoJson, "{", Encoding.UTF8);
            _primerFragmento = true;

            _repo.ReiniciarControlLote(fechaCorte);

            _logger.LogInformation(
                "Iniciando con {Hilos} workers. Archivo: {Archivo}",
                cantidadHilos, archivoJson);

            var tareas = new Task[cantidadHilos];

            for (int i = 0; i < cantidadHilos; i++)
            {
                int workerId = i + 1;

                tareas[i] = Task.Run(() =>
                {
                    _logger.LogInformation("Worker {Id} iniciado", workerId);

                    while (true)
                    {
                        try
                        {
                            var lote = _repo.ObtenerLote(workerId);

                            if (lote == null)
                                break;

                            var fragmento = ConstruirFragmento(lote);

                            if (string.IsNullOrEmpty(fragmento))
                                continue;

                            lock (_lockFile)
                            {
                                string prefijo;
                                lock (_lockPrimer)
                                {
                                    prefijo = _primerFragmento ? "" : ",";
                                    _primerFragmento = false;
                                }
                                File.AppendAllText(archivoJson, prefijo + fragmento, Encoding.UTF8);
                            }
                            lock (_lockFile)
                            {
                                totalProcesados += lote.Tarjetas.Count;
                            }                            _logger.LogInformation(
                                "Worker {Id} procesó {N} tarjetas (lote {Lote})",
                                workerId, lote.Tarjetas.Count, lote.NumeroLote);
                        }
                        catch (Exception ex)
                        {
                            _logger.LogError(ex, "Error en worker {Id}", workerId);
                            break;
                        }
                    }

                    _logger.LogInformation("Worker {Id} finalizado", workerId);
                });
            }

            Task.WaitAll(tareas);

            File.AppendAllText(archivoJson, "}", Encoding.UTF8);
            _logger.LogInformation("Proceso finalizado. Archivo: {Ruta}", archivoJson);
            return totalProcesados;
        }

        // ── Helpers ──────────────────────────────────────────────────────────

        private static void WriteD2(Utf8JsonWriter w, string name, decimal value)
            => w.WriteNumber(name, Math.Round(value, 2, MidpointRounding.AwayFromZero));

        private static decimal R2(decimal value)
            => Math.Round(value, 2, MidpointRounding.AwayFromZero);

        // ── Constructor de fragmento ──────────────────────────────────────────

        private string ConstruirFragmento(LoteDatosDto lote)
        {
            if (lote.Encabezados.Count == 0)
                return "";

            var detallesPorCuenta = lote.Detalles
                .GroupBy(d => d.No_Cuenta)
                .ToDictionary(g => g.Key, g => g.ToList());

            var finanPorCuenta = lote.Financiamientos
                .GroupBy(f => f.No_Cuenta)
                .ToDictionary(g => g.Key, g => g.ToList());

            var sb = new StringBuilder();
            bool primero = true;

            foreach (var enc in lote.Encabezados)
            {
                if (!primero) sb.Append(',');
                primero = false;

                var detalle = detallesPorCuenta.GetValueOrDefault(enc.No_Cuenta, []);
                var financiamiento = finanPorCuenta.GetValueOrDefault(enc.No_Cuenta, []);

                sb.Append('"');
                sb.Append(enc.No_Tarjeta);
                sb.Append("\":");

                using var ms = new MemoryStream();
                using var writer = new Utf8JsonWriter(ms, new JsonWriterOptions
                {
                    Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
                });

                writer.WriteStartObject();
                writer.WritePropertyName("Encabezado");
                EscribirEncabezado(writer, enc);
                writer.WritePropertyName("Detalle");
                EscribirDetalle(writer, detalle);
                writer.WritePropertyName("Financiamientos");
                EscribirFinanciamientos(writer, financiamiento);
                writer.WriteEndObject();
                writer.Flush();

                sb.Append(Encoding.UTF8.GetString(ms.ToArray()));
            }

            return sb.ToString();
        }

