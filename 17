        private void ValorCrediticio()
        {
            Label lbError = NabBarCampos.Groups.FindByName("Titulo").FindControl("lbError") as Label;

            SQLSrv query = new SQLSrv(Properties.Settings.Default.DBGestorBP, "usp_ObtenerValorCrediByCodigo");

            try
            {
                string codigo = BanderaCodigo.Value.ToString();

                DataTable dt = new DataTable();

                query.Parametros.Add(new SqlParameter("@CodigoCrediticio", codigo));
                query.Parametros.Add(new SqlParameter("@idSolicitud", Session["idSolicitud"]));

                dt = query.getDataTableWithParameters();

                if (query.Success)
                {
                    if (dt.Rows.Count > 0)
                    {
                        spinPorcentajeCrediticio.Value = (!string.IsNullOrEmpty(dt.Rows[0]["ValorCrediticio"].ToString())) ? Convert.ToDecimal(dt.Rows[0]["ValorCrediticio"]) : 0;
                    }
                }
                //Controles
                Control ctrl1 = new Control();
                Control ctrl2 = new Control();
                Control ctrl3 = new Control();

                ctrl1 = CallBackGarantias.FindControl("gridviewGarantias");
                ASPxGridView GridGarantias = ctrl1 as ASPxGridView;
                ctrl2 = GridGarantias.FindEditFormTemplateControl("spinMontoAvaluo");
                ctrl3 = GridGarantias.FindEditFormTemplateControl("spinValorCrediticio");

                string montoAvaluo = null;
                if ((ctrl2 as ASPxSpinEdit).Value != null)
                {
                    montoAvaluo = (ctrl2 as ASPxSpinEdit).Value.ToString();
                }

                if (montoAvaluo != null)
                {
                    decimal valorcred = ((!string.IsNullOrEmpty(dt.Rows[0]["ValorCrediticio"].ToString())) ? Convert.ToDecimal(dt.Rows[0]["ValorCrediticio"]) : 0);
                    decimal monto = Convert.ToDecimal(montoAvaluo);
                    (ctrl3 as ASPxSpinEdit).Value = (monto * valorcred);
                }
            }
            catch (Exception ex)
            {
                lbError.Text = lbError.Text + "\n Error en cboValorCrediticio_Callback \nError: " + ex.ToString() + "\n Query.Message: " + query.Mensaje;
            }

        }

