        private void ObtenerMunicipio(string Departamento)
        {
            ASPxComboBox cboMunicipio = NabBarCampos.Groups.FindByName("InformacionCredito").FindControl("cboMunicipio") as ASPxComboBox;
            Label lbError = NabBarCampos.Groups.FindByName("Titulo").FindControl("lbError") as Label;
            ASPxComboBox cboAldea = NabBarCampos.Groups.FindByName("InformacionCredito").FindControl("cboAldea") as ASPxComboBox;

            SQLSrv query = new SQLSrv(Properties.Settings.Default.DBGestorBP, "usp_ObtMunicipio");
            DataTable dt = new DataTable();

            try
            {
                if (!string.IsNullOrEmpty(Departamento))
                {
                    query.Parametros.Add(new SqlParameter("@idDepto", Departamento));

                    dt = query.getDataTableWithParameters();

                    if (query.Success)
                    {
                        if (dt.Rows.Count > 0)
                        {
                            cboMunicipio.DataSource = dt;
                            cboMunicipio.ValueField = "idMunicipio";
                            cboMunicipio.TextField = "Municipio";
                            cboMunicipio.DataBind();                          
                        }
                    }
                }


            }
            catch (Exception ex)
            {
                lbError.Text = lbError.Text + "\n Error en obtener los municipios del departamento seleccionado \nError: " + ex.ToString();
            }

        }

        private void ObtenerAldea(string Municipio)
        {
            ASPxComboBox cboAldea = NabBarCampos.Groups.FindByName("InformacionCredito").FindControl("cboAldea") as ASPxComboBox;
            ASPxComboBox cboLugarInversion = NabBarCampos.Groups.FindByName("InformacionCredito").FindControl("cboLugarInversion") as ASPxComboBox;
            String departamento = "";
            if (cboLugarInversion.Value != null)
            {
                departamento = cboLugarInversion.Value.ToString();
            }

            Label lbError = NabBarCampos.Groups.FindByName("Titulo").FindControl("lbError") as Label;

            SQLSrv query = new SQLSrv(Properties.Settings.Default.DBGestorBP, "usp_obtAldea");
            DataTable dt = new DataTable();

            try
            {
                if ((!string.IsNullOrEmpty(Municipio)) && (!string.IsNullOrEmpty(departamento)))
                {
                    query.Parametros.Add(new SqlParameter("@idmun", Municipio));
                    query.Parametros.Add(new SqlParameter("@iddep", departamento));

                    dt = query.getDataTableWithParameters();

                    if (query.Success)
                    {
                        if (dt.Rows.Count > 0)
                        {
                            cboAldea.DataSource = dt;
                            cboAldea.ValueField = "idAldea";
                            cboAldea.TextField = "Aldea";
                            cboAldea.DataBind();
                        }
                    }
                }


            }
            catch (Exception ex)
            {
                lbError.Text = lbError.Text + "\n Error en obtener las aldeas del municipio seleccionado \nError: " + ex.ToString();
            }

        }

