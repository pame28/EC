            {
                ASPxComboBox dropMonedaOperacion = sender as ASPxComboBox;
                Int32 idProducto = Convert.ToInt32(gridPropuestaCreditoDesembolso.GetRowValues(gridPropuestaCreditoDesembolso.EditingRowVisibleIndex, "idProducto").ToString());

                dropMonedaOperacion.DataSource = obtieneProductoMoneda(idProducto);
                dropMonedaOperacion.DataBind();

                if (gridPropuestaCreditoDesembolso.GetRowValues(gridPropuestaCreditoDesembolso.EditingRowVisibleIndex, "idMoneda").ToString() != string.Empty)
                {
                    Int32 idMoneda = Convert.ToInt32(gridPropuestaCreditoDesembolso.GetRowValues(gridPropuestaCreditoDesembolso.EditingRowVisibleIndex, "idMoneda").ToString());
                    dropMonedaOperacion.SelectedItem = dropMonedaOperacion.Items.FindByValue(idMoneda);
                }
            }
        }

