using System;
using System.IO;
using System.Security.Cryptography;

namespace EstadosCuentaTC.Services
{
    public static class EncriptacionAES
    {
        // Tamaños recomendados para AES-GCM
        private const int NonceSizeBytes = 12; // 96 bits, tamaño recomendado por NIST
        private const int TagSizeBytes = 16;   // 128 bits, tamaño máximo/recomendado del tag

        /// <summary>
        /// Encripta un archivo completo con AES-GCM.
        /// El archivo de salida contiene: [tag (16 bytes)] + [ciphertext].
        /// El nonce se maneja aparte (igual que antes se guardaba el IV en LlavePublica.txt).
        /// </summary>
        public static void EncriptarArchivo(string rutaEntrada, string rutaSalida, string keyString, string nonceBase64)
        {
            byte[] key = Convert.FromBase64String(keyString);
            byte[] nonce = Convert.FromBase64String(nonceBase64);

            if (nonce.Length != NonceSizeBytes)
                throw new ArgumentException($"El nonce debe tener {NonceSizeBytes} bytes para AES-GCM.");

            byte[] plaintext = File.ReadAllBytes(rutaEntrada);
            byte[] ciphertext = new byte[plaintext.Length];
            byte[] tag = new byte[TagSizeBytes];

            using (var aesGcm = new AesGcm(key, TagSizeBytes))
            {
                aesGcm.Encrypt(nonce, plaintext, ciphertext, tag);
            }

            using (var fsSalida = new FileStream(rutaSalida, FileMode.Create, FileAccess.Write))
            {
                fsSalida.Write(tag, 0, tag.Length);
                fsSalida.Write(ciphertext, 0, ciphertext.Length);
            }
        }

        /// <summary>
        /// Desencripta un archivo generado por EncriptarArchivo.
        /// </summary>
        public static void DesencriptarArchivo(string rutaEntrada, string rutaSalida, string keyString, string nonceBase64)
        {
            byte[] key = Convert.FromBase64String(keyString);
            byte[] nonce = Convert.FromBase64String(nonceBase64);

            byte[] contenido = File.ReadAllBytes(rutaEntrada);

            if (contenido.Length < TagSizeBytes)
                throw new InvalidDataException("El archivo encriptado está corrupto o incompleto.");

            byte[] tag = new byte[TagSizeBytes];
            byte[] ciphertext = new byte[contenido.Length - TagSizeBytes];

            Buffer.BlockCopy(contenido, 0, tag, 0, TagSizeBytes);
            Buffer.BlockCopy(contenido, TagSizeBytes, ciphertext, 0, ciphertext.Length);

            byte[] plaintext = new byte[ciphertext.Length];

            using (var aesGcm = new AesGcm(key, TagSizeBytes))
            {
                // Si la llave/nonce/tag no coinciden exactamente, esto lanza CryptographicException
                // (a diferencia de CBC, que podía "desencriptar" datos corruptos sin avisarte).
                aesGcm.Decrypt(nonce, ciphertext, tag, plaintext);
            }

            File.WriteAllBytes(rutaSalida, plaintext);
        }

        /// <summary>
        /// Genera un nonce aleatorio de 12 bytes, apto para AES-GCM.
        /// </summary>
        public static string GenerarNonceBase64()
        {
            byte[] nonce = new byte[NonceSizeBytes];
            using (var rng = RandomNumberGenerator.Create())
                rng.GetBytes(nonce);

            return Convert.ToBase64String(nonce);
        }
    }
}















using Microsoft.Extensions.Logging;
using System;
using System.IO;
using System.IO.Compression;

namespace EstadosCuentaTC.Services
{
    public class EncriptacionService
    {
        private readonly ILogger<EncriptacionService> _logger;

        public EncriptacionService(ILogger<EncriptacionService> logger)
        {
            _logger = logger;
        }

        public void Ejecutar(string rutaJson, string nombreArchivoBase, DateTime fechaCorte, string keyString)
        {
            try
            {
                _logger.LogInformation("---------- INICIO ENCRIPTACIÓN Y COMPRESIÓN (AES-GCM) ----------");

                string rutaFinal = Path.Combine(rutaJson, fechaCorte.ToString("yyyy-MM-dd"));
                string nombreJson = $"{nombreArchivoBase}{fechaCorte.Day}.json";
                string pathJson = Path.Combine(rutaFinal, nombreJson);

                _logger.LogInformation("Archivo a encriptar: {Archivo}", pathJson);

                if (!File.Exists(pathJson))
                {
                    _logger.LogError("El archivo JSON no existe: {Archivo}", pathJson);
                    throw new FileNotFoundException($"No existe el archivo: {pathJson}");
                }

                // Generar nonce aleatorio (12 bytes, requerido por AES-GCM)
                _logger.LogInformation("Generando nonce aleatorio...");
                string nonceBase64 = EncriptacionAES.GenerarNonceBase64();

                // Guardar el nonce (equivalente al IV anterior, pero de 12 bytes)
                string rutaLlave = Path.Combine(rutaFinal, "LlavePublica.txt");
                File.WriteAllText(rutaLlave, nonceBase64);
                _logger.LogInformation("Nonce guardado en: {Ruta}", rutaLlave);

                // Encriptar
                string archivoEnc = pathJson + "e";
                _logger.LogInformation("Encriptando archivo...");
                EncriptacionAES.EncriptarArchivo(pathJson, archivoEnc, keyString, nonceBase64);

                // Reemplazar original con encriptado
                File.Delete(pathJson);
                File.Move(archivoEnc, pathJson);
                _logger.LogInformation("Archivo encriptado correctamente: {Archivo}", pathJson);

                // Comprimir en ZIP
                string nombreZip = $"{nombreArchivoBase}{fechaCorte.Day}.zip";
                string rutaZipTemp = rutaFinal + ".zip";
                string rutaZipFinal = Path.Combine(rutaFinal, nombreZip);

                _logger.LogInformation("Comprimiendo carpeta en ZIP...");

                if (File.Exists(rutaZipTemp))
                {
                    File.Delete(rutaZipTemp);
                    _logger.LogInformation("ZIP temporal anterior eliminado: {Zip}", rutaZipTemp);
                }

                if (File.Exists(rutaZipFinal))
                {
                    File.Delete(rutaZipFinal);
                    _logger.LogInformation("ZIP final anterior eliminado: {Zip}", rutaZipFinal);
                }

                ZipFile.CreateFromDirectory(rutaFinal, rutaZipTemp);
                File.Move(rutaZipTemp, rutaZipFinal);

                _logger.LogInformation("ZIP generado en: {Zip}", rutaZipFinal);
                _logger.LogInformation("---------- FIN ENCRIPTACIÓN Y COMPRESIÓN ----------");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en el proceso de encriptación/compresión");
                throw;
            }
        }
    }
}