ALTER   PROCEDURE [dbo].[usp_CreditoBandeja] --exec [dbo].[usp_CreditoBandeja] 9133, '1000000001547346', '1808196500247'
	-- Add the parameters for the stored procedure here
	@NumLote bigint,
	@NumeroTarjeta VARCHAR(20),
	@Identidad VARCHAR(20)
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	SET LANGUAGE SPANISH
/***********************************************************************************************/

	IF OBJECT_ID('tempdb..#TblTarjetas') IS NOT NULL
	BEGIN
				DROP TABLE #TblTarjetas
	END


	IF OBJECT_ID('tempdb..#TblMontos') IS NOT NULL
	BEGIN
				DROP TABLE #TblMontos
	END



	IF OBJECT_ID('tempdb..#Tbltipoembperclitar') IS NOT NULL
	BEGIN
				DROP TABLE #Tbltipoembperclitar
	END



	IF OBJECT_ID('tempdb..#TblClientes') IS NOT NULL
	BEGIN
				DROP TABLE #TblClientes
	END




	IF OBJECT_ID('tempdb..#TblServicios') IS NOT NULL
	BEGIN
				DROP TABLE #TblServicios
	END


	IF OBJECT_ID('tempdb..#TblFiadores') IS NOT NULL
	BEGIN
				DROP TABLE #TblFiadores
	END


	IF OBJECT_ID('tempdb..#TblEUsuariosETarjetas') IS NOT NULL
	BEGIN
				DROP TABLE #TblEUsuariosETarjetas
	END

	IF OBJECT_ID('tempdb..#TblReferenciasTC') IS NOT NULL
	BEGIN
				DROP TABLE #TblReferenciasTC
	END

	SELECT DISTINCT 
					  IC.imprimircontrato, 				  
					  ic.nombrecliente, 
					  ic.segundonombre, 
					  ic.apellido1, 
					  ic.apellido2, 
					  ltrim(rtrim(ic.nombrecliente)) + ' ' + ltrim(rtrim(ic.segundonombre)) + ' ' + ltrim(rtrim(ic.apellido1)) + ' ' + ltrim(rtrim(ic.apellido2)) AS nombrecompleto, 
					  ltrim(rtrim(ic.identidad)) AS numeroidentidad, 
					  ic.numlote, 
					  ISNULL(ic.NumeroTarjetaCore, ic.numerotarjeta) as numerotarjeta, 
					  ic.tipotarjeta, 				 
					  ic.direccionestadocuenta1, 
					  ic.direccionestadocuenta2, 
					  ic.direccionestadocuenta3, 
					  ic.telefono1, 
					  ic.telefono2, 
					  ic.telefono3,
					   (SELECT TOP (1) codigocrm
					   FROM   dbo.splitstring(ic.telefono1 + '/' + ic.telefono2 + '/' + ic.telefono3, '/') AS splitstring_1
					   WHERE  (  tam >= 9)) AS codigocrm, 
					   isnull(ic.codigodistribucion, '') AS codigodistribucion, 
					   ic.bin, 
					   ic.codigoproducto,
					   ic.TasaCambio, 
					   rtrim(ltrim(ic.tarjetaimprimir)) AS terminaciontc, 
					   rtrim(ltrim(ic.nombreempresa)) AS nombreempresatitular, 
					   ic.limitecreditoml, 
					   ic.limitecreditome, 
					   ic.cedulajuridica, 
					   day(getdate()) AS dia,
						CASE month(getdate())
						WHEN 1 THEN  'Enero'
						WHEN 2 THEN  'Febrero'
						WHEN 3 THEN  'Marzo'
						WHEN 4 THEN  'Abril'
						WHEN 5 THEN  'Mayo'
						WHEN 6 THEN  'Junio'
						WHEN 7 THEN  'Julio'
						WHEN 8 THEN  'Agosto'
						WHEN 9 THEN  'Septiembre'
						WHEN 10 THEN  'Octubre'
						WHEN 11 THEN  'Noviembre'
						WHEN 12 THEN  'Diciembre'
						END
						AS mes, year(getdate()) AS ano, 
						ltrim(rtrim(ic.nombrefiador1)) + ' ' + ltrim(rtrim(ic.apellido1fiador1)) + ' ' + ltrim(rtrim(ic.apellido2fiador1)) AS fiador1, 
						ltrim(rtrim(ic.nombrefiador2)) + ' ' + ltrim(rtrim(ic.apellido1fiador2)) + ' ' + ltrim(rtrim(ic.apellido2fiador2)) AS fiador2, 
						ltrim(rtrim(ic.nombrefiador3)) + ' ' + ltrim(rtrim(ic.apellido1fiador3)) + ' ' + ltrim(rtrim(ic.apellido2fiador3)) AS fiador3, 
						ltrim(rtrim(ic.numcedulafiador1)) AS cedulafiador1, 
						ltrim(rtrim(ic.numcedulafiador2)) AS cedulafiador2, 
						ltrim(rtrim(ic.numcedulafiador3)) AS cedulafiador3, 					
						ltrim(rtrim(ic.s2gnit)) AS rtn, 					
						ic.ciclocorte, 
						ic.ciudad, 					
						isnull(ic.cat, 0) AS cat, 					
						ic.plazofinanciamiento,
						Convert(VarChar(10),GetDate(),103) as fechaactual, 				
						CASE
						WHEN
						  ( SELECT count(a.bin)
							FROM   parbinproductoprepagada a
							WHERE  a.bin = ic.bin) > 0 
							THEN  '1'
						  ELSE '0'
						END
						AS esprepagada, 
						ic.numerocuenta, 
						ltrim(rtrim(replace(replace(ic.identidad, '-', ''), ' ', '')))  identidad, 
						ic.fechafinvigencia,				
						CASE month(ic.fechafinvigencia) - 1
						WHEN 1 THEN  'Enero'
						WHEN 2 THEN  'Febrero'
						WHEN 3 THEN  'Marzo'
						WHEN 4 THEN  'Abril'
						WHEN 5 THEN  'Mayo'
						WHEN 6 THEN  'Junio'
						WHEN 7 THEN  'Julio'
						WHEN 8 THEN  'Agosto'
						WHEN 9 THEN  'Septiembre'
						WHEN 10 THEN  'Octubre'
						WHEN 11 THEN  'Noviembre'
						WHEN 12 THEN  'Diciembre'
						WHEN 0 THEN  'Diciembre'
						END	AS mesvencimiento 
				INTO #TblTarjetas
				FROM Tarjetas AS ic 
				WHERE IC.NumLote = @NumLote
				AND NumeroTarjeta = rtrim(ltrim( @NumeroTarjeta))

			
				SELECT	DISTINCT	
						a.Bin,
						a.CodigoProducto,
						a.maximo, 
						a.maximo * b.tasacambio AS maximolps, 
						a.cobertura, 
						a.maximoanual, 
						a.tasalps AS tasaintereslocal, 
						a.tasadls AS tasainteresinternacional, 
						a.membresiaanualtitular, 
						a.comisionretirosefectivo, 
						a.comisionretirosefectivodls, 
						a.segurocoberturadeuda, 
						a.membresiaadicional, 
						a.rehabilitacion30dias, 
						a.rehabilitacion60dias, 
						a.rehabilitacionm60dias, 
						a.sobregirolineacred, 
						a.chequesmndevueltosmn, 
						a.chequesmndevueltosme, 
						a.chequesmedevueltosme, 
						a.servicioselectronicos, 
						a.deteriororeposiciontit, 
						a.deteriororeposicionadi, 
						a.coberturahre, 
						a.copiascomptrndisputamn, 
						a.copiascomptrndisputame, 
						a.reposicionec, 
						a.reposicionnip, 
						a.bpprotege AS montobpprotege, 
						a.emisionconstanciasref, 
						a.descripciontarjeta, 
						a.bpasistmed, 
						a.cargoshonorarios, 
						a.calculohonorarios, 
						a.monedalimite, 
						a.empresarial,
						a.Tipo_Prod
				INTO #TblMontos
				FROM Montos a
				INNER JOIN #TblTarjetas b
					ON a.Bin = b.BIN
					and a.CodigoProducto = b.CodigoProducto

		

			SELECT  DISTINCT
					a.NumeroTarjeta,
					a.tipocliente,
					rtrim(ltrim(a.tipopersoneria)) AS tipopersoneria
			INTO #Tbltipoembperclitar
			FROM #TblTarjetas b
			LEFT JOIN dbo.uvw_tipoembperclitar a
				ON a.NumeroTarjeta = b.NumeroTarjeta

			SELECT 	ltrim(rtrim(replace(replace(a.identidad, '-', ''), ' ', ''))) AS identidad,
				 
					isnull(a.bpmovil, '') AS bpmovil,
					isnull(a.tipoplan, '') AS tipoplan, 
					isnull(a.bpprotege, '') AS bpprotege, 
					isnull(a.serviciobxi, '') AS serviciobxi, 
					isnull(a.estadocuenta, '') AS estadocuenta, 
					isnull(a.serviciohre, '') AS serviciohre, 
					isnull(a.pagoautomatico, '') AS pagoautomatico, 
					a.tiposervicio
			INTO #TblServicios
			FROM uvw_servicioafiliadosaclientes a
			INNER JOIN #TblTarjetas b
				ON ltrim(rtrim(replace(replace(a.identidad, '-', ''), ' ', ''))) = b.identidad


			SELECT  a.cif,
					ltrim(rtrim(replace(replace(a.identidad, '-', ''), ' ', ''))) AS identidad,
					a.departamento, 
					a.municipio,
					a.TipoPersona,
					a.CodActEconomica,
					a.ActividadEconomica,
					a.CodCIIU,
					a.CIIU,
					a.FuenteIngreso,
					a.RepresentanteLegal,
					a.NacionalidadRepresentante,
					a.Identidad_RepresentanteLegal
			INTO #TblClientes
			FROM Clientes a
			INNER JOIN #TblTarjetas b
				ON ltrim(rtrim(replace(replace(a.identidad, '-', ''), ' ', ''))) = b.identidad
		


			SELECT  replace(a.numerotarjeta, '*', '') AS numerotarjeta,
					a.numlote,
					a.origentc,
					a.direccion,
					a.tarjetatruncada, 
					a.nombreempresa, 
					a.NumeroTarjeta numerotarjeta2, 
					a.Equivalencia_ATH Equivalencia_ATH2,
					'*' + a.Equivalencia_ATH + '*' Equivalencia_ATH					
					--Convert(VarChar(10),GetDate(),103) as fechaactual					
			INTO #TblTarjetasR
			FROM TarjetasR a
			INNER JOIN #TblTarjetas b
				ON replace(b.numerotarjeta, '*', '') = a.numerotarjeta 


			SELECT a.CiF,
				   a.Incidente,	
				   a.Estado, 
				   a.FechaCreacion,
				   a.Descripcion,
				   a.EmpleadoAsignado,
				   a.EmpleadoCreador,
				   a.AreaAtencion,
				   a.UltimaEtapa
			INTO #TblSolicitudesCRM	   
			FROM SolicitudesCRM a
			INNER JOIN #TblClientes b
				ON a.CiF = b.Cif

			SELECT a.[Cif]
				  ,a.[Nombre_Patrono]
				  ,a.[Direccion_Ref_Laboral]
				  ,a.[Puesto_o_Cargo]
				  ,a.[Fecha_Ingreso]
				  ,a.[Salario]
				  ,a.[Nombre_Patrono2]
				  ,a.[Direccion_Ref_Laboral2]
				  ,a.[Puesto_o_Cargo2]
				  ,a.[Fecha_Ingreso2]
				  ,a.[Salario2]
				  ,a.[Nombre_Patrono3]
				  ,a.[Direccion_Ref_Laboral3]
				  ,a.[Puesto_o_Cargo3]
				  ,a.[Fecha_Ingreso3]
				  ,a.[Salario3]
				  ,a.[Sector_Economico_Patrono]
				  ,a.[Profesion]
				  ,a.[Fuente_Ingresos]
				  ,a.[Nombre_Conyugue]
				  ,a.[Nombre_Ref_Per/Fam]
				  ,a.[Parentesco_Ref_Per/Fam]
				  ,a.[Direccion_Ref_Per/Fam]
				  ,a.[Telefono_Ref_Per/Fam]
				  ,a.[Telefono_Ofi_Ref_Per/Fam]
				  ,a.[Nombre_Ref_Per/Fam2]
				  ,a.[Parentesco_Ref_Per/Fam2]
				  ,a.[Direccion_Ref_Per/Fam2]
				  ,a.[Telefono_Ref_Per/Fam2]
				  ,a.[Telefono_Ofi_Ref_Per/Fam2]
				  ,a.[Nombre_Ref_Per/Fam3]
				  ,a.[Parentesco_Ref_Per/Fam3]
				  ,a.[Direccion_Ref_Per/Fam3]
				  ,a.[Telefono_Ref_Per/Fam3]
				  ,a.[Telefono_Ofi_Ref_Per/Fam3]
			INTO #TblReferenciasTC   
			FROM ReferenciasTC a
			INNER JOIN #TblClientes b
				ON rtrim(ltrim(a.Cif)) = b.Cif


				SELECT	   EF.[NumeroTarjeta] 
						  ,EF.[NoCuentaClaro]
						  ,EF.[NOMBRE-FIADOR-PRISMA]
						  ,EF.[NUMDOC-FIADOR-PRISMA]
						  ,EF.[DOMICILIO1-FIADOR-PRISMA]
						  ,EF.[DOMICILIO2-FIADOR-PRISMA]
						  ,EF.[DOMICILIO3-FIADOR-PRISMA]
						  ,EF.[TELEFONO-FIADOR-PRISMA]
						  ,EF.[E-MAIL-USUARIO FIADOR-PRISMA]
						  ,EF.[E-MAIL-DOMINIO FIADOR-PRISMA]
						  ,EF.[NOMBRE-FIADOR-PRISMA2]
						  ,EF.[NUMDOC-FIADOR-PRISMA2]
						  ,EF.[DOMICILIO1-FIADOR-PRISMA2]
						  ,EF.[DOMICILIO2-FIADOR-PRISMA2]
						  ,EF.[DOMICILIO3-FIADOR-PRISMA2]
						  ,EF.[TELEFONO-FIADOR-PRISMA2]
						  ,EF.[E-MAIL-USUARIO FIADOR-PRISMA2]
						  ,EF.[E-MAIL-DOMINIO FIADOR-PRISMA2]
						  ,EF.[NOMBRE-FIADOR-PRISMA3]
						  ,EF.[NUMDOC-FIADOR-PRISMA3]
						  ,EF.[DOMICILIO1-FIADOR-PRISMA3]
						  ,EF.[DOMICILIO2-FIADOR-PRISMA3]
						  ,EF.[DOMICILIO3-FIADOR-PRISMA3]
						  ,EF.[TELEFONO-FIADOR-PRISMA3]
						  ,EF.[E-MAIL-USUARIO FIADOR-PRISMA3]
						  ,EF.[E-MAIL-DOMINIO FIADOR-PRISMA3]
				INTO #TblFiadores
				FROM EFiadores EF
				INNER JOIN #TblTarjetas b
				ON replace(b.numerotarjeta, '*', '') = EF.numerotarjeta 

				SELECT   EU.[NumeroTarjeta] 
						,EU.[DOMICILIO1-PRISMA]
						,EU.[PUERTA-PRISMA]
						,EU.[DOMICILIO2-PRISMA]
						,EU.[DOMICILIO3-PRISMA]
						,EU.[COD-POSTAL-PRISMA]
						,EU.[BARRIO-COMUNA-PRISMA]
						,EU.[CIUDAD-LOCALIDAD-PRISMA]
						,EU.[COD-DEPARTAMENTO-PRISMA]
						,EU.[COD-PAIS-PRISMA]
						,EU.[TELEFONO-PRISMA]
						,EU.[DOMICILIO1-CORR-PRISMA]
						,EU.[DOMICILIO2-CORR-PRISMA]
						,EU.[DOMICILIO3-CORR-PRISMA]
						,EU.[PUERTA-CORR-PRISMA]
						,EU.[COD-POSTAL-CORR-PRISMA]
						,EU.[BARRIO-COMUNA-CORR-PRISMA]
						,EU.[CIUDAD-LOCALIDAD-CORR-PRISMA]
						,EU.[COD-DEPARTAMENTO-CORR PRISMA]
						,EU.[COD-PAIS-CORR-PRISMA]
						,EU.[CASILLA-CORREO-CORR-PRISMA]
						,EU.[E-MAIL-USUARIO-PRISMA]
						,EU.[E-MAIL-DOMINIO-PRISMA]
						,EU.[NAC-PRISMA]
						,EU.[SEXO-PRISMA]
						,EU.[ESTCIV-PRISMA]
						,EU.[FNAC-PRISMA]
						,EU.[OCUPACION-PRISMA]
				INTO #TblEUsuariosETarjetas 
				FROM EUsuarios_ETarjetas EU
				INNER JOIN #TblTarjetas b
				ON replace(b.numerotarjeta, '*', '') = EU.numerotarjeta 


	SELECT   distinct
			 a.imprimircontrato
			,a.nombrecliente
			,a.segundonombre
			,a.apellido1
			,a.apellido2
			,a.nombrecompleto
			,a.numeroidentidad
			,a.numlote
			,a.numerotarjeta
			,a.tipotarjeta
			,a.direccionestadocuenta1
			,a.direccionestadocuenta2
			,a.direccionestadocuenta3
			,a.telefono1
			,a.telefono2
			,a.telefono3
			,a.codigocrm
			,a.codigodistribucion
			,a.bin
			,a.codigoproducto
			,a.TasaCambio
			,a.terminaciontc
			,a.nombreempresatitular
			,FORMAT(a.limitecreditoml,'###,###,###.00') limitecreditoml
			,FORMAT(a.limitecreditome,'###,###,###.00') limitecreditome
			,a.cedulajuridica
			,a.dia
			,a.mes
			,DATENAME(MONTH,DATEADD(MONTH,MONTH(g.FechaCarga),'20190101')) MesSiguiente
			,a.ano
			,a.fiador1
			,a.fiador2
			,a.fiador3
			,a.cedulafiador1
			,a.cedulafiador2
			,a.cedulafiador3
			,a.rtn
			,a.ciclocorte
			,a.ciudad
			,a.cat
			,a.plazofinanciamiento
			,a.fechaactual
			,a.esprepagada
			,a.numerocuenta
			,a.identidad
			,a.fechafinvigencia
			,a.mesvencimiento		
			,FORMAT(b.maximo,'###,###,###.00') as maximo
			,FORMAT(b.maximolps,'###,###,###.00') as maximolps
			,b.cobertura
			,b.maximoanual
			,b.tasaintereslocal
			,b.tasainteresinternacional
			,b.membresiaanualtitular
			,b.comisionretirosefectivo
			,b.comisionretirosefectivodls
			,b.segurocoberturadeuda
			,b.membresiaadicional
			,b.rehabilitacion30dias
			,b.rehabilitacion60dias
			,b.rehabilitacionm60dias
			,b.sobregirolineacred
			,b.chequesmndevueltosmn
			,b.chequesmndevueltosme
			,b.chequesmedevueltosme
			,b.servicioselectronicos
			,b.deteriororeposiciontit
			,b.deteriororeposicionadi
			,b.coberturahre
			,b.copiascomptrndisputamn
			,b.copiascomptrndisputame
			,b.reposicionec
			,b.reposicionnip
			,b.montobpprotege
			,b.emisionconstanciasref
			,b.descripciontarjeta
			,b.bpasistmed
			,b.cargoshonorarios
			,b.calculohonorarios
			,b.monedalimite
			,b.empresarial
			,b.Tipo_Prod
			,c.NumeroTarjeta
			,c.tipocliente
			,c.tipopersoneria
			,d.bpmovil, 
			d.tipoplan, 
			d.bpprotege, 
			d.serviciobxi, 
			d.estadocuenta, 
			d.serviciohre, 
			d.pagoautomatico, 
			d.tiposervicio,
			e.Cif,
			e.Departamento,
			e.Municipio,
			f.origentc,
			f.direccion,
			f.tarjetatruncada, 
			f.nombreempresa, 
			f.numerotarjeta2, 
			f.Equivalencia_ATH2,
			Equivalencia_ATH,
			g.FechaCarga,
			e.TipoPersona,
			e.CodActEconomica,
			e.ActividadEconomica,
			e.CodCIIU,
			e.CIIU,
			e.FuenteIngreso,
			e.RepresentanteLegal,
			e.NacionalidadRepresentante,
			e.Identidad_RepresentanteLegal,
			h.Incidente,	
			h.Estado, 
			h.FechaCreacion,
			h.Descripcion,
			h.EmpleadoAsignado,
			h.EmpleadoCreador,
			h.AreaAtencion,
			h.UltimaEtapa
			,	EF.[NOMBRE-FIADOR-PRISMA]
			,	EF.[NUMDOC-FIADOR-PRISMA]
			,	EF.[DOMICILIO1-FIADOR-PRISMA]
			,	EF.[DOMICILIO2-FIADOR-PRISMA]
			,	EF.[DOMICILIO3-FIADOR-PRISMA]
			,	EF.[TELEFONO-FIADOR-PRISMA]
			,	EF.[E-MAIL-USUARIO FIADOR-PRISMA]
			,	EF.[E-MAIL-DOMINIO FIADOR-PRISMA]
			,	EF.[NOMBRE-FIADOR-PRISMA2]
			,	EF.[NUMDOC-FIADOR-PRISMA2]
			,	EF.[DOMICILIO1-FIADOR-PRISMA2]
			,	EF.[DOMICILIO2-FIADOR-PRISMA2]
			,	EF.[DOMICILIO3-FIADOR-PRISMA2]
			,	EF.[TELEFONO-FIADOR-PRISMA2]
			,	EF.[E-MAIL-USUARIO FIADOR-PRISMA2]
			,	EF.[E-MAIL-DOMINIO FIADOR-PRISMA2]
			,	EF.[NOMBRE-FIADOR-PRISMA3]
			,	EF.[NUMDOC-FIADOR-PRISMA3]
			,	EF.[DOMICILIO1-FIADOR-PRISMA3]
			,	EF.[DOMICILIO2-FIADOR-PRISMA3]
			,	EF.[DOMICILIO3-FIADOR-PRISMA3]
			,	EF.[TELEFONO-FIADOR-PRISMA3]
			,	EF.[E-MAIL-USUARIO FIADOR-PRISMA3]
			,	EF.[E-MAIL-DOMINIO FIADOR-PRISMA3]
			,	EU.[DOMICILIO1-PRISMA]
			,	EU.[PUERTA-PRISMA]
			,	EU.[DOMICILIO2-PRISMA]
			,	EU.[DOMICILIO3-PRISMA]
			,	EU.[COD-POSTAL-PRISMA]
			,	EU.[BARRIO-COMUNA-PRISMA]
			,	EU.[CIUDAD-LOCALIDAD-PRISMA]
			,	EU.[COD-DEPARTAMENTO-PRISMA]
			,	EU.[COD-PAIS-PRISMA]
			,	EU.[TELEFONO-PRISMA]
			,	EU.[DOMICILIO1-CORR-PRISMA]
			,	EU.[DOMICILIO2-CORR-PRISMA]
			,	EU.[DOMICILIO3-CORR-PRISMA]
			,	EU.[PUERTA-CORR-PRISMA]
			,	EU.[COD-POSTAL-CORR-PRISMA]
			,	EU.[BARRIO-COMUNA-CORR-PRISMA]
			,	EU.[CIUDAD-LOCALIDAD-CORR-PRISMA]
			,	EU.[COD-DEPARTAMENTO-CORR PRISMA]
			,	EU.[COD-PAIS-CORR-PRISMA]
			,	EU.[CASILLA-CORREO-CORR-PRISMA]
			,	EU.[E-MAIL-USUARIO-PRISMA]
			,	EU.[E-MAIL-DOMINIO-PRISMA]
			,	EU.[NAC-PRISMA]
			,	EU.[SEXO-PRISMA]
			,	EU.[ESTCIV-PRISMA]
