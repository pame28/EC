using EstadosCuentaTC.Data;
using EstadosCuentaTC.Dtos;
using Microsoft.Data.SqlClient;
using System;
using System.Data;

namespace EstadosCuentaTC.Repositories
{
    public class ParametrosGeneracionECRepository
    {
        private readonly SqlExecutor _sql;

        public ParametrosGeneracionECRepository(SqlExecutor sql)
        {
            _sql = sql;
        }

        public ParametrosGeneracionECDto ObtenerParametros()
        {
            using var conn = _sql.GetConnection();

            // Obtener parámetros de generación
            using var cmd = new SqlCommand("usp_ObtenerParametrosGeneracionEC", conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            using var reader = cmd.ExecuteReader();

            if (!reader.Read())
                throw new Exception("No hay parámetros de generación configurados");

            var parametros = new ParametrosGeneracionECDto
            {

                FechaCorteProcesar = reader.GetDateTime(reader.GetOrdinal("FechaCorteProcesar")),
                DireccionReporte = reader["DireccionReporte"]?.ToString() ?? "",
                RutaArchivoJson = reader["RutaArchivoJson"]?.ToString() ?? "",
                RutaDestinoArchivoJson = reader["RutaDestinoArchivoJson"]?.ToString() ?? "",
                LlaveEncripta = reader["LlaveEncripta"]?.ToString() ?? "",
                TipoGeneracion = reader["TipoGeneracion"]?.ToString() ?? "",
                RegistrosPorLote = reader.GetInt32(reader.GetOrdinal("RegistrosPorLote")),
                CantidadHilos = reader.GetInt32(reader.GetOrdinal("CantidadHilos")),
                NombreArchivo = reader["NombreArchivo"]?.ToString() ?? ""

            };

            reader.Close();

            //  Obtener contep
            parametros.CantidadEstadosCuenta = ObtenerCantidadEstadosCuenta(conn);

            return parametros;
        }

        private int ObtenerCantidadEstadosCuenta(SqlConnection conn)
        {
            using var cmd = new SqlCommand("usp_ObtenerCantidadEstadosCuenta", conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            return Convert.ToInt32(cmd.ExecuteScalar());
        }
    }
}







