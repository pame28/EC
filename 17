ALTER PROCEDURE [dbo].[usp_consultaObtieneInfoClientes]
	-- Add the parameters for the stored procedure here
(
	@idCliente int
	,@usuario varchar(20)
	,@Accion int
)
AS
BEGIN

	SET NOCOUNT ON;

	IF @Accion = 1 
	BEGIN 

	--Obtiene Tasa
	DECLARE @monTasaCambio AS DECIMAL(11,7)
	SELECT  @monTasaCambio = monTasaCambio FROM Monedas
	------------------------------------------------------

		SELECT	c.idCliente
			,c.cliCif
			,c.cliIdentidad
			,c.cliNombre
			,c.cliTipoCliente
			,c.cliOficialAsignado
			,o.ofiNombre
			,c.cliZona
			--Datos de Localización
			,c.cliTelefono1
			,c.cliTelefono2
			,c.cliTelefono3
			,c.cliFax
			,c.cliDireccion1
			,c.cliCorreo
			,c.cliDireccion2	
			,e.etaDescripcion	
			--Ajuste Requerimiento 207-2017
			,u.UsrNombre 	
			------------------------------
			--Ajuste telefono favorito
			,ISNULL(fa.Telefono, '') as TelefonoFavorito
		FROM Clientes c WITH(NOLOCK) 
						LEFT JOIN Oficiales o WITH(NOLOCK) ON c.cliOficialAsignado=o.idOficial
						LEFT JOIN Etapas e WITH(NOLOCK) ON e.idEtapa=c.cliEtapaCobranza
						--Ajuste Requerimiento 207-2017----------------------------
						LEFT JOIN colasDetalle cd WITH(NOLOCK) ON cd.idCliente=c.idCliente
						LEFT JOIN Cobradores c2 WITH(NOLOCK) ON cd.idCobrador=c2.idCobrador and c2.cobEstado=1
						LEFT JOIN Usuarios u WITH(NOLOCK) ON c2.idUsuario=u.idUsuario
						--Ajuste telefono favorito
						LEFT JOIN ClientesTelefonoFavorito fa WITH(NOLOCK) ON fa.idCliente = c.idCliente
						-----------------------------------------------------------  
		WHERE c.idCliente=@idCliente
		
			
		--Obtiene Saldos Totales de los productos esto si son en dolares o Lempiras------------------------------------------------------------
			SELECT	sp.salTipoProducto
					,sp.salMoneda
					,sp.salNumeroOperacion
					/***************************Cambio requerimiento 15-2017****************************************/
					,CASE WHEN sp.salTipoProducto='TDC' AND sp.salMoneda='USD' THEN 
								ROUND((sp.salTotalConsumoTC
				 				+sp.salSaldoIntraTC
								+sp.salSaldoExtraTC
								+sp.salInteresMoratorio
								+SP.salInteresAcumuladoPeriodoTC)*@monTasaCambio,2)
						  WHEN sp.salMoneda='USD' AND sp.salTipoProducto<>'TDC' THEN
						  		ROUND(sp.salMontoCancelacion*@monTasaCambio,2)
						  WHEN sp.salTipoProducto='TDC' AND sp.salMoneda='LPS'	THEN
								sp.salTotalConsumoTC
				 				+sp.salSaldoIntraTC
								+sp.salSaldoExtraTC
								+sp.salInteresMoratorio
								+SP.salInteresAcumuladoPeriodoTC 
						 ELSE sp.salMontoCancelacion	
					END	AS cancFecha	 
					/**********************************************************************************************/
					,CASE WHEN sp.salMoneda ='USD' THEN (sp.salMontoUltimoPago*@monTasaCambio)
						 ELSE sp.salMontoUltimoPago
					END monUltiPago

					,CASE
					WHEN sp.salTipoProducto='TDC' and sp.salMoneda='USD' THEN (sp.salCapitalMora * @monTasaCambio)
					WHEN sp.salTipoProducto='TDC' THEN sp.salCapitalMora
					WHEN sp.salMoneda='USD' THEN  ((sp.salInteresNoContabilizado + sp.salCapitalMora + sp.salInteresMora + sp.salSeguroMora + sp.salInteresMoratorio)  * @monTasaCambio)
					ELSE sp.salInteresNoContabilizado + sp.salCapitalMora + sp.salInteresMora + sp.salSeguroMora + sp.salInteresMoratorio
					END	 AS saldoMora						
					,sp.salEstadoOperacion
					/***************************Cambio requerimiento 15-2017****************************************/
	                ,ISNULL(
	                CASE 
						--Lempiras PTM
	                    WHEN sp.salTipoProducto in ('PTM','SOB') AND sp.salMoneda = 'LPS' AND sp.salEmpresaId=3 THEN 
											
	                                sp.salMontoCancelacion
	                                           
						WHEN sp.salTipoProducto in ('PTM','SOB') AND sp.salMoneda = 'LPS' AND sp.salEmpresaId<>3 AND sp.salCongelado='' THEN 
									
								CASE 
									WHEN 
										CAST(GETDATE() AS DATE)>sp.salFechaVencimiento AND sp.salTipoProducto='SOB' AND sp.salCapitalVigente<=0 THEN
										sp.salCapitalMora
										+ sp.salInteresVigente 
										+ sp.salInteresMora	                                                    
										+ sp.salInteresMoratorio
										+ sp.salInteresNoContabilizado 
									ELSE	
										sp.salCapitalVigente 
										+ sp.salInteresVigente 
										+ sp.salInteresMora	                                                    
										+ sp.salInteresMoratorio
										+ sp.salInteresNoContabilizado	                                          
								END                                            
											
						WHEN sp.salTipoProducto in ('PTM','SOB') AND sp.salMoneda = 'LPS' AND sp.salEmpresaId<>3 AND sp.salCongelado='P' THEN 
						CASE 
	                        WHEN 
	                            CAST(GETDATE() AS DATE)>sp.salFechaVencimiento THEN
	                            sp.salCapitalMora 
	                        ELSE	
	                            sp.salCapitalVigente	                                          
						END
						--Dolares PTM
						WHEN sp.salTipoProducto in ('PTM','SOB') AND sp.salMoneda = 'USD' AND sp.salEmpresaId=3 THEN 
											
	                            ROUND (sp.salMontoCancelacion * @monTasaCambio , 2)
	                                           
						WHEN sp.salTipoProducto in ('PTM','SOB') AND sp.salMoneda = 'USD' AND sp.salEmpresaId<>3 AND sp.salCongelado='' THEN 
											
	                            ROUND((CASE 
											WHEN 
												CAST(GETDATE() AS DATE)>sp.salFechaVencimiento AND sp.salTipoProducto='SOB' AND sp.salCapitalVigente<=0 THEN
												sp.salCapitalMora
												+ sp.salInteresVigente 
												+ sp.salInteresMora	                                                    
												+ sp.salInteresMoratorio
												+ sp.salInteresNoContabilizado 
											ELSE	
												sp.salCapitalVigente 
												+ sp.salInteresVigente 
												+ sp.salInteresMora	                                                    
												+ sp.salInteresMoratorio
												+ sp.salInteresNoContabilizado	                                          
										END) *  @monTasaCambio, 2)                                           
											
							WHEN sp.salTipoProducto in ('PTM','SOB') AND sp.salMoneda = 'USD' AND sp.salEmpresaId<>3 AND sp.salCongelado='P' THEN 
							CASE 
							WHEN 
	                            CAST(GETDATE() AS DATE)>sp.salFechaVencimiento THEN
	                            ROUND (sp.salCapitalMora * @monTasaCambio , 2)
							ELSE	
	                            ROUND (sp.salCapitalVigente * @monTasaCambio , 2)                                         
							END
						--Lempiras TDC
						WHEN sp.salTipoProducto = 'TDC' AND sp.salMoneda = 'LPS' THEN
								sp.salTotalConsumoTC
								+sp.salSaldoIntraTC
								+sp.salSaldoExtraTC
						--Dolares TDC
						WHEN sp.salTipoProducto = 'TDC' AND sp.salMoneda = 'USD' THEN
								ROUND((sp.salTotalConsumoTC
								+sp.salSaldoIntraTC
								+sp.salSaldoExtraTC)* @monTasaCambio , 2)
	                END,0) AS saldoContable	 	                         
	                 /***********************************************************************************************/																												
			FROM Clientes c WITH(NOLOCK) 
							INNER JOIN RelacionesDeProductos rp WITH(NOLOCK) on c.idCliente=rp.idCliente AND rp.relTipoRelacion in ('SOW','JAF')
							INNER JOIN SaldosDeProductos	sp WITH(NOLOCK)	on rp.relNumeroOperacion=sp.salNumeroOperacion AND rp.relMoneda=sp.salMoneda
			WHERE c.idCliente=@idCliente
			
--------REQ.BH-5221 Carga de campos reserva y categoría de riesgos a Cobranzas BP----------------
		DECLARE @TotalReserva AS MONEY
		DECLARE @CategoriaRiesgo AS VARCHAR(5)

		SELECT @TotalReserva = SUM(DISTINCT br.Reserva)
		FROM Clientes c WITH(NOLOCK) 
		INNER JOIN RelacionesDeProductos rp WITH(NOLOCK) ON c.idCliente = rp.idCliente AND rp.relTipoRelacion IN ('SOW','JAF')
		INNER JOIN SaldosDeProductos sp WITH(NOLOCK) ON rp.relNumeroOperacion = sp.salNumeroOperacion AND rp.relMoneda = sp.salMoneda
		LEFT JOIN BandejaCamposReserva br WITH(NOLOCK) ON br.idCliente = c.idCliente AND (br.operacion = sp.salNumeroOperacion OR br.operacion = sp.salNumeroOperacionTC)
		WHERE br.idCliente = @idCliente

		SELECT TOP 1 @CategoriaRiesgo=br.Categoria
			FROM Clientes c WITH(NOLOCK) 
						INNER JOIN RelacionesDeProductos rp WITH(NOLOCK) on c.idCliente=rp.idCliente AND rp.relTipoRelacion in ('SOW','JAF')
						INNER JOIN SaldosDeProductos	sp WITH(NOLOCK)	on rp.relNumeroOperacion=sp.salNumeroOperacion AND rp.relMoneda=sp.salMoneda
						LEFT JOIN BandejaCamposReserva br WITH(NOLOCK) ON br.idcliente=c.idCliente AND (br.operacion=sp.salNumeroOperacion OR br.operacion=sp.salNumeroOperacionTC )
						INNER JOIN PrioridadCategoria pc WITH(NOLOCK) ON rtrim(ltrim(br.Categoria))=rtrim(ltrim(pc.Descripcion))
		WHERE br.idCliente=@idCliente
		ORDER BY pc.Prioridad asc

		SELECT ISNULL(@TotalReserva ,0) ReservaRequerida
		,ISNULL(@CategoriaRiesgo ,'') CategoriaRiesgo
	
		/********************Requerimiento 104-2048******************************************************************************************/
	--Obtiene Saldos Totales de los productos esto si son en dolares o Lempiras------------------------------------------------------------
			SELECT	CASE WHEN sp.salTipoProducto='TDC' AND sp.salMoneda='USD' THEN 
								ROUND((sp.salTotalConsumoTC
				 				+sp.salSaldoIntraTC
								+sp.salSaldoExtraTC
								+sp.salInteresMoratorio
								+SP.salInteresAcumuladoPeriodoTC)*@monTasaCambio,2)
						  WHEN sp.salMoneda='USD' AND sp.salTipoProducto<>'TDC' THEN
						  		ROUND(sp.salMontoCancelacion*@monTasaCambio,2)
						  WHEN sp.salTipoProducto='TDC' AND sp.salMoneda='LPS'	THEN
								sp.salTotalConsumoTC
				 				+sp.salSaldoIntraTC
								+sp.salSaldoExtraTC
								+sp.salInteresMoratorio
								+SP.salInteresAcumuladoPeriodoTC 
						 ELSE sp.salMontoCancelacion	
					END	AS cancFecha					
					,CASE WHEN sp.salMoneda ='USD' THEN (sp.salMontoUltimoPago*@monTasaCambio)
						 ELSE sp.salMontoUltimoPago
					END monUltiPago					
					,(CASE 
					      WHEN (
					               CASE 
					                    WHEN sp.salTipoProducto = 'TDC'
					               AND sp.salMoneda = 'USD' THEN (sp.salCapitalMora * @monTasaCambio)
					                   WHEN sp.salTipoProducto = 'TDC' THEN sp.salCapitalMora
					                   WHEN sp.salMoneda = 'USD' THEN (
					                       (
					                           sp.salInteresNoContabilizado + sp.salCapitalMora 
					                           + sp.salInteresMora + sp.salSeguroMora 
					                           + sp.salInteresMoratorio
					                       ) * @monTasaCambio
					                   )
					                   ELSE sp.salInteresNoContabilizado + sp.salCapitalMora 
					                   + sp.salInteresMora + sp.salSeguroMora + 
					                   sp.salInteresMoratorio
					                   END
					           ) > 0 THEN (
					               CASE 
					                    WHEN sp.salTipoProducto = 'TDC'
					               AND sp.salMoneda = 'USD' THEN (sp.salCapitalMora * @monTasaCambio)
					                   WHEN sp.salTipoProducto = 'TDC' THEN sp.salCapitalMora
					                   WHEN sp.salMoneda = 'USD' THEN (
					                       (
					                           sp.salInteresNoContabilizado + sp.salCapitalMora 
					                           + sp.salInteresMora + sp.salSeguroMora 
					                           + sp.salInteresMoratorio
					                       ) * @monTasaCambio
					                   )
					                   ELSE sp.salInteresNoContabilizado + sp.salCapitalMora 
					                   + sp.salInteresMora + sp.salSeguroMora + 
					                   sp.salInteresMoratorio
					                   END
					           )
					      ELSE 0
					 END) AS saldoMora
					/***************************Cambio requerimiento 15-2017****************************************/
					,ISNULL(
	                CASE 
						--Lempiras PTM
	                    WHEN sp.salTipoProducto in ('PTM','SOB') AND sp.salMoneda = 'LPS' AND sp.salEmpresaId=3 THEN 
											
	                                sp.salMontoCancelacion
	                                           
						WHEN sp.salTipoProducto in ('PTM','SOB') AND sp.salMoneda = 'LPS' AND sp.salEmpresaId<>3 AND sp.salCongelado='' THEN 
									
								CASE 
									WHEN 
										CAST(GETDATE() AS DATE)>sp.salFechaVencimiento AND sp.salTipoProducto='SOB' AND sp.salCapitalVigente<=0 THEN
										sp.salCapitalMora
										+ sp.salInteresVigente 
										+ sp.salInteresMora	                                                    
										+ sp.salInteresMoratorio
										+ sp.salInteresNoContabilizado 
									ELSE	
										sp.salCapitalVigente 
										+ sp.salInteresVigente 
										+ sp.salInteresMora	                                                    
										+ sp.salInteresMoratorio
										+ sp.salInteresNoContabilizado	                                          
								END                                            
											
						WHEN sp.salTipoProducto in ('PTM','SOB') AND sp.salMoneda = 'LPS' AND sp.salEmpresaId<>3 AND sp.salCongelado='P' THEN 
						CASE 
	                        WHEN 
	                            CAST(GETDATE() AS DATE)>sp.salFechaVencimiento THEN
	                            sp.salCapitalMora 
	                        ELSE	
	                            sp.salCapitalVigente	                                          
						END
						--Dolares PTM
						WHEN sp.salTipoProducto in ('PTM','SOB') AND sp.salMoneda = 'USD' AND sp.salEmpresaId=3 THEN 
											
	                            ROUND (sp.salMontoCancelacion * @monTasaCambio , 2)
	                                           
						WHEN sp.salTipoProducto in ('PTM','SOB') AND sp.salMoneda = 'USD' AND sp.salEmpresaId<>3 AND sp.salCongelado='' THEN 
											
	                            ROUND((CASE 
											WHEN 
												CAST(GETDATE() AS DATE)>sp.salFechaVencimiento AND sp.salTipoProducto='SOB' AND sp.salCapitalVigente<=0 THEN
												sp.salCapitalMora
												+ sp.salInteresVigente 
												+ sp.salInteresMora	                                                    
												+ sp.salInteresMoratorio
												+ sp.salInteresNoContabilizado 
											ELSE	
												sp.salCapitalVigente 
												+ sp.salInteresVigente 
												+ sp.salInteresMora	                                                    
												+ sp.salInteresMoratorio
												+ sp.salInteresNoContabilizado	                                          
										END) *  @monTasaCambio, 2)                                           
											
							WHEN sp.salTipoProducto in ('PTM','SOB') AND sp.salMoneda = 'USD' AND sp.salEmpresaId<>3 AND sp.salCongelado='P' THEN 
							CASE 
							WHEN 
	                            CAST(GETDATE() AS DATE)>sp.salFechaVencimiento THEN
	                            ROUND (sp.salCapitalMora * @monTasaCambio , 2)
							ELSE	
	                            ROUND (sp.salCapitalVigente * @monTasaCambio , 2)                                         
							END
						--Lempiras TDC
						WHEN sp.salTipoProducto = 'TDC' AND sp.salMoneda = 'LPS' THEN
								sp.salTotalConsumoTC
								+sp.salSaldoIntraTC
								+sp.salSaldoExtraTC
						--Dolares TDC
						WHEN sp.salTipoProducto = 'TDC' AND sp.salMoneda = 'USD' THEN
								ROUND((sp.salTotalConsumoTC
								+sp.salSaldoIntraTC
								+sp.salSaldoExtraTC)* @monTasaCambio , 2)
	                END,0) AS saldoContable	                         
	                 /***********************************************************************************************/																												
			FROM Clientes c WITH(NOLOCK)
							INNER JOIN RelacionesDeProductos rp WITH(NOLOCK) on c.idCliente=rp.idCliente AND rp.relTipoRelacion in ('SOW','JAF')
							INNER JOIN SaldosDeProductos	sp WITH(NOLOCK)	on rp.relNumeroOperacion=sp.salNumeroOperacion AND rp.relMoneda=sp.salMoneda
			WHERE c.idCliente=@idCliente
		/*************************************************************************************************************************************/
		
		
		
		----------Inicio Requerimiento 63-2018 Ajustes Fórmula Saldo Mora---------------------------
	
		SELECT ca2.CallAs400		   	
		FROM CallsAS400 ca2 WITH(NOLOCK)
		WHERE ca2.idCallAS400=1
	
		SELECT  cca.Campo
			   ,cca.TipoDato
			   ,cca.Longitud
			   ,cca.Direccion		
		FROM CallsAS400 ca2 WITH(NOLOCK) INNER JOIN CallsCamposAS400 cca WITH(NOLOCK) ON ca2.idCallAS400=cca.idCallAS400
		WHERE ca2.idCallAS400=1	
	
	
		SELECT  cla.Libreria		
		FROM CallsAS400 ca2 WITH(NOLOCK) INNER JOIN CallsLibreriasAS400 cla WITH(NOLOCK) ON ca2.idCallAS400=cla.idCallAS400
		WHERE ca2.idCallAS400=1	
		--------------------------------------------------------------------------------------------
	END

	

	IF @Accion = 2 
	BEGIN
		---Cuentas de los clientes-------------------------------------------
		DECLARE @cif as varchar(20)

		--Obtiene el Cif del Cliente
		SELECT @cif=c.cliCif			
		FROM Clientes c WITH(NOLOCK)
		WHERE c.idCliente=@idCliente

	END

	
	IF @Accion = 3 
	BEGIN
		--Obtiene los datos de los productos del cliente----------------------------------------------------------------------------------------
		SELECT 
				sp.salTipoProducto																										AS tipoProducto
				,sp.salProductoDesc																										AS producto
				,sp.salNumeroOperacion																									AS noOperacion	
				,CASE
				WHEN sp.salTipoProducto='TDC' THEN sp.salCapitalMora 
				ELSE sp.salInteresNoContabilizado + sp.salCapitalMora + sp.salInteresMora + sp.salSeguroMora + sp.salInteresMoratorio
				END																														AS saldoMora
				/***************************Cambio requerimiento 15-2017****************************************/
	            
	            ,CASE 
					--PTM
	                WHEN sp.salTipoProducto in ('PTM','SOB')  AND sp.salEmpresaId=3 THEN 
											
	                            sp.salMontoCancelacion
	                                           
					WHEN sp.salTipoProducto in ('PTM','SOB')  AND sp.salEmpresaId<>3 AND sp.salCongelado='' THEN 
								
								CASE 
									WHEN 
										CAST(GETDATE() AS DATE)>sp.salFechaVencimiento AND sp.salTipoProducto='SOB' AND sp.salCapitalVigente<=0 THEN
										sp.salCapitalMora
										+ sp.salInteresVigente 
										+ sp.salInteresMora	                                                    
										+ sp.salInteresMoratorio
										+ sp.salInteresNoContabilizado 
									ELSE	
										sp.salCapitalVigente 
										+ sp.salInteresVigente 
										+ sp.salInteresMora	                                                    
										+ sp.salInteresMoratorio
										+ sp.salInteresNoContabilizado	                                          
								END	                                                                        
											
					WHEN sp.salTipoProducto in ('PTM','SOB')  AND sp.salEmpresaId<>3 AND sp.salCongelado='P' THEN 
					CASE 
	                    WHEN 
	                        CAST(GETDATE() AS DATE)>sp.salFechaVencimiento THEN
	                        sp.salCapitalMora 
	                    ELSE	
	                        sp.salCapitalVigente	                                          
					END
					--TDC
					WHEN sp.salTipoProducto = 'TDC'  THEN
							sp.salTotalConsumoTC
							+sp.salSaldoIntraTC
							+sp.salSaldoExtraTC					
	            END
	            																														AS saldoContable	                         
	             /***********************************************************************************************/
				,CASE WHEN sp.salTipoProducto='TDC' THEN 
							(sp.salTotalConsumoTC
				 				+sp.salSaldoIntraTC
								+sp.salSaldoExtraTC
								+sp.salInteresMoratorio
								+SP.salInteresAcumuladoPeriodoTC)
					  ELSE sp.salMontoCancelacion
				 END																													AS cancFecha
				,sp.salMontoUltimoPago																									AS monUltiPago
				,sp.salMoneda																											AS moneda
				,sp.salEstadoOperacion																									AS condicion
				--Inicio Ajuste Requerimiento 56-2018----------------------------																									
				,sp.salNumeroOperacionTC																								AS NumeroTC
				--Fin Ajuste Requerimiento 56-2018----------------------------
				--Inicio Ajuste Requerimiento 63-2018----------------------------																									
				,sp.salEmpresaId
				--Fin Ajuste Requerimiento 63-2018----------------------------	
				--------REQ.BH-5221 Carga de campos reserva y categoría de riesgos a Cobranzas BP----------------
				,ISNULL(br.Reserva,0)				    AS reserva
				,ISNULL(br.Categoria,'')				AS categoriaRiesgo
				, sp.salDiasMora            AS DiasMora
		FROM Clientes c WITH(NOLOCK) 
						INNER JOIN RelacionesDeProductos rp WITH(NOLOCK) on c.idCliente=rp.idCliente AND rp.relTipoRelacion in ('SOW','JAF')
						INNER JOIN SaldosDeProductos	sp WITH(NOLOCK)	on rp.relNumeroOperacion=sp.salNumeroOperacion AND rp.relMoneda=sp.salMoneda
						LEFT JOIN BandejaCamposReserva br WITH(NOLOCK) ON br.idcliente=c.idCliente AND (br.operacion=sp.salNumeroOperacion OR br.operacion=sp.salNumeroOperacionTC )
		WHERE c.idCliente=@idCliente
		ORDER BY (sp.salInteresNoContabilizado + sp.salCapitalMora + sp.salInteresMora + sp.salSeguroMora + sp.salInteresMoratorio) DESC
		--------------------------------------------------------------------------------------------------------------------------------------------------
	END

	IF @Accion = 4 
	BEGIN

			--Obtiene las gestiones del cliente Consultado
			SELECT 
					bg.idBitacoraGes				AS idBitacora
					,g.idGestion
					,g.gesDescripcion				AS gestionDes
					,r.idResultado
					,r.resDescripcion				AS resultadoDes
					,bg.biGesFecha					AS fechaGestion
					,u.UsrNombre					AS usuario
					,bg.biGesProximaFecha			AS proximafecha
					,bg.biGesObservaciones			AS observaciones
					,bg.biGesGeEtiqueta1			AS geEtiqueta1
					,bg.biGesGeValor1				AS geValor1
					,bg.biGesGeEtiqueta2			AS geEtiqueta2
					,bg.biGesGeValor2				AS geValor2
					,bg.biGesMontoPromesa			AS montoPromesa
					,isnull(np.idNoPago,1)			idNoPago 					
					,np.Razon						AS NoPago 
			FROM BitacoraGestionados bg WITH(NOLOCK) 
										INNER JOIN Gestiones g WITH(NOLOCK) on bg.idGestion=g.idGestion
										INNER JOIN Resultados r WITH(NOLOCK) on bg.idResultado=r.idResultado
										LEFT JOIN Usuarios u WITH(NOLOCK) on u.idUsuario=bg.idUsuario
										LEFT JOIN NoPago np WITH(NOLOCK) ON np.idNoPago=isnull(bg.idNoPago ,1)

			WHERE idCliente=@idCliente
			ORDER BY bg.idBitacoraGes DESC
			------------------------------------------------------------------------------------------------
	END	
	
END


	

	




