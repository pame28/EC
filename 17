USE [EstadosCuentaJSONProcesador]
GO

CREATE OR ALTER PROCEDURE dbo.sp_ObtenerLlaveEncripta
    @Id INT
AS
BEGIN
    SET NOCOUNT ON;

    OPEN SYMMETRIC KEY SK_LlaveEncriptaTC
        DECRYPTION BY CERTIFICATE CertEstadosCuentaTC;

    SELECT CONVERT(VARCHAR(100), DECRYPTBYKEY(LlaveEncriptaCifrada)) AS LlaveEncripta
    FROM dbo.ParametrosGeneracionEC
    WHERE Id = @Id;

    CLOSE SYMMETRIC KEY SK_LlaveEncriptaTC;
END
GO

-- Permisos: solo la cuenta de servicio de la app deberia
-- poder ejecutar este SP. No le des acceso directo a
-- LlaveEncriptaCifrada ni a abrir la symmetric key.
