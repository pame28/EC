/* ==========================================================================
   DIAGNÓSTICO: por qué una TC no aparece (o sí) en uvw_CobranzaProductosTC
   Filtra por CIF (NoClienteUnico)
   ========================================================================== */

DECLARE @CIF VARCHAR(15) = '0000000000000';  -- <-- Cambiar aquí el CIF a validar

-- --------------------------------------------------------------------------
-- PASO 0: Ver todos los registros del cliente en EPosicionDiaria (sin filtro)
--         Esto muestra TODOS los NumeroTarjeta que tiene, no solo el consolidado.
-- --------------------------------------------------------------------------
SELECT 'PASO 0 - EPosicionDiaria (todos los registros del CIF)' AS Paso,
       ep.NoUsuario, ep.NoCuentaClaro, ep.NoClienteUnico, ep.NumeroTarjeta,
       ep.CodigoProducto
FROM EPosicionDiaria ep WITH(NOLOCK)
WHERE ep.NoClienteUnico = @CIF;

-- --------------------------------------------------------------------------
-- PASO 1: ¿Existe el registro CONSOLIDADO (NumeroTarjeta = ceros)?
--         Requisito obligatorio #1 de la vista.
-- --------------------------------------------------------------------------
SELECT 'PASO 1 - Registro consolidado (NumeroTarjeta=0000...)' AS Paso,
       ep.NoUsuario, ep.NoCuentaClaro, ep.NoClienteUnico, ep.NumeroTarjeta
FROM EPosicionDiaria ep WITH(NOLOCK)
WHERE ep.NoClienteUnico = @CIF
  AND ep.NumeroTarjeta = '0000000000000000';
-- Si esto NO devuelve filas -> la cuenta NUNCA saldrá en la vista, sin importar lo demás.

-- --------------------------------------------------------------------------
-- PASO 2: ¿Existe en EUsuarios? (INNER JOIN obligatorio #2)
-- --------------------------------------------------------------------------
SELECT 'PASO 2 - EUsuarios' AS Paso,
       eu.NoUsuario, eu.EstadoCuenta, eu.CodigoDeptoParticular
FROM EPosicionDiaria ep WITH(NOLOCK)
INNER JOIN EUsuarios eu WITH(NOLOCK) ON eu.NoUsuario = ep.NoUsuario
WHERE ep.NoClienteUnico = @CIF
  AND ep.NumeroTarjeta = '0000000000000000';
-- Si el PASO 1 devolvió filas pero este PASO 2 no -> falta en EUsuarios.

-- --------------------------------------------------------------------------
-- PASO 3a: ¿Existe en uvw_SaldosVasa con CategoriaTarjeta='0'? (ruta CLIENTE NORMAL)
-- --------------------------------------------------------------------------
SELECT 'PASO 3a - uvw_SaldosVasa (cliente normal)' AS Paso,
       us.NoCuenta, us.CategoriaTarjeta, us.NumeroTarjeta, us.EstadoTarjeta,
       us.NumTarjetaTruncada
FROM EPosicionDiaria ep WITH(NOLOCK)
INNER JOIN uvw_SaldosVasa us WITH(NOLOCK) ON us.NoCuenta = ep.NoUsuario
WHERE ep.NoClienteUnico = @CIF
  AND ep.NumeroTarjeta = '0000000000000000';
-- Filtra manualmente CategoriaTarjeta='0' para ver si ese es el bloqueo:
SELECT 'PASO 3a-bis - uvw_SaldosVasa CategoriaTarjeta=0' AS Paso,
       us.NoCuenta, us.CategoriaTarjeta, us.NumeroTarjeta
FROM EPosicionDiaria ep WITH(NOLOCK)
INNER JOIN uvw_SaldosVasa us WITH(NOLOCK) 
       ON us.NoCuenta = ep.NoUsuario AND us.CategoriaTarjeta = '0'
WHERE ep.NoClienteUnico = @CIF
  AND ep.NumeroTarjeta = '0000000000000000';

-- --------------------------------------------------------------------------
-- PASO 3b: ¿Existe en uvw_CobranzasCuentas? (ruta CLIENTE EMPRESARIAL)
-- --------------------------------------------------------------------------
SELECT 'PASO 3b - uvw_CobranzasCuentas (cliente empresarial)' AS Paso,
       us.No_Cuenta, us.Estado_Tarjeta, us.Pago_Vencido_ML, us.Pago_Vencido_ME
FROM EPosicionDiaria ep WITH(NOLOCK)
INNER JOIN uvw_CobranzasCuentas us WITH(NOLOCK) ON us.No_Cuenta = ep.NoUsuario
WHERE ep.NoClienteUnico = @CIF
  AND ep.NumeroTarjeta = '0000000000000000';

-- --------------------------------------------------------------------------
-- PASO 4: Resultado final - ¿aparece en la vista?
-- --------------------------------------------------------------------------
SELECT 'PASO 4 - Resultado en la vista final' AS Paso, v.*
FROM uvw_CobranzaProductosTC v
WHERE v.PROD_CIF = @CIF;

-- --------------------------------------------------------------------------
-- PASO 5 (opcional): Ver info adicional de LEFT JOINs (no bloquean, solo enriquecen)
-- --------------------------------------------------------------------------
SELECT 'PASO 5 - parBinProducto (solo descripción, no bloquea)' AS Paso,
       ep.CodigoProducto, p.DescEmisor
FROM EPosicionDiaria ep WITH(NOLOCK)
LEFT JOIN parBinProducto p WITH(NOLOCK) ON ep.CodigoProducto = p.Producto
WHERE ep.NoClienteUnico = @CIF
  AND ep.NumeroTarjeta = '0000000000000000';

