SELECT CLIE_CIF, LEN(CLIE_CIF), COUNT(*)
FROM BandejaTC_Procesador.dbo.CLIENTES_TC
GROUP BY CLIE_CIF, LEN(CLIE_CIF)
HAVING COUNT(*) > 1




SELECT CLIE_IDEN, COUNT(DISTINCT CLIE_CIF) AS cifs_distintos, COUNT(*) AS total
FROM (
    SELECT LTRIM(RTRIM(CLIE_IDEN)) CLIE_IDEN, LTRIM(RTRIM(CLIE_CIF)) CLIE_CIF
    FROM BandejaTC_Procesador.dbo.CLIENTES_TC
) x
GROUP BY CLIE_IDEN
HAVING COUNT(*) > 1