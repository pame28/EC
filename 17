-- 1. Crear el LOGIN a nivel de servidor
USE master;
GO

CREATE LOGIN appCobranzas 
WITH PASSWORD = 'appCobranzas',
     CHECK_POLICY = OFF,      -- evita que se apliquen políticas de complejidad de Windows
     CHECK_EXPIRATION = OFF;  -- evita que la contraseña expire
GO

-- 2. Cambiar al contexto de la base de datos
USE BPTarjetas_PRD_Procesador;
GO

-- 3. Crear el USER mapeado al LOGIN
CREATE USER appCobranzas FOR LOGIN appCobranzas;
GO

-- 4. (Opcional) Asignar permisos/roles al usuario
ALTER ROLE db_datareader ADD MEMBER appCobranzas;
ALTER ROLE db_datawriter ADD MEMBER appCobranzas;
GO