/* ==========================================================================
   DIAGNÓSTICO ESPECÍFICO: uvw_SaldosVasa
   Traza por qué una tarjeta CategoriaTarjeta='0' no sale (o sale la '1' en su lugar)
   ========================================================================== */

DECLARE @NoCuenta VARCHAR(20) = '0000000000';  -- <-- Coloca aquí el NoCuenta (NoUsuario) a validar
-- Si no conoces el NoCuenta, puedes obtenerlo del CIF así:
-- SELECT DISTINCT NoUsuario FROM EPosicionDiaria WHERE NoClienteUnico = 'TU_CIF';

-- --------------------------------------------------------------------------
-- PASO A: TODAS las tarjetas del NoCuenta en MaestroSaldos + ETarjetas
--         (antes de cualquier filtro de la vista) -> aquí vemos qué categorías
--         existen realmente y con qué estados.
-- --------------------------------------------------------------------------
SELECT 'PASO A - Tarjetas crudas en MaestroSaldos + ETarjetas' AS Paso,
       a.NoCuenta, a.NumeroTarjeta, a.CategoriaTarjeta, a.EstadoTarjeta AS EstadoTarjeta_MaestroSaldos,
       t.EstadoHabilitar, t.TarjetaImprimir, a.EstadoCuenta
FROM MaestroSaldos a WITH(NOLOCK)
INNER JOIN ETarjetas t WITH(NOLOCK) ON a.NumeroTarjeta = t.NumeroTarjeta
WHERE a.NoCuenta = @NoCuenta
ORDER BY a.CategoriaTarjeta, a.NumeroTarjeta;
-- Revisa: ¿aparece la tarjeta cat=0 aquí? Si NO aparece -> el problema es que
-- MaestroSaldos y ETarjetas no están haciendo match para esa tarjeta (revisar PASO B).

-- --------------------------------------------------------------------------
-- PASO B: ¿La tarjeta cat=0 existe en MaestroSaldos pero NO en ETarjetas (o viceversa)?
--         Esto detecta problemas de "join" (formato de NumeroTarjeta, etc.)
-- --------------------------------------------------------------------------
SELECT 'PASO B1 - Solo en MaestroSaldos (no matchea en ETarjetas)' AS Paso,
       a.NoCuenta, a.NumeroTarjeta, a.CategoriaTarjeta, a.EstadoTarjeta
FROM MaestroSaldos a WITH(NOLOCK)
WHERE a.NoCuenta = @NoCuenta
  AND a.CategoriaTarjeta = '0'
  AND NOT EXISTS (SELECT 1 FROM ETarjetas t WITH(NOLOCK) WHERE t.NumeroTarjeta = a.NumeroTarjeta);

-- --------------------------------------------------------------------------
-- PASO C: De las tarjetas que SÍ pasan el join (Paso A), ¿cuáles pasan el
--         filtro de EstadoHabilitar de la vista?
-- --------------------------------------------------------------------------
SELECT 'PASO C - Filtro EstadoHabilitar' AS Paso,
       a.NoCuenta, a.NumeroTarjeta, a.CategoriaTarjeta, a.EstadoTarjeta, t.EstadoHabilitar,
       CASE WHEN t.EstadoHabilitar IN ('','I','*','R','U','A','B','E','D','H','G','K','J') 
            THEN 'PASA' ELSE 'NO PASA - EXCLUIDA AQUI' END AS Resultado
FROM MaestroSaldos a WITH(NOLOCK)
INNER JOIN ETarjetas t WITH(NOLOCK) ON a.NumeroTarjeta = t.NumeroTarjeta
WHERE a.NoCuenta = @NoCuenta
ORDER BY a.CategoriaTarjeta, a.NumeroTarjeta;

-- --------------------------------------------------------------------------
-- PASO D: De las que pasan el Paso C, ¿en qué rama caen según EstadoTarjeta?
--         Solo 20, 22, 25, 29 tienen rama. Cualquier otro valor = excluida.
-- --------------------------------------------------------------------------
SELECT 'PASO D - Clasificacion por EstadoTarjeta' AS Paso,
       a.NoCuenta, a.NumeroTarjeta, a.CategoriaTarjeta, a.EstadoTarjeta,
       CASE a.EstadoTarjeta
            WHEN 20 THEN 'Normal (activa)'
            WHEN 22 THEN 'Orden No Renovar'
            WHEN 25 THEN 'Problema'
            WHEN 29 THEN 'Cerrada'
            ELSE 'SIN RAMA - EXCLUIDA (EstadoTarjeta no contemplado por la vista)'
       END AS RamaDestino
FROM MaestroSaldos a WITH(NOLOCK)
INNER JOIN ETarjetas t WITH(NOLOCK) ON a.NumeroTarjeta = t.NumeroTarjeta
WHERE a.NoCuenta = @NoCuenta
  AND t.EstadoHabilitar IN ('','I','*','R','U','A','B','E','D','H','G','K','J')
ORDER BY a.CategoriaTarjeta, a.NumeroTarjeta;

-- --------------------------------------------------------------------------
-- PASO E: Resultado final de la vista para este NoCuenta (todas las categorías)
-- --------------------------------------------------------------------------
SELECT 'PASO E - Resultado final uvw_SaldosVasa' AS Paso,
       Cif, NoCuenta, NumeroTarjeta, CategoriaTarjeta, EstadoTarjeta, EstadoCuenta
FROM uvw_SaldosVasa
WHERE NoCuenta = @NoCuenta;

