namespace ApiTerms.Repository
{
    public class CardsRepository : ICardsRepository
    {
        private readonly DBHelper _dbHelper;
        private readonly ILogger<CardsRepository> _logger;

        public CardsRepository(DBHelper dbHelper, ILogger<CardsRepository> logger)
        {
            _dbHelper = dbHelper;
            _logger = logger;
        }

        public async Task<CardsBaseInformation> GetBaseInfo(string cardNumber)
        {
            try
            {
                using var reader = await _dbHelper.ExecuteReaderAsync("usp_GetBaseExtrafinancing",
                    new Dictionary<string, object> { { "@NumeroTarjeta", cardNumber } });

                while (await reader.ReadAsync())
                {
                    return new CardsBaseInformation
                    {
                        Bin = reader.GetString(0),
                        LastFourDigits = reader.GetString(1),
                        DocumentNumber = reader.GetString(2),
                        DocumentType = reader.GetString(3),
                        Gender = reader.GetString(4),
                    };
                }

                _logger.LogInformation($"Requesting: CardsRepository.GetBaseInfo: No se encontraron resultados");
                return new CardsBaseInformation();
            }
            catch (Exception ex)
            {
                throw new InvalidOperationException($"Error en CardRepository: {ex.Message}", ex);
            }
        }

        public async Task<string> GetMsjError(int id)
        {
            string mensaje = string.Empty;
            try
            {
                using var reader = await _dbHelper.ExecuteReaderAsync("usp_GetMensajeError",
                    new Dictionary<string, object> { { "@Id", id } });

                while (await reader.ReadAsync())
                {
                  return mensaje = reader.GetString(0);
                }
                return string.Empty;
            }
            catch (Exception ex)
            {
                throw new InvalidOperationException($"Error en CardRepository.GetMsjError: {ex.Message}", ex);
            }
        }


        public async Task InsConsultaDisponible(string Equivalente, string Canal, string Motivo, double? Intra, double? Extra)
        {
            _logger.LogInformation("Ejecutando usp_InsertaRptConsultaSaldos");
            var parametros = new Dictionary<string, object>
            {
                {"@Equivalente", Equivalente },
                {"@Canal", Canal },
                {"@Motivo", Motivo }
            };

            if (Intra != null)
                parametros.Add("@DisponibleIntra", "Intra");
            if(Extra != null)
                parametros.Add("@DisponibleExtra", "Extra");
            try
            {
              int filasAfectadas = await _dbHelper.ExecuteNonQueryAsync("usp_InsertaRptConsultaSaldos", parametros);
                _logger.LogInformation("Ejecucion exitosa");
            }
            catch (Exception ex)
            {
                throw new InvalidOperationException($"Error en CardRepository.InsConsultaDisponible: {ex.Message}", ex);
            }
        }

        public async Task<string> GetProduct(string equivalente)
        {
            string producto = string.Empty;
            try
            {
                using var reader = await _dbHelper.ExecuteReaderAsync("usp_ObtieneProducto",
                    new Dictionary<string, object> { { "@Equivalente", equivalente } });

                while (await reader.ReadAsync())
