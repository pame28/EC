                            comando1.CommandType = CommandType.StoredProcedure;
                            comando1.Connection = conexion1;
                            comando1.Parameters.AddWithValue("@numeroOperacionTC", row["EquivalenteTarjeta"].ToString());
                            comando1.Parameters.AddWithValue("@SaldoMoraTDC", Convert.ToDecimal(row["Lempiras"].ToString()));
                            comando1.Parameters.AddWithValue("@Moneda", "LPS");
                            comando1.ExecuteNonQuery();
                        }
                        conexion1.Dispose();
                        conexion1.Close();
                    }

                    //Se actualiza el saldo para tarjetas en dolares
                    using (SqlConnection conexion2 = new SqlConnection(SistemaCobranzasBP.Properties.Settings.Default.cnc))
                    {
                        conexion2.Open();
                        using (SqlCommand command2 = new SqlCommand("usp_ActualizaSaldoMora"))
                        {
                            command2.CommandType = CommandType.StoredProcedure;
                            command2.Connection = conexion2;
                            command2.Parameters.AddWithValue("@numeroOperacionTC", row["EquivalenteTarjeta"].ToString());
                            command2.Parameters.AddWithValue("@SaldoMoraTDC", Convert.ToDecimal(row["Dolares"].ToString()));
                            command2.Parameters.AddWithValue("@Moneda", "USD");
                            command2.ExecuteNonQuery();
                        }
                        conexion2.Dispose();
                        conexion2.Close();
                    }

                }

                if (validarError == "Error")
                {
                    if (ConteoTErrores != string.Empty)
                        ConteoTErrores += ", " + row["EquivalenteTarjeta"].ToString();
                    else
                        ConteoTErrores += " " + row["EquivalenteTarjeta"].ToString();
                }


            }

            foreach (DataRow row1 in dtTarjetas.Rows)
            {

                string noTarjeta1 = row1["NumeroTC"].ToString();
                string noOperacion1 = row1["noOperacion"].ToString();

                //Consultar movimientos del día
                DataView wsDatos = new DataView(wsSaldoMora.MovimientosDelDia(noTarjeta1).Tables[0], "Tipo in ('Pago','Reverso')", "NumeroTarjeta", DataViewRowState.CurrentRows);// wsTC.MovimientosDelDia(noTarjeta).Tables[0].DefaultView;
                                                                                                                                                                           //wsDatos.RowFilter = "Tipo in ('Pago','Reverso')";             


                foreach (DataRow wsRow in wsDatos.ToTable().Rows)
                {
                    //Agregar fila a Tabla

                    string moneda = (wsRow["Moneda"].ToString() == "L") ? "LPS" : wsRow["Moneda"].ToString();

                    DataRow newRow1 = dtTarjetaCredito.NewRow();
                    newRow1["NumeroOperacion"] = noOperacion1;
                    newRow1["Moneda"] = moneda;
                    newRow1["CapitalMora"] = wsRow["Monto"];
                    newRow1["HoraTrx"] = wsRow["Hora"];

                    dtTarjetaCredito.Rows.Add(newRow1);
                }
            }

            //Si se obtuvo informacion del AS400 y TC actualizamos la información del cliente
            if (dtPTM.Rows.Count > 0 || dtTarjetaCredito.Rows.Count > 0)
            {
                List<SqlParameter> parametros = new List<SqlParameter>();

                SqlParameter param1 = new SqlParameter();
                param1.ParameterName = "@idCliente";
                param1.Direction = ParameterDirection.Input;
                param1.SqlDbType = SqlDbType.Int;
                param1.SqlValue = Session["idCliente"].ToString();

                SqlParameter param2 = new SqlParameter();
                param2.ParameterName = "@tblData";
                param2.Direction = ParameterDirection.Input;
                param2.SqlDbType = SqlDbType.Structured;
                param2.Value = dtPTM;

                SqlParameter param3 = new SqlParameter();
                param3.ParameterName = "@tblDataTC";
                param3.Direction = ParameterDirection.Input;
                param3.SqlDbType = SqlDbType.Structured;
                param3.Value = dtTarjetaCredito;

                parametros.Add(param1);
                parametros.Add(param2);
                parametros.Add(param3);

                query.SqlExecuteWithParameters("usp_getSaldosMora", parametros);
            }


            #region Rat.381167 Mantenimiento a integración entre Cobranzas BP y API Account Data Services
            if (ConteoTErrores != string.Empty)
            {
                ((ASPxLabel)NavBarCliente.Groups[3].FindControl("lblMensajePrisma")).Text = "No se obtuvo valor de prisma para las tarjetas: " + ConteoTErrores;
                ((ASPxLabel)NavBarCliente.Groups[3].FindControl("lblMensajePrisma")).Visible = true;
            }
            #endregion

            #endregion 
        }
        #endregion


