        {
            if (((HtmlTable)NavDetalleProd.Groups[0].FindControl("tblOpcionesPagos")) != null)
            {

                ((HtmlTable)NavDetalleProd.Groups[0].FindControl("tblOpcionesPagos")).Style.Add("Display", mostrar ? "normal" : "none");
            }
        }

