   public static void DesencriptarArchivo(string rutaEntrada, string rutaSalida, string keyBase64, string nonceBase64)
   {
       byte[] key = Convert.FromBase64String(keyBase64);
       byte[] nonce = Convert.FromBase64String(nonceBase64);

       if (nonce.Length != NonceSizeBytes)
           throw new ArgumentException($"El nonce debe tener {NonceSizeBytes} bytes.");

       byte[] contenido = File.ReadAllBytes(rutaEntrada);

       if (contenido.Length < TagSizeBytes)
           throw new InvalidDataException("El archivo encriptado está corrupto o incompleto.");

       byte[] tag = new byte[TagSizeBytes];
       byte[] ciphertext = new byte[contenido.Length - TagSizeBytes];

       Buffer.BlockCopy(contenido, 0, tag, 0, TagSizeBytes);
       Buffer.BlockCopy(contenido, TagSizeBytes, ciphertext, 0, ciphertext.Length);

       byte[] plaintext = new byte[ciphertext.Length];

       using (var aesGcm = new AesGcm(key, TagSizeBytes))
       {

           aesGcm.Decrypt(nonce, ciphertext, tag, plaintext);
       }

       File.WriteAllBytes(rutaSalida, plaintext);
   }










        public static (string keyBase64, string nonceBase64) LeerLlaveYNonce(string rutaTxt)
        {
            string? key = null;
            string? nonce = null;

            foreach (var linea in File.ReadAllLines(rutaTxt))
            {
                if (linea.StartsWith("Llave=", StringComparison.OrdinalIgnoreCase))
                    key = linea.Substring("Llave=".Length).Trim();
                else if (linea.StartsWith("Nonce=", StringComparison.OrdinalIgnoreCase))
                    nonce = linea.Substring("Nonce=".Length).Trim();
            }

            if (string.IsNullOrEmpty(key) || string.IsNullOrEmpty(nonce))
                throw new FormatException("No se encontraron las líneas 'Llave=' y 'Nonce=' en el archivo.");

            return (key, nonce);
        }








