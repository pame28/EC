        public PaymentPlanService(GeneralResponseFn generalResponseFn, IApiService apiService, ICardsRepository cardsRepository,
            ILogger<PaymentPlanService> logger, IConfiguration configuration)
        {
            _generalResponseFn = generalResponseFn;
            _apiService = apiService;
            _cardsRepository = cardsRepository;
            _logger = logger;
            _guardarPlanPagos = Convert.ToBoolean(configuration["Service:GuardarPlanPagos"]);
