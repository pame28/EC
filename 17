        public Payments Posicion_Declarac(string EquivalenciaTarjeta, string Bearer, string url_Posicion_Declaraciones, string ContentTypeAPI, string BodyRequestJsonAPI, string Proxy)
        {
            //Intanciamos la clase SQL para el log de errores
            //SQLSrv ErroresQuery = new SQLSrv(_ConnectionString, "usp_logApiPrismaAccountDataServices");

            //Generamos las variables de objetos que utilizaremos
            this._Mensaje = string.Empty;
            this._Success = true;
            Payments Result = new Payments();
      
            try
            {
                //Contruimos el request para traer el Token Bearer OAUTH que se necesita para consumir el API AccountDataServices
                // Seteamos los parametros
                var client = new RestSharp.RestClient(url_Posicion_Declaraciones);
                client.Timeout = -1;
                if (!Ambiente)
                {
                    client.Proxy = new System.Net.WebProxy(Proxy);
                }
                var requestApi = new RestRequest(Method.POST);
                requestApi.AddHeader("Authorization", "Bearer " + Bearer);
                requestApi.AddHeader("Content-Type", ContentTypeAPI);
                requestApi.AddParameter(ContentTypeAPI, BodyRequestJsonAPI, ParameterType.RequestBody);

                //Ejecutamos el REQUEST
                var response = client.Execute(requestApi);
                var content = response.Content; // Obtemos la info de respuesta del JSON 

                if (response.StatusCode != HttpStatusCode.OK)
                {
                    this._Mensaje = content + " response.ErrorMessage:" + response.ErrorMessage;
                    this._Success = false;
                    log.Debug("Error en public statements_Position Posicion_Declaraciones al consultar API: " + this._Mensaje);
                }

                JObject jsonObj = JObject.Parse(response.Content);
                //string valor = jsonObj.GetValue("current_minimum_payment").ToString();
                double CampoLempiras = 0;
                double CampoDolares = 0;
                foreach (JObject item in jsonObj["cards"])
                {
                    foreach (Newtonsoft.Json.Linq.JProperty item2 in item["payments"])
                    {
                        //string prueba = item2.Value["current_minimum_payment"].ToString();
                        if (item2.Name == "current_minimum_payment") 
                        {
                            CampoLempiras = Convert.ToDouble(item2.Value.ToString());
                        }
                        if (item2.Name == "dollar_current_minimum_payment")
                        {
                            CampoDolares = Convert.ToDouble(item2.Value.ToString());
                        }
                    }

                }
                Result.current_minimum_payment = CampoLempiras;
                Result.dollar_current_minimum_payment = CampoDolares;
                //Result = JsonConvert.DeserializeObject<Card>(content);
            }
            catch (Exception ex)
            {

                this._Mensaje = ex.Message;
                this._Success = false;
                log.Debug("Error en try public statements_Position Posicion_Declaraciones: " + this._Mensaje);
            }
            

            return Result;
        }


        private void apiPrismaMemoryCacheOAUTH()
        {
            //Restamos 120 segundos, solo por contingencia, para evitar errores de expiración precoz de lado del servidor de Prisma, así ir a traer 120 segundos antes el BearerOAUTH
            int OAUTHExpira = Convert.ToInt16(this._BearerOAUTHExpira) - 120;
            //Genera el nuevo item en cache que vamos agregar del BearerOAUTH            
            cache.Add("BearerCache", BearerOAUTH, DateTimeOffset.Now.AddSeconds(OAUTHExpira));
        }

