using ApiPaymentPlan.Service.Interface;
using ApiPaymentPlan.Models.AccessToken;

namespace ApiPaymentPlan.Service
{
    public class TokenProvider : ITokenProvider
    {
        private readonly HttpClient _httpClient;
        private AccessTokenResponse? _cachedToken;
        private DateTime _expiresAt;
        private readonly SemaphoreSlim _lock = new(1, 1);
        private readonly ILogger<TokenProvider> _logger;


        //Para auth
        private readonly string endpoint;

        public TokenProvider(HttpClient httpClient, IConfiguration configuration, ILogger<TokenProvider> logger)
        {
            _httpClient = httpClient;
            endpoint = configuration["ApiSettings:EndpointAccessToken"]
                ?? throw new ArgumentNullException(nameof(configuration), "EndpointAccessToken no puede ser nulo");
            _logger = logger;
        }

        public async Task<string> GetTokenAsync()
        {
            try
            {

                var response = await _httpClient.GetAsync(endpoint);

                if (!response.IsSuccessStatusCode)
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    _logger.LogError("Error en llamada a {Endpoint}. StatusCode: {StatusCode}, Body: {Body}", endpoint, response.StatusCode, errorContent);
                    throw new HttpRequestException($"Error en llamada a {endpoint}. StatusCode: {response.StatusCode}");
                }

                _cachedToken = await response.Content.ReadFromJsonAsync<AccessTokenResponse>();

                return _cachedToken.accessToken;
            }
            catch (Exception ex)
            {
                _logger.LogError("Error en llamada a {Endpoint} con {Error}.", endpoint, ex.Message.ToString());
                throw new HttpRequestException($"Error en llamada a {endpoint}.");
            }
        }
    }
}







using plantilla_microservicios_repository.DTOs.Response;
using plantilla_microservicios_repository.Service.Interface;

namespace plantilla_microservicios_repository.Utils
{
    public class GeneralResponseFn
    {
        private readonly IValidationService _validationService;

        public GeneralResponseFn(IValidationService validationService)
        {
            _validationService = validationService;
        }

        public async Task<GeneralResponse> Response(int status, string code, object? data = null)
        {
            return new GeneralResponse
            {
                Status = status,
                HasError = false,
                PaymentPlan = data,
                Messages = new List<Messages>
                {
                    new Messages
                    {
                        Code = code,
                        Description = await _validationService.getMensajeValidacion(code)
                    }
                }
            };
        }

        public GeneralResponse ResponseError(int status, string description)
        {
            return new GeneralResponse
            {
                Status = status,
                HasError = true,
                PaymentPlan = null,
                Messages = new List<Messages>
                {
                    new Messages
                    {
                        Code = Constantes.CODE_SYSTEM_ERROR,
                        Description = description
                    }
                }
            };
        }

        public GeneralResponse ResponseErrorDesembolso(int status, int code, string description, string message)
        {
            return new GeneralResponse
            {
                Status = status,
                HasError = true,
                PaymentPlan = null,
                Messages = new List<Messages>
                {
                    new Messages
                    {
                        Code = code.ToString(),
                        Description = description,
                        Message = message
                    }
                }
            };
        }

        public async Task<GeneralResponse> ResponseError(int status, string codeError, string description)
        {
            var codigosEstandar = new HashSet<string> { "00", "99" };
            string finalDescription;

            if (codigosEstandar.Contains(codeError))
            {
                var error = await _validationService.getMensajeValidacion(codeError);
                finalDescription = error.Replace("{descripcion}", description);
            }

            else
            {
                finalDescription = description;
            }
            return new GeneralResponse
            {
                Status = status,
                HasError = true,
                PaymentPlan = null,
                Messages = new List<Messages>
                {
                    new Messages
                    {
                        Code = codeError,
                        Description = finalDescription
                    }
                }
            };
        }
    }
}





