        #region Ejecución del a las vistas de la API de Prisma
        public DataTable getApiOAUTH()
        {
            //Intanciamos la clase SQL para el log de errores
            //SQLSrv ErroresQuery = new SQLSrv(_ConnectionString, "usp_logApiPrismaAccountDataServices");

            //Generamos las variables de objetos que utilizaremos
            this._Mensaje = string.Empty;
            this._Success = true;
            DataTable dtResult = new DataTable();
            DataTable dtquery = new DataTable();


            //Instanciamos la clase de SQL para realizar la consulta de obtener los parametros para el request de obtner el OAUTH
            SQLSrv query = new SQLSrv(_ConnectionString, "usp_apiRequestAccountDataServicesOAUTH");
            dtquery = query.getDataTable();


            //Validamos si la consulta SQL no genero ningun tipo de error
            if (!query.Success)
            {
                log.Debug("Error ejecutando usp_apiRequestAccountDataServicesOAUTH: " + query.Mensaje);
            }
            else
            {

                //Validamos que el dtquery no venga NULL
                if (dtquery != null)
                {
                    //Validamos que el dtquery viene con información
                    if (dtquery.Rows.Count > 0)
                    {
                        try
                        {
                            //Contruimos el request para traer el Token Bearer OAUTH que se necesita para consumir el API AccountDataServices
                            // Seteamos los parametros
                            var client = new RestSharp.RestClient(dtquery.Rows[0]["EndpointOAUTH"].ToString());
                            client.Timeout = -1;
                            if (!Ambiente)
                            {
                                client.Proxy = new System.Net.WebProxy(dtquery.Rows[0]["Proxy"].ToString());
                            }
                            var requestApi = new RestRequest(Method.POST);
                            requestApi.AddHeader("Authorization", dtquery.Rows[0]["APIKeyEncode64"].ToString());
                            requestApi.AddHeader("Content-Type", dtquery.Rows[0]["ContentTypeAPI"].ToString());

                            //Ejecutamos el REQUEST
                            var response = client.Execute(requestApi);
                            var content = response.Content;

                            if (response.StatusCode == HttpStatusCode.OK)
                            {
                                content = "[" + response.Content + "]"; // Obtemos la info de respuesta del JSON
                            }
                            else
                            {
                                this._Mensaje = content + " response.ErrorMessage:" + response.ErrorMessage;
                                this._Success = false;
                                log.Debug("Error en ApiOAUTH: " + this._Mensaje + ", " + response.ErrorMessage);
                            }


                            //Devolvemos el resultado en un DataTable
                            dtResult = JsonConvert.DeserializeObject<DataTable>(content);
                        }
                        catch (Exception ex)
                        {

                            this._Mensaje = ex.Message;
                            this._Success = false;
                            log.Debug("Error en try public DataTable getApiOAUTH AccountDataService: " + this._Mensaje);
                        }
                    }

                }

            }

            return dtResult;
        }
