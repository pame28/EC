-- ==========================================================
-- Author:		<Elkin Amador Garcia>
-- Create date: <29-04-2016>
-- Description:	<Clientes PTM Y TC consolidados con estructura de la tabla Clientes>
-- ==========================================================

CREATE VIEW [dbo].[uvw_Clientes]
AS
	SELECT		
		   CLIE_CIF							  cliCif,
		   CLIE_IDEN                          cliIdentidad,
		   CLIE_TIPD                          cliTipoDocumento,
		   CLIE_TIPP                          cliTipoPersona,		   
		   CAST(CLIE_NAME AS VARCHAR(50))     cliNombre,
		   CLIE_NACI                          cliNacionalidad,
		   ''								  cliTipoCliente,
		   CAST(0 AS SMALLINT)                cliZona,
		   CLIE_TEL1                          cliTelefono1,
		   CLIE_TEL2                          cliTelefono2,
		   ''								  cliTelefono3,
		   CAST(CLIE_FAX AS VARCHAR(20))      CliFax,
		   CLIE_MAIL                          cliCorreo,
		   CLIE_DIR1                          cliDireccion1,
		   CLIE_DIR2                          cliDireccion2,		   		   
		   CLIE_FECA                          cliFechaUltimaActualizacion,
		   CLIE_OFIC                          cliOficialNegocios,
		   '0'								  cliOficialAsignado,
		   CLIE_OFIC                          cliOficialAsignadoICBS,
		   NULL								  cliFlujoCobranza,
		   NULL								  cliEtapaCobranza,
		   NULL								  cliColaCobranza,
		   NULL								  cliDiaMora,
		   NULL								  cliPromesaIncumplida,
		   GETDATE()                          cliFechaUltimaGestion,
		   --CAST(0 AS SMALLINT)                cliAgotado,		   
		   NULL								  cliCobradorAsi,
		   CAST(1 AS SMALLINT)                cliTipoAsignacionEtapa,
		   Origen
FROM   uvw_BandejaDeClientes with(nolock)






