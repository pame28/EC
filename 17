        private string Encrypt(string parametro)
        {
            string publickey = "", secretkey = "";
            try
            {
                DataTable dt = new DataTable();
                SQLSrv query = new SQLSrv(Properties.Settings.Default.DBGestorBP, "usp_ObtenerEncriptado");

                dt = query.getDataTable();

                if (query.Success)
                {
                    if (dt.Rows.Count > 0)
                    {
                        publickey = dt.Rows[0]["LlavePublica"].ToString();
                        secretkey = dt.Rows[0]["LlaveSecreta"].ToString();

                    }
                }

                string ToReturn = "";
                byte[] secretkeyByte = { };
                secretkeyByte = System.Text.Encoding.UTF8.GetBytes(secretkey);
                byte[] publickeybyte = { };
                publickeybyte = System.Text.Encoding.UTF8.GetBytes(publickey);
                MemoryStream ms = null;
                CryptoStream cs = null;
                byte[] inputbyteArray = System.Text.Encoding.UTF8.GetBytes(parametro);
                using (DESCryptoServiceProvider des = new DESCryptoServiceProvider())
                {
                    ms = new MemoryStream();
                    cs = new CryptoStream(ms, des.CreateEncryptor(publickeybyte, secretkeyByte),
                                          CryptoStreamMode.Write);
                    cs.Write(inputbyteArray, 0, inputbyteArray.Length);
                    cs.FlushFinalBlock();
                    ToReturn = Convert.ToBase64String(ms.ToArray());
                }
                return ToReturn;
            }
            catch (Exception ex)
            {
                throw new Exception(ex.Message, ex.InnerException);
            }
        }

