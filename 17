using EstadosCuentaTC.Data;
using EstadosCuentaTC.Logging;
using EstadosCuentaTC.Repositories;
using EstadosCuentaTC.Services;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;

// Host.CreateApplicationBuilder ya carga appsettings.json (opcional) y agrega
// Console como proveedor de logging por defecto, leyendo niveles desde la
// sección "Logging" del appsettings. No llamamos a AddConsole()/SetMinimumLevel()
// a mano, que es lo que dispara S4792 en el análisis de Sonar.
var hostBuilder = Host.CreateApplicationBuilder(args);

// Forzamos que sea obligatorio (por defecto el Host lo carga como opcional).
hostBuilder.Configuration.AddJsonFile("appsettings.json", optional: false);

_ = hostBuilder.Configuration.GetConnectionString("DefaultConnection")
    ?? throw new InvalidOperationException("ConnectionString no configurado");

var logsDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Logs");
Directory.CreateDirectory(logsDir); // la crea si no existe

var logPath = Path.Combine(logsDir, $"log_{DateTime.Now:yyyyMMdd_HHmmss}.txt");
Console.WriteLine($"Log guardándose en: {logPath}");

// Único agregado explícito de logging: nuestro proveedor propio de archivo.
hostBuilder.Logging.AddProvider(new FileLoggerProvider(logPath));

// ── Registro de servicios en el contenedor de DI ────────────────────────
hostBuilder.Services.AddSingleton<SqlExecutor>();
hostBuilder.Services.AddSingleton<ParametrosGeneracionECRepository>();
hostBuilder.Services.AddSingleton<EstadoCuentaRepository>();
hostBuilder.Services.AddSingleton<EncriptacionService>();
hostBuilder.Services.AddSingleton<ParametrosGeneracionECService>();
hostBuilder.Services.AddSingleton<GeneracionIndividualService>();
hostBuilder.Services.AddSingleton<GeneracionEstadoCuentaService>();

using var host = hostBuilder.Build();

var logger = host.Services.GetRequiredService<ILogger<Program>>();
var parametrosECService = host.Services.GetRequiredService<ParametrosGeneracionECService>();
var generacionService = host.Services.GetRequiredService<GeneracionEstadoCuentaService>();

try
{
    var parametros = parametrosECService.ObtenerParametros();
    Console.WriteLine("\nGENERACIÓN ESTADOS DE CUENTA JSON");
    generacionService.Ejecutar(parametros);
    Console.WriteLine("\n========== FIN PROCESO ==========");
}
catch (Exception ex)
{
    Console.WriteLine("\nERROR GENERAL: Se produjo un error durante la ejecución del proceso.");
    logger.LogError(ex, "Error general durante la ejecución del proceso");
}

