CREATE VIEW [dbo].[uvw_CobranzaProductosTC]
As
	WITH Saldos
AS
(
	SELECT *
	FROM uvw_SaldosVasa WITH(NOLOCK)
)
,
SaldosIntras
AS
(	
	SELECT cp.NoCuentaClaro      
      --cp.GrupoMovimientos
         ,(
			   CASE 
					WHEN cp.MonedaLiquidar = '840' THEN 'USD'
					WHEN cp.MonedaLiquidar = '340' THEN 'LPS'
			   END
		   ) AS Moneda      
      ,SUM(CASE WHEN cp.GrupoMovimientos LIKE 'R%' THEN  cp.PlanCuotaCapitalPend * -1 ELSE cp.PlanCuotaCapitalPend END) CapitalPendienteInt      
	FROM   CuotasPendientes cp WITH(NOLOCK)
	INNER JOIN EUsuarios e WITH(NOLOCK)--Modificado por ruben milla para excluir tarjetas castigadas.
	ON e.NoUsuario = cp.NumeroCuenta
	--No se debe excluir por que al capturador si se reporta.
	WHERE cp.GrupoMovimientos NOT IN ('CGO','RGO','EXF','REX') --AND cp.NoCuentaClaro='0032378498'	
	GROUP BY
		  cp.NoCuentaClaro,
		   --cp.GrupoMovimientos,
		   cp.MonedaLiquidar
	HAVING SUM(CASE WHEN cp.GrupoMovimientos LIKE 'R%' THEN  cp.PlanCuotaCapitalPend * -1 ELSE cp.PlanCuotaCapitalPend END) > 0
)
,
SaldosExtras
AS
(	
	
	
	SELECT cp.NoCuentaClaro,
		   cp.GrupoMovimientos,
		   (
			   CASE 
					WHEN cp.MonedaLiquidar = '840' THEN 'USD'
					WHEN cp.MonedaLiquidar = '340' THEN 'LPS'
			   END
		   )                                Moneda,
		   SUM(cp.PlanCuotaCapitalPend)     CapitalPendienteEx
	FROM   CuotasPendientes                cp WITH(NOLOCK) 
	WHERE  cp.GrupoMovimientos = 'EXF'
		   AND NOT EXISTS(
				   SELECT 1
				   FROM   (
							  SELECT cp.NoCuentaClaro,                                 
									 cp.CodigoTransaccion,
									 cp.CodigoTransaccionRelacion                                 
							  FROM   CuotasPendientes cp WITH(NOLOCK) 
							  WHERE  (
										 EXISTS(
											 SELECT 1
											 FROM   CuotasPendientes cp2 WITH(NOLOCK) 
											 WHERE  cp2.CodigoTransaccion = cp.CodigoTransaccionRelacion
										 ) --Excluye los RIN y REX
										 OR EXISTS (
												SELECT 1
												FROM   CuotasPendientes cp2 WITH(NOLOCK) 
												WHERE  cp2.CodigoTransaccionRelacion = 
													   cp.CodigoTransaccion
											)
									 ) --Excluye los extras reversado
									 AND cp.GrupoMovimientos IN ('EXF', 'REX')
						  ) AS X
				   WHERE  x.NoCuentaClaro = cp.NoCuentaClaro
		   ) --AND cp.NoCuentaClaro='0028293840'

	GROUP BY
		   cp.NoCuentaClaro,
		   cp.GrupoMovimientos,
		   cp.MonedaLiquidar	
)
,

