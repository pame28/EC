				--Inicio Ajuste Requerimiento 63-2018----------------------------																									
				,sp.salEmpresaId
				--Fin Ajuste Requerimiento 63-2018----------------------------	
				--------REQ.BH-5221 Carga de campos reserva y categoría de riesgos a Cobranzas BP----------------
				,ISNULL(br.Reserva,0)				    AS reserva
				,ISNULL(br.Categoria,'')				AS categoriaRiesgo
				, sp.salDiasMora            AS DiasMora
		FROM Clientes c with (nolock) 
		INNER JOIN RelacionesDeProductos rp with (nolock)
		on c.idCliente=rp.idCliente AND rp.relTipoRelacion in ('SOW','JAF')
		INNER JOIN SaldosDeProductos	sp	with (nolock) 
		on rp.relNumeroOperacion=sp.salNumeroOperacion AND rp.relMoneda=sp.salMoneda
		LEFT JOIN BandejaCamposReserva br with (nolock)
		ON br.idcliente=c.idCliente AND (br.operacion=sp.salNumeroOperacion OR br.operacion=sp.salNumeroOperacionTC )
						--INNER JOIN EstadosOperaciones	e	on e.EstadoOperacion=sp.salEstadoOperacion
		WHERE c.idCliente=@idCliente
		ORDER BY (sp.salInteresNoContabilizado + sp.salCapitalMora + sp.salInteresMora + sp.salSeguroMora + sp.salInteresMoratorio) DESC
		--------------------------------------------------------------------------------------------------------------------------------------------------
	END

