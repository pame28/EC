using EstadosCuentaTC.Repositories;
using Microsoft.Extensions.Logging;
using System;
using System.IO;
using System.Text;

namespace EstadosCuentaTC.Services
{
    public class GeneracionIndividualService
    {
        private readonly EstadoCuentaRepository _repo;
        private readonly ILogger<GeneracionIndividualService> _logger;

        public GeneracionIndividualService(
            EstadoCuentaRepository repo,
            ILogger<GeneracionIndividualService> logger)
        {
            _repo = repo;
            _logger = logger;
        }

        public int Ejecutar(string rutaBase, string nombreArchivoBase, DateTime fechaCorte)
        {
            try
            {
                _logger.LogInformation("---------- INICIO GENERACIÓN INDIVIDUAL ----------");

                var ruta = Path.Combine(rutaBase, fechaCorte.ToString("yyyy-MM-dd"));
                Directory.CreateDirectory(ruta);
                _logger.LogInformation("Carpeta de salida: {Ruta}", ruta);

                var archivoJson = Path.Combine(ruta, $"{nombreArchivoBase}{fechaCorte:yyyyMMdd}.json");
                _logger.LogInformation("Archivo JSON de salida: {Archivo}", archivoJson);

                int contador = 0;

                using (var writer = new StreamWriter(archivoJson, false, Encoding.UTF8, bufferSize: 65536))
                {
                    writer.Write("{");

                    while (true)
                    {
                        var resultado = _repo.ProcesarSiguiente();

                        if (resultado == null)
                        {
                            _logger.LogInformation("No hay más registros por procesar.");
                            break;
                        }

                        var (tarjeta, json) = resultado.Value;

                        if (string.IsNullOrWhiteSpace(json))
                        {
                            _logger.LogWarning("Tarjeta {Tarjeta} no tiene JSON, se escribe vacío.", tarjeta);
                            json = "{}";
                        }

                        if (contador > 0)
                            writer.Write(",");

                        writer.Write($"\"{tarjeta}\":{json}");
                        contador++;

                        if (contador % 100 == 0)
                            _logger.LogInformation("Procesados hasta ahora: {Contador}", contador);
                    }

                    writer.Write("}");
                }

                _logger.LogInformation("---------- FIN GENERACIÓN INDIVIDUAL ----------");
                _logger.LogInformation("Total procesados: {Contador}", contador);
                _logger.LogInformation("Archivo generado en: {Archivo}", archivoJson);

                return contador;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en Generación Individual");
                throw;
            }
        }
    }
}









