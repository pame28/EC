using System.Net.Http.Headers;
using transacciones_flotantes.Service.Interface;

namespace transacciones_flotantes.Service
{
    public class AuthHandler : DelegatingHandler
    {
        private readonly IProveedorTokenService _tokenProvider;
        private readonly ILogger<AuthHandler> _logger;

        public AuthHandler(IProveedorTokenService tokenProvider, ILogger<AuthHandler> logger)
        {
            _tokenProvider = tokenProvider;
            _logger = logger;
        }

        protected override async Task<HttpResponseMessage> SendAsync(
            HttpRequestMessage request, CancellationToken cancellationToken)
        {
            _logger.LogInformation("***** Petición recibida AuthHandler.SendAsync() *****");

            try
            {
                var token = await _tokenProvider.ObtenerAccessTokenAsync();
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

                _logger.LogInformation("Token enviado en Authorization Header : {Token}", token);

                var response = await base.SendAsync(request, cancellationToken);

                if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    _logger.LogWarning("Token rechazado con 401. Invalidando y reintentando...");

                    _tokenProvider.InvalidarToken();

                    var nuevoToken = await _tokenProvider.ObtenerAccessTokenAsync();

                    var retryRequest = await CloneRequestAsync(request, nuevoToken);

                    _logger.LogInformation("Reintento con nuevo token: {Token}", nuevoToken);

                    response = await base.SendAsync(retryRequest, cancellationToken);
                }

                _logger.LogInformation("***** Llamado completado con AuthHandler.SendAsync() *****");

                return response;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex,
                    "Error en AuthHandler.SendAsync(). Descripcion: {Message}", ex.Message);

                return new HttpResponseMessage(System.Net.HttpStatusCode.InternalServerError)
                {
                    Content = new StringContent($"Error en AuthHandler: {ex.Message}")
                };
            }
        }

        private static async Task<HttpRequestMessage> CloneRequestAsync(
            HttpRequestMessage original, string nuevoToken)
        {
            var clone = new HttpRequestMessage(original.Method, original.RequestUri);

            foreach (var header in original.Headers)
            {
                if (header.Key.Equals("Authorization", StringComparison.OrdinalIgnoreCase))
                    continue;

                var sanitizedValues = SanitizeHeaderValues(header.Value);
                if (sanitizedValues.Any())
                {
                    try
                    {
                        clone.Headers.Add(header.Key, sanitizedValues);
                    }
                    catch (FormatException)
                    {
                        // Header con formato inválido: se omite intencionalmente
                    }
                }
            }

            clone.Headers.Authorization = new AuthenticationHeaderValue("Bearer", nuevoToken);

            if (original.Content != null)
            {
                var bodyBytes = await original.Content.ReadAsByteArrayAsync();
                clone.Content = new ByteArrayContent(bodyBytes);

                foreach (var header in original.Content.Headers)
                {
                    var sanitizedValues = SanitizeHeaderValues(header.Value);
                    if (sanitizedValues.Any())
                    {
                        try
                        {
                            clone.Content.Headers.Add(header.Key, sanitizedValues);
                        }
                        catch (FormatException)
                        {
                            // Header con formato inválido: se omite intencionalmente
                        }
                    }
                }
            }

            return clone;
        }

        /// <summary>
        /// Elimina caracteres CRLF de los valores de headers para prevenir HTTP Header Injection.
        /// </summary>
        private static IEnumerable<string> SanitizeHeaderValues(IEnumerable<string> values)
        {
            return values
                .Select(v => v.Replace("\r", string.Empty).Replace("\n", string.Empty).Trim())
                .Where(v => !string.IsNullOrWhiteSpace(v));
        }
    }
}