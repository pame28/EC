USE [BandejaVASA_PRD]
GO
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO

ALTER PROCEDURE [dbo].[usp_vistaClientesImpresionContratosNP] 
	@nombreArchivo varchar(50) 
AS
BEGIN
	SET NOCOUNT ON;
	SET ANSI_WARNINGS OFF;

	SELECT  CAST([Origen] AS VARCHAR(4))                    AS Origen
	      , CAST([NumeroCuenta] AS VARCHAR(13))              AS NumeroCuenta
	      , CAST([NumeroTarjeta] AS VARCHAR(16))              AS NumeroTarjeta
	      , CAST([Bin] AS VARCHAR(10))                        AS Bin
	      , CAST([CodigoProducto] AS VARCHAR(6))               AS CodigoProducto
	      , CAST([DescEmisor] AS VARCHAR(30))                  AS DescEmisor
	      , CAST([NombreCliente] AS VARCHAR(20))               AS NombreCliente
	      , CAST([SegundoNombre] AS VARCHAR(23))               AS SegundoNombre
	      , CAST([Apellido1] AS VARCHAR(15))                   AS Apellido1
	      , CAST([Apellido2] AS VARCHAR(15))                   AS Apellido2
	      , CAST([NombreEmbozado] AS VARCHAR(30))              AS NombreEmbozado
	      , CAST([Identidad] AS VARCHAR(19))                   AS Identidad
	      , CAST([TipoTarjeta] AS VARCHAR(1))                  AS TipoTarjeta
	      , CAST([NombreEmpresa] AS VARCHAR(40))               AS NombreEmpresa
	      , CAST([CedulaJuridica] AS VARCHAR(19))              AS CedulaJuridica
	      , CAST([DireccionEstadoCuenta1] AS VARCHAR(40))      AS DireccionEstadoCuenta1
	      , CAST([DireccionEstadoCuenta2] AS VARCHAR(40))      AS DireccionEstadoCuenta2
	      , CAST([DireccionEstadoCuenta3] AS VARCHAR(40))      AS DireccionEstadoCuenta3
	      , CAST([Ciudad] AS VARCHAR(15))                      AS Ciudad
	      , CAST([ApartadoPostal] AS VARCHAR(33))              AS ApartadoPostal
	      , CAST([LocalidadRetiro] AS VARCHAR(2))               AS LocalidadRetiro
	      , CAST([Telefono1] AS VARCHAR(30))                   AS Telefono1
	      , CAST([Telefono2] AS VARCHAR(30))                   AS Telefono2
	      , CAST([Telefono3] AS VARCHAR(30))                   AS Telefono3
	      , CAST([CicloCorte] AS VARCHAR(2))                   AS CicloCorte
	      , [LimiteCreditoML]
	      , [LimiteCreditoME]
	      , [PlazoFinanciamiento]
	      , [TasaCambio]
	      , CAST([NombreFiador1] AS VARCHAR(40))               AS NombreFiador1
	      , CAST([Apellido1Fiador1] AS VARCHAR(15))            AS Apellido1Fiador1
	      , CAST([Apellido2Fiador1] AS VARCHAR(15))            AS Apellido2Fiador1
	      , CAST([NumCedulaFiador1] AS VARCHAR(19))            AS NumCedulaFiador1
	      , CAST([DireccionFiador1] AS VARCHAR(80))            AS DireccionFiador1
	      , CAST([NombreFiador2] AS VARCHAR(40))               AS NombreFiador2
	      , CAST([Apellido1Fiador2] AS VARCHAR(15))            AS Apellido1Fiador2
	      , CAST([Apellido2Fiador2] AS VARCHAR(15))            AS Apellido2Fiador2
	      , CAST([NumCedulaFiador2] AS VARCHAR(15))            AS NumCedulaFiador2
	      , CAST([DireccionFiador2] AS VARCHAR(80))            AS DireccionFiador2
	      , CAST([NombreFiador3] AS VARCHAR(40))               AS NombreFiador3
	      , CAST([Apellido1Fiador3] AS VARCHAR(15))            AS Apellido1Fiador3
	      , CAST([Apellido2Fiador3] AS VARCHAR(15))            AS Apellido2Fiador3
	      , CAST([NumCedulaFiador3] AS VARCHAR(15))            AS NumCedulaFiador3
	      , CAST([DireccionFiador3] AS VARCHAR(80))            AS DireccionFiador3
	      , CAST([DescripcionSeguro1] AS VARCHAR(40))          AS DescripcionSeguro1
	      , [MontoSeguro1]
	      , CAST([DescripcionSeguro2] AS VARCHAR(40))          AS DescripcionSeguro2
	      , [MontoSeguro2]
	      , [ImprimirContrato]
	      , [ImprimirSobre]
	      , CAST([OrigenEmbozado] AS VARCHAR(10))              AS OrigenEmbozado
	      , CAST([TipoPersoneria] AS VARCHAR(10))              AS TipoPersoneria
	      , CAST([TipoCliente] AS VARCHAR(10))                 AS TipoCliente
	      , CAST([S2GNIT] AS VARCHAR(25))                      AS S2GNIT
	      , CAST([TarjetaImprimir] AS VARCHAR(4))              AS TarjetaImprimir
	      , CAST([TarjetaTruncada] AS VARCHAR(19))             AS TarjetaTruncada
	      , CAST([Correo] AS VARCHAR(80))                      AS Correo
	      , [FechaFinVigencia]
	      , CAST([CodigoDistribucion] AS VARCHAR(10))          AS CodigoDistribucion
	      , CAST([NombreArchivoCompleto] AS VARCHAR(50))       AS NombreArchivoCompleto
	      , [NumeroTarjetaCore]
	FROM (
		SELECT  *
		FROM uvw_ClientesImpresionContratosNP
		WHERE NombreArchivo = @nombreArchivo
	) x

END