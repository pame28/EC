)
, Productos
AS(		
		SELECT 
				--[NoOperacion]						AS	PROD_NCTA
				 ROW_NUMBER() OVER(PARTITION BY NoCuentaClaro,Moneda ORDER BY NoCuentaClaro DESC) AS "NoRow" 
				,CAST([NoCuentaClaro] AS VARCHAR(10))					AS	PROD_NCTA	--NoEquivalente
				,CAST([CIF] AS VARCHAR(15))								AS	PROD_CIF	--NoEquivalente
				,CAST([NumeroTarjeta] AS VARCHAR(16))					AS	PROD_NTC	--NoEquivalente
				,CAST([Moneda] AS VARCHAR(3))							AS	PROD_MONE
				,CAST([DíasMora] AS INT)								AS	PROD_DIAM
				,CAST([EstadoCuenta] AS VARCHAR(3))						AS	PROD_STAT	
				,CAST([EstadoTarjeta] AS VARCHAR(2))					AS	PROD_STATT	--NoEquivalente
				,CAST([SaldoVencido] AS DECIMAL(18,2))					AS	PROD_SALM	--NoEquivalente
				,CAST([CapitalVencido] AS DECIMAL(16,2))				AS	PROD_CAPM	
				,CAST([InteresVencido] AS DECIMAL(16,2))				AS	PROD_INTM
				,CAST([CargoVencido] AS DECIMAL(16,2))					AS	PROD_CARV	--NoEquivalente
				,CAST([InteresAcumulado] AS DECIMAL(10,2))				AS	PROD_IMOR
				,CAST([PagoMinimoPeriodoActual] AS DECIMAL(16,2))		AS	PROD_PAGM
				,CAST([LiquidacionAnterior] AS DECIMAL(16,2))			AS	PROD_SAUE
				,CAST([FechaOtorgado] AS DATE)							AS  PROD_FECO
				,CAST([FechaUltimoPago] AS DATE)						AS	PROD_FULP
				,CAST([FechaProximoPago] AS DATE)						AS	PROD_FPPA	--NoEquivalente
				,CAST([VencimientoPlastico] AS DATE)					AS	PROD_FECV
				,CAST([SaldoContadoPeriodoActual] AS DECIMAL(16,2))		AS	PROD_MCAN
				,CAST([Producto] AS VARCHAR(37))						AS	PROD_TIPO
				,CAST([FechaVencimiento] AS DATE)						AS	PROD_FVEN	--NoEquivalente				
				,CAST([Cartera] AS INT)									AS	PROD_DIAC
				,CAST([DeptoParticular] AS VARCHAR(3))					AS	PROD_DTOP	--NoEquivalente
				,CAST([Clasificacion] AS VARCHAR(1))					AS	PROD_CLAS	--NoEquivalente
				,CAST([Tasa] AS DECIMAL(7,4))							AS	PROD_TASA
				,CAST([GrupoAfinidad] AS INT)							AS	PROD_GRAF	--NoEquivalente
				,CAST([ModeloLiquidacion] AS INT)						AS	PROD_MODL	--NoEquivalente
				,CAST([CreditoDisponible] AS DECIMAL(16,2))				AS	PROD_CRED	--NoEquivalente
				,CAST([MontoUltimoPago] AS DECIMAL(18,2))				AS	PROD_MOUP
				,CAST([LimiteCredito] AS DECIMAL(16,2))					AS	PROD_MNTO
				,CAST([CiclosVencidos] AS INT)							AS	PROD_CVEN	--NoEquivalente
				--cambio para priorización de colas
				,CAST([SaldoConsumido] AS DECIMAL(18,2))				AS	PROD_SCON
				,CAST([SaldoIntra] AS DECIMAL(18,2))					AS	PROD_SINT
				,CAST([SaldoExtra] AS DECIMAL(18,2))					AS	PROD_SEXF
				,CAST([InteresAcumuladoPeriodo] AS DECIMAL(18,2))		AS	PROD_IACP	
				,CAST([NumTarjetaTruncada] AS VARCHAR(20))		        AS	PROD_NUMTC	--NoTarjetaTruncada
		FROM	CobranzaProductosTC  WITH(NOLOCK) ) 

		SELECT [PROD_NCTA]
			,[PROD_CIF]
			,[PROD_NTC]
			,[PROD_MONE]
			,[PROD_DIAM]
			,[PROD_STAT]
			,[PROD_STATT]
			,[PROD_SALM]
			,[PROD_CAPM]
			,[PROD_INTM]
			,[PROD_CARV]
			,[PROD_IMOR]
			,[PROD_PAGM]
			,[PROD_SAUE]
			,[PROD_FECO]
			,[PROD_FPPA]
			,[PROD_FULP]
			,[PROD_FECV]
			,[PROD_MCAN]
			,[PROD_TIPO]
			,[PROD_FVEN]
			,[PROD_DIAC]
			,[PROD_DTOP]
			,[PROD_CLAS]
			,[PROD_TASA]
			,[PROD_GRAF]
			,[PROD_MODL]
			,[PROD_CRED]
			,[PROD_MOUP]
			,[PROD_MNTO]
			,[PROD_CVEN]
			--cambio para priorización de colas
			,[PROD_SCON]
			,[PROD_SINT]
			,[PROD_SEXF]
			,[PROD_IACP]
			,PROD_NUMTC
		FROM PRODUCTOS WITH(NOLOCK) 
