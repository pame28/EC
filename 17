if (modoMicroservicio)
{
    _logger.Info("ModoMicroservicio ACTIVO -> consumiendo microservicio directamente");
    try
    {
        return await _microservicioClient.ConsultarAsync(requestDto);
    }
    catch (Exception ex)
    {
        _logger.Error($"Error en modoMicroservicio | Card: {requestDto.counterpart_card} | Canal: {requestDto.channel}", ex);
        return BadRequest(ex.Message);
    }
}

bool esMigrada;
try
{
    esMigrada = _repo.EsTarjetaMigrada(requestDto.counterpart_card);
}
catch (Exception ex)
{
    _logger.Error($"Error en EsTarjetaMigrada | Card: {requestDto.counterpart_card}", ex);
    return BadRequest(ex.Message);
}

if (esMigrada)
{
    _logger.Info("Tarjeta MIGRADA, consumiendo microservicio");
    try
    {
        return await _microservicioClient.ConsultarAsync(requestDto);
    }
    catch (Exception ex)
    {
        _logger.Error($"Error consultando microservicio (migrada) | Card: {requestDto.counterpart_card}", ex);
        return BadRequest(ex.Message);
    }
}