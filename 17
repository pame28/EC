        private void ObtenerObligaciones() {

            Label lblTasaCambio = NabBarCampos.Groups.FindByName("Titulo").FindControl("lblTasaCambio") as Label;
            decimal TipoCambio = 0;
            TipoCambio = Convert.ToDecimal(lblTasaCambio.Text.ToString());


            DataTable dt = new DataTable();
            SQLSrv query = new SQLSrv(Properties.Settings.Default.DBGestorBP, "usp_RecargarObgCredResolicion");

            query.Parametros.Add(new SqlParameter("@idSolicitud", Session["idSolicitud"].ToString()));
            query.Parametros.Add(new SqlParameter("@idResolucion", Session["idResolucion"].ToString()));
            dt = query.getDataTableWithParameters();

            if (query.Success)
            {
                if (dt.Rows.Count > 0)
                {
                    decimal TOTAL_DIRECTA_LPS = Convert.ToDecimal(dt.Rows[0]["TOTAL_DIRECTA_LPS"]);
                    decimal TOTAL_DIRECTA_USD = Convert.ToDecimal(dt.Rows[0]["TOTAL_DIRECTA_USD"]);
                    decimal TOTAL_INDIRECTA_LPS = Convert.ToDecimal(dt.Rows[0]["TOTAL_INDIRECTA_LPS"]);
                    decimal TOTAL_INDIRECTA_USD = Convert.ToDecimal(dt.Rows[0]["TOTAL_INDIRECTA_USD"]);
                    decimal MONTO_PROPUESTO_LPS = Convert.ToDecimal(dt.Rows[0]["MONTO_PROPUESTO_LPS"]);
                    decimal MONTO_PROPUESTO_USD = Convert.ToDecimal(dt.Rows[0]["MONTO_PROPUESTO_USD"]);
                    decimal TOTAL_MONTO_LPS = Convert.ToDecimal(dt.Rows[0]["TOTAL_MONTO_LPS"]);
                    decimal TOTAL_MONTO_USD = Convert.ToDecimal(dt.Rows[0]["TOTAL_MONTO_USD"]);

                    spinDeudaDirectLps.Value = TOTAL_DIRECTA_LPS;
                    spinDeudaDirectaUS.Value = TOTAL_DIRECTA_USD;

                    spinDeudaIndirectaLps.Value = TOTAL_INDIRECTA_LPS;
                    spinDeudaIndirectaUS.Value = TOTAL_INDIRECTA_USD;

                    spinDeudaDirectaTotalLps.Value = TOTAL_DIRECTA_LPS + (TOTAL_DIRECTA_USD * TipoCambio);
                    spinDeudaDirectaTotalUS.Value = TOTAL_DIRECTA_USD + (TOTAL_DIRECTA_LPS / TipoCambio);

                    spinDeudaIndirectaTotalLps.Value = TOTAL_INDIRECTA_LPS + (TOTAL_INDIRECTA_USD * TipoCambio);
                    spinDeudaIndirectaTotalUS.Value = TOTAL_INDIRECTA_USD + (TOTAL_INDIRECTA_LPS / TipoCambio);

                    spinMontoPropuestoLps.Value = MONTO_PROPUESTO_LPS;
                    spinMontoPropuestoUS.Value = MONTO_PROPUESTO_USD;

                    spinMontoPropuestoTotalLps.Value = TOTAL_MONTO_LPS;
                    spinMontoPropuestoTotalUS.Value = TOTAL_MONTO_USD;


                    spinExposicionTotalLPS.Value = TOTAL_DIRECTA_LPS + TOTAL_INDIRECTA_LPS + MONTO_PROPUESTO_LPS;
                    spinExposicionTotalUSD.Value = TOTAL_DIRECTA_USD + TOTAL_INDIRECTA_USD + MONTO_PROPUESTO_USD;

                    spinExposicionTotalLPS2.Value = Convert.ToDecimal(spinDeudaDirectaTotalLps.Value) + Convert.ToDecimal(spinDeudaIndirectaTotalLps.Value) + Convert.ToDecimal(spinMontoPropuestoTotalLps.Value);
                    spinExposicionTotalUSD2.Value = Convert.ToDecimal(spinDeudaDirectaTotalUS.Value) + Convert.ToDecimal(spinDeudaIndirectaTotalUS.Value) + Convert.ToDecimal(spinMontoPropuestoTotalUS.Value);

                }
            }
        }

