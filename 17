        protected void mantenimientoGarantias(string idResolucionGarantiaExposicion, string idSolicitud, string idResolucion, string codigo, string valorRemate, string montoAvaluo, string descripcion, string valorCrediticio, string accion)
        {
            SQLSrv query = new SQLSrv(Properties.Settings.Default.DBGestorBP, "usp_mantGarantiaExposicion");

            query.Parametros.Add(new SqlParameter("@idResolucionGarantiaExposicion", idResolucionGarantiaExposicion));
            query.Parametros.Add(new SqlParameter("@idSolicitud", idSolicitud));

            if (!string.IsNullOrEmpty(idResolucion))
                query.Parametros.Add(new SqlParameter("@idResolucion", idResolucion));
            else
                query.Parametros.Add(new SqlParameter("@idResolucion", DBNull.Value));

            if (!string.IsNullOrEmpty(codigo))
                query.Parametros.Add(new SqlParameter("@codigo", codigo));
            else
                query.Parametros.Add(new SqlParameter("@codigo", DBNull.Value));

            if (!string.IsNullOrEmpty(valorRemate))
                query.Parametros.Add(new SqlParameter("@valorRemate", valorRemate));
            else
                query.Parametros.Add(new SqlParameter("@valorRemate", DBNull.Value));

            if (!string.IsNullOrEmpty(montoAvaluo))
                query.Parametros.Add(new SqlParameter("@montoAvaluo", montoAvaluo));
            else
                query.Parametros.Add(new SqlParameter("@montoAvaluo", DBNull.Value));

            if (!string.IsNullOrEmpty(descripcion))
                query.Parametros.Add(new SqlParameter("@descripcion", descripcion));
            else
                //query.Parametros.Add(new SqlParameter("@descripcion", DBNull.Value));
                query.Parametros.Add(new SqlParameter("@descripcion", "."));

            if (!string.IsNullOrEmpty(valorCrediticio))
                query.Parametros.Add(new SqlParameter("@valorCrediticio", valorCrediticio));
            else
                query.Parametros.Add(new SqlParameter("@valorCrediticio", DBNull.Value));

            query.Parametros.Add(new SqlParameter("@accion", accion));

            query.executeWithParameters();

            if (!query.Success)
                throw new Exception(query.Mensaje);
        }

