        /// <summary>
        /// Carga el ícono de la ventana / barra de tareas. Si existe un .ico
        /// lo usa directamente (mejor calidad, admite varios tamaños). Si solo
        /// hay un .png, lo convierte en memoria a Icon.
        /// </summary>
        private void CargarIconoSiExiste()
        {
            try
            {
                string carpetaAssets = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Assets\\Images");
                string rutaIco = Path.Combine(carpetaAssets, "icon.ico");
                string rutaPng = Path.Combine(carpetaAssets, "logoIco.png");

                if (File.Exists(rutaIco))
                {
                    Icon = new Icon(rutaIco);
                }
                else if (File.Exists(rutaPng))
                {
                    Icon = CrearIconoDesdePng(rutaPng);
                }
            }
            catch
            {
                // Si el ícono no carga por cualquier motivo, seguimos con el
                // ícono por defecto sin romper la app.
            }
        }

        /// <summary>
        /// Convierte un PNG a Icon en tiempo de ejecución. Windows genera un
        /// HICON nativo (GetHicon) y lo clonamos a un Icon administrado antes
        /// de liberar el handle nativo, para no dejar el recurso GDI sin liberar.
        /// Para mejor nitidez en la barra de tareas, usa un PNG cuadrado
        /// (idealmente 256x256) con fondo transparente.
        /// </summary>
        private static Icon CrearIconoDesdePng(string rutaPng)
        {
            using var bitmap = new Bitmap(rutaPng);
            IntPtr hIcon = bitmap.GetHicon();
            try
            {
                using var iconTemporal = Icon.FromHandle(hIcon);
                return (Icon)iconTemporal.Clone();
            }
            finally
            {
                DestroyIcon(hIcon);
            }
        }

        private void CargarLogoSiExiste()
