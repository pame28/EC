USE [EstadosCuentaJSONProcesador]
GO

-- =========================================================
-- PASO 1: Database Master Key
-- Protege el certificado del paso 2. Cambia la contraseña
-- por una propia, larga y única, y guardala en tu gestor
-- de secretos (no la dejes en este archivo).
-- =========================================================
IF NOT EXISTS (SELECT 1 FROM sys.symmetric_keys WHERE name = '##MS_DatabaseMasterKey##')
BEGIN
    CREATE MASTER KEY ENCRYPTION BY PASSWORD = 'CAMBIA_ESTA_CLAVE_MAESTRA_LARGA_Y_UNICA';
END
GO

-- =========================================================
-- PASO 2: Certificado que protege la symmetric key
-- =========================================================
IF NOT EXISTS (SELECT 1 FROM sys.certificates WHERE name = 'CertEstadosCuentaTC')
BEGIN
    CREATE CERTIFICATE CertEstadosCuentaTC
        WITH SUBJECT = 'Certificado para proteger llave de encriptacion de estados de cuenta';
END
GO

-- =========================================================
-- PASO 3: Symmetric Key real
-- SQL Server genera el material criptografico de forma
-- aleatoria automaticamente; nunca lo ves ni lo eliges.
-- =========================================================
IF NOT EXISTS (SELECT 1 FROM sys.symmetric_keys WHERE name = 'SK_LlaveEncriptaTC')
BEGIN
    CREATE SYMMETRIC KEY SK_LlaveEncriptaTC
        WITH ALGORITHM = AES_256
        ENCRYPTION BY CERTIFICATE CertEstadosCuentaTC;
END
GO

-- =========================================================
-- PASO 4: Columna nueva para guardar la llave AES de la app,
-- ya cifrada (reemplaza a LlaveEncripta en texto plano)
-- =========================================================
IF NOT EXISTS (
    SELECT 1 FROM sys.columns
    WHERE object_id = OBJECT_ID('dbo.ParametrosGeneracionEC')
      AND name = 'LlaveEncriptaCifrada'
)
BEGIN
    ALTER TABLE dbo.ParametrosGeneracionEC
        ADD LlaveEncriptaCifrada VARBINARY(256) NULL;
END
GO

-- =========================================================
-- PASO 5: Guardar la nueva llave AES-256 de la aplicacion,
-- cifrada con SK_LlaveEncriptaTC. Esta es la llave que usa
-- EncriptacionAES.EncriptarArchivo en tu app C#.
--
-- Llave generada aleatoriamente (32 bytes / AES-256):
--   QOUNBL5a3lerVGAzwJZNIbOE/48DL2UO7usx4l7kTkA=
--
-- Reemplaza a la llave vieja de 16 bytes (AES-128):
--   qeH8b6jBD5h9i4KjMZBqYA==
-- =========================================================
OPEN SYMMETRIC KEY SK_LlaveEncriptaTC
    DECRYPTION BY CERTIFICATE CertEstadosCuentaTC;

UPDATE dbo.ParametrosGeneracionEC
SET LlaveEncriptaCifrada = ENCRYPTBYKEY(
    KEY_GUID('SK_LlaveEncriptaTC'),
    CONVERT(VARBINARY(100), 'QOUNBL5a3lerVGAzwJZNIbOE/48DL2UO7usx4l7kTkA=')
)
WHERE Id = 1; -- ajusta el filtro segun tu registro real

CLOSE SYMMETRIC KEY SK_LlaveEncriptaTC;
GO

-- =========================================================
-- PASO 6: Verificacion - confirma que quedo bien guardada
-- =========================================================
OPEN SYMMETRIC KEY SK_LlaveEncriptaTC
    DECRYPTION BY CERTIFICATE CertEstadosCuentaTC;

SELECT CONVERT(VARCHAR(100), DECRYPTBYKEY(LlaveEncriptaCifrada)) AS LlaveEncriptaTextoPlano
FROM dbo.ParametrosGeneracionEC
WHERE Id = 1;

CLOSE SYMMETRIC KEY SK_LlaveEncriptaTC;
GO

-- =========================================================
-- PASO 7 (ejecutar solo despues de confirmar el paso 6 y
-- de actualizar tu app para leer LlaveEncriptaCifrada):
-- elimina la columna vieja en texto plano.
-- =========================================================
