using EstadosCuentaTC.Data;
using Microsoft.Data.SqlClient;
using System;

namespace EstadosCuentaTC.Repositories
{
    public class LlaveEncriptaRepository
    {
        private readonly SqlExecutor _sql;

        public LlaveEncriptaRepository(SqlExecutor sql)
        {
            _sql = sql;
        }

        /// <summary>
        /// Llama al SP que abre la symmetric key, descifra el
        /// valor y lo devuelve. Como ParametrosGeneracionEC solo
        /// tiene un registro, no se necesita filtrar por Id.
        /// </summary>
        public string ObtenerLlaveEncripta()
        {
            using var conn = _sql.GetConnection();
            using var cmd = new SqlCommand("dbo.sp_ObtenerLlaveDescifrada", conn);

            cmd.CommandType = System.Data.CommandType.StoredProcedure;

            var resultado = cmd.ExecuteScalar() as string;

            if (string.IsNullOrEmpty(resultado))
                throw new InvalidOperationException(
                    "No se pudo obtener la llave de encriptacion desde la base de datos.");

            return resultado;
        }
    }
}