        protected void Page_Load(object sender, EventArgs e)
        {
            if (!Page.IsPostBack)
            {
                if ((Request.QueryString["Res"] != null) && (Request.QueryString["log"] != null))
                {
                    string idResolucion = Decrypt(Request.QueryString["Res"]);
                    string usuario = Decrypt(Request.QueryString["log"]);

                    SQLSrv query = new SQLSrv(Properties.Settings.Default.DBGestorBP, "usp_ValidarSolicitud");
                    query.Parametros.Add(new SqlParameter("@idResolucion", idResolucion));
                    query.Parametros.Add(new SqlParameter("@idusuario", usuario));
                    DataTable dt = new DataTable();

                    dt = query.getDataTableWithParameters();

                    if (query.Success)
                    {
                        if (dt.Rows.Count > 0)
                        {
                            if (dt.Rows[0]["login"].ToString() == "True")
                            {
                                if (dt.Rows[0]["idusuario"].ToString() == usuario)
                                {
                                    Session["idSolicitud"] = dt.Rows[0]["idsolicitud"].ToString();
                                    Session["idResolucion"] = Decrypt(Request.QueryString["Res"]);
                                    Session["Usuario"] = dt.Rows[0]["Usuario"].ToString();
                                }
                                else
                                {
                                   Redireccionar();
                                }

                            }

                        }
                    }
                    if ((Session["idSolicitud"] != null) && Session["idResolucion"]!=null)
                    {
                        ObtenerCamposResolucion();
                        #region MONEDA SOLICITUD
                        DataTable dt2 = new DataTable();
                        SQLSrv query2 = new SQLSrv(Properties.Settings.Default.DBGestorBP, "usp_getMonedaSolicitud");

                        query2.Parametros.Add(new SqlParameter("@idSolicitud", Session["idSolicitud"].ToString()));

                        dt2 = query2.getDataTableWithParameters();

                        if (query2.Success)
                        {
                            if (dt2.Rows.Count > 0)
                                Session["MONEDA_SOLICITUD"] = dt2.Rows[0]["Tipo"].ToString();

                        }
                        #endregion
                        LlenaComboBox();
                        LlenaCamposFormulario();
                    }
                    else
                    {
                        Redireccionar();
                    }
                    

                }
                else
                {
                    Redireccionar();
                }

            }

            if(Session["idSolicitud"] == null)
                Redireccionar();
           
        }

