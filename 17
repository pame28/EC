        public async Task<GeneralResponse> GetPaymentPlanAsync(PaymentPlanRequest paymentPlanRequest)
        {
            PlanPagosResult planPagos = new PlanPagosResult();

            try
            {

                DataTable dtResult = new DataTable();
                _logger.LogInformation("SOLICITUD RECIBIDA *****ConsultaPlanPagos*****");

                //Valida que el equivalente de la TC sea numerico, no este nulo y contenga todos los caracteres
                _logger.LogInformation("Validacion del numero equivalente");
                if (string.IsNullOrEmpty(paymentPlanRequest.equivalente) | string.IsNullOrWhiteSpace(paymentPlanRequest.equivalente))
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(11);
                    _logger.LogInformation("El equivalente no debe venir vacio -> EQUIVALENTE: " + paymentPlanRequest.equivalente);
                    
                    var mensajeError = "El número equivalente no debe estar vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                                         planPagos.Error.ToString(), mensajeError);
                }

                if (!Regex.IsMatch(paymentPlanRequest.equivalente, @"^[0-9]+$") | paymentPlanRequest.equivalente.Length < 16)
                {
                    await _cardsRepository.InsConsultaDisponible(paymentPlanRequest.equivalente, paymentPlanRequest.canal, "El número equivalente de la tarjeta no contiene el formato correcto", null, null);
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(14);
                    _logger.LogInformation("El número equivalente de la tarjeta no contiene el formato correcto -> EQUIVALENTE: " + paymentPlanRequest.equivalente);

                    var mensajeError = "El número equivalente no contiene el formato correcto";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }

                _logger.LogInformation("Validando el Monto");
                if (string.IsNullOrEmpty(paymentPlanRequest.monto.ToString()))
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(11);
                    _logger.LogInformation(planPagos.Error + " -> MONTO: " + paymentPlanRequest.monto);
                   
                    var mensajeError = "El monto no debe estar vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }

                _logger.LogInformation("Validando Tipo");
                if (string.IsNullOrEmpty(paymentPlanRequest.tipo))
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(11);
                    _logger.LogInformation(planPagos.Error + " -> TIPO: " + paymentPlanRequest.tipo);

                    var mensajeError = "El tipo no debe estar vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }


                if (paymentPlanRequest.tipo != "Intra" && paymentPlanRequest.tipo != "Extra")
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(14);
                    _logger.LogInformation("El tipo debe de ser Intra o Extra" + " -> TIPO: " + paymentPlanRequest.tipo);

                    var mensajeError = "El tipo debe de ser Intra o Extra";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }

                _logger.LogInformation("Validando Plazo");
                if (string.IsNullOrEmpty(paymentPlanRequest.plazo.ToString()))
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(11);
                    _logger.LogInformation(planPagos.Error + " -> PLAZO: " + paymentPlanRequest.plazo);

                    var mensajeError = "El plazo no debe venir vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }

                //_logger.LogInformation("Buscando tipo de producto");
                //string tipoProducto = await _cardsRepository.GetProduct(paymentPlanRequest.equivalente);
                //_logger.LogInformation("Tipo producto => " + tipoProducto);

                #region Consulta a core
                var extrafinancingPaymentPlanResponse = await consultaCore(paymentPlanRequest);
                
                if (extrafinancingPaymentPlanResponse == null)
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(14);
                    _logger.LogInformation("Consulta a api payment plan es null");

                    var mensajeError = "El api retorno vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }

                if(extrafinancingPaymentPlanResponse.response.code != "00")
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(14);
                    _logger.LogInformation("Consulta a api payment plan es null");

                    var mensajeError = extrafinancingPaymentPlanResponse.response.description;

                    return _generalResponseFn.ResponseErrorDesembolso(
                        Constantes.STATUS_OK, 
                        planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }
                #endregion


                _logger.LogInformation("Traer el calculo de la cuota");
                _logger.LogInformation("Calculando CAT/TEA");
                _logger.LogInformation("CAT/TEA =>" + extrafinancingPaymentPlanResponse.informationPlan.catTea);

                _logger.LogInformation("Traer diseño HTML");
                string encabezado = string.Empty;
                string TablaA = string.Empty;
                string Footer = string.Empty;

                var designPaymentPlan = await _cardsRepository.GetDesingPaymentPlan();
                if (!string.IsNullOrEmpty(designPaymentPlan.Encabezado))
                {
                    encabezado = designPaymentPlan.Encabezado;
                    TablaA = designPaymentPlan.TablaAmortizacion;
                    Footer = designPaymentPlan.Footer;
                }


                _logger.LogInformation("Reemplazar datos en encabezado");
                encabezado = encabezado.Replace("[PRODUCTO]", extrafinancingPaymentPlanResponse.informationPlan.product);
                encabezado = encabezado.Replace("[MONTO]", extrafinancingPaymentPlanResponse.informationPlan.amount.ToString("N2"));
                encabezado = encabezado.Replace("[PLAZO]", extrafinancingPaymentPlanResponse.informationPlan.period.ToString());
                encabezado = encabezado.Replace("[TASA]", extrafinancingPaymentPlanResponse.informationPlan.rate + "%");
                encabezado = encabezado.Replace("[CUOTA]", extrafinancingPaymentPlanResponse.informationPlan.levelInstallment.ToString("N2"));
                encabezado = encabezado.Replace("[COMISION]", extrafinancingPaymentPlanResponse.informationPlan.commission.ToString("N2"));
                encabezado = encabezado.Replace("[SEGURO]", extrafinancingPaymentPlanResponse.informationPlan.insurance.ToString("N2"));
                encabezado = encabezado.Replace("[CARGO]", (extrafinancingPaymentPlanResponse.informationPlan.totalCharge.ToString("N2")));
                encabezado = encabezado.Replace("[PCUOTA]", (extrafinancingPaymentPlanResponse.informationPlan.firstLeveledInstallment.ToString("N2")));
                encabezado = encabezado.Replace("[CAT]", extrafinancingPaymentPlanResponse.informationPlan.catTea.ToString() + "%");


                //decimal SaldoC = Convert.ToDecimal(paymentPlanRequest.monto), PagoC = 0, PagoI = 0, SPagoC = 0, SPagoI = 0, Tasa = Convert.ToDecimal(extrafinancingPaymentPlanResponse.informationPlan.tasa), Cuota = Convert.ToDecimal(extrafinancingPaymentPlanResponse.informationPlan.cuotaNivelada);
               
                _logger.LogInformation("Creando tabla de amortización");
                string TblCompleta, TBL = string.Empty;
                TblCompleta = TablaA.Replace("[ID]", "");
                TblCompleta = TblCompleta.Replace("[SALDOC]", "<b>L. " + paymentPlanRequest.monto.ToString("N2") + "</b>");
                TblCompleta = TblCompleta.Replace("[PAGOC]", "");
                TblCompleta = TblCompleta.Replace("[PAGOI]", "");
                TblCompleta = TblCompleta.Replace("[CUOTAT]", "");

                foreach(var item in extrafinancingPaymentPlanResponse.installments)
                {
                    TBL = TablaA;
                    TBL = TBL.Replace("[ID]", item.month.ToString());
                    TBL = TBL.Replace("[CUOTAT]", item.installmentTotal.ToString("N2"));
                    TBL = TBL.Replace("[PAGOI]", item.interests.ToString("N2"));
                    TBL = TBL.Replace("[PAGOC]", item.capitalPayment.ToString("N2"));


                    TBL = TBL.Replace("[SALDOC]", item.capitalBalance.ToString("N2"));

                    //if (SaldoC > 1)
                    //{
                    //    TBL = TBL.Replace("[SALDOC]", SaldoC.ToString("N2"));
                    //}
                    //else
                    //{
                    //    TBL = TBL.Replace("[SALDOC]", Math.Round(SaldoC, 0).ToString("N2"));
                    //}

                    TblCompleta = TblCompleta + TBL;
                }

                TBL = TablaA;
                TBL = TBL.Replace("[ID]", "TOTAL");
                TBL = TBL.Replace("[CUOTAT]", extrafinancingPaymentPlanResponse.total.totalInstallment.ToString("N2")); //(Cuota * paymentPlanRequest.plazo).ToString("N2"));
                TBL = TBL.Replace("[PAGOI]", extrafinancingPaymentPlanResponse.total.paymentInterests.ToString("N2"));
                TBL = TBL.Replace("[PAGOC]", extrafinancingPaymentPlanResponse.total.paymentCapital.ToString("N2"));
                TBL = TBL.Replace("[SALDOC]", "");
                _logger.LogInformation("Creando PDF");
                string PlanCompleto = encabezado + TblCompleta + TBL + Footer;
                MemoryStream memoryStream = new MemoryStream();


                PdfWriter pdfWriter = new PdfWriter(memoryStream);
                PdfDocument pdf = new PdfDocument(pdfWriter);

                iText.Kernel.Geom.Rectangle Pagina = new iText.Kernel.Geom.Rectangle(700, 792);

                iText.Layout.Document document = new iText.Layout.Document(pdf, new PageSize(Pagina));

                document.SetMargins(2, 2, 2, 2);
                pdf = document.GetPdfDocument();

                HtmlConverter.ConvertToPdf(PlanCompleto, pdf, new ConverterProperties());
                document.Close();
                pdf.Close();
                pdfWriter.Close();

                _logger.LogInformation("Convirtiendo Base64");
                byte[] bytes = memoryStream.ToArray();
                string base64String = Convert.ToBase64String(bytes);
                planPagos.PlanPagos = base64String;

                //if (Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings.Get("GuardarPlanPagos")))
                if(_guardarPlanPagos)
                {
                    _logger.LogInformation("Plan de pagos");
                    _logger.LogInformation(base64String);
                }

                _logger.LogInformation("Ejecución exitosa");

                return await _generalResponseFn.Response(Constantes.STATUS_OK, "00", planPagos.PlanPagos);

            }

            catch (Exception ex)
            {
                planPagos.Respuesta = 1;
                planPagos.Error = await _cardsRepository.GetMsjError(14);
                _logger.LogInformation("Error en publicPlanPagosResult ConsultaPlanPagos");
                _logger.LogInformation(ex.Message);

                string mensajeError = "Error en publicPlanPagosResult ConsultaPlanPagos";
                return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);

            }

        }

        public async Task<ExtrafinancingPaymentResponse> consultaCore(PaymentPlanRequest paymentPlanRequest)
        {
            _logger.LogInformation("Consultando core tarjetas");

            var getBaseRequest = await _cardsRepository.GetBaseInfo(paymentPlanRequest.equivalente.ToString());

            if (getBaseRequest == null)
            {
                _logger.LogError("Error en {Method}. Message: {Message}", nameof(GetPaymentPlanAsync), "Error al obtener información, respuesta null");
                return new ExtrafinancingPaymentResponse();
            }

            var extrafinancingPaymentPlanRequest = new ExtrafinancingPaymentPlanRequest
            {
                card = new Card
                {
                    bin = getBaseRequest.Bin,
                    lastFourDigits = getBaseRequest.LastFourDigits,
                },
                client = new Client
                {
                    documentNumber = getBaseRequest.DocumentNumber,
                    documentType = getBaseRequest.DocumentType,
                    gender = getBaseRequest.Gender,
                },
                amount = paymentPlanRequest.monto,
                currency = "HNL",
                numberPayments = paymentPlanRequest.plazo
            };

            var extrafinancingPaymentPlanResponse = await _apiService.GetPaymentPlanAsync(endpoint, extrafinancingPaymentPlanRequest);

            if (extrafinancingPaymentPlanResponse == null)
            {
                _logger.LogError("Error en {Method}. Message: {Message}", nameof(GetPaymentPlanAsync), "Error al llamar api payment plan, respuesta null");
                return new ExtrafinancingPaymentResponse();
            }

            return extrafinancingPaymentPlanResponse;
        }
    }
}









