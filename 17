        protected void ObtieneGrupoRelacionado(string codigo)
        {
            ASPxComboBox cboCodigoGrupo = NabBarCampos.Groups.FindByName("InformacionCredito").FindControl("cboCodigoGrupo") as ASPxComboBox;
            ASPxComboBox cboGrupo = NabBarCampos.Groups.FindByName("InformacionCredito").FindControl("cboGrupo") as ASPxComboBox;

            if(cboCodigoGrupo.SelectedIndex!=-1){
                codigo=cboCodigoGrupo.Value.ToString();
                string Query = string.Empty;
                SQLSrv query = new SQLSrv(Properties.Settings.Default.DBGestorBP, "usp_ObtieneQueryGrupoRelacionado");

                try
                {
                    DataTable dt = new DataTable();
                    query.Parametros.Add(new SqlParameter("@Grupo", codigo));

                    dt = query.getDataTableWithParameters();

                    if (query.Success)
                    {
                        if (dt.Rows.Count > 0)
                        {
                            Query = dt.Rows[0]["Query"].ToString();
                        }
                    }

                    DataTable dtResult = new DataTable();
                    #region Consulta AS400
                    try
                    {
                        string connectionAs400 = Properties.Settings.Default.cnxAS400;
                        OleDbConnection cone = new OleDbConnection(connectionAs400);

                        OleDbCommand OleDbCmd = new OleDbCommand();
                        OleDbDataAdapter OleDbAdap = new OleDbDataAdapter();

                        if (cone.State == ConnectionState.Closed)
                            cone.Open();

                        OleDbCmd.Connection = cone;
                        OleDbCmd.CommandText = Query;
                        OleDbAdap.SelectCommand = OleDbCmd;
                        OleDbAdap.Fill(dtResult);
                        cone.Close();
                    }
                    catch (Exception ex)
                    {
                        Label lbError = (Label)NabBarCampos.Groups.FindByName("Titulo").FindControl("lbError");
                        lbError.Text = lbError.Text + "\n Error en ObtieneCtasTitular, consulta AS400: " + Query + " Error = " + ex.Message + "\nQuery.Mesage= " + query.Mensaje;
                    }
                    #endregion

                    cboGrupo.DataSource = dtResult;
                    cboGrupo.ValueField = "GRUPO";
                    cboGrupo.TextField = "NOMBRE";
                    cboGrupo.DataBind();
                }
                catch (Exception ex)
                {
                    Label lbError = (Label)NabBarCampos.Groups.FindByName("Titulo").FindControl("lbError");
                    lbError.Text = lbError.Text + "\n Error en ObtieneCtasTitular, EXEC usp_ObtenerCtasIntrucDesembolso, Error = " + ex.Message + "\nQuery.Mesage= " + query.Mensaje + "\n QueryAS: " + Query;
                }
            }
        }

