ALTER PROCEDURE [dbo].[usp_RecargarObgCredResolicion]
	@idSolicitud INT,
	@idResolucion INT = NULL,
	@idUsuario varchar(50) 
AS
BEGIN
		DECLARE @tasaCambio DECIMAL(8,4),
				--TITULAR
				@deudasDirectasLPS MONEY,
				@deudasDirectasUSD MONEY,
				@deudasDirectasCOLPS MONEY,--CODEUDOR
				@deudasDirectasCOUSD MONEY,--CODEUDOR
				@deudasDirectasUSDXF MONEY, --TITULAR
				@deudasDirectasCOUSDXF MONEY, --CODEUDOR
				@deudasDirectasUSDTarjetas MONEY, --TITULAR
				@deudasDirectasCOUSDTarjetas MONEY, -- CODEUDOR
				-------TOTALES DEUDAS DIRECTAS
				@deudasDirectasTotalLPS MONEY, 
				@deudasDirectasTotalUSD MONEY,
				
				@deudaIndirectaLPS MONEY,
				@deudaCOIndirectaLPS MONEY,
				@deudaIndirectaUSD MONEY,
				@deudaCOIndirectaUSD MONEY,
				@deudaIndirectaTotalLPS MONEY,
				@deudaIndirectaTotalUSD MONEY,
				@montoPropuestoLPS MONEY,
				@montoPropuestoUSD MONEY,
				@totalMontoPropuestoLPS MONEY,
				@TotalMontoPropuestoUSD MONEY,

				@cif VARCHAR(50),
				@cifCoDeudor1 VARCHAR(50),
				@cifCoDeudor2 VARCHAR(50),
				@cifCoDeudor3 VARCHAR(50),
				@cifCoDeudor4 VARCHAR(50),
				@FechaActualizado varchar(50),
				@usuarioActualizo varchar(50),
				@fechaActualizadoOBL datetime,
				@Usuario varchar(50),
				@LineaTitular money,
				@LineaCodeudores money
				--@cifCoDeudor VARCHAR(max)
				
		--LLENA EL CIF DEL TITULAR
		select @tasaCambio=tipoCambio 
		from resolucion 
		where idresolucion=@idResolucion

		SET @cif=(SELECT TOP 1 cifSolicitante FROM ResolucionSolicitante where idSolicitud =@idSolicitud and idResolucion=@idResolucion AND TipoSolicitante=1 )

		SET @cifCoDeudor1=(SELECT cifSolicitante FROM ResolucionSolicitante where idSolicitud =@idSolicitud and idResolucion=@idResolucion AND TipoSolicitante=2 )
		SET @cifCoDeudor2=(SELECT cifSolicitante FROM ResolucionSolicitante where idSolicitud =@idSolicitud and idResolucion=@idResolucion AND TipoSolicitante=3 )
		SET @cifCoDeudor3=(SELECT cifSolicitante FROM ResolucionSolicitante where idSolicitud =@idSolicitud and idResolucion=@idResolucion AND TipoSolicitante=4 )
		SET @cifCoDeudor4=(SELECT cifSolicitante FROM ResolucionSolicitante where idSolicitud =@idSolicitud and idResolucion=@idResolucion AND TipoSolicitante=5 )
		
		SET @Usuario=(SELECT top 1 usuario FROM Usuarios where idUsuario=@idUsuario)
	
		UPDATE Resolucion SET FActObligaciones=GETDATE(), usuActObligaciones=@Usuario WHERE idResolucion=@idResolucion
		
		SET @usuarioActualizo =(SELECT isnull(usuActObligaciones,'') FROM Resolucion WHERE idResolucion=@idResolucion)
		SET @FechaActualizado =(select isnull(FORMAT(FActObligaciones, 'dd/MM/yyyy HH:mm:ss', 'es-ES' ),'') from Resolucion where idResolucion=@idResolucion)
		SET @fechaActualizadoOBL =(SELECT FActObligaciones from Resolucion where idResolucion=@idResolucion)


  IF EXISTS (SELECT 1 FROM Plantillas where id_Plantilla = (select top 1 idPlantilla from SolicitudRelacionada where idResolucion=@idResolucion and idSolicitudPrincipal=@idSolicitud) and Grupo_Parte=0)
BEGIN
			-- LIMITE DE CREDITO DE LA TC DEL TITULAR
			SELECT @deudasDirectasUSDTarjetas = ISNULL(SUM(OV.Monto) ,0)
			FROM ObligacionesVasa OV
			where OV.CIF=@CIF AND Tipo='Tarjeta'

			-- LIMITE DE EXTRAFINANCIAMIENTO DE TC 
			SELECT @deudasDirectasUSDXF = ISNULL(SUM(OV.Monto) ,0)
			FROM ObligacionesVasa OV
			where OV.CIF=@CIF AND Tipo='ExtraFinanciamiento'

						--DEUDAS DIRECTAS DEL CODEUDOR EN DOLARES
			IF ( @cifCoDeudor1 IS NOT NULL) -- SI EXISTE UN CODEUDOR PARA LA SOLICITUD 
				BEGIN
					SELECT @deudasDirectasCOUSD = ISNULL(SUM(operaciones.MONTO), 0)
					FROM (SELECT 
					ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO ASC) fila,ro.MONTO, ro.TIPO, ro.CIF
							FROM ResolucionObligaciones ro
							WHERE RO.CIF IN (@CIF,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
							AND ro.MONEDA = 'US$'
							) operaciones
					WHERE operaciones.fila = 1 AND operaciones.TIPO = 'Directa' AND operaciones.CIF IN(@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
			
				
					-- LIMITE DE CREDITO DE LA TC
					SELECT @deudasDirectasCOUSDTarjetas = ISNULL(SUM(OV.Monto) ,0)
					FROM ObligacionesVasa OV
					where OV.CIF in(@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4) AND Tipo='Tarjeta'

				END
	

			--DEUDAS DIRECTAS DEL CODEUDOR EN DOLARES
			IF ( @cifCoDeudor1 IS NOT NULL) -- SI EXISTE UN CODEUDOR PARA LA SOLICITUD 
				BEGIN

					-- LIMITE DE EXTRAFINANCIAMIENTO DE TC 
					SELECT @deudasDirectasCOUSDXF = ISNULL(SUM(OV.Monto) ,0)
					FROM ObligacionesVasa OV
					where OV.CIF IN(@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4) AND Tipo='ExtraFinanciamiento'
				END

			-- DEUDAS DIRECTAS EN LEMPIRAS DEL TITULAR
			SELECT @deudasDirectasLPS = ISNULL(SUM(operaciones.MONTO), 0)
					FROM (	SELECT 
							ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO asc) fila,ro.MONTO, ro.TIPO, ro.CIF
							FROM ResolucionObligaciones ro
			      			WHERE ro.MONEDA = 'L' AND RO.OPERACION!='-1'
						AND RO.CIF IN (@CIF,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
					) operaciones
					WHERE operaciones.fila = 1 AND operaciones.TIPO='Directa' AND operaciones.CIF IN(@CIF)

				SELECT @LineaTitular=ISNULL(SUM(rt.MONTO), 0)
				FROM ResolucionObligaciones rt 
				WHERE rt.OPERACION='-1' AND rt.CIF=@cif

			--DEUDAS DIRECTAS EN LEMPIRAS DEL CODEUDOR
			IF ( @cifCoDeudor1 IS NOT NULL) -- SI EXISTE UN CODEUDOR PARA LA SOLICITUD 
				BEGIN
	               SELECT @deudasDirectasCOLPS = ISNULL(SUM(operaciones.MONTO), 0)
					FROM (	SELECT 
							ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO asc) fila,ro.MONTO, ro.TIPO, ro.CIF
							FROM ResolucionObligaciones ro 
			      			WHERE ro.MONEDA = 'L' AND RO.OPERACION!='-1'
						AND RO.CIF IN (@cif,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
					) operaciones
					WHERE operaciones.fila = 1 AND operaciones.TIPO='Directa' AND operaciones.CIF IN(@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)

				SELECT @LineaCodeudores=ISNULL(SUM(rt.MONTO), 0)
				FROM ResolucionObligaciones rt 
				WHERE rt.OPERACION='-1' AND rt.CIF IN (@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)

				END

			--DEUDAS DIRECTAS EN DOLARES DEL TITULAR		
			SELECT @deudasDirectasUSD = ISNULL(SUM(operaciones.MONTO), 0)
					FROM (	SELECT 
							ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO asc) fila,ro.MONTO, ro.TIPO, ro.CIF
							FROM ResolucionObligaciones ro
			      			WHERE RO.CIF IN (@CIF,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4) AND ro.MONEDA = 'US$'		
					) operaciones
					WHERE operaciones.fila = 1 AND operaciones.TIPO = 'Directa' AND operaciones.CIF IN(@CIF)

		
			--DEUDAS DIRECTAS DEL CODEUDOR EN DOLARES
			IF ( @cifCoDeudor1 IS NOT NULL) -- SI EXISTE UN CODEUDOR PARA LA SOLICITUD 
				BEGIN
                SELECT @deudasDirectasCOUSD = ISNULL(SUM(operaciones.MONTO), 0)
					FROM (SELECT 
					ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO ASC) fila,ro.MONTO, ro.TIPO, ro.CIF
							FROM ResolucionObligaciones ro
							WHERE RO.CIF IN (@cif,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
							AND ro.MONEDA = 'US$'
							) operaciones
					WHERE operaciones.fila = 1 AND operaciones.TIPO = 'Directa' AND operaciones.CIF in(@cifCoDeudor1, @cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)

				END


			--Deudas Indirectas en LPS
			SELECT @deudaIndirectaLPS = ISNULL(SUM(operaciones.MONTO), 0)
					FROM (	SELECT 
							ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO asc) fila,ro.MONTO, ro.TIPO, ro.CIF
							FROM ResolucionObligaciones ro
			      			WHERE ro.MONEDA = 'L'
						AND RO.CIF IN (@CIF,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
					) operaciones
					WHERE operaciones.fila = 1 AND operaciones.TIPO='Indirecta' AND operaciones.CIF IN(@CIF)

			IF ( @cifCoDeudor1 IS NOT NULL) -- SI EXISTE UN CODEUDOR PARA LA SOLICITUD 
					BEGIN
				SELECT @deudaCOIndirectaLPS= ISNULL(SUM(operaciones.MONTO), 0)
						FROM (	SELECT 
								ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO asc) fila,ro.MONTO, ro.TIPO, ro.CIF
								FROM   ResolucionObligaciones ro
					WHERE   ro.MONEDA = 'L'
							AND RO.CIF IN (@CIF,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
						) operaciones
						WHERE operaciones.fila = 1 AND operaciones.TIPO = 'Indirecta' 
			END


			--Deudas Indirectas en USD
			SELECT @deudaIndirectaUSD= ISNULL(SUM(operaciones.MONTO), 0)
					FROM (SELECT 
						ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO ASC) fila,ro.MONTO, ro.TIPO, ro.CIF
								FROM ResolucionObligaciones ro
								WHERE ro.CIF IN (@CIF,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
								AND ro.MONEDA = 'US$'
								) operaciones
						WHERE operaciones.fila = 1 AND operaciones.TIPO = 'Indirecta' AND operaciones.CIF IN(@CIF)

			IF ( @cifCoDeudor1 IS NOT NULL) -- SI EXISTE UN CODEUDOR PARA LA SOLICITUD 
					BEGIN
				   SELECT @deudaCOIndirectaUSD= ISNULL(SUM(operaciones.MONTO), 0)
					FROM (SELECT 
						ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO ASC) fila,ro.MONTO, ro.TIPO, ro.CIF
								FROM ResolucionObligaciones ro
								WHERE RO.CIF IN (@cif,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
								AND ro.MONEDA = 'US$'
								) operaciones
						WHERE operaciones.fila = 1 AND operaciones.TIPO = 'Indirecta' AND operaciones.CIF in(@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
			END


END

  IF EXISTS (SELECT 1 FROM Plantillas where id_Plantilla = (select top 1 idPlantilla from SolicitudRelacionada where idResolucion=@idResolucion and idSolicitudPrincipal=@idSolicitud) and Grupo_Parte=1)
BEGIN
			-- LIMITE DE CREDITO DE LA TC DEL TITULAR
			SELECT @deudasDirectasUSDTarjetas = ISNULL(SUM(OV.Monto) ,0)
			FROM ObligacionesVasa OV
			where OV.CIF=@CIF AND Tipo='Tarjeta'

			-- LIMITE DE EXTRAFINANCIAMIENTO DE TC 
			SELECT @deudasDirectasUSDXF = ISNULL(SUM(OV.Monto) ,0)
			FROM ObligacionesVasa OV
			where OV.CIF=@CIF AND Tipo='ExtraFinanciamiento'

						--DEUDAS DIRECTAS DEL CODEUDOR EN DOLARES
			IF ( @cifCoDeudor1 IS NOT NULL) -- SI EXISTE UN CODEUDOR PARA LA SOLICITUD 
				BEGIN
					SELECT @deudasDirectasCOUSD = ISNULL(SUM(operaciones.MONTO), 0)
					FROM (SELECT 
					ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO ASC) fila,ro.MONTO, ro.TIPO, ro.CIF
							FROM ResolucionObligacionesGrupo ro
							WHERE RO.CIF IN (@CIF,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
							AND ro.MONEDA = 'US$'
							) operaciones
					WHERE operaciones.fila = 1 AND operaciones.TIPO = 'Directa' AND operaciones.CIF IN(@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
			
				
					-- LIMITE DE CREDITO DE LA TC
					SELECT @deudasDirectasCOUSDTarjetas = ISNULL(SUM(OV.Monto) ,0)
					FROM ObligacionesVasa OV
					where OV.CIF in(@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4) AND Tipo='Tarjeta'

				END
	

			--DEUDAS DIRECTAS DEL CODEUDOR EN DOLARES
			IF ( @cifCoDeudor1 IS NOT NULL) -- SI EXISTE UN CODEUDOR PARA LA SOLICITUD 
				BEGIN

					-- LIMITE DE EXTRAFINANCIAMIENTO DE TC 
					SELECT @deudasDirectasCOUSDXF = ISNULL(SUM(OV.Monto) ,0)
					FROM ObligacionesVasa OV
					where OV.CIF IN(@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4) AND Tipo='ExtraFinanciamiento'
				END

			-- DEUDAS DIRECTAS EN LEMPIRAS DEL TITULAR
			SELECT @deudasDirectasLPS = ISNULL(SUM(operaciones.MONTO), 0)
					FROM (	SELECT 
							ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO asc) fila,ro.MONTO, ro.TIPO, ro.CIF
							FROM ResolucionObligacionesGrupo ro
			      			WHERE ro.MONEDA = 'L' AND ro.OPERACION!='-1'
						AND RO.CIF IN (@CIF,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
					) operaciones
					WHERE operaciones.fila = 1 AND operaciones.TIPO='Directa' AND operaciones.CIF IN(@CIF)

			SELECT @LineaTitular=ISNULL(SUM(rt.MONTO), 0)
				FROM ResolucionObligacionesGrupo rt 
				WHERE rt.OPERACION='-1' AND rt.CIF=@cif

			--DEUDAS DIRECTAS EN LEMPIRAS DEL CODEUDOR
			IF ( @cifCoDeudor1 IS NOT NULL) -- SI EXISTE UN CODEUDOR PARA LA SOLICITUD 
				BEGIN
	               SELECT @deudasDirectasCOLPS = ISNULL(SUM(operaciones.MONTO), 0)
					FROM (	SELECT 
							ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO asc) fila,ro.MONTO, ro.TIPO, ro.CIF
							FROM ResolucionObligacionesGrupo ro
			      			WHERE ro.MONEDA = 'L' AND ro.OPERACION='-1'
						AND RO.CIF IN (@cif,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
					) operaciones
					WHERE operaciones.fila = 1 AND operaciones.TIPO='Directa' AND operaciones.CIF IN(@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)

				SELECT @LineaCodeudores=ISNULL(SUM(rt.MONTO), 0)
				FROM ResolucionObligacionesGrupo rt 
				WHERE rt.OPERACION='-1' AND rt.CIF IN (@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)

				END

			--DEUDAS DIRECTAS EN DOLARES DEL TITULAR		
			SELECT @deudasDirectasUSD = ISNULL(SUM(operaciones.MONTO), 0)
					FROM (	SELECT 
							ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO asc) fila,ro.MONTO, ro.TIPO, ro.CIF
							FROM ResolucionObligacionesGrupo ro
			      			WHERE RO.CIF IN (@CIF,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4) AND ro.MONEDA = 'US$'		
					) operaciones
					WHERE operaciones.fila = 1 AND operaciones.TIPO = 'Directa' AND operaciones.CIF IN(@CIF)

		
			--DEUDAS DIRECTAS DEL CODEUDOR EN DOLARES
			IF ( @cifCoDeudor1 IS NOT NULL) -- SI EXISTE UN CODEUDOR PARA LA SOLICITUD 
				BEGIN
                SELECT @deudasDirectasCOUSD = ISNULL(SUM(operaciones.MONTO), 0)
					FROM (SELECT 
					ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO ASC) fila,ro.MONTO, ro.TIPO, ro.CIF
							FROM ResolucionObligacionesGrupo ro
							WHERE RO.CIF IN (@cif,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
							AND ro.MONEDA = 'US$'
							) operaciones
					WHERE operaciones.fila = 1 AND operaciones.TIPO = 'Directa' AND operaciones.CIF in(@cifCoDeudor1, @cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)

				END


			--Deudas Indirectas en LPS
			SELECT @deudaIndirectaLPS = ISNULL(SUM(operaciones.MONTO), 0)
					FROM (	SELECT 
							ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO asc) fila,ro.MONTO, ro.TIPO, ro.CIF
							FROM ResolucionObligacionesGrupo ro
			      			WHERE ro.MONEDA = 'L'
						AND RO.CIF IN (@CIF,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
					) operaciones
					WHERE operaciones.fila = 1 AND operaciones.TIPO='Indirecta'  AND operaciones.CIF IN(@CIF)

			IF ( @cifCoDeudor1 IS NOT NULL) -- SI EXISTE UN CODEUDOR PARA LA SOLICITUD 
					BEGIN
				SELECT @deudaCOIndirectaLPS= ISNULL(SUM(operaciones.MONTO), 0)
						FROM (	SELECT 
								ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO asc) fila,ro.MONTO, ro.TIPO, ro.CIF
								FROM   ResolucionObligacionesGrupo ro
					WHERE   ro.MONEDA = 'L'
							AND RO.CIF IN (@CIF,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
						) operaciones
						WHERE operaciones.fila = 1 AND operaciones.TIPO = 'Indirecta' 
			END


			--Deudas Indirectas en USD
			SELECT @deudaIndirectaUSD= ISNULL(SUM(operaciones.MONTO), 0)
					FROM (SELECT 
						ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO ASC) fila,ro.MONTO, ro.TIPO, ro.CIF
								FROM ResolucionObligacionesGrupo ro
								WHERE ro.CIF IN (@CIF,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
								AND ro.MONEDA = 'US$'
								) operaciones
						WHERE operaciones.fila = 1 AND operaciones.TIPO = 'Indirecta' AND operaciones.CIF IN(@CIF)

			IF ( @cifCoDeudor1 IS NOT NULL) -- SI EXISTE UN CODEUDOR PARA LA SOLICITUD 
					BEGIN
				   SELECT @deudaCOIndirectaUSD= ISNULL(SUM(operaciones.MONTO), 0)
					FROM (SELECT 
						ROW_NUMBER() OVER(PARTITION BY ro.OPERACION ORDER BY ro.TIPO ASC) fila,ro.MONTO, ro.TIPO, ro.CIF
								FROM ResolucionObligacionesGrupo ro
								WHERE RO.CIF IN (@cif,@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
								AND ro.MONEDA = 'US$'
								) operaciones
						WHERE operaciones.fila = 1 AND operaciones.TIPO = 'Indirecta' AND operaciones.CIF in(@cifCoDeudor1,@cifCoDeudor2, @cifCoDeudor3, @cifCoDeudor4)
			END


END

		--Guarda las deudas Directas en LPS en la variable y le asigna 0 en caso de ser nulo
		SELECT @deudasDirectasLPS = (ISNULL(@deudasDirectasLPS, 0) + ISNULL(@LineaTitular, 0))
		
		SELECT @deudasDirectasCOLPS  = (ISNULL(@deudasDirectasCOLPS , 0) + ISNULL(@LineaCodeudores , 0))
		SELECT @deudasDirectasUSD = ISNULL(@deudasDirectasUSD, 0)
		SELECT @deudasDirectasCOUSD = ISNULL(@deudasDirectasCOUSD, 0)
		SELECT @deudasDirectasUSDTarjetas = ISNULL(@deudasDirectasUSDTarjetas, 0)
		SELECT @deudasDirectasCOUSDTarjetas = ISNULL(@deudasDirectasCOUSDTarjetas, 0)
		SELECT @deudasDirectasUSDXF = ISNULL(@deudasDirectasUSDXF, 0)
		SELECT @deudasDirectasCOUSDXF = ISNULL(@deudasDirectasCOUSDXF, 0)

		--Total Deudas Directas en LPS y Dolares
		SELECT @deudasDirectasTotalLPS = (@deudasDirectasLPS + @deudasDirectasCOLPS)
		      ,@deudasDirectasTotalUSD = (@deudasDirectasUSD + @deudasDirectasCOUSD+ @deudasDirectasUSDTarjetas+ @deudasDirectasCOUSDTarjetas + @deudasDirectasUSDXF+ @deudasDirectasCOUSDXF);
		      
		SELECT @deudasDirectasTotalLPS = ISNULL(@deudasDirectasTotalLPS ,0)
		      ,@deudasDirectasTotalUSD = ISNULL(@deudasDirectasTotalUSD ,0)

		SELECT @deudaIndirectaLPS = ISNULL(@deudaIndirectaLPS, 0)
		SELECT @deudaCOIndirectaLPS = ISNULL(@deudaCOIndirectaLPS, 0)

		SELECT @deudaIndirectaUSD = ISNULL(@deudaIndirectaUSD, 0)
		SELECT @deudaCOIndirectaUSD = ISNULL(@deudaCOIndirectaUSD, 0)
		
		--Total Deudas Indirectas en LPS Y Dolares
		SELECT @deudaIndirectaTotalLPS = @deudaIndirectaLPS + @deudaCOIndirectaLPS
		      ,@deudaIndirectaTotalUSD = @deudaIndirectaUSD + @deudaCOIndirectaUSD
		      
		SELECT @deudaIndirectaTotalLPS = ISNULL(@deudaIndirectaTotalLPS ,0)
		      ,@deudaIndirectaTotalUSD = ISNULL(@deudaIndirectaTotalUSD ,0)

		--Monto propuesto en lempiras
		SELECT @montoPropuestoLPS= SUM(ISNULL(SR.montoPropuesto, 0))
		FROM SolicitudRelacionada SR INNER JOIN Monedas M 
		ON SR.idMoneda=M.idMoneda WHERE  SR.idSolicitudPrincipal = @idSolicitud 
		AND SR.idResolucion=@idResolucion AND M.moneda='Lempiras'

		--Monto propuesto en Dolares
		SELECT @montoPropuestoUSD= SUM(ISNULL(SR.montoPropuesto, 0))
		FROM SolicitudRelacionada SR INNER JOIN Monedas M 
		ON SR.idMoneda=M.idMoneda WHERE  SR.idSolicitudPrincipal = @idSolicitud 
		AND SR.idResolucion=@idResolucion AND M.moneda='Dolares'
		
		SELECT @totalMontoPropuestoLPS=ISNULL(@totalMontoPropuestoLPS,0), 
		@TotalMontoPropuestoUSD=ISNULL(@TotalMontoPropuestoUSD,0),
		@montoPropuestoLPS=ISNULL(@montoPropuestoLPS, 0),
		@montoPropuestoUSD=ISNULL(@montoPropuestoUSD, 0);

		--Total monto propuesto LPS
		SELECT @totalMontoPropuestoLPS= @montoPropuestoLPS+(@montoPropuestoUSD * @tasaCambio);
		SELECT @TotalMontoPropuestoUSD= @montoPropuestoUSD+(@montoPropuestoLPS / @tasaCambio);


		SELECT @deudasDirectasTotalLPS AS TOTAL_DIRECTA_LPS, @deudasDirectasTotalUSD AS TOTAL_DIRECTA_USD,
			   @deudaIndirectaTotalLPS AS TOTAL_INDIRECTA_LPS, @deudaIndirectaTotalUSD AS TOTAL_INDIRECTA_USD,
			   @tasaCambio AS TASA_CAMBIO, @montoPropuestoLPS AS MONTO_PROPUESTO_LPS, @montoPropuestoUSD AS MONTO_PROPUESTO_USD,
			   @totalMontoPropuestoLPS AS TOTAL_MONTO_LPS, @totalMontoPropuestoUSD AS TOTAL_MONTO_USD,
			   @usuarioActualizo AS USUARIO_ACTUALIZO, @FechaActualizado as FECHA_ACTUALIZO, @fechaActualizadoOBL AS FECHA
		FROM Parametros



END
