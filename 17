        private void BtnDesencriptar_Click(object? sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(txtArchivoEncriptado.Text) ||
                string.IsNullOrWhiteSpace(txtLlavePublica.Text))
            {
                MostrarEstado(false, "Selecciona el archivo encriptado y el archivo LlavePublica.txt.");
                return;
            }

            if (!File.Exists(txtArchivoEncriptado.Text))
            {
                MostrarEstado(false, "El archivo encriptado seleccionado no existe.");
                return;
            }

            if (!File.Exists(txtLlavePublica.Text))
            {
                MostrarEstado(false, "El archivo LlavePublica.txt seleccionado no existe.");
                return;
            }

            // ---------- Verificar si el archivo ya está desencriptado ----------
            if (EsJsonValido(txtArchivoEncriptado.Text))
            {
                MostrarEstado(false, "Este archivo ya está desencriptado.");
                return;
            }

            try
            {
                btnDesencriptar.Enabled = false;
                btnDesencriptar.Text = "Desencriptando...";
                Cursor = Cursors.WaitCursor;

                var (keyBase64, nonceBase64) = LeerLlaveYNonce(txtLlavePublica.Text);

                EncriptacionAES.DesencriptarArchivo(
                    txtArchivoEncriptado.Text,
                    txtArchivoEncriptado.Text,
                    keyBase64,
                    nonceBase64);

                MostrarEstado(true, "¡Listo! El archivo se desencriptó correctamente y ya puedes abrirlo.");

                // Limpiar los campos tras una desencriptación exitosa
                LimpiarCampos();
            }
            catch (CryptographicException)
            {
                MostrarEstado(false, "No se pudo desencriptar. Verifica que el archivo y la llave correspondan al mismo par.");
            }
            catch (FormatException)
            {
                MostrarEstado(false, "El archivo de llave no tiene el formato esperado.");
            }
            catch (Exception ex)
            {
                MostrarEstado(false, $"Error inesperado: {ex.Message}");
            }
            finally
            {
                btnDesencriptar.Enabled = true;
                btnDesencriptar.Text = "🔓  Desencriptar archivo";
                Cursor = Cursors.Default;
            }
        }

        /// <summary>
        /// Verifica si el contenido del archivo ya es un JSON válido, lo cual indica
        /// que el archivo ya fue desencriptado previamente.
        /// </summary>
        private static bool EsJsonValido(string ruta)
        {
            try
            {
                string contenido = File.ReadAllText(ruta);

                if (string.IsNullOrWhiteSpace(contenido))
                    return false;

                using var doc = JsonDocument.Parse(contenido);
                return true;
            }
            catch
            {
                return false;
            }
        }

        private void LimpiarCampos()
        {
            txtArchivoEncriptado.Text = string.Empty;
            txtLlavePublica.Text = string.Empty;
        }

        private static (string keyBase64, string nonceBase64) LeerLlaveYNonce(string rutaTxt)
        {
            string? key = null;
            string? nonce = null;

            foreach (var linea in File.ReadAllLines(rutaTxt))
            {
                if (linea.StartsWith("Llave=", StringComparison.OrdinalIgnoreCase))
                    key = linea.Substring("Llave=".Length).Trim();
                else if (linea.StartsWith("Nonce=", StringComparison.OrdinalIgnoreCase))
                    nonce = linea.Substring("Nonce=".Length).Trim();
            }

            if (string.IsNullOrEmpty(key) || string.IsNullOrEmpty(nonce))
                throw new FormatException("No se encontraron las líneas 'Llave=' y 'Nonce=' en el archivo.");

            return (key, nonce);
        }

