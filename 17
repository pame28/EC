using System;
using System.IO;
using System.Text.Json;

namespace EstadosCuentaTC.Desencriptador
{
    /// <summary>
    /// Lógica de negocio separada de la interfaz gráfica: detectar si un
    /// archivo ya está desencriptado y leer la llave/nonce desde el .txt.
    /// Al no depender de WinForms, esta clase se puede probar con pruebas
    /// unitarias sin necesidad de levantar un formulario.
    /// </summary>
    internal static class DesencriptadorService
    {
        /// <summary>
        /// Verifica si el contenido del archivo ya es un JSON válido, lo cual
        /// indica que el archivo ya fue desencriptado previamente.
        /// </summary>
        public static bool EsJsonValido(string ruta)
        {
            try
            {
                string contenido = File.ReadAllText(ruta);

                if (string.IsNullOrWhiteSpace(contenido))
                    return false;

                using var doc = JsonDocument.Parse(contenido);
                return true;
            }
            catch
            {
                return false;
            }
        }

        /// <summary>
        /// Lee las líneas "Llave=" y "Nonce=" del archivo de llave.
        /// </summary>
        public static (string keyBase64, string nonceBase64) LeerLlaveYNonce(string rutaTxt)
        {
            string? key = null;
            string? nonce = null;

            foreach (var linea in File.ReadAllLines(rutaTxt))
            {
                if (linea.StartsWith("Llave=", StringComparison.OrdinalIgnoreCase))
                    key = linea.Substring("Llave=".Length).Trim();
                else if (linea.StartsWith("Nonce=", StringComparison.OrdinalIgnoreCase))
                    nonce = linea.Substring("Nonce=".Length).Trim();
            }

            if (string.IsNullOrEmpty(key) || string.IsNullOrEmpty(nonce))
                throw new FormatException("No se encontraron las líneas 'Llave=' y 'Nonce=' en el archivo.");

            return (key, nonce);
        }
    }
}



















