                // sin romper la app.
            }
        }

        /// <summary>
        /// Crea un "campo de texto" con look moderno: sin el borde clásico de
        /// Windows, fondo gris muy claro y una línea de acento abajo. Se
        /// implementa con un Panel (que sí respeta la altura que le pongas)
        /// conteniendo un TextBox sin borde propio, porque un TextBox de una
        /// sola línea IGNORA cualquier Height que se le asigne.
        /// </summary>
        private (Panel contenedor, TextBox campo) CrearCampoTexto(int left, int top, int width)
        {
            var contenedor = new Panel
            {
                Left = left,
                Top = top,
                Width = width,
                Height = Theme.AltoCampoTexto,
                BackColor = Theme.CampoFondo
            };

            var campo = new TextBox
            {
                Left = 14,
                Width = width - 28,
                Font = new Font("Segoe UI", 10f),
                BackColor = Theme.CampoFondo,
                ForeColor = Theme.Header,
                BorderStyle = BorderStyle.None,
            };
            campo.Top = (contenedor.Height - campo.Height) / 2;
            campo.TextChanged += (s, e) => OcultarEstado();

            contenedor.Controls.Add(campo);

            // Borde muy sutil alrededor + línea de acento abajo (look "input" moderno,
            // sin esquinas redondas).
            contenedor.Paint += (s, e) =>
            {
                using var lapizBorde = new Pen(Theme.CampoBorde, 1);
                e.Graphics.DrawRectangle(lapizBorde, 0, 0, contenedor.Width - 1, contenedor.Height - 1);

                using var lapizAcento = new Pen(Theme.Accento, 2);
                e.Graphics.DrawLine(lapizAcento, 1, contenedor.Height - 1, contenedor.Width - 1, contenedor.Height - 1);
            };

            return (contenedor, campo);
        }

        /// <summary>
        /// Botón "Examinar..." con look moderno: sin borde, fondo con un tinte
        /// claro del color de acento (en vez de blanco + borde), y un tono más
        /// oscuro al pasar el mouse / al hacer clic.
        /// </summary>
        private Button CrearBoton(string texto, int left, int top, int width)
        {
            var boton = new Button
            {
                Text = texto,
                Left = left,
                Top = top,
                Width = width,
                Height = Theme.AltoBotonExaminar,
                Font = new Font("Segoe UI", 9.5f),
                ForeColor = Theme.Accento,
                FlatStyle = FlatStyle.Flat,
                Cursor = Cursors.Hand,
                TextAlign = ContentAlignment.MiddleCenter
            };
            boton.FlatAppearance.BorderSize = 1;
            boton.FlatAppearance.BorderColor = Theme.Gris;
            boton.FlatAppearance.MouseOverBackColor = Theme.BotonExaminarHover;
            boton.FlatAppearance.MouseDownBackColor = Theme.BotonExaminarPresionado;
            return boton;
        }
    }
