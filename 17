AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	
	
	SET NOCOUNT ON;
	declare @identity int

	--Recostrucción de los indices
	insert into BitacoraProcesos values ('Recostrucción de Indices',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_RebuildIndex

	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity

	--Actualizar tipo de Actualización de Oficiales de recuperación
	insert into BitacoraProcesos values ('Actualización de oficiales',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_ActualizarOficiales

	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity

	--Actualización de funcionarios de recuperación localmente del proceso AS400
	insert into BitacoraProcesos values ('Actualización de funcionarios proceso AS400',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_procActualizaFuncionariosLocalmente

	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity
		
	--Actualizar las zonas de Prestamos y Sobregiros.
	insert into BitacoraProcesos values ('Actualización de zonas',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_ActualizarZonas

	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity
	
	--Proceso de carga a historico de cobranzas cargas SaldoDeProductos y ClientesMora 
	insert into BitacoraProcesos values ('Cargas al Historial Cobranza',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_cargasHistorialCobranza

	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity
	
	--Proceso evaluación de cumplimiento de promesas de pago y proxima fecha de ejecucion de clientes
	insert into BitacoraProcesos values ('Actualización Automatica Promesas Pago ',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_ActulizacionAutomaticaPromesasPago

	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity

	--Actualización de etapa, flujo, dias de mora, de cliente
	insert into BitacoraProcesos values ('Actualización Automatica Clientes Etapas',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_ActulizacionAutomaticaClientesEtapas

	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity

	--Actualización de saldo contable a clientes
	insert into BitacoraProcesos values ('Actualización Automatica Saldo Contable Clientes',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_ActualizaSaldoContableClientes
	
	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity

	--asignación de clientes a colas principales 
	insert into BitacoraProcesos values ('Actualización Automatica Colas',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_ActulizacionAutomaticaColas
	
	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity

	--asignación de clientes de colas de trabajo a cobradores 
	insert into BitacoraProcesos values ('Actualización Automatica Cobradores ',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_ActulizacionAutomaticaCobradores
	
	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity
	
	--asignación de clientes por oficial asignado a cobradores 
	insert into BitacoraProcesos values ('Actualización Fija Cobradores ',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_ActulizacionFijaCobradores
	
	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity
	
	--Gestores en colas de Trabajo
	insert into BitacoraProcesos values ('Actualización de Gestores a clientes ',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_procGestoresColas
	
	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity
	
	---Actualización los clientes reinsidentes en mora en el Historico cobranzas BP 
	insert into BitacoraProcesos values ('Actualización Clientes ReinsidentesMora',getdate(),getdate()-1)
	set @identity = @@identity

	exec usp_ActulizacionClientesReinsidentesMora

	update BitacoraProcesos set biFechaFinal = getdate()
	where idBitacora = @identity

END




