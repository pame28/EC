USE [EstadosCuentaJSONProcesador]
GO

-- Permiso para ejecutar el SP
GRANT EXECUTE ON dbo.usp_ObtenerLlaveEncripta TO [app_estadosCuenta];
GO

-- Permiso para que el SP pueda abrir la symmetric key usando
-- el certificado (esto es lo que faltaba).
GRANT CONTROL ON CERTIFICATE::CertEstadosCuentaTC TO [app_estadosCuenta];
GO

-- Permiso adicional: para abrir la symmetric key, el usuario
-- tambien necesita VIEW DEFINITION sobre la key misma (no
-- solo sobre el certificado que la protege).
GRANT VIEW DEFINITION ON SYMMETRIC KEY::SK_LlaveEncriptaTC TO [app_estadosCuenta];
GO