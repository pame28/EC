        // ── Sección Detalle ───────────────────────────────────────────────────

        private static void EscribirDetalle(Utf8JsonWriter w, List<DetalleDto> movs)
        {
            w.WriteStartArray();

            foreach (var m in movs.OrderBy(x => x.Fecha_Consumo))
            {
                w.WriteStartObject();
                w.WriteString("Fecha_Consumo", m.Fecha_Consumo?.ToString("dd/MM/yyyy") ?? "");
                w.WriteNumber("Tipo_Reg", 1);
                w.WriteString("Descripcion_Mov", m.Descripcion_Mov.Trim());
                w.WriteNumber("DebitosMN", R2(m.Moneda_Mov == "HN" && m.TipoMovimiento == "D" ? m.Monto_Mov : 0));
                w.WriteNumber("CreditosMN", R2(m.Moneda_Mov == "HN" && m.TipoMovimiento == "C" ? m.Monto_Mov : 0));
                w.WriteNumber("DebitosME", R2(m.Moneda_Mov == "DO" && m.TipoMovimiento == "D" ? m.Monto_Mov : 0));
                w.WriteNumber("CreditosME", R2(m.Moneda_Mov == "DO" && m.TipoMovimiento == "C" ? m.Monto_Mov : 0));
                w.WriteEndObject();
            }

            w.WriteStartObject();
            w.WriteString("Fecha_Consumo", "");
            w.WriteNumber("Tipo_Reg", 2);
            w.WriteString("Descripcion_Mov", "Subtotal");
            w.WriteNumber("DebitosMN", R2(movs.Where(x => x.Moneda_Mov == "HN" && x.TipoMovimiento == "D").Sum(x => x.Monto_Mov)));
            w.WriteNumber("CreditosMN", R2(movs.Where(x => x.Moneda_Mov == "HN" && x.TipoMovimiento == "C").Sum(x => x.Monto_Mov)));
            w.WriteNumber("DebitosME", R2(movs.Where(x => x.Moneda_Mov == "DO" && x.TipoMovimiento == "D").Sum(x => x.Monto_Mov)));
