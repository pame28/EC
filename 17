            ctrl2 = GridGarantias.FindEditFormTemplateControl("spinNumGarantia");
            ctrl3 = GridGarantias.FindEditFormTemplateControl("ASPxMemoDescripcionGarantia");

            string NumGarantia = null;
            if ((ctrl2 as ASPxSpinEdit).Value != null)
            {
                NumGarantia = (ctrl2 as ASPxSpinEdit).Value.ToString();
                
                SQLSrv query = new SQLSrv(Properties.Settings.Default.DBGestorBP, "usp_CrearGarantiaPlantilla");
                                DataTable dt = new DataTable();

                query.Parametros.Add(new SqlParameter("@CodigoCrediticio", codigo));
                query.Parametros.Add(new SqlParameter("@idSolicitud", Session["idSolicitud"]));
                query.Parametros.Add(new SqlParameter("@numgarantia", NumGarantia));
                query.Parametros.Add(new SqlParameter("@accion", "1"));

                dt = query.getDataTableWithParameters();

                if (query.Success)
                {
                    if (dt.Rows.Count > 0)
                    {
                        (ctrl3 as ASPxMemo).Text = ((!string.IsNullOrEmpty(dt.Rows[0][0].ToString())) ? dt.Rows[0][0].ToString() : "");
