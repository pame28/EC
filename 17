					END
					--TDC
					WHEN sp.salTipoProducto = 'TDC'  THEN
							sp.salTotalConsumoTC
							+sp.salSaldoIntraTC
							+sp.salSaldoExtraTC					
	            END
	            																														AS saldoContable	                         
	             /***********************************************************************************************/
				--,sp.salMontoCancelacion																								AS cancFecha
				,CASE WHEN sp.salTipoProducto='TDC' THEN 
							(sp.salTotalConsumoTC
