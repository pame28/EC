        {
            _sql = sql;
        }


        public (string tarjeta, string json)? ProcesarSiguiente()
        {
            using var conn = _sql.GetConnection();

            using var cmd = new SqlCommand("usp_ProcesarSiguienteEstadoCuenta", conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            using var reader = cmd.ExecuteReader();

            if (!reader.Read())
                return null;

            return (

        reader["NoTarjeta"]?.ToString() ?? string.Empty,
        reader["JsonEstadoCuenta"]?.ToString() ?? string.Empty

            );
        }

        public LoteDatosDto? ObtenerLote(int workerId)
        {
            using var conn = _sql.GetConnection();
            using var cmd = new SqlCommand("usp_EstadoCuentaJsonMasivo", conn)
            {
                CommandType = CommandType.StoredProcedure,
                CommandTimeout = 0
            };

            cmd.Parameters.AddWithValue("@WorkerId", workerId);

            if (conn.State != ConnectionState.Open)
                conn.Open();

            using var reader = cmd.ExecuteReader();

            // ── RS1: Encabezados ─────────────────────────────────────────────
            // Si el SP devuelve la señal de fin (col "Resultado") → bandeja vacía
            if (reader.FieldCount == 1 && reader.GetName(0) == "Resultado")
                return null;

            var encabezados = new List<EncabezadoDto>();
            int numeroLote = 0;

            while (reader.Read())
            {
                var enc = MapEncabezado(reader);
                encabezados.Add(enc);

                // El número de lote es el mismo para todos los registros del RS1;
                // se toma del primero y se propaga al LoteDatosDto.
                if (numeroLote == 0)
                    numeroLote = enc.NumeroLote;
            }

            if (encabezados.Count == 0)
                return null;

            // ── RS2: Detalle ─────────────────────────────────────────────────
            var detalles = new List<DetalleDto>();
            reader.NextResult();

            while (reader.Read())
                detalles.Add(MapDetalle(reader));

            // ── RS3: Financiamientos ─────────────────────────────────────────
            var financiamientos = new List<FinanciamientoDto>();
            reader.NextResult();

            while (reader.Read())
                financiamientos.Add(MapFinanciamiento(reader));

            // ── RS4: Tarjetas del lote ───────────────────────────────────────
            var tarjetas = new List<string>();
            reader.NextResult();

            while (reader.Read())
                tarjetas.Add(reader.GetString(0));

            return new LoteDatosDto
            {
                Encabezados = encabezados,
                Detalles = detalles,
                Financiamientos = financiamientos,
                Tarjetas = tarjetas,
                NumeroLote = numeroLote
            };
        }


        public void ReiniciarControlLote(DateTime fechaCorte)
        {
            using var conn = _sql.GetConnection();
            using var cmd = new SqlCommand("usp_ReiniciarControlLote", conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            cmd.Parameters.AddWithValue("@FechaCorte", fechaCorte.Date);

            if (conn.State != ConnectionState.Open)
                conn.Open();

            cmd.ExecuteNonQuery();
        }

        // ── Mappers ──────────────────────────────────────────────────────────

