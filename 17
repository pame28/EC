			update [dbo].[ParametrosCorte] set Estado=0 where Id=@UltimoRegistro;
			--Insertar la nueva fecha activa
			insert into [dbo].[ParametrosCorte] (FechaCorte, Estado) values (CONVERT(date, @FechaCorteNueva), 1);

END

