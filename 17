SELECT                                          
TRANSA.TRXCOD COD_TRX, TRANSA.TRXDES DESCRI_TRX,
TRANSA. TRXOEM GRUPO,                           
TRANSA. TRXFLG VER_EDO_CTA,                     
IFNULL(MOTI.CDCODMOTI, 0) COD_MOTIVO,           
IFNULL(MOTI.CDDESMOTI, '') DESCRIMOTIVO         
FROM TCATV3DAT.TCTRX TRANSA                     
LEFT JOIN TCATV3DAT.TCMOTTRX MOTR               
 ON MOTR.TRXCOD = TRANSA.TRXCOD                 
LEFT JOIN TCATV3DAT.TCMOTICD MOTI               
 ON MOTR.CDCODMOTI = MOTI.CDCODMOTI             
ORDER BY 1