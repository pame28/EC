CREATE VIEW [dbo].[uvw_ClientesNuevos]
AS

WITH ClientesNuevos AS (
                          SELECT [cliCif],
                                 [cliIdentidad],
                                 [cliTipoDocumento],
                                 [cliTipoPersona],
                                 [cliNombre],
                                 [cliNacionalidad],
                                 [cliTipoCliente],
                                 [cliZona],
                                 [cliTelefono1],
                                 [cliTelefono2],
                                 [cliTelefono3],
                                 [CliFax],
                                 [cliCorreo],
                                 [cliDireccion1],
                                 [cliDireccion2],
                                 [cliFechaUltimaActualizacion],
                                 [cliOficialNegocios],
                                 [cliOficialAsignado],
                                 [cliOficialAsignadoICBS],
                                 [cliFlujoCobranza],
                                 [cliEtapaCobranza],
                                 [cliColaCobranza],
                                 [cliDiaMora],
                                 [cliPromesaIncumplida],
                                 [cliFechaUltimaGestion],
                                 [cliCobradorAsi],
                                 [cliTipoAsignacionEtapa]
                          FROM   [dbo].[uvw_Clientes] c WITH(NOLOCK)
                          WHERE  NOT EXISTS(
                                     SELECT 1
                                     FROM   Clientes cl WITH(NOLOCK)
                                     WHERE  cl.cliCif = c.cliCif
                                            OR  cl.cliIdentidad = c.cliIdentidad
                                 )
                      )
,ClientesNuevosDepurados AS (
                                SELECT [cliCif],
                                       [cliIdentidad],
                                       [cliTipoDocumento],
                                       [cliTipoPersona],
                                       [cliNombre],
                                       [cliNacionalidad],
                                       [cliTipoCliente],
                                       [cliZona],
                                       [cliTelefono1],
                                       [cliTelefono2],
                                       [cliTelefono3],
                                       [CliFax],
                                       [cliCorreo],
                                       [cliDireccion1],
                                       [cliDireccion2],
                                       [cliFechaUltimaActualizacion],
                                       [cliOficialNegocios],
                                       [cliOficialAsignado],
                                       [cliOficialAsignadoICBS],
                                       [cliFlujoCobranza],
                                       [cliEtapaCobranza],
                                       [cliColaCobranza],
                                       [cliDiaMora],
                                       [cliPromesaIncumplida],
                                       [cliFechaUltimaGestion],
                                       [cliCobradorAsi],
                                       [cliTipoAsignacionEtapa]
                                FROM   ClientesNuevos cn                               
                                WHERE  NOT EXISTS (
                                           SELECT 1
                                           FROM   ClientesNuevos c
                                           WHERE  c.cliIdentidad = cn.cliCif
                                       )
                                      -- AND LEN(cn.cliCif) <= 12
                            )  
   
   SELECT [cliCif],
          [cliIdentidad],
          [cliTipoDocumento],
          [cliTipoPersona],
          [cliNombre],
          [cliNacionalidad],
          [cliTipoCliente],
          [cliZona],
          [cliTelefono1],
          [cliTelefono2],
          [cliTelefono3],
          [CliFax],
          [cliCorreo],
          [cliDireccion1],
          [cliDireccion2],
          [cliFechaUltimaActualizacion],
          [cliOficialNegocios],
          [cliOficialAsignado],
          [cliOficialAsignadoICBS],
          [cliFlujoCobranza],
          [cliEtapaCobranza],
          [cliColaCobranza],
          [cliDiaMora],
          [cliPromesaIncumplida],
          [cliFechaUltimaGestion],
          [cliCobradorAsi],
          [cliTipoAsignacionEtapa]
   FROM   ClientesNuevosDepurados cnd
    INNER JOIN BandejaMaestroClientes bmc
                               ON cnd.cliCif=bmc.CIF AND cnd.cliIdentidad=bmc.Identidad




