    /// La construcción visual vive en MainForm.UI.cs y la lógica pura de
    /// negocio vive en DesencriptadorService.
    /// </summary>
    public partial class MainForm : Form
    {
        private TextBox txtArchivoEncriptado = null!;
        private TextBox txtLlavePublica = null!;
