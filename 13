SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO

ALTER PROCEDURE [dbo].[usp_ProcesarLoteEstadosCuenta]
    @Cantidad INT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @Resultados TABLE (
        NoTarjeta VARCHAR(16),
        JsonEstadoCuenta VARCHAR(MAX)
    );

    DECLARE @Lote INT;

    BEGIN TRY
        BEGIN TRAN;

        -- Secuencia de lote
        SELECT @Lote = NEXT VALUE FOR dbo.Seq_LoteEstadoCuenta;

        -- Obtener lote
        ;WITH CTE AS (
            SELECT TOP (@Cantidad) *
            FROM BandejaEstadoCuenta WITH (UPDLOCK, READPAST)
            WHERE Estado = 2
            ORDER BY No_Tarjeta
        )
        SELECT * INTO #Lote FROM CTE;

        IF NOT EXISTS (SELECT 1 FROM #Lote)
        BEGIN
            ROLLBACK;
            RETURN;
        END

        DECLARE @NoTarjeta VARCHAR(16);
        DECLARE @Json NVARCHAR(MAX);

        DECLARE cursor_lote CURSOR FOR
        SELECT No_Tarjeta FROM #Lote;

        OPEN cursor_lote;
        FETCH NEXT FROM cursor_lote INTO @NoTarjeta;

        WHILE @@FETCH_STATUS = 0
        BEGIN
            -- Ejecutar SP individual
            SELECT @Json = NULL;

            -- Capturar resultado correctamente
            SELECT @Json = JsonEstadoCuenta
            FROM (
                EXEC dbo.usp_SBEstadoCuentaJson @NoTarjeta
            ) AS X;

            -- Fallback por seguridad
            IF @Json IS NULL
                SET @Json = '{}';

            -- Insertar resultado
            INSERT INTO @Resultados (NoTarjeta, JsonEstadoCuenta)
            VALUES (@NoTarjeta, @Json);

            FETCH NEXT FROM cursor_lote INTO @NoTarjeta;
        END

        CLOSE cursor_lote;
        DEALLOCATE cursor_lote;

        -- Marcar como procesado
        UPDATE b
        SET Estado = 1
        FROM BandejaEstadoCuenta b
        INNER JOIN #Lote l
            ON b.No_Tarjeta = l.No_Tarjeta
            AND b.No_Cuenta = l.No_Cuenta;

        -- Insertar histórico con lote secuencial
        INSERT INTO HistoricoMaestroEstadosCuentaJSON
        (
            FechaCorte,
            NoTarjeta,
            NoCuenta,
            NoCuentaVASA,
            Nombre,
            Correo,
            Origen,
            Lote,
            Procesado,
            FechaEjecucion
        )
        SELECT 
            Fecha_Corte,
            No_Tarjeta,
            No_Cuenta,
            No_Cuenta_VASA,
            Nombre,
            Correo,
            Origen,
            @Lote,
            1,
            GETDATE()
        FROM #Lote;

        COMMIT;

        -- Resultado final
        SELECT 
            NoTarjeta,
            JsonEstadoCuenta
        FROM @Resultados;

    END TRY
    BEGIN CATCH
        ROLLBACK;
        THROW;
    END CATCH
END
GO