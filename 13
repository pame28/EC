ALTER PROCEDURE [dbo].[usp_ProcesarLoteEstadosCuenta]
    @Cantidad INT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @Lote TABLE (
        No_Tarjeta VARCHAR(16),
        No_Cuenta VARCHAR(20),
        Fecha_Corte DATE,
        No_Cuenta_VASA VARCHAR(20),
        Nombre VARCHAR(200),
        Correo VARCHAR(200),
        Origen VARCHAR(50)
    );

    --  Tomar lote SIN OFFSET
    INSERT INTO @Lote
    SELECT TOP (@Cantidad)
        No_Tarjeta,
        No_Cuenta,
        Fecha_Corte,
        No_Cuenta_VASA,
        Nombre,
        Correo,
        Origen
    FROM BandejaEstadoCuenta WITH (UPDLOCK, READPAST)
    WHERE Estado = 2
    ORDER BY No_Tarjeta;

    IF NOT EXISTS (SELECT 1 FROM @Lote)
        RETURN;

    DECLARE @Resultados TABLE (
        NoTarjeta VARCHAR(16),
        JsonEstadoCuenta NVARCHAR(MAX)
    );

    DECLARE @NoTarjeta VARCHAR(16);

    DECLARE cursor_lote CURSOR FOR
    SELECT No_Tarjeta FROM @Lote;

    OPEN cursor_lote;
    FETCH NEXT FROM cursor_lote INTO @NoTarjeta;

    WHILE @@FETCH_STATUS = 0
    BEGIN
        DECLARE @Json TABLE (JsonEstadoCuenta NVARCHAR(MAX));

        INSERT INTO @Json
        EXEC dbo.usp_SBEstadoCuentaJson @NoTarjeta;

        INSERT INTO @Resultados
        SELECT 
            @NoTarjeta,
            ISNULL((SELECT TOP 1 JsonEstadoCuenta FROM @Json), '{}');

        FETCH NEXT FROM cursor_lote INTO @NoTarjeta;
    END

    CLOSE cursor_lote;
    DEALLOCATE cursor_lote;

    --  Marcar procesados
    UPDATE b
    SET Estado = 1
    FROM BandejaEstadoCuenta b
    INNER JOIN @Lote l
        ON b.No_Tarjeta = l.No_Tarjeta
        AND b.No_Cuenta = l.No_Cuenta;

    --  Histórico (lote simple por ejecución C#)
    INSERT INTO HistoricoMaestroEstadosCuentaJSON
    (
        FechaCorte,
        NoTarjeta,
        NoCuenta,
        NoCuentaVASA,
        Nombre,
        Correo,
        Origen,
        Lote,
        Procesado,
        FechaEjecucion
    )
    SELECT 
        Fecha_Corte,
        No_Tarjeta,
        No_Cuenta,
        No_Cuenta_VASA,
        Nombre,
        Correo,
        Origen,
        1,
        1,
        GETDATE()
    FROM @Lote;

    --  devolver resultados
    SELECT * FROM @Resultados;
END


using EstadosCuentaTC.Data;
using EstadosCuentaTC.Dtos;
using Microsoft.Data.SqlClient;
using System;
using System.Collections.Generic;
using System.Data;
using System.Text;

namespace EstadosCuentaTC.Repositories
{
    public class EstadoCuentaRepository
    {
        private readonly SqlExecutor _sql;

        public EstadoCuentaRepository(SqlExecutor sql)
        {
            _sql = sql;
        }


        public (string tarjeta, string json)? ProcesarSiguiente()
        {
            using var conn = _sql.GetConnection();

            using var cmd = new SqlCommand("usp_ProcesarSiguienteEstadoCuenta", conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            using var reader = cmd.ExecuteReader();

            if (!reader.Read())
                return null;

            return (
                reader["NoTarjeta"]?.ToString(),
                reader["JsonEstadoCuenta"]?.ToString()
            );
        }

        public List<(string tarjeta, string json)> ProcesarLote(int cantidad)
        {
            var lista = new List<(string, string)>();

            using var conn = _sql.GetConnection();

            using var cmd = new SqlCommand("usp_ProcesarLoteEstadosCuenta", conn)
            {
                CommandType = CommandType.StoredProcedure,
                CommandTimeout = 0
            };

            cmd.Parameters.AddWithValue("@Cantidad", cantidad);

            using var reader = cmd.ExecuteReader();

            while (reader.Read())
            {
                lista.Add((
                    reader["NoTarjeta"]?.ToString(),
                    reader["JsonEstadoCuenta"]?.ToString()
                ));
            }

            return lista;
        }
    }

}




using EstadosCuentaTC.Repositories;
using Microsoft.Extensions.Logging;
using System;
using System.Collections.Generic;
using System.Text;

namespace EstadosCuentaTC.Services
{
    public class GeneracionLoteService
    {
        private readonly EstadoCuentaRepository _repo;
        private readonly ILogger<GeneracionLoteService> _logger;

        public GeneracionLoteService(EstadoCuentaRepository repo,
            ILogger<GeneracionLoteService> logger)
        {
            _repo = repo;
            _logger = logger;
        }

        public void Ejecutar(string rutaBase, DateTime fechaCorte, int loteSize)
        {
            var ruta = Path.Combine(rutaBase, fechaCorte.ToString("yyyy-MM-dd"));
            Directory.CreateDirectory(ruta);

            var archivoJson = Path.Combine(
                ruta,
                $"Estado_de_cuenta_{fechaCorte:yyyyMMdd}.json"
            );

            using var writer = new StreamWriter(archivoJson, false, Encoding.UTF8);

            writer.Write("{");

            bool primeraVez = true;
            int numeroLote = 1;

            while (true)
            {
                var lote = _repo.ProcesarLote(loteSize);

                if (lote.Count == 0)
                    break;

                foreach (var item in lote)
                {
                    if (!primeraVez)
                        writer.Write(",");

                    writer.Write($"\"{item.tarjeta}\":{item.json}");

                    primeraVez = false;
                }

                _logger.LogInformation(
                    "Lote {lote} procesado: {count}",
                    numeroLote,
                    lote.Count
                );

                numeroLote++;
            }

            writer.Write("}");

            _logger.LogInformation("Fin generación por lote");
        }
    }
}


using EstadosCuentaTC.Dtos;
using EstadosCuentaTC.Repositories;
using Microsoft.Extensions.Logging;
using System;
using System.Collections.Generic;
using System.Text;

namespace EstadosCuentaTC.Services
{
    public class GeneracionEstadoCuentaService
    {
        private readonly GeneracionIndividualService _individualService;
        private readonly ILogger<GeneracionEstadoCuentaService> _logger;
        private readonly ILoggerFactory _loggerFactory;
        private readonly JsonRepository _jsonRepo;
        private readonly EstadoCuentaRepository _repo;

        public GeneracionEstadoCuentaService(
            GeneracionIndividualService individualService,
            JsonRepository jsonRepo,
            EstadoCuentaRepository repo,
            ILogger<GeneracionEstadoCuentaService> logger,
            ILoggerFactory loggerFactory)
        {
            _individualService = individualService;
            _logger = logger;
            _jsonRepo = jsonRepo;
            _repo = repo;
            _loggerFactory = loggerFactory;
        }

        public void Ejecutar(ParametrosGeneracionECDto parametros)
        {
            _logger.LogInformation("FASE 4 - GENERACIÓN ESTADOS DE CUENTA");

            // Paso 3 - generar JSON
            var cantidadGenerada = _jsonRepo.GenerarJson();

            _logger.LogInformation(
                "Registros generados: ",
                cantidadGenerada
            );


            if (parametros.TipoGeneracion == "INDIVIDUAL")
            {
                _logger.LogInformation("Modo INDIVIDUAL");
                _individualService.Ejecutar(parametros.RutaArchivoJson, parametros.FechaCorteProcesar);
            }
            else if (parametros.TipoGeneracion == "LOTE")
            {
                _logger.LogInformation("Modo LOTE");

                var loteLogger = _loggerFactory.CreateLogger<GeneracionLoteService>();
                var loteService = new GeneracionLoteService(_repo, loteLogger);

                loteService.Ejecutar(
                    parametros.RutaArchivoJson,
                    parametros.FechaCorteProcesar,
                    parametros.RegistrosPorLote
                );
            }
            else
            {
                throw new Exception($"TipoGeneracion no válido: {parametros.TipoGeneracion}");
            }
        }
    }
}


