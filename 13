ALTER PROCEDURE [dbo].[usp_GenerarEstadoCuentaJsonMasivo]
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @FechaCorte DATE;

    SELECT TOP 1 @FechaCorte = FechaCorte
    FROM dbo.ParametrosCorte
    WHERE Estado = 1
    ORDER BY FechaCorte DESC;

    SELECT (
        SELECT
            BE.No_Tarjeta AS [key],
            JSON_QUERY(EC.JsonEstadoCuenta) AS [value]
        FROM dbo.BandejaEstadoCuenta BE
        CROSS APPLY (
            SELECT CAST((
                -- 🔥 AQUÍ VA TU MISMO SELECT GRANDE DEL SP
            ) AS NVARCHAR(MAX)) AS JsonEstadoCuenta
        ) EC
        WHERE BE.Estado = 0
        FOR JSON PATH
    ) AS JsonFinal;
END