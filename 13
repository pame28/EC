CREATE PROCEDURE usp_ObtenerTarjetasPendientes
    @Cantidad INT
AS
BEGIN
    SET NOCOUNT ON;

    ;WITH CTE AS
    (
        SELECT TOP (@Cantidad)
            No_Tarjeta
        FROM BandejaEstadoCuenta WITH (ROWLOCK, READPAST)
        WHERE Estado = 0
        ORDER BY No_Tarjeta
    )
    UPDATE CTE
    SET Estado = 2
    OUTPUT inserted.No_Tarjeta;
END