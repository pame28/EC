using EstadosCuentaTC.Repositories;
using Microsoft.Extensions.Logging;
using System;
using System.IO;
using System.Text;
using System.Threading.Tasks;

namespace EstadosCuentaTC.Services
{
    public class GeneracionLoteService
    {
        private readonly EstadoCuentaRepository _repo;
        private readonly ILogger<GeneracionLoteService> _logger;

        // 🔒 LOCK PARA ESCRITURA SEGURA
        private static readonly object _lockFile = new object();

        public GeneracionLoteService(
            EstadoCuentaRepository repo,
            ILogger<GeneracionLoteService> logger)
        {
            _repo = repo;
            _logger = logger;
        }

        public void Ejecutar(string rutaBase, DateTime fechaCorte, int cantidadHilos)
        {
            var ruta = Path.Combine(rutaBase, fechaCorte.ToString("yyyy-MM-dd"));
            Directory.CreateDirectory(ruta);

            var archivoJson = Path.Combine(
                ruta,
                $"Estado_de_cuenta_{fechaCorte:yyyyMMdd}.json"
            );

            // 🔥 Crear archivo vacío
            using (var writer = new StreamWriter(archivoJson, false, Encoding.UTF8))
            {
                writer.Write("{");
            }

            _logger.LogInformation($"Iniciando con {cantidadHilos} hilos...");

            var tareas = new Task[cantidadHilos];

            for (int i = 0; i < cantidadHilos; i++)
            {
                int workerId = i + 1;

                tareas[i] = Task.Run(() =>
                {
                    _logger.LogInformation($"Worker {workerId} iniciado");

                    while (true)
                    {
                        try
                        {
                            // 🔥 EL SP DEBE DEVOLVER JSON POR REGISTRO
                            var json = _repo.EjecutarProcesoMasivo(workerId);

                            if (string.IsNullOrEmpty(json))
                                break;

                            // 🔒 ESCRITURA SEGURA
                            lock (_lockFile)
                            {
                                File.AppendAllText(archivoJson, json + ",");
                            }
                        }
                        catch (Exception ex)
                        {
                            _logger.LogError(ex, $"Error en worker {workerId}");
                            break;
                        }
                    }

                    _logger.LogInformation($"Worker {workerId} finalizado");
                });
            }

            Task.WaitAll(tareas);

            // 🔥 CERRAR JSON CORRECTAMENTE
            lock (_lockFile)
            {
                using (var writer = new StreamWriter(archivoJson, true, Encoding.UTF8))
                {
                    writer.Write("}");
                }
            }

            _logger.LogInformation("Proceso finalizado");
        }
    }
}







public string EjecutarProcesoMasivo(int workerId)
{
    using var cmd = new SqlCommand("usp_SBEstadoCuentaJsonMasivo", _connection)
    {
        CommandType = CommandType.StoredProcedure,
        CommandTimeout = 0
    };

    cmd.Parameters.AddWithValue("@WorkerId", workerId);

    if (_connection.State != ConnectionState.Open)
        _connection.Open();

    var result = cmd.ExecuteScalar();

    return result?.ToString();
}