using EstadosCuentaTC.Data;
using EstadosCuentaTC.Repositories;
using EstadosCuentaTC.Services;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Logging;

var builder = new ConfigurationBuilder()
    .AddJsonFile("appsettings.json", optional: false);

var config = builder.Build();

var connectionString = config.GetConnectionString("DefaultConnection")
    ?? throw new Exception("ConnectionString no configurado");

// 🔹 Logger
var loggerFactory = LoggerFactory.Create(builder =>
{
    builder.AddConsole();
});

// 🔹 Loggers específicos
var loggerEmail = loggerFactory.CreateLogger<EmailRepository>();
var loggerCorreos = loggerFactory.CreateLogger<CorreosService>();
var loggerParam = loggerFactory.CreateLogger<ParametrosGeneracionECService>();
var loggerGeneracion = loggerFactory.CreateLogger<GeneracionEstadoCuentaService>();
var loggerIndividual = loggerFactory.CreateLogger<GeneracionIndividualService>();

// 🔹 Infraestructura
var sql = new SqlExecutor(connectionString);

// 🔹 FASE 1
var prepara = new PreparaDataService(sql);

// 🔹 Repositorios
var configRepo = new ConfigRepository(sql);
var correosRepo = new CorreosRepository(sql);
var emailRepo = new EmailRepository(configRepo, loggerEmail);
var paramRepo = new ParametrosGeneracionECRepository(sql);
var jsonRepo = new JsonRepository(sql);

// 🔹 FASE 2
var correosService = new CorreosService(
    correosRepo,
    emailRepo,
    loggerCorreos
);

// 🔹 FASE 3
var parametrosService = new ParametrosGeneracionECService(
    paramRepo,
    jsonRepo,
    loggerParam
);

// 🔹 FASE 4 (Servicios de generación)
var individualService = new GeneracionIndividualService(
    jsonRepo,
    paramRepo,
    loggerIndividual
);

var generacionService = new GeneracionEstadoCuentaService(
    individualService,
    loggerGeneracion
);

try
{
    Console.WriteLine("========== INICIO PROCESO ==========\n");

    // =========================
    // FASE 1
    // =========================
    Console.WriteLine("FASE 1: PREPARA DATA");
    prepara.Ejecutar();

    // =========================
    // FASE 2
    // =========================
    Console.WriteLine("\nFASE 2: CORREOS NO VALIDOS");
    await correosService.InsertarCorreosNoValidosAsync();

    // =========================
    // FASE 3
    // =========================
    Console.WriteLine("\nFASE 3: OBTENER PARÁMETROS");
    var parametros = parametrosService.ObtenerParametros();

    // =========================
    // FASE 4
    // =========================
    Console.WriteLine("\nFASE 4: GENERACIÓN ESTADOS DE CUENTA");
    generacionService.Ejecutar(parametros);

    Console.WriteLine("\n========== FIN PROCESO ==========");
}
catch (Exception ex)
{
    Console.WriteLine($"ERROR GENERAL: {ex.Message}");
}