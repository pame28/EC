using EstadosCuentaTC.Repositories;
using Microsoft.Extensions.Logging;
using System;
using System.Collections.Generic;
using System.Text;

namespace EstadosCuentaTC.Services
{
    public class GeneracionIndividualService
    {
        private readonly EstadoCuentaRepository _repo;
        private readonly ILogger<GeneracionIndividualService> _logger;

        public GeneracionIndividualService(
            EstadoCuentaRepository repo,
            ILogger<GeneracionIndividualService> logger)
        {
            _repo = repo;
            _logger = logger;
        }

        public void Ejecutar(string rutaBase, DateTime fechaCorte)
        {
            try
            {
                _logger.LogInformation("Inicio Generación Individual");

                var ruta = Path.Combine(rutaBase, fechaCorte.ToString("yyyy-MM-dd"));
                var archivoJson = Path.Combine(ruta, $"Estado_de_cuenta_corte_{fechaCorte.Day}.json");
                var contadorPath = Path.Combine(ruta, "Contador.txt");

                if (!File.Exists(contadorPath))
                    File.WriteAllText(contadorPath, "");

                while (true)
                {
                    var tarjeta = _repo.ObtenerPendiente();

                    if (tarjeta == null)
                        break;

                    var cantidad = _repo.ObtenerCantidadPendiente();

                    var json = _repo.ObtenerJson(tarjeta.NoTarjeta, tarjeta.FechaCorte);

                    if (string.IsNullOrWhiteSpace(json))
                        json = "{}";

                    var tarjetaKey = $"\"{tarjeta.NoTarjeta}\":";

                    var contadorTexto = File.ReadAllText(contadorPath);
                    bool esInicio = string.IsNullOrEmpty(contadorTexto);
                    bool esFinal = cantidad == 1;

                    if (esInicio)
                    {
                        File.AppendAllText(archivoJson, "{");
                        File.WriteAllText(contadorPath, "1");
                    }
                    else
                    {
                        int contador = int.Parse(contadorTexto) + 1;
                        File.WriteAllText(contadorPath, contador.ToString());
                    }

                    if (esFinal)
                    {
                        File.AppendAllText(archivoJson, $"{tarjetaKey}{json}");
                        File.AppendAllText(archivoJson, "}");
                    }
                    else
                    {
                        File.AppendAllText(archivoJson, $"{tarjetaKey}{json},");
                    }

                    _repo.MarcarProcesado(tarjeta.NoTarjeta, tarjeta.NoCuenta);

                    _repo.InsertarHistorico(
                       DateTime.Parse( tarjeta.FechaCorte),
                        tarjeta.NoTarjeta,
                        tarjeta.NoCuenta,
                        tarjeta.NoCuentaVASA,
                        tarjeta.Nombre,
                        tarjeta.Correo,
                        tarjeta.Origen
                    );

                    _logger.LogInformation("Procesado: {tarjeta}", tarjeta.NoTarjeta);
                }

                _logger.LogInformation("Fin Generación Individual");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en Generación Individual");
                throw;
            }
        }
    }
}






using EstadosCuentaTC.Dtos;
using EstadosCuentaTC.Repositories;
using Microsoft.Extensions.Logging;
using System;
using System.Collections.Generic;
using System.Text;

namespace EstadosCuentaTC.Services
{
    public class GeneracionEstadoCuentaService
    {
        private readonly GeneracionIndividualService _individualService;
        private readonly ILogger<GeneracionEstadoCuentaService> _logger;
        private readonly JsonRepository _jsonRepo;

        public GeneracionEstadoCuentaService(
            GeneracionIndividualService individualService,
            JsonRepository jsonRepo,
            ILogger<GeneracionEstadoCuentaService> logger)
        {
            _individualService = individualService;
            _logger = logger;
            _jsonRepo = jsonRepo;
        }

        public void Ejecutar(ParametrosGeneracionECDto parametros)
        {
            _logger.LogInformation("FASE 4 - GENERACIÓN ESTADOS DE CUENTA");

            // Paso 3 - generar JSON
            var cantidadGenerada = _jsonRepo.GenerarJson();

            _logger.LogInformation(
                "Registros generados: {count}",
                cantidadGenerada
            );


            if (parametros.TipoGeneracion == "INDIVIDUAL")
            {
                _logger.LogInformation("Modo INDIVIDUAL");
                _individualService.Ejecutar(parametros.RutaArchivoJson, parametros.FechaCorteProcesar);
            }
            else if (parametros.TipoGeneracion == "LOTE")
            {
                _logger.LogInformation("Modo LOTE (pendiente)");
                throw new NotImplementedException("LOTE aún no implementado");
            }
            else
            {
                throw new Exception($"TipoGeneracion no válido: {parametros.TipoGeneracion}");
            }
        }
    }
}


