DECLARE cursor_lote CURSOR FOR
SELECT No_Tarjeta FROM @Lote;

OPEN cursor_lote;
FETCH NEXT FROM cursor_lote INTO @NoTarjeta;

WHILE @@FETCH_STATUS = 0
BEGIN
    BEGIN TRY
        DECLARE @Json TABLE (JsonEstadoCuenta NVARCHAR(MAX));

        INSERT INTO @Json
        EXEC dbo.usp_SBEstadoCuentaJson @NoTarjeta;

        INSERT INTO @Resultados
        SELECT 
            @NoTarjeta,
            ISNULL((SELECT TOP 1 JsonEstadoCuenta FROM @Json), '{}');

    END TRY
    BEGIN CATCH

        INSERT INTO @Resultados
        VALUES (@NoTarjeta, '{}');

        INSERT INTO LogErroresEstadosCuenta (
            NoTarjeta,
            ErrorMensaje
        )
        VALUES (
            @NoTarjeta,
            ERROR_MESSAGE()
        );

        UPDATE BandejaEstadoCuenta
        SET 
            Estado = 3,
            Intentos = ISNULL(Intentos,0) + 1,
            UltimoError = ERROR_MESSAGE()
        WHERE No_Tarjeta = @NoTarjeta;

    END CATCH;

    FETCH NEXT FROM cursor_lote INTO @NoTarjeta;
END

CLOSE cursor_lote;
DEALLOCATE cursor_lote;








CREATE TABLE LogErroresEstadosCuenta (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    NoTarjeta VARCHAR(16),
    ErrorMensaje VARCHAR(MAX),
    Fecha DATETIME DEFAULT GETDATE()
);







ALTER TABLE BandejaEstadoCuenta
ADD Intentos INT DEFAULT 0,
    UltimoError VARCHAR(MAX);
