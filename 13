public void Ejecutar(GeneracionLoteRequest request)
{
    var ruta = Path.Combine(
        request.RutaBase,
        request.FechaCorte.ToString("yyyy-MM-dd")
    );

    Directory.CreateDirectory(ruta);

    var archivoJson = Path.Combine(
        ruta,
        $"Estado_de_cuenta_{request.FechaCorte:yyyyMMdd}.json"
    );

    using var writer = new StreamWriter(archivoJson, false, Encoding.UTF8);

    writer.Write("{");

    bool primeraVez = true;
    int numeroLote = 1;

    while (true)
    {
        var inicioLote = DateTime.Now;

        var tarjetas = _repo.ObtenerTarjetasPendientes(request.RegistrosPorLote);

        if (tarjetas.Count == 0)
        {
            _logger.LogInformation("No hay más registros");
            break;
        }

        var opciones = new ParallelOptions
        {
            MaxDegreeOfParallelism = request.CantidadHilos
        };

        var resultados = new ConcurrentBag<string>();

        Parallel.ForEach(tarjetas, opciones, tarjeta =>
        {
            try
            {
                var resultado = _repo.ProcesarPorTarjeta(tarjeta);

                var json = resultado?.json ?? "{}";

                if (string.IsNullOrWhiteSpace(json) || json == "{}")
                    throw new Exception("JSON vacío");

                var linea = $"\"{tarjeta}\":{json}";

                resultados.Add(linea);

                _repo.MarcarComoProcesado(tarjeta);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, $"Error con tarjeta {tarjeta}");
                _repo.MarcarComoError(tarjeta, ex.Message);
            }
        });

        foreach (var linea in resultados)
        {
            if (!primeraVez)
                writer.Write(",");

            writer.Write(linea);
            primeraVez = false;
        }

        var duracion = DateTime.Now - inicioLote;

        _logger.LogInformation(
            $"Lote {numeroLote} | Registros: {resultados.Count} | Tiempo: {duracion.TotalSeconds}s"
        );

        numeroLote++;
    }

    writer.Write("}");

    _logger.LogInformation($"Archivo generado en: {archivoJson}");
    _logger.LogInformation("Proceso finalizado");
}








