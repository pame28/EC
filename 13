CREATE INDEX IX_BandejaEstadoCuenta_Procesado
ON dbo.BandejaEstadoCuenta (Procesado)



public (string tarjeta, string json)? ProcesarSiguiente()
{
    using var conn = _sql.GetConnection();

    using var cmd = new SqlCommand("usp_ProcesarSiguienteEstadoCuenta", conn)
    {
        CommandType = CommandType.StoredProcedure
    };

    using var reader = cmd.ExecuteReader();

    if (!reader.Read())
        return null;

    return (
        reader["NoTarjeta"]?.ToString(),
        reader["JsonEstadoCuenta"]?.ToString()
    );
}









while (true)
{
    var resultado = _repo.ProcesarSiguiente();

    if (resultado == null)
        break;

    var (tarjeta, json) = resultado.Value;

    if (string.IsNullOrWhiteSpace(json))
        json = "{}";

    var tarjetaKey = $"\"{tarjeta}\":";

    var contadorTexto = File.ReadAllText(contadorPath);
    int contador = int.Parse(contadorTexto);

    if (contador == 0)
    {
        File.AppendAllText(archivoJson, "{");
    }
    else
    {
        File.AppendAllText(archivoJson, ",");
    }

    contador++;
    File.WriteAllText(contadorPath, contador.ToString());

    File.AppendAllText(archivoJson, $"{tarjetaKey}{json}");

    _logger.LogInformation("Procesado: {tarjeta}", tarjeta);
}

// cerrar JSON
File.AppendAllText(archivoJson, "}");











