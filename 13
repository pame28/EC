ALTER PROCEDURE [dbo].[usp_LlenarBandejaEstadoCuenta]
(
    @Tipo VARCHAR(20)
)
AS
BEGIN
    SET NOCOUNT ON;

    IF(@Tipo = 'Limpiar')
    BEGIN
        TRUNCATE TABLE dbo.BandejaEstadoCuenta;
        RETURN;
    END

    IF(@Tipo = 'Llenar')
    BEGIN
        DECLARE @Cantidad INT;
        DECLARE @FechaCorte DATE;

        SELECT @Cantidad = COUNT(*) 
        FROM dbo.BandejaEstadoCuenta;

        SELECT @FechaCorte = FechaCorte
        FROM dbo.ParametrosCorte
        WHERE Estado = 1;

        IF (@Cantidad < 1)
        BEGIN
            INSERT INTO dbo.BandejaEstadoCuenta
            (
               [Fecha_Corte]
      ,[No_Tarjeta]
      ,[No_Cuenta]
      ,[No_Cuenta_VASA]
      ,[Nombre]
      ,[Correo]
      ,[Origen]
      ,[Estado]
            )
            SELECT
                h.Fecha_Corte,
                TRIM(h.No_Tarjeta),
                TRIM(h.No_Cuenta),
				TRIM(h.NoCuentaClaro) AS No_Cuenta_VASA,
				TRIM(h.Nombre_TH_Tit) AS Nombre,
                TRIM(h.Correo),
				TRIM(h.Origen),
                2
            FROM dbo.BandejaEncabezado h
            WHERE
                h.Fecha_Corte = @FechaCorte
				AND h.origen IN (SELECT Origen FROM dbo.ParametrosOrigenes WHERE Estado = 1)
                AND h.Correo <> ''
                AND h.Correo NOT IN
                (
                    SELECT Correo
                    FROM dbo.CorreosNoValidos
                    WHERE Estado = 1
                )
                AND
                (
                    EXISTS
                    (
                        SELECT 1
                        FROM dbo.BandejaDetalle d
                        WHERE d.EC_DetalleNo_Cuenta = h.No_Cuenta
						--AND d.EC_DetalleNo_Tarjeta = h.No_Tarjeta
                        AND d.Fecha_Corte = h.Fecha_Corte
                    )
                    OR h.Pago_Contado_MN <> 0
                    OR h.Pago_Contado_ME <> 0
                );
        END
    END
END
