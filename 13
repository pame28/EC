using System;
using System.IO;
using System.Security.Cryptography;

namespace EstadosCuentaTC.Security
{
    public static class EncriptacionAES
    {
        public static void EncriptarArchivo(string rutaEntrada, string rutaSalida, string keyString, string llaveiv)
        {
            byte[] key = Convert.FromBase64String(keyString);
            byte[] iv = Convert.FromBase64String(llaveiv);

            using (Aes aesAlg = Aes.Create())
            {
                aesAlg.Key = key;
                aesAlg.IV = iv;
                aesAlg.Mode = CipherMode.CBC;
                aesAlg.Padding = PaddingMode.PKCS7;

                using (FileStream fsEntrada = new FileStream(rutaEntrada, FileMode.Open, FileAccess.Read))
                using (FileStream fsSalida = new FileStream(rutaSalida, FileMode.Create, FileAccess.Write))
                using (CryptoStream cs = new CryptoStream(fsSalida, aesAlg.CreateEncryptor(), CryptoStreamMode.Write))
                {
                    fsEntrada.CopyTo(cs);
                }
            }
        }
    }
}













using EstadosCuentaTC.Security;
using Microsoft.Extensions.Logging;
using System;
using System.IO;
using System.Security.Cryptography;

namespace EstadosCuentaTC.Services
{
    public class EncriptacionService
    {
        private readonly ILogger<EncriptacionService> _logger;

        public EncriptacionService(ILogger<EncriptacionService> logger)
        {
            _logger = logger;
        }

        public void Ejecutar(string rutaJson, string nombreJson, DateTime fechaCorte, string keyString)
        {
            try
            {
                _logger.LogInformation("INICIO ENCRIPTACIÓN");

                string rutaFinal = Path.Combine(rutaJson, fechaCorte.ToString("yyyy-MM-dd"));
                string pathJson = Path.Combine(rutaFinal, nombreJson);

                if (!File.Exists(pathJson))
                    throw new FileNotFoundException($"No existe el archivo: {pathJson}");

                // 🔹 1. Generar IV
                byte[] iv = new byte[16];
                using (RandomNumberGenerator rng = RandomNumberGenerator.Create())
                {
                    rng.GetBytes(iv);
                }

                string ivBase64 = Convert.ToBase64String(iv);

                // 🔹 2. Guardar llave pública
                string rutaLlave = Path.Combine(rutaFinal, "LlavePublica.txt");
                File.WriteAllText(rutaLlave, ivBase64);

                // 🔹 3. Encriptar (SIN borrar JSON)
                string archivoEnc = pathJson + ".enc";

                EncriptacionAES.EncriptarArchivo(
                    pathJson,
                    archivoEnc,
                    keyString,
                    ivBase64
                );

                _logger.LogInformation("Archivo encriptado correctamente");
            }
            catch (Exception ex)
            {
                _logger.LogError($"Error en encriptación: {ex.Message}");
                throw;
            }
        }
    }
}








using Microsoft.Extensions.Logging;
using System;
using System.IO;
using System.IO.Compression;

namespace EstadosCuentaTC.Services
{
    public class ZipService
    {
        private readonly ILogger<ZipService> _logger;

        public ZipService(ILogger<ZipService> logger)
        {
            _logger = logger;
        }

        public void Comprimir(string rutaJson, string nombreJson, DateTime fechaCorte)
        {
            try
            {
                _logger.LogInformation("INICIO ZIP");

                string rutaFinal = Path.Combine(rutaJson, fechaCorte.ToString("yyyy-MM-dd"));

                string zipTemporal = rutaFinal + ".zip";
                string nombreZip = nombreJson.Replace("json", "zip");
                string destinoZip = Path.Combine(rutaFinal, nombreZip);

                if (File.Exists(zipTemporal))
                    File.Delete(zipTemporal);

                ZipFile.CreateFromDirectory(rutaFinal, zipTemporal);

                if (File.Exists(destinoZip))
                    File.Delete(destinoZip);

                File.Move(zipTemporal, destinoZip);

                _logger.LogInformation("ZIP generado correctamente");
            }
            catch (Exception ex)
            {
                _logger.LogError($"Error al comprimir: {ex.Message}");
                throw;
            }
        }
    }
}










using EstadosCuentaTC.Dtos;
using EstadosCuentaTC.Repositories;
using Microsoft.Extensions.Logging;
using System;

namespace EstadosCuentaTC.Services
{
    public class GeneracionEstadoCuentaService
    {
        private readonly GeneracionIndividualService _individualService;
        private readonly JsonRepository _jsonRepo;
        private readonly EstadoCuentaRepository _repo;
        private readonly ILogger<GeneracionEstadoCuentaService> _logger;
        private readonly ILoggerFactory _loggerFactory;

        private readonly EncriptacionService _encriptacionService;
        private readonly ZipService _zipService;

        public GeneracionEstadoCuentaService(
            GeneracionIndividualService individualService,
            JsonRepository jsonRepo,
            EstadoCuentaRepository repo,
            ILogger<GeneracionEstadoCuentaService> logger,
            ILoggerFactory loggerFactory,
            EncriptacionService encriptacionService,
            ZipService zipService)
        {
            _individualService = individualService;
            _jsonRepo = jsonRepo;
            _repo = repo;
            _logger = logger;
            _loggerFactory = loggerFactory;
            _encriptacionService = encriptacionService;
            _zipService = zipService;
        }

        public void Ejecutar(ParametrosGeneracionECDto parametros)
        {
            _logger.LogInformation("FASE 4 - GENERACIÓN ESTADOS DE CUENTA");

            string nombreArchivo;

            if (parametros.TipoGeneracion == "INDIVIDUAL")
            {
                _logger.LogInformation("Modo INDIVIDUAL");

                nombreArchivo = _individualService.Ejecutar(
                    parametros.RutaArchivoJson,
                    parametros.FechaCorteProcesar
                );
            }
            else if (parametros.TipoGeneracion == "LOTE")
            {
                _logger.LogInformation("Modo LOTE");

                var loteLogger = _loggerFactory.CreateLogger<GeneracionLoteService>();
                var loteService = new GeneracionLoteService(_repo, loteLogger);

                nombreArchivo = loteService.Ejecutar(
                    parametros.RutaArchivoJson,
                    parametros.FechaCorteProcesar,
                    parametros.CantidadHilos
                );
            }
            else
            {
                throw new Exception($"TipoGeneracion no válido: {parametros.TipoGeneracion}");
            }

            // 🔐 ENCRIPTAR
            _encriptacionService.Ejecutar(
                parametros.RutaArchivoJson,
                nombreArchivo,
                parametros.FechaCorteProcesar,
                parametros.LlaveEncripta
            );

            // 📦 ZIP
            _zipService.Comprimir(
                parametros.RutaArchivoJson,
                nombreArchivo,
                parametros.FechaCorteProcesar
            );

            _logger.LogInformation("PROCESO COMPLETADO");
        }
    }
}










