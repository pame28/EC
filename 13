namespace EstadosCuentaTC.Repositories
{
    public class EstadoCuentaRepository
    {
        private readonly SqlExecutor _sql;

        public EstadoCuentaRepository(SqlExecutor sql)
        {
            _sql = sql;
        }

        // 🔹 Obtener 1 registro pendiente
        public TarjetaPendienteDto ObtenerPendiente()
        {
            using var conn = _sql.GetConnection();

            using var cmd = new SqlCommand("usp_ObtenerTarjeta", conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            using var reader = cmd.ExecuteReader();

            if (!reader.Read())
                return null;

            return new TarjetaPendienteDto
            {
                FechaCorte = reader["Fecha_Corte"]?.ToString(),
                NoTarjeta = reader["No_Tarjeta"]?.ToString(),
                NoCuenta = reader["No_Cuenta"]?.ToString(),
                NoCuentaVASA = reader["No_Cuenta_VASA"]?.ToString(),
                Nombre = reader["Nombre"]?.ToString(),
                Correo = reader["Correo"]?.ToString(),
                Origen = reader["Origen"]?.ToString()
            };
        }

        // 🔹 Obtener JSON directo (OPTIMIZADO)
        public string ObtenerJson(string tarjeta, string fechaCorte)
        {
            using var conn = _sql.GetConnection();

            using var cmd = new SqlCommand("usp_SBEstadoCuentaJson", conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            cmd.Parameters.AddWithValue("@NoTarjeta", tarjeta);
         //   cmd.Parameters.AddWithValue("@FechaCorte", fechaCorte);

            var result = cmd.ExecuteScalar();

            return result?.ToString() ?? "{}";
        }

        // 🔹 Actualizar estado
        public void MarcarProcesado(string tarjeta, string cuenta)
        {
            _sql.Execute($@"
                UPDATE BandejaEstadoCuenta
                SET Estado = 1
                WHERE No_Tarjeta = '{tarjeta}'
                AND No_Cuenta = '{cuenta}'
            ");
        }

        // 🔹 Insertar histórico
        public void InsertarHistorico(
           DateTime fechaCorte,
           string tarjeta,
           string cuenta,
           string cuentaVasa,
           string nombre,
           string correo,
           string origen,           
           int? lote = null
       )
        {
            using var conn = _sql.GetConnection();

            using var cmd = new SqlCommand("usp_InsertarHistoricoECJson", conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            cmd.Parameters.AddWithValue("@FechaCorte", fechaCorte);
            cmd.Parameters.AddWithValue("@NoTarjeta", tarjeta ?? "");
            cmd.Parameters.AddWithValue("@NoCuenta", cuenta ?? "");
            cmd.Parameters.AddWithValue("@NoCuentaVASA", cuentaVasa ?? "");
            cmd.Parameters.AddWithValue("@Nombre", nombre ?? "");
            cmd.Parameters.AddWithValue("@Correo", correo ?? "");
            cmd.Parameters.AddWithValue("@Origen", origen ?? "");
            cmd.Parameters.AddWithValue("@Lote", lote ?? (object)DBNull.Value);
 

