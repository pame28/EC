using EstadosCuentaTC.Repositories;
using Microsoft.Extensions.Logging;
using System;
using System.Collections.Generic;
using System.Text;

namespace EstadosCuentaTC.Services
{
    public class GeneracionIndividualService
    {
        private readonly EstadoCuentaRepository _repo;
        private readonly ILogger<GeneracionIndividualService> _logger;

        public GeneracionIndividualService(
            EstadoCuentaRepository repo,
            ILogger<GeneracionIndividualService> logger)
        {
            _repo = repo;
            _logger = logger;
        }

        public void Ejecutar(string rutaBase, DateTime fechaCorte)
        {
            try
            {
                _logger.LogInformation("Inicio Generación Individual");

                var ruta = Path.Combine(rutaBase, fechaCorte.ToString("yyyy-MM-dd"));

                if (!Directory.Exists(ruta))
                {
                    Directory.CreateDirectory(ruta);
                }

                var archivoJson = Path.Combine(ruta, $"Estado_de_cuenta_corte_{fechaCorte.Day}.json");
                var contadorPath = Path.Combine(ruta, "Contador.txt");

                if (!File.Exists(contadorPath))
                    File.WriteAllText(contadorPath, "0");

                while (true)
                {
                    var tarjeta = _repo.ObtenerPendiente();

                    if (tarjeta == null)
                        break;

                    var cantidad = _repo.ObtenerCantidadPendiente();

                    var json = _repo.ObtenerJson(tarjeta.NoTarjeta, tarjeta.FechaCorte);

                    if (string.IsNullOrWhiteSpace(json))
                        json = "{}";

                    var tarjetaKey = $"\"{tarjeta.NoTarjeta}\":";


                    if (!File.Exists(contadorPath))
                    {
                        File.WriteAllText(contadorPath, "0");
                    }

                    var contadorTexto = File.ReadAllText(contadorPath);
                    bool esInicio = string.IsNullOrEmpty(contadorTexto);
                    bool esFinal = cantidad == 1;

                    if (esInicio)
                    {
                        File.AppendAllText(archivoJson, "{");
                        File.WriteAllText(contadorPath, "1");
                    }
                    else
                    {
                        int contador = int.Parse(contadorTexto) + 1;
                        File.WriteAllText(contadorPath, contador.ToString());
                    }

                    if (esFinal)
                    {
                        File.AppendAllText(archivoJson, $"{tarjetaKey}{json}");
                        File.AppendAllText(archivoJson, "}");
                    }
                    else
                    {
                        File.AppendAllText(archivoJson, $"{tarjetaKey}{json},");
                    }

                    _repo.MarcarProcesado(tarjeta.NoTarjeta, tarjeta.NoCuenta);

                    _repo.InsertarHistorico(
                       DateTime.Parse(tarjeta.FechaCorte),
                        tarjeta.NoTarjeta,
                        tarjeta.NoCuenta,
                        tarjeta.NoCuentaVASA,
                        tarjeta.Nombre,
                        tarjeta.Correo,
                        tarjeta.Origen
                    );

                    _logger.LogInformation("Procesado: {tarjeta}", tarjeta.NoTarjeta);
                }

                _logger.LogInformation("Fin Generación Individual");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en Generación Individual");
                throw;
            }
        }
    }
}


