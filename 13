ALTER PROCEDURE [dbo].[usp_ProcesarLoteEstadosCuenta]
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @Resultados TABLE (
        NoTarjeta VARCHAR(16),
        JsonEstadoCuenta NVARCHAR(MAX)
    );

    DECLARE @Lote INT = 1;
    DECLARE @TamanoLote INT;

    -- 🔥 Obtener tamaño de lote desde parámetros
    SELECT TOP 1 @TamanoLote = RegistrosPorLote
    FROM ParametrosGeneracionEC;

    IF @TamanoLote IS NULL OR @TamanoLote <= 0
        SET @TamanoLote = 100; -- valor por defecto

    DECLARE @Offset INT = 0;

    BEGIN TRY
        BEGIN TRAN;

        WHILE (1 = 1)
        BEGIN
            -- 🔥 Obtener lote actual
            ;WITH CTE AS (
                SELECT *
                FROM BandejaEstadoCuenta WITH (UPDLOCK, READPAST)
                WHERE Estado = 2
                ORDER BY No_Tarjeta
                OFFSET @Offset ROWS
                FETCH NEXT @TamanoLote ROWS ONLY
            )
            SELECT * INTO #Lote FROM CTE;

            IF NOT EXISTS (SELECT 1 FROM #Lote)
                BREAK;

            DECLARE @NoTarjeta VARCHAR(16);
            DECLARE @Json NVARCHAR(MAX);

            DECLARE cursor_lote CURSOR FOR
            SELECT No_Tarjeta FROM #Lote;

            OPEN cursor_lote;
            FETCH NEXT FROM cursor_lote INTO @NoTarjeta;

            WHILE @@FETCH_STATUS = 0
            BEGIN
                SET @Json = NULL;

                -- 🔥 Capturar JSON correctamente
                DECLARE @TablaJson TABLE (
                    JsonEstadoCuenta NVARCHAR(MAX)
                );

                INSERT INTO @TablaJson
                EXEC dbo.usp_SBEstadoCuentaJson @NoTarjeta;

                SELECT @Json = JsonEstadoCuenta
                FROM @TablaJson;

                IF @Json IS NULL
                    SET @Json = '{}';

                INSERT INTO @Resultados (NoTarjeta, JsonEstadoCuenta)
                VALUES (@NoTarjeta, @Json);

                FETCH NEXT FROM cursor_lote INTO @NoTarjeta;
            END

            CLOSE cursor_lote;
            DEALLOCATE cursor_lote;

            -- 🔥 Marcar como procesado
            UPDATE b
            SET Estado = 1
            FROM BandejaEstadoCuenta b
            INNER JOIN #Lote l
                ON b.No_Tarjeta = l.No_Tarjeta
                AND b.No_Cuenta = l.No_Cuenta;

            -- 🔥 Insertar histórico con lote correcto
            INSERT INTO HistoricoMaestroEstadosCuentaJSON
            (
                FechaCorte,
                NoTarjeta,
                NoCuenta,
                NoCuentaVASA,
                Nombre,
                Correo,
                Origen,
                Lote,
                Procesado,
                FechaEjecucion
            )
            SELECT 
                Fecha_Corte,
                No_Tarjeta,
                No_Cuenta,
                No_Cuenta_VASA,
                Nombre,
                Correo,
                Origen,
                @Lote,
                1,
                GETDATE()
            FROM #Lote;

            -- 🔥 Avanzar al siguiente lote
            SET @Offset = @Offset + @TamanoLote;
            SET @Lote = @Lote + 1;

            DROP TABLE #Lote;
        END

        COMMIT;

        -- 🔥 Resultado final
        SELECT 
            NoTarjeta,
            JsonEstadoCuenta
        FROM @Resultados;

    END TRY
    BEGIN CATCH
        ROLLBACK;
        THROW;
    END CATCH
END
GO