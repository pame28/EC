using EstadosCuentaTC.Repositories;
using EstadosCuentaTC.Services;

var builder = Host.CreateApplicationBuilder(args);

builder.Services.AddSingleton<EstadoCuentaRepository>();
builder.Services.AddSingleton<GeneracionLoteService>();

builder.Services.AddHostedService<Worker>();

var host = builder.Build();
host.Run();






using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;

namespace EstadosCuentaTC.Worker
{
    public class Worker : BackgroundService
    {
        private readonly ILogger<Worker> _logger;
        private readonly GeneracionLoteService _loteService;

        public Worker(
            ILogger<Worker> logger,
            GeneracionLoteService loteService)
        {
            _logger = logger;
            _loteService = loteService;
        }

        protected override async Task ExecuteAsync(CancellationToken stoppingToken)
        {
            _logger.LogInformation("Worker iniciado...");

            while (!stoppingToken.IsCancellationRequested)
            {
                try
                {
                    _logger.LogInformation("Iniciando proceso de lote...");

                    // ⚡ EJECUTAR PROCESO COMPLETO
                    _loteService.Ejecutar(
                        rutaBase: "C:\\EstadosCuenta",
                        fechaCorte: DateTime.Now,
                        loteSize: 1000,
                        cantidadHilos: 4
                    );

                    _logger.LogInformation("Lote terminado correctamente");
                }
                catch (Exception ex)
                {
                    _logger.LogError(ex, "Error en el worker");
                }

                // ⏱️ Espera antes del siguiente ciclo (evita sobrecargar)
                await Task.Delay(TimeSpan.FromMinutes(1), stoppingToken);
            }
        }
    }
}