-- SP simplificado: solo retorna sets planos
ALTER PROCEDURE [dbo].[usp_SBEstadoCuentaJsonMasivo]
    @WorkerId INT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @FechaCorte DATE;
    DECLARE @BatchSize INT;

    CREATE TABLE #Lote (No_Tarjeta VARCHAR(16) PRIMARY KEY);

    SELECT TOP 1 @FechaCorte = FechaCorte
    FROM dbo.ParametrosCorte WHERE Estado = 1
    ORDER BY FechaCorte DESC;

    SELECT TOP 1 @BatchSize = RegistrosPorLote
    FROM dbo.ParametrosGeneracionEC;

    -- Bloqueo optimista con READPAST
    INSERT INTO #Lote (No_Tarjeta)
    SELECT TOP (@BatchSize) No_Tarjeta
    FROM dbo.BandejaEstadoCuenta WITH (ROWLOCK, READPAST)
    WHERE Estado = 0
      AND (WorkerId IS NULL OR WorkerId = @WorkerId)
    ORDER BY No_Tarjeta;

    IF NOT EXISTS (SELECT 1 FROM #Lote)
    BEGIN
        SELECT 0 AS Resultado; RETURN;
    END

    UPDATE be SET Estado = 2, WorkerId = @WorkerId
    FROM dbo.BandejaEstadoCuenta be
    INNER JOIN #Lote l ON be.No_Tarjeta = l.No_Tarjeta
    WHERE Estado = 0;

    -- ✅ Resultado 1: Encabezados (JOIN único, sin FOR JSON)
    SELECT
        hc.No_Tarjeta,
        hc.Origen, hc.Emisor, hc.No_Cuenta,
        hc.Nombre_TH_Tit, hc.Emisor_Madre,
        -- ... resto de columnas ...
        hc.Fecha_Pago, hc.Fecha_Corte,
        hc.Pago_Contado_MN, hc.Pago_Minimo_MN,
        -- ... etc ...
        ISNULL(CONVERT(VARCHAR(MAX), map.Mensaje), '') AS Mensaje_1,
        t.EstadoTarjeta
    FROM #Lote l
    INNER JOIN dbo.BandejaEstadoCuenta be ON be.No_Tarjeta = l.No_Tarjeta
    INNER JOIN dbo.BandejaEncabezado hc
        ON hc.No_Tarjeta = be.No_Tarjeta
       AND hc.Fecha_Corte = @FechaCorte
    LEFT JOIN dbo.CuentasArregloPagos ecap
        ON hc.NoCuentaClaro = ecap.NumeroCuenta
       AND ecap.FechaCorte = @FechaCorte
    LEFT JOIN HistoricoVASATC.dbo.MensajeArregloPagos map
        ON map.idMensaje = ecap.idMensaje
    LEFT JOIN dbo.Tarjetas t ON t.NumeroTarjeta = be.No_Tarjeta;

    -- ✅ Resultado 2: Detalle (UN solo scan de la tabla)
    SELECT
        a.EC_DetalleNo_Cuenta AS No_Cuenta,
        a.Fecha_Consumo,
        a.Tipo_Reg,
        a.Descripcion_Mov,
        a.Moneda_Mov,
        b.TipoMovimiento,
        a.Monto_Mov
    FROM dbo.BandejaDetalle a
    INNER JOIN dbo.TiposMovimientos b ON b.CodMovimiento = a.Codigo_Mov
    INNER JOIN dbo.BandejaEncabezado hc
        ON hc.No_Cuenta = a.EC_DetalleNo_Cuenta
       AND hc.Fecha_Corte = @FechaCorte
    INNER JOIN #Lote l ON l.No_Tarjeta = hc.No_Tarjeta
    WHERE a.Fecha_Corte = @FechaCorte;

    -- ✅ Resultado 3: Financiamientos (UN solo scan)
    SELECT
        f.NumeroCuenta AS No_Cuenta,
        CASE WHEN f.EsIntra = 1 THEN 'Intrafinanciamientos'
             ELSE 'Extrafinanciamientos' END AS Tipo,
        f.FechaOtorgamiento, f.ImporteTotalPlan,
        f.MonedaMovimiento, f.Importe,
        f.CantidadCuotasPlan, f.NoCuotaLiquidada,
        f.PlanExtraTasa, f.PlanCuotaCapitalPend
    FROM dbo.BandejaFinanciamientos f
    INNER JOIN dbo.BandejaEncabezado hc
        ON hc.No_Cuenta = f.NumeroCuenta
       AND hc.Fecha_Corte = @FechaCorte
    INNER JOIN #Lote l ON l.No_Tarjeta = hc.No_Tarjeta
    WHERE f.FechaCierre = @FechaCorte
      AND f.PlanCuotaCapitalPend > 0
      AND (f.EsIntra = 1 OR f.EsExtra = 1);

    -- Retorna las tarjetas del lote para que .NET sepa qué actualizar
    SELECT No_Tarjeta FROM #Lote;
END

















// Leer los 3 DataReaders en una sola llamada al SP
using var cmd = new SqlCommand("usp_SBEstadoCuentaJsonMasivo", conn);
cmd.CommandType = CommandType.StoredProcedure;
cmd.Parameters.AddWithValue("@WorkerId", workerId);

using var reader = await cmd.ExecuteReaderAsync();

// --- Reader 1: Encabezados ---
var encabezados = new Dictionary<string, JsonObject>();
while (await reader.ReadAsync())
{
    var noTarjeta = reader.GetString("No_Tarjeta");
    encabezados[noTarjeta] = MapEncabezado(reader);
}

// --- Reader 2: Detalle ---
var detalles = new Dictionary<string, List<JsonObject>>();
await reader.NextResultAsync();
while (await reader.ReadAsync())
{
    var noCuenta = reader.GetString("No_Cuenta");
    if (!detalles.ContainsKey(noCuenta))
        detalles[noCuenta] = new List<JsonObject>();
    detalles[noCuenta].Add(MapDetalle(reader));
}

// --- Reader 3: Financiamientos ---
var financiamientos = new Dictionary<string, List<JsonObject>>();
await reader.NextResultAsync();
while (await reader.ReadAsync())
{
    var noCuenta = reader.GetString("No_Cuenta");
    if (!financiamientos.ContainsKey(noCuenta))
        financiamientos[noCuenta] = new List<JsonObject>();
    financiamientos[noCuenta].Add(MapFinanciamiento(reader));
}

// --- Construir JSON final ---
var jsonFinal = new JsonObject();
foreach (var (noTarjeta, encabezado) in encabezados)
{
    var noCuenta = encabezado["No_Cuenta"]?.ToString() ?? "";
    jsonFinal[noTarjeta] = new JsonObject
    {
        ["Encabezado"] = encabezado,
        ["Detalle"] = JsonSerializer.SerializeToNode(
            detalles.GetValueOrDefault(noCuenta, [])),
        ["Financiamientos"] = JsonSerializer.SerializeToNode(
            financiamientos.GetValueOrDefault(noCuenta, []))
    };
}

var jsonString = jsonFinal.ToJsonString();
