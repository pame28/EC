using EstadosCuentaTC.Repositories;
using Microsoft.Extensions.Logging;
using System;
using System.Collections.Generic;
using System.Text;

namespace EstadosCuentaTC.Services
{
    public class CorreosService
    {
        private readonly CorreosRepository _repo;
        private readonly EmailRepository _email;
        private readonly ILogger<CorreosService> _logger;

        public CorreosService(
            CorreosRepository repo,
            EmailRepository email,
            ILogger<CorreosService> logger)
        {
            _repo = repo;
            _email = email;
            _logger = logger;
        }

        public async Task EjecutarAsync()
        {
            try
            {
                _logger.LogInformation("Inicio Correos No Válidos");

                _repo.LimpiarHistorico("NOVALIDOS");

                var lista = _repo.ObtenerCorreosNoValidos();

                _logger.LogInformation("Cantidad: {count}", lista.Count);

                if (lista.Any())
                    _repo.InsertarHistorico(lista);

                _logger.LogInformation("Fin Correos No Válidos");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error proceso");

                await _email.EnviarAsync("ERROR", ex.Message);
            }
        }
    }
}


