using EstadosCuentaTC.Data;
using EstadosCuentaTC.Repositories;
using EstadosCuentaTC.Services;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Logging;

var builder = new ConfigurationBuilder()
    .AddJsonFile("appsettings.json", optional: false);

var config = builder.Build();

var connectionString = config.GetConnectionString("DefaultConnection")
    ?? throw new Exception("ConnectionString no configurado");

// 🔹 Logger
var loggerFactory = LoggerFactory.Create(builder =>
{
    builder.AddConsole();
});

var loggerEmail = loggerFactory.CreateLogger<EmailRepository>();
var loggerCorreos = loggerFactory.CreateLogger<CorreosService>();

// 🔹 Infraestructura
var sql = new SqlExecutor(connectionString);

// 🔹 FASE 1
var prepara = new PreparaDataService(sql);

// 🔹 Repos
var configRepo = new ConfigRepository(sql);
var correosRepo = new CorreosRepository(sql);
var emailRepo = new EmailRepository(configRepo, loggerEmail);

// 🔹 FASE 2
var correosService = new CorreosService(sql, correosRepo, emailRepo, loggerCorreos);

try
{
    Console.WriteLine("========== INICIO PROCESO ==========\n");

    Console.WriteLine("FASE 1: PREPARA DATA");
    prepara.Ejecutar();

    Console.WriteLine("\nFASE 2: CORREOS NO VALIDOS");
    correosService.Ejecutar();

    Console.WriteLine("\n========== FIN PROCESO ==========");
}
catch (Exception ex)
{
    Console.WriteLine($"ERROR GENERAL: {ex.Message}");
}