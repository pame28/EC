ALTER PROCEDURE [dbo].[usp_LimpiarTablaHistoricoCorreosEC]
    @Tipo VARCHAR(20)
AS
BEGIN

    IF(@Tipo = 'COMPLETA')
        TRUNCATE TABLE [dbo].[HistoricoCorreosEC];

    IF(@Tipo = 'NOVALIDOS')
        DELETE FROM [dbo].[HistoricoCorreosEC]
        WHERE CorreoCliente IN (
            SELECT Correo FROM dbo.CorreosNoValidos WHERE Estado = 1
        )
        AND Estado = 0;

END









