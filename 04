using Microsoft.Data.SqlClient;
using System.Data;

namespace EstadosCuentaTC.Data
{
    public class SqlExecutor
    {
        private readonly string _connectionString;

        public SqlExecutor(string connectionString)
        {
            _connectionString = connectionString;
        }

        public SqlConnection GetConnection()
        {
            var conn = new SqlConnection(_connectionString);
            conn.Open();
            return conn;
        }

        public void Execute(string sp, params SqlParameter[] parameters)
        {
            using var conn = GetConnection();
            using var cmd = new SqlCommand(sp, conn);
            cmd.CommandType = CommandType.StoredProcedure;

            if (parameters != null)
                cmd.Parameters.AddRange(parameters);

            cmd.ExecuteNonQuery();
        }
    }
}









using EstadosCuentaTC.Data;
using EstadosCuentaTC.Dtos;
using Microsoft.Data.SqlClient;

namespace EstadosCuentaTC.Repositories
{
    public class ConfigRepository
    {
        private readonly SqlExecutor _sql;

        public ConfigRepository(SqlExecutor sql)
        {
            _sql = sql;
        }

        public ConfigEmailDto ObtenerConfigEmail(string tipo)
        {
            using var conn = _sql.GetConnection();
            using var cmd = new SqlCommand(@"
                SELECT TOP 1 *
                FROM ConfiguracionEmail
                WHERE Estado = '1' AND Tipo = @Tipo
            ", conn);

            cmd.Parameters.AddWithValue("@Tipo", tipo);

            using var reader = cmd.ExecuteReader();

            if (reader.Read())
            {
                return new ConfigEmailDto
                {
                    SmtpServer = reader["SmtpServer"].ToString(),
                    MailFrom = reader["MailFrom"].ToString(),
                    MailSubject = reader["MailSubject"].ToString(),
                    CorreoDestino = reader["CorreoDestino"].ToString()
                };
            }

            throw new Exception($"No existe configuración para tipo: {tipo}");
        }
    }
}








using EstadosCuentaTC.Data;
using EstadosCuentaTC.Dtos;
using Microsoft.Data.SqlClient;

namespace EstadosCuentaTC.Repositories
{
    public class CorreosRepository
    {
        private readonly SqlExecutor _sql;

        public CorreosRepository(SqlExecutor sql)
        {
            _sql = sql;
        }

        public void LimpiarHistorico(string tipo)
        {
            _sql.Execute("usp_LimpiarTablaHistoricoCorreosEC",
                new SqlParameter("@Tipo", tipo));
        }

        public List<CorreoNoValidoDto> ObtenerCorreosNoValidos()
        {
            var lista = new List<CorreoNoValidoDto>();

            using var conn = _sql.GetConnection();
            using var cmd = new SqlCommand("usp_ConsultarCorreosInvalidosEstadoCuenta", conn);
            cmd.CommandType = System.Data.CommandType.StoredProcedure;

            using var reader = cmd.ExecuteReader();

            while (reader.Read())
            {
                lista.Add(new CorreoNoValidoDto
                {
                    FechaCorte = (DateTime)reader["FechaCorte"],
                    NoCuenta = reader["NoCuenta"].ToString(),
                    NoCuentaVASA = reader["NoCuentaVASA"].ToString(),
                    Nombre = reader["Nombre"].ToString(),
                    Correo = reader["Correo"].ToString()
                });
            }

            return lista;
        }

        public void InsertarHistorico(List<CorreoNoValidoDto> lista)
        {
            using var conn = _sql.GetConnection();

            foreach (var item in lista)
            {
                using var cmd = new SqlCommand(@"
                    INSERT INTO HistoricoCorreosEC
                    (FechaCorte, NoCuenta, NoCuentaVASA, Nombre, CorreoCliente, Estado)
                    VALUES (@FechaCorte, @NoCuenta, @NoCuentaVASA, @Nombre, @Correo, 0)
                ", conn);

                cmd.Parameters.AddWithValue("@FechaCorte", item.FechaCorte);
                cmd.Parameters.AddWithValue("@NoCuenta", item.NoCuenta);
                cmd.Parameters.AddWithValue("@NoCuentaVASA", item.NoCuentaVASA ?? "");
                cmd.Parameters.AddWithValue("@Nombre", item.Nombre ?? "");
                cmd.Parameters.AddWithValue("@Correo", item.Correo ?? "");

                cmd.ExecuteNonQuery();
            }
        }
    }
}









using EstadosCuentaTC.Dtos;
using Microsoft.Extensions.Logging;
using System.Net.Mail;

namespace EstadosCuentaTC.Repositories
{
    public class EmailRepository
    {
        private readonly ILogger<EmailRepository> _logger;
        private readonly ConfigRepository _configRepo;

        public EmailRepository(
            ConfigRepository configRepo,
            ILogger<EmailRepository> logger)
        {
            _configRepo = configRepo;
            _logger = logger;
        }

        public async Task EnviarAsync(string tipo, string mensaje, string? destinoOverride = null)
        {
            try
            {
                var config = _configRepo.ObtenerConfigEmail(tipo);

                using var smtp = new SmtpClient(config.SmtpServer)
                {
                    UseDefaultCredentials = true
                };

                using var mail = new MailMessage
                {
                    From = new MailAddress(config.MailFrom),
                    Subject = config.MailSubject,
                    Body = mensaje,
                    IsBodyHtml = false
                };

                var destinoFinal = destinoOverride ?? config.CorreoDestino;

                mail.To.Add(destinoFinal);

                await smtp.SendMailAsync(mail);

                _logger.LogInformation("Correo tipo {tipo} enviado a {destino}", tipo, destinoFinal);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error enviando correo tipo {tipo}", tipo);
            }
        }
    }
}












using EstadosCuentaTC.Repositories;
using Microsoft.Extensions.Logging;

namespace EstadosCuentaTC.Services
{
    public class CorreosService
    {
        private readonly CorreosRepository _repo;
        private readonly EmailRepository _email;
        private readonly ILogger<CorreosService> _logger;

        public CorreosService(
            CorreosRepository repo,
            EmailRepository email,
            ILogger<CorreosService> logger)
        {
            _repo = repo;
            _email = email;
            _logger = logger;
        }

        public async Task EjecutarAsync()
        {
            try
            {
                _logger.LogInformation("Inicio Correos No Válidos");

                _repo.LimpiarHistorico("NOVALIDOS");

                var lista = _repo.ObtenerCorreosNoValidos();

                _logger.LogInformation("Cantidad: {count}", lista.Count);

                if (lista.Any())
                    _repo.InsertarHistorico(lista);

                _logger.LogInformation("Fin Correos No Válidos");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error proceso");

                await _email.EnviarAsync("ERROR", ex.Message);
            }
        }
    }
}










using EstadosCuentaTC.Data;
using EstadosCuentaTC.Repositories;
using EstadosCuentaTC.Services;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;

var services = new ServiceCollection();

// Configuración
var config = new ConfigurationBuilder()
    .AddJsonFile("appsettings.json")
    .Build();

services.AddSingleton<IConfiguration>(config);

// Logger
services.AddLogging(builder =>
{
    builder.AddConsole();
});

// DB
services.AddSingleton<SqlExecutor>(sp =>
    new SqlExecutor(config.GetConnectionString("DefaultConnection"))
);

// Repositorios
services.AddTransient<ConfigRepository>();
services.AddTransient<CorreosRepository>();
services.AddTransient<EmailRepository>();

// Servicios
services.AddTransient<CorreosService>();

var provider = services.BuildServiceProvider();

// Ejecutar proceso
var service = provider.GetRequiredService<CorreosService>();
await service.EjecutarAsync();