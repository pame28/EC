ALTER PROCEDURE [dbo].[usp_ObtenerQuery]

AS
BEGIN
DECLARE @FechaCorte DATE;
SELECT @FechaCorte=FechaCorte FROM Param_IS_ECTC WHERE Estado=1;

--		SELECT Query, CantQuery,RutaArchivoJson, RutaArchivoHistoricoJson, @FechaCorte AS FechaCorte
		SELECT 
		Query, 
		--CantQuery,
		'SELECT (select COUNT(*) from BandejaECTC B where B.Estado=2) as "Registros"' CantQuery, 
		RutaArchivoJson, 
		RutaArchivoHistoricoJson, 
		@FechaCorte AS FechaCorte, 
		Llave, 
		'LOTE' TipoGeneracion, 
		100000 CantidadEjecucion, 
		20 CantidadLotes, 
		'SELECT CEILING (((select COUNT(*) from BandejaECTCJson B where B.Estado=2)*1.0)/20) as "RegistrosPorLote"' QueryRegistrosPorLote
		FROM EstadoCuentaHTML WHERE IdRows=1;

END


