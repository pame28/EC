private static string ConvertirFecha(string fechaIso)
{
    if (string.IsNullOrWhiteSpace(fechaIso))
        return fechaIso;

    if (!DateTimeOffset.TryParse(fechaIso, out var dto))
        return fechaIso;

    var tzId = OperatingSystem.IsWindows()
        ? "Central America Standard Time"   // Windows
        : "America/Tegucigalpa";            // Linux / OpenShift

    var tz = TimeZoneInfo.FindSystemTimeZoneById(tzId);

    var localTime = TimeZoneInfo.ConvertTime(dto, tz);

    return localTime.ToString("yyyy-MM-ddTHH:mm:sszzz");
}