using api_token_notifica.Repository;
using api_token_notifica.Infraestructure.Data;
using api_token_notifica.Repository.Interface;
using api_token_notifica.Service;
using api_token_notifica.Service.Interface;
using api_token_notifica.Utils;
using Microsoft.AspNetCore.Mvc;
using Serilog;
using System.Security.Cryptography.X509Certificates;

// Cargar certificados personalizados antes de iniciar la app
LoadCustomCertificates();

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddOpenApi();
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen();
builder.Services.Configure<ApiBehaviorOptions>(options =>
{
    options.SuppressModelStateInvalidFilter = true;
});

builder.Services.AddScoped<DBHelper>();
builder.Services.AddScoped<IParametrosRepository, ParametrosRepository>();
builder.Services.AddScoped<ICuentaRepository, CuentaRepository>();
builder.Services.AddScoped<ICardRepository, CardRepository>();
builder.Services.AddScoped<IServersRepository, ServersRepository>();
builder.Services.AddScoped<IPlantillaRepository, PlantillaRepository>();
builder.Services.AddScoped<ITokenRequestorRepository, TokenRequestorRepository>();
builder.Services.AddScoped<IValidationService, ValidationServiceImp>();
builder.Services.AddScoped<ITokenNotificationService, TokenNotificationService>();
builder.Services.AddScoped<IParametrosService, ParametrosService>();
builder.Services.AddScoped<IMailService, MailService>();
builder.Services.AddScoped<ISmsService, SmsService>();
builder.Services.AddScoped<IBPTarjetasService, BPTarjetasService>();
builder.Services.AddScoped<ICuentaService, CuentaService>();
builder.Services.AddScoped<ICardService, CardService>();
builder.Services.AddScoped<IServerService, ServerService>();
builder.Services.AddScoped<IPlantillaService, PlantillaService>();
builder.Services.AddScoped<ITokenRequestorService, TokenRequestorService>();
builder.Services.AddScoped<MessageResponseFn>();

builder.Host.UseSerilog((context, services, config) =>
    config.ReadFrom.Configuration(context.Configuration)
          .ReadFrom.Services(services));

builder.Services.Configure<CorrelationIdOptions>(
    builder.Configuration.GetSection("CorrelationIdOptions"));

builder.Services.AddControllers();
builder.Services.AddAuthorization();

var app = builder.Build();

if (app.Environment.IsDevelopment())
{
    app.MapOpenApi();
    app.UseSwagger();
    app.UseSwaggerUI(c =>
    {
        c.SwaggerEndpoint("/openapi/v1.json", "api_autentication v1");
        c.RoutePrefix = "swagger";
    });
}

app.UseHttpsRedirection();
app.UseCorrelationId();
app.MapControllers();
app.Run();

// Método para cargar certificados personalizados desde un directorio configurable
static void LoadCustomCertificates()
{
    var certDir = Environment.GetEnvironmentVariable("CUSTOM_CERTS_DIR") ?? "/app/certificates";

    if (!Directory.Exists(certDir))
    {
        Console.WriteLine($"[Certificados] Directorio no encontrado: {certDir}. Saltando carga.");
        return;
    }

    var certFiles = Directory.GetFiles(certDir, "*.crt");

    if (certFiles.Length == 0)
    {
        Console.WriteLine($"[Certificados] No se encontraron archivos .crt en {certDir}");
        return;
    }

    using var store = new X509Store(StoreName.Root, StoreLocation.CurrentUser);
    store.Open(OpenFlags.ReadWrite);

    foreach (var certFile in certFiles)
    {
        try
        {
            var certificate = new X509Certificate2(certFile);
            store.Add(certificate);
            Console.WriteLine($"[Certificados] Cargado: {Path.GetFileName(certFile)} | Subject: {certificate.Subject} | Expira: {certificate.NotAfter:yyyy-MM-dd}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Certificados] Error al cargar {Path.GetFileName(certFile)}: {ex.Message}");
        }
    }

    store.Close();
    Console.WriteLine($"[Certificados] {certFiles.Length} certificado(s) procesado(s) desde {certDir}");
}









