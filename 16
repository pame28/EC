ALTER PROCEDURE [dbo].[Usp_ValidaCuentaCliente] 
	-- Parametros
	@Cuenta nvarchar(18), 
	@Cif nvarchar(18) 
	AS
BEGIN

 DECLARE @Contador AS INT	
 SELECT  @Contador = COUNT(*)  FROM AS400_ClientesCuentas where LTRIM(RTRIM(REPLACE(numCuenta,'-',''))) = LTRIM(RTRIM(@Cuenta)) AND LTRIM(RTRIM(cifCliente))=LTRIM(RTRIM(@Cif))
 
 IF @Contador = 0
 
 BEGIN
 	
SELECT @Contador = COUNT(*) FROM AS400_ClientesCuentas AS A
INNER JOIN  AS400_DPALIAS AS B
ON A.PRTIPO=B.PRTIPO AND A.DPAGEN=B.DPAGEN AND A.DPCORR=B.DPCORR AND A.DPDIVE = B.DPDIVE
WHERE REPLACE(LTRIM(REPLACE(B.DPALIA, '0', ' ')), ' ', '0')=REPLACE(LTRIM(REPLACE(@Cuenta, '0', ' ')), ' ', '0')AND LTRIM(RTRIM(A.cifCliente)) = LTRIM(RTRIM(@Cif))
--LTRIM(RTRIM(B.DPALIA))=LTRIM(RTRIM(@Cuenta)) AND LTRIM(RTRIM(A.cifCliente)) = LTRIM(RTRIM(@Cif))

 END
  
IF @Contador IS NULL	
BEGIN
	SET @Contador=0
END
  
SELECT @Contador AS Coincidencias
END






