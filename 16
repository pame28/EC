        public ApiConsultaAdelanto(HttpClient httpClient, ILogger<ApiConsultaAdelanto> logger)
        {
            _httpClient = httpClient;
            _logger = logger;
        }

        public async Task<GeneralResponse?> GetConsultaAdelanto(string endpoint, AccountDataRequest data)
        {
            try
            {

                var json = JsonSerializer.Serialize(data);
                _logger.LogInformation("Body enviado: {Json}", json);


                _logger.LogInformation("***** Petición recibida {Method} *****", nameof(GetConsultaAdelanto));
                var response = await _httpClient.PostAsJsonAsync(endpoint, data);

                if (!response.IsSuccessStatusCode)
                {
                    var errorContent = await response.Content.ReadFromJsonAsync<AccountDataErrorResponse>();
                    _logger.LogError("Error en llamada a {Endpoint}. StatusCode: {StatusCode}, Body: {Body}", endpoint, response.StatusCode.ToString(), errorContent);

                    return new GeneralResponse
                    {
                        Status = 200, //errorContent.status,
                        HasError = true,
                        DisponibleAdelanto = 0,
