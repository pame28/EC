        private void getprofile()
        {
            try
            {
                using (SqlConnection conexion = new SqlConnection(TransaccionesBancarias.Properties.Settings.Default.ConnectionSeguridad))
                {
                    conexion.Open();
                    using (SqlCommand cmd = new SqlCommand("Usp_GetProfile"))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        Object returnValue;
                        cmd.CommandTimeout = 300;
                        cmd.Parameters.AddWithValue("@usuario", usuario.ToLower());
                        cmd.Parameters.AddWithValue("@Aplicacion", TransaccionesBancarias.Properties.Settings.Default.AplicacionCod);
                        cmd.Connection = conexion;
                        returnValue = cmd.ExecuteScalar();
                        TransaccionesBancarias.Properties.Settings.Default.Profile = Convert.ToInt32(returnValue);
                        conexion.Close();
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error al obtener Perfil de Usuario" + Environment.NewLine + ex.Message.ToString(), "", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void validausuario()
