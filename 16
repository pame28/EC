using api_otp_notifica.DTOs.Cuentas;
using api_otp_notifica.Models.Entities;
using api_otp_notifica.Repository.Interface;
using api_otp_notifica.Service.Interface;

namespace api_otp_notifica.Service
{
    public class CuentaService : ICuentaService
    {
        private readonly ICuentaRepository _cuentaRepository;
        private readonly ILogger<CuentaService> _logger;

        public CuentaService(ICuentaRepository cuentaRepository, ILogger<CuentaService> logger) 
        {
            _cuentaRepository = cuentaRepository;   
            _logger = logger;   
        }

        public async Task<CuentaDto> GetAccountAsync(string equivalente)
        {
            Cuenta? cuenta = await _cuentaRepository.GetAccountByEquivalent(equivalente);

            if (cuenta == null)
            {
                _logger.LogWarning("No se encontró información de Cuenta para equivalente {equivalente}", equivalente);
                return new CuentaDto();
            }

            CuentaDto cuentaDto = new CuentaDto
            {
                NoCuentaClaro = cuenta.NoCuentaClaro ?? string.Empty,
                CIF = cuenta.CIF ?? string.Empty,
                Nombre = cuenta.Nombre ?? string.Empty,
            };

            _logger.LogInformation("Información de Cuenta encontrada => equivalente {equivalente}: CIF => {CIF}", equivalente, cuentaDto.CIF);

            return cuentaDto;
        }
    }
}








using api_otp_notifica.Infraestructure.Data;
using api_otp_notifica.Models.Entities;
using api_otp_notifica.Repository.Interface;

namespace api_otp_notifica.Repository
{
    public class CuentaRepository : ICuentaRepository
    {
        private readonly DBHelper _dbHelper;
        private readonly ILogger<CuentaRepository> _logger;
        public CuentaRepository(DBHelper dBHelper, ILogger<CuentaRepository> logger) 
        {
            _dbHelper = dBHelper;
            _logger = logger;   
        }

        public async Task<Cuenta?> GetAccountByEquivalent(string equivalente)
        {
            try
            {
                using var reader = await _dbHelper.ExecuteReaderAsync("usp_GetCuenta",
                    new Dictionary<string, object> { { "@Equivalente", equivalente } });

                if (!await reader.ReadAsync())
                {
                    _logger.LogWarning("No se encontró cuenta para el equivalente {equivalente} en DB", equivalente);
                    return null;
                }

                var cuenta = new Cuenta
                {
                    NoCuentaClaro = reader["NoCuentaClaro"]?.ToString(),
                    CIF = reader["CIF"]?.ToString(),
                    Nombre = reader["Nombre"]?.ToString()
                };

                _logger.LogInformation("Cuenta encontrada en DB: equivalente={equivalente}, CIF={CIF}", equivalente, cuenta.CIF);
                return cuenta;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error de base de datos al obtener cuenta con equivalente {equivalente}", equivalente);
                throw;
            }
        }
    }
}




namespace api_otp_notifica.DTOs.Cuentas
{
    public class CuentaDto
    {
        public string NoCuentaClaro { get; set; } = string.Empty;
        public string CIF { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
    }
}
