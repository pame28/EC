namespace plantilla_microservicios_repository.Service
{
    public class ConsultaAdelantoService : ITermsService
    {
        private readonly GeneralResponseFn _generalResponseFn;
        private readonly IApiConsultaAdelanto _apiService;
        private readonly ICardsRepository _cardsRepository;
        private readonly ILogger<ConsultaAdelantoService> _logger;
        private readonly string endpoint;


        public ConsultaAdelantoService(GeneralResponseFn generalResponseFn, IApiConsultaAdelanto apiService, ICardsRepository cardsRepository, ILogger<ConsultaAdelantoService> logger, IConfiguration configuration)
        {
            _generalResponseFn = generalResponseFn;
            _apiService = apiService;   
            _cardsRepository = cardsRepository;
            endpoint = configuration["ApiSettings:EndpointStatements"]
                ?? throw new ArgumentNullException(nameof(configuration), "EndpointStatements no puede ser nulo");
            _logger = logger;
        }
        public async Task<GeneralResponse> GetTermsAsync(ConsultaAdelantoEfectivoRequest consultaAdelantoEfectivoRequest)
        {
            DataTable dtResult = new DataTable();

            ConsultaAdelantoEfectivoResult consultaAdelanto = new ConsultaAdelantoEfectivoResult();

            try
            {
                _logger.LogInformation("SOLICITUD RECIBIDA *******ConsultaAdelantoEfectivo*******");
                _logger.LogInformation("EQUIVALENTE =>" + consultaAdelantoEfectivoRequest.equivalente + " | CANAL =>" + consultaAdelantoEfectivoRequest.canal);


                //Valida que el equivalente de la TC sea numerico, no este nulo y contenga todos los caracteres
                _logger.LogInformation("Validacion del numero equivalente");
                if (string.IsNullOrEmpty(consultaAdelantoEfectivoRequest.equivalente) | string.IsNullOrWhiteSpace(consultaAdelantoEfectivoRequest.equivalente))
                {
                    consultaAdelanto.Respuesta = 1;
                    consultaAdelanto.Error = await _cardsRepository.GetMsjError(11);
                    string mensaje = "El equivalente no debe venir vacio -> EQUIVALENTE: " + consultaAdelantoEfectivoRequest.equivalente;
                    _logger.LogInformation(mensaje);

                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.STATUS_OK, consultaAdelanto.Respuesta, consultaAdelanto.Error, mensaje);
                    //return consultaAdelanto;
                }
                if (!Regex.IsMatch(consultaAdelantoEfectivoRequest.equivalente, @"^[0-9]+$") | consultaAdelantoEfectivoRequest.equivalente.Length < 16)
                {
                    await _cardsRepository.InsConsultaDisponible(consultaAdelantoEfectivoRequest.equivalente, consultaAdelantoEfectivoRequest.canal,
                         "El número equivalente de la tarjeta no contiene el formato correcto", null, null);
                    consultaAdelanto.Respuesta = 1;
                    consultaAdelanto.Error = await _cardsRepository.GetMsjError(14);
                    string mensaje = "El número equivalente de la tarjeta no contiene el formato correcto -> EQUIVALENTE: " + consultaAdelantoEfectivoRequest.equivalente;
                    _logger.LogInformation(mensaje);

                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.STATUS_OK, consultaAdelanto.Respuesta, consultaAdelanto.Error, mensaje);

                    //return consultaAdelanto;
                }

                _logger.LogInformation("Validando Canal");
                if (string.IsNullOrEmpty(consultaAdelantoEfectivoRequest.canal))
                {
                    consultaAdelanto.Respuesta = 1;
                    consultaAdelanto.Error = await _cardsRepository.GetMsjError(11);

                    _logger.LogInformation(consultaAdelanto.Error + " CANAL =>" + consultaAdelantoEfectivoRequest.canal);
                    string mensaje = "Canal no puede venir vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.STATUS_OK, consultaAdelanto.Respuesta, consultaAdelanto.Error, mensaje);

                    //return consultaAdelanto;
                }

                #region Valida que la TC sea titular
                _logger.LogInformation("Validando que la TC sea titular");

                int existeTarjeta = await _cardsRepository.ValidaTarjetaTitular(consultaAdelantoEfectivoRequest.equivalente);
                if (existeTarjeta == 0)
                {
                    consultaAdelanto.Respuesta = 1;
                    consultaAdelanto.Error = await _cardsRepository.GetMsjError(12);
                    string mensaje = "La TC consultada no es titular EQUIVALENTE =>" + consultaAdelantoEfectivoRequest.equivalente;
                    _logger.LogInformation(mensaje);
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.STATUS_OK, consultaAdelanto.Respuesta, consultaAdelanto.Error, mensaje);

                    //return consultaAdelanto;
                }
                #endregion

                #region Consulta a core 
                _logger.LogInformation("Consultando core bancario");
                var getBaseRequest = await _cardsRepository.GetBaseInfo(consultaAdelantoEfectivoRequest.equivalente.ToString());

                if (getBaseRequest == null)
                {
                    _logger.LogError("Error en {Method}. Message: {Message}", nameof(GetTermsAsync), "Error al obtener información, respuesta null");
                    return await _generalResponseFn.ResponseError(
                            Constantes.STATUS_NOT_FOUND,
                            Constantes.CODE_SYSTEM_ERROR,
                            $"Error al obtener información base: respuesta null - no se encontró registro para equivalente: {consultaAdelantoEfectivoRequest.equivalente.ToString()}");
                }

                var accountDataRequest = new AccountDataRequest
                {
                    card = new Card
                    {
                        bin = getBaseRequest.Bin,
                        lastFourDigits = getBaseRequest.LastFourDigits
                    },
                    client = new Client
                    {
                        documentNumber = getBaseRequest.DocumentNumber.Trim(),
                        documentType = getBaseRequest.DocumentType,
                        gender = getBaseRequest.Gender
                    },
                };

                var consultaApiResponse = await _apiService.GetConsultaAdelanto(endpoint, accountDataRequest);

                if (consultaApiResponse == null) {
                    consultaAdelanto.Respuesta = 1;
                    consultaAdelanto.Error = await _cardsRepository.GetMsjError(14);
                    _logger.LogInformation("Error en public ConsultaAdelantoEfectivoResult ConsultaAdelantoEfectivo");
                    string mensaje = $"Respuesta obtenida de endpoint {endpoint} ha sido nulll";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.STATUS_ERROR, consultaAdelanto.Respuesta, consultaAdelanto.Error, mensaje);
                }

                if (consultaApiResponse.HasError)
                {
                    return consultaApiResponse;
                }

                return await _generalResponseFn.Response(
                   Constantes.STATUS_OK,
                   "00",
                   consultaApiResponse.DisponibleAdelanto);
    
                #endregion
            }
            catch (Exception ex)
            {
                consultaAdelanto.Respuesta = 1;
                consultaAdelanto.Error = await _cardsRepository.GetMsjError(14);
                _logger.LogInformation("Error en public ConsultaAdelantoEfectivoResult ConsultaAdelantoEfectivo");
                _logger.LogInformation(ex.Message);
                string mensaje = ex.Message;
                return _generalResponseFn.ResponseErrorDesembolso(Constantes.STATUS_ERROR, consultaAdelanto.Respuesta, consultaAdelanto.Error, mensaje);

            }

        }
    }
}









using ApiConsultaAdelantoEfectivo.Service;
using ApiTerms.Models.AccessToken;
using ApiTerms.Service.Interface;
using Microsoft.AspNetCore.Authentication.BearerToken;

namespace ApiTerms.Service
{
    public class TokenProvider : ITokenProvider
    {
        private readonly HttpClient _httpClient;
        private Models.AccessToken.AccessTokenResponse? _cachedToken;
        private readonly SemaphoreSlim _lock = new(1, 1);
        private readonly ILogger<TokenProvider> _logger;


        //Para auth
        private readonly string endpoint;

        public TokenProvider(HttpClient httpClient, IConfiguration configuration, ILogger<TokenProvider> logger)
        {
            _httpClient = httpClient;
            endpoint = configuration["ApiSettings:EndpointAccessToken"]
                                ?? throw new ArgumentNullException(nameof(configuration), "Endpoint no puede ser nulo"); 
            _logger = logger;
        }

        public async Task<string> GetTokenAsync()
        {
            try
            {

                var response = await _httpClient.GetAsync(endpoint);

                if (!response.IsSuccessStatusCode)
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    _logger.LogError("Error en llamada a {Endpoint}. StatusCode: {StatusCode}, Body: {Body}", endpoint, response.StatusCode, errorContent);
                    throw new HttpRequestException($"Error en llamada a {endpoint}. StatusCode: {response.StatusCode}");
                }

                _cachedToken = await response.Content.ReadFromJsonAsync<Models.AccessToken.AccessTokenResponse>();

                return _cachedToken.accessToken;
            }
            catch (Exception ex)
            {
                _logger.LogError("Error en llamada a {Endpoint} con {Error}.", endpoint, ex.Message.ToString());
                throw new HttpRequestException($"Error en llamada a {endpoint}.");
            }
        }
    }
}





using Microsoft.AspNetCore.Http;
