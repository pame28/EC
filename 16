        private void ObtieneTotales()
        {
            decimal credito = 0;
            decimal debito = 0;

            try
            {
                for (int i = 0; i < gridView1.DataRowCount; i++)
                {
                    gridView1.FocusedRowHandle = i;

                    credito = credito + Convert.ToDecimal(gridView1.GetFocusedRowCellValue("credito"));
                    debito = debito + Convert.ToDecimal(gridView1.GetFocusedRowCellValue("debito"));
                }

                TxtDebito.EditValue = debito;
                TxtCredito.EditValue = credito;

                if (debito != credito)
                {
                    MessageBox.Show("Créditos y débitos no cuadran", "Error de Cuadre", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    error++;
                }
                else if (debito == 0 && credito == 0)
                {
                    MessageBox.Show("Totales no pueden estar en Cero", "Totales Incorrectos", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    error++;
                }
            }
            catch (Exception ex)
            {
                log.Error("Error al totalizar cuentas");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error  al totalizar cuentas" + ex.ToString());
                error++;
                return;
            }
        }

        private void ActualizaGrid()
        {
            // Limpia el contenido actual del grid
            GrdPlanilla.DataSource = null;
            TotalCreditos = 0;
            TotalDebitos = 0;
            ContadorTC = 0;
            int contadordebitos = 0;

            try
            {
                if (dsFromXls.Tables.Count > 2)
                {
                    dsFromXls.Tables.Remove("DetallePlanilla");
                }

                //crea un nuevo datatable dentro del dataset y lo llena
                dsFromXls.Tables.Add("DetallePlanilla");
                dsFromXls.Tables["DetallePlanilla"].Columns.Add("secuencia", typeof(string));
                dsFromXls.Tables["DetallePlanilla"].Columns.Add("cuenta", typeof(string));
                dsFromXls.Tables["DetallePlanilla"].Columns.Add("nombre", typeof(string));
                dsFromXls.Tables["DetallePlanilla"].Columns.Add("debito", typeof(decimal));
                dsFromXls.Tables["DetallePlanilla"].Columns.Add("credito", typeof(decimal));
                dsFromXls.Tables["DetallePlanilla"].Columns.Add("concepto", typeof(string));
                dsFromXls.Tables["DetallePlanilla"].Columns.Add("tipo", typeof(string));

                for (int i = 0; i < dsFromXls.Tables[0].Rows.Count; i++)
                {
                    DataRow dr = dsFromXls.Tables["DetallePlanilla"].NewRow();
                    dr["secuencia"] = dsFromXls.Tables[0].Rows[i][0].ToString();
                    dr["cuenta"] = dsFromXls.Tables[0].Rows[i][1].ToString();
                    dr["nombre"] = dsFromXls.Tables[0].Rows[i][4].ToString();
                    if (Convert.ToInt64(dsFromXls.Tables[0].Rows[i][2].ToString()) == 2)
                    {
                        dr["debito"] = Convert.ToDecimal(dsFromXls.Tables[0].Rows[i][3].ToString());
                        TotalDebitos++;
                        contadordebitos++;
                    }
                    else
                        dr["debito"] = "0.00";
                    if (Convert.ToInt64(dsFromXls.Tables[0].Rows[i][2].ToString()) == 1)
                    {
                        dr["credito"] = Convert.ToDecimal(dsFromXls.Tables[0].Rows[i][3].ToString());
                        TotalCreditos++;
                        if (dsFromXls.Tables[0].Rows[i][1].ToString().Length >= LongitudTC)
                        {
                            //int count = dsFromXls.Tables[0].Rows[i][1].ToString().Length;
                            ContadorTC++;
                        }
                    }
                    else
                        dr["credito"] = "0.00";
                    dr["concepto"] = "PAGO PLANILLA";
                    dr["tipo"] = dsFromXls.Tables[0].Rows[i][5].ToString();
                    dsFromXls.Tables["DetallePlanilla"].Rows.Add(dr);
                }

                GrdPlanilla.DataSource = dsFromXls.Tables["DetallePlanilla"];

                if (contadordebitos > 1)
                {
                    MessageBox.Show("Solo puede Venir una cuenta de Debito dentro del archivo", "Cantidad de Debitos Incorrecto", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    error++;
                }
            }
            catch (Exception ex)
            {
                log.Error("Error al Actualizar Grid");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al Actualizar Grid" + ex.ToString());
                error++;
            }
        }

