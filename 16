        private void EjecutaPGM()//ejecuta los calls al as400
        {
            resp_call = string.Empty;
            string Codigo = string.Empty;

            OleDbConnection Conn = new OleDbConnection(_cnnAS400);
            try
            {
                OleDbCommand cmdCuentas = new OleDbCommand("{{CALL BPPGM/GAMAT200R(?,?,?,?,?)}}", Conn);
                cmdCuentas.CommandType = CommandType.Text;

                OleDbParameter oCodigoAplicacion = new OleDbParameter("$APLCOD", OleDbType.Char, 15); //Parametro Nombre Archivo
                oCodigoAplicacion.Value = Service;
                oCodigoAplicacion.Direction = ParameterDirection.Input;

                OleDbParameter oLote = new OleDbParameter("$NOLOTE_Chr", OleDbType.Char, 10); //Parametro Nombre Archivo
                oLote.Value = Lote.ToString();
                oLote.Direction = ParameterDirection.Input;

                OleDbParameter oCodErr = new OleDbParameter("$CODERR", OleDbType.Char, 1); //Parametro Error 
                oCodErr.Value = "";
                oCodErr.Direction = ParameterDirection.Output;

                OleDbParameter oErrorP = new OleDbParameter("$MSGERR", OleDbType.Char, 40); //Parametro Error 
                oErrorP.Value = "";
                oErrorP.Direction = ParameterDirection.Output;

                OleDbParameter oNoArchivo = new OleDbParameter("$APLPR002", OleDbType.Char, 100); //Parametro Nombre Archivo
                oNoArchivo.Value = FileName;
                oNoArchivo.Direction = ParameterDirection.Input;

                cmdCuentas.Parameters.Add(oCodigoAplicacion);//Agregamos los prámetros
                cmdCuentas.Parameters.Add(oLote);
                cmdCuentas.Parameters.Add(oCodErr);
                cmdCuentas.Parameters.Add(oErrorP);
                cmdCuentas.Parameters.Add(oNoArchivo);

                if (Conn.State != ConnectionState.Open)
                    Conn.Open();

                OleDbCommand oCmdLIBLE = new OleDbCommand(); //Agregamos a la conexión las librerías que se ocupará el programa.
                oCmdLIBLE.CommandType = CommandType.Text;
                oCmdLIBLE.Connection = Conn;

                oCmdLIBLE.CommandText = "{{CALL PGM(QSYS/QCMDEXC) PARM('CHGLIBL LIBL(*NONE)' 30)}}";
                oCmdLIBLE.ExecuteNonQuery();
                oCmdLIBLE.CommandText = "{{CALL PGM(QSYS/QCMDEXC) PARM('ADDLIBLE LIB(BPDAT)' 30)}}";
                oCmdLIBLE.ExecuteNonQuery();
                oCmdLIBLE.CommandText = "{{CALL PGM(QSYS/QCMDEXC) PARM('ADDLIBLE LIB(DP053DAT)' 30)}}";
                oCmdLIBLE.ExecuteNonQuery();
                oCmdLIBLE.CommandText = "{{CALL PGM(QSYS/QCMDEXC) PARM('ADDLIBLE LIB(BPPGM)' 30)}}";
                oCmdLIBLE.ExecuteNonQuery();
                oCmdLIBLE.CommandText = "{{CALL PGM(QSYS/QCMDEXC) PARM('ADDLIBLE LIB(V5DPDTAQ)' 30)}}";
                oCmdLIBLE.ExecuteNonQuery();
                oCmdLIBLE.CommandText = "{{CALL PGM(QSYS/QCMDEXC) PARM('ADDLIBLE LIB(V5DPJOUR)' 30)}}";
                oCmdLIBLE.ExecuteNonQuery();
                oCmdLIBLE.CommandText = "{{CALL PGM(QSYS/QCMDEXC) PARM('ADDLIBLE LIB(IB054PGM)' 30)}}";
                oCmdLIBLE.ExecuteNonQuery();
                oCmdLIBLE.CommandText = "{{CALL PGM(QSYS/QCMDEXC) PARM('ADDLIBLE LIB(IB054DAT)' 30)}}";
                oCmdLIBLE.ExecuteNonQuery();
                oCmdLIBLE.CommandText = "{{CALL PGM(QSYS/QCMDEXC) PARM('ADDLIBLE LIB(DP053PGM)' 30)}}";
                oCmdLIBLE.ExecuteNonQuery();
                oCmdLIBLE.CommandText = "{{CALL PGM(QSYS/QCMDEXC) PARM('ADDLIBLE LIB(CLIPGM)' 30)}}";
                oCmdLIBLE.ExecuteNonQuery();
                cmdCuentas.ExecuteNonQuery();
                resp_call = cmdCuentas.Parameters["$MSGERR"].Value.ToString();
                Codigo = cmdCuentas.Parameters["$CODERR"].Value.ToString();

                //if (resp_call != "")
                if (Codigo != "0" && Codigo != "")
                {
                    this.ValidacionesAS400();
                    MessageBox.Show("Se ha encontrado el siguiente error: " + "'" + resp_call + "'" + "  al llamar el programa del AS400", "Transacciones Bancarias", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    error++;
                }
            }
            catch (Exception ex)
            {
                log.Error("Error al llamar Programa del AS400  ");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al llamar Programa del AS400  " + ex.Message.ToString(), "Transacciones Bancarias", MessageBoxButtons.OK, MessageBoxIcon.Error);
                error++;
            }
            finally
            {
                if (Conn.State == ConnectionState.Open)
                {
                    Conn.Close();
                    Conn.Dispose();
                }
            }
        }

