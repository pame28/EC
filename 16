using api_otp_notifica.Service.Interface;
using Microsoft.AspNetCore.Mvc;
using api_otp_notifica.Utils;
using System.Text.Json;

namespace api_otp_notifica.Controllers.Notifications
{
    [Route("api/[controller]")]
    [ApiController]
    public class OTP_NOTIFICATIONSController : ControllerBase
    {
        private readonly IOtpNotificationService _notificationService;
        private readonly MessageResponseFn _messageResponseFn;
        private readonly ILogger<OTP_NOTIFICATIONSController> _logger;
        public OTP_NOTIFICATIONSController(IOtpNotificationService notificationService, MessageResponseFn messageResponseFn, ILogger<OTP_NOTIFICATIONSController> logger)
        {
            _notificationService = notificationService;
            _messageResponseFn = messageResponseFn; 
            _logger = logger;
        }

        // POST api/OTP_NOTIFICATIONController
        [HttpPost]
        public async Task<IActionResult> Post([FromBody] OtpRequestDto request)
        {
            try
            {
                _logger.LogInformation("***** Petición de OTP_NOTIFICATIONS de token {request}*****", JsonSerializer.Serialize(request));

                if (!ModelState.IsValid)
                {
                    var responseError = _messageResponseFn.MessageResponseFromModelState(ModelState);
                    return BadRequest(responseError);
                }

                ResponseMessages response = await _notificationService.SendOtpAsync(request);

                _logger.LogInformation("***** Respuesta de la petición {Response} *****", JsonSerializer.Serialize(response));

                return StatusCode(response.Status,response);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error crítico no controlado en el controlador OTP");
                ResponseMessages response = await _messageResponseFn.MessageResponseError(Constantes.STATUS_ERROR);
                return StatusCode(Constantes.STATUS_ERROR, response);
            }
        }
    }
}









