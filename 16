        private void BuildTextFile(string TipoArchivo, DataTable Fuente)
        {
            try
            {
                System.IO.FileStream wFile;
                byte[] byteData = new byte[0];
                FileName = TipoArchivo + Service + Lote.ToString().PadLeft(10, '0') + ".TXT";
                Dierctorio = Properties.Settings.Default.Source;
                if (!Directory.Exists(Dierctorio))
                    Directory.CreateDirectory(Dierctorio);

                if (File.Exists(Dierctorio + @"\" + FileName))
                    File.Delete(Dierctorio + @"\" + FileName);

                wFile = new FileStream(Dierctorio + @"\" + FileName, FileMode.Append);
                //FOR QUE RECORRE EL DATATABLE DONDE SE ALMACENO LA RESPUESTA DEL QUERY EJECUTADO
                for (int i = 0; i < Fuente.Rows.Count; i++)
                {
                    //FOR QUE RECORRE LAS COLUMNAS DEL DATATABLE DONDE SE ALMACENO LA RESPUESTA DEL QUERY EJECUTADO
                    for (int f = 0; f < Fuente.Columns.Count; f++)
                    {
                        //VALIDA HASTA CUANDO ES LA PENULTIMA COLUMNA PARA INSERTAR EL SEPARADOR
                        if (f == (Fuente.Columns.Count) - 1)
                        {
                            byteData = Encoding.ASCII.GetBytes(Fuente.Rows[i][f].ToString());
                        }
                        //SINO LE INSERTA EL SEPARADOR A LAS COLUMNAS
                        else
                        {
                            byteData = Encoding.ASCII.GetBytes(Fuente.Rows[i][f].ToString() + '|');
                        }
                        //ESCRIBE LOS DATOS DENTRO DE LA FILA
                        wFile.Write(byteData, 0, byteData.Length);
                        byteData = new byte[0];
                    }
                    //AGREGA UNA NUEVA FILA CUANDO HA RECORRIDO TODAS LAS COLUMNAS
                    byteData = Encoding.ASCII.GetBytes(Environment.NewLine);
                    wFile.Write(byteData, 0, byteData.Length);
                }
                wFile.Close();
            }
            catch (Exception ex)
            {
                log.Error("Error al Construir Archivo de Texto");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al Construir Archivo de Texto" + Environment.NewLine + ex.Message.ToString(), "", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

