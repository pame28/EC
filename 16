// Paso 1 — Eliminar archivos previos en la carpeta destino
// incluyendo zips de ejecuciones anteriores
if (Directory.Exists(destinationDirectory))
{
    // Eliminar archivos sueltos en la raíz
    foreach (string file in Directory.GetFiles(destinationDirectory))
        File.Delete(file);

    // ✅ Eliminar también carpetas de fechas anteriores si quedaron
    foreach (string dir in Directory.GetDirectories(destinationDirectory))
    {
        // Solo elimina carpetas con formato de fecha yyyy-MM-dd
        string nombreDir = Path.GetFileName(dir);
        if (DateTime.TryParse(nombreDir, out _))
            Directory.Delete(dir, true);
    }
}