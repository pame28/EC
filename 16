        private void ProcesoValidacion()
        {
            if (TotalDebitos > 0 && TotalCreditos > 0)
            {
                this.ActualizaEstatus("VL");
                if (error == 0)
                {
                    this.crearcamposDT();
                    this.ActualizaProgressBar(20);
                }
                if (error == 0)
                {
                    this.ValidaNumerosCuentasEnCero();
                    if (ContadorTC > 0)
                        this.ValidacionesTC();
                    if (error == 0)
                    {
                        this.llenarDTFileText();
                        this.ActualizaProgressBar(40);
                    }
                }
                if (error == 0)
                {
                    this.BuildTextFile("VS", FileText);
                    this.ActualizaProgressBar(60);
                }
                if (error == 0)
                {
                    if (UploadToAS400(Dierctorio + @"\" + FileName, ".txt", true, true, Properties.Settings.Default.Destino, Properties.Settings.Default.Source + @"\", Properties.Settings.Default.ServidorDB2))
                    {
                        this.ActualizaProgressBar(80);
                        this.EjecutaPGM();

                        this.ActualizaProgressBar(90);
                        if (error == 0)
                        {
                            this.ActualizaEstatus("V");
                            this.ActualizaProgressBar(100);
                        }
                    }
                    else
                        error++;
                }
            }
            else
            {
                MessageBox.Show("Debitos y Creditos con valor Cero", "Error en Montos", MessageBoxButtons.OK, MessageBoxIcon.Error);
                ErrorDebito++;
                error++;
            }
        }

