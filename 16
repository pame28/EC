        private void ValidaCampos()
        {
            if (CboTipoOperacion.Text == null || CboTipoOperacion.Text == "")
            {
                MessageBox.Show("Debe de seleccionar Tipo de Operacion", "Advertencia", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                BtnCargar.Enabled = true;
                error++;
                return;
            }
            if ((CboTipoOperacion.Text == "Crédito" || CboTipoOperacion.Text == "Crédito y Débito") && CboCredito.EditValue == null)
            {
                MessageBox.Show("Debe de seleccionar transacción de Crédito", "Advertencia", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                BtnCargar.Enabled = true;
                error++;
                return;
            }
            if ((CboTipoOperacion.Text == "Débito" || CboTipoOperacion.Text == "Crédito y Débito") && CboDebito.EditValue == null)
            {
                MessageBox.Show("Debe seleccionar transacción de Débito", "Advertencia", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                BtnCargar.Enabled = true;
                error++;
                return;
            }
            if ((CboTipoOperacion.Text == "Crédito" || CboTipoOperacion.Text == "Crédito y Débito") && CboMotivoCredito.EditValue == null)
            {
                MessageBox.Show("Debe seleccionar motivo de Crédito", "Advertencia", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                BtnCargar.Enabled = true;
                error++;
                return;
            }
            if ((CboTipoOperacion.Text == "Débito" || CboTipoOperacion.Text == "Crédito y Débito") && CboMotivoDebito.EditValue == null)
            {
                MessageBox.Show("Debe seleccionar Motivo de Débito", "Advertencia", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                BtnCargar.Enabled = true;
                error++;
                return;
            }
            if (CboMonedas.EditValue == null)
            {
                MessageBox.Show("Debe de seleccionar una moneda", "Advertencia", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                BtnCargar.Enabled = true;
                error++;
                return;
            }
            if (TxtObservacion.Text.Length < 13)
            {
                MessageBox.Show("Observación debe ser mas específica", "Advertencia", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                BtnCargar.Enabled = true;
                error++;
                return;
            }
            if (TxtObservacion.Text.Length > 40)
