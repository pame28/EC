        private void cargarexcel()//abre la conexion para cargar archivo
        {
            try
            {
                String _Path;

                OpenFileDialog openFileDialog1 = new OpenFileDialog();
                openFileDialog1.Filter = "Archivos Excel (*.xls;*.xlsx;*.ods)|*.xls; *.xlsx; *.ods";
                if (openFileDialog1.ShowDialog() == DialogResult.OK)
                {
                    resp_open = true;
                    _Path = openFileDialog1.FileName.ToString();
                    if (_Path.Length > 0)
                    {
                        SpreadsheetGear.IWorkbook wbk = SpreadsheetGear.Factory.GetWorkbook(_Path, new System.Globalization.CultureInfo("es-HN"));     //Cargar Archivo de Excell
                        SpreadsheetGear.IWorksheet wst = wbk.Worksheets[0];
                        dsFromXls = wst.UsedRange.GetDataSet(SpreadsheetGear.Data.GetDataFlags.FormattedText);
                        dsFromXls.Tables[0].Columns.Add("Secuencia").SetOrdinal(0);//agregamos campo numero de fila 
                        dsFromXls.Tables[0].Columns.Add("TipoCuenta").SetOrdinal(5);//agregamos campo para tipo de cuenta 

                        if (dsFromXls.Tables[0].Rows.Count <= 25000)
                        {
                            for (int i = 0; i < dsFromXls.Tables[0].Rows.Count; i++)//llenamos campo numero de fila 
                            {
                                dsFromXls.Tables[0].Rows[i][0] = i + 1;
                                if (dsFromXls.Tables[0].Rows[i][1].ToString() == "")
                                {
                                    dsFromXls.Tables[0].Rows[i].Delete();
                                }
                            }
                        }
                        else
                        {
                            MessageBox.Show("Solo puede cargar archivos con un maximo de 25,000 registros", "Exceso de registros", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                            error++;
                        }
                    }
                }
                else
                {
                    MessageBox.Show("No se ha seleccionado ningun archivo", "Accion Cancelada", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    resp_open = false;
                }
            }
            catch (Exception ex)
            {
                log.Error("Error al importar archivo de excel con SpreadsheetGear");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al importar archivo de excel con SpreadsheetGear" + ex.ToString());
                error++;
            }
        }

