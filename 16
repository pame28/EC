        private void sendemail()
        {
            try
            {
                String NotificationsMails = string.Empty;
                DataTable respuesta = new DataTable();
                String conexion = Properties.Settings.Default.ConnectionDB;

                string Query = "EXEC Usp_GetNotificactionsMails '{0}',{1}";

                Query = string.Format(Query, Properties.Settings.Default.Zona, Properties.Settings.Default.Area);

                Query = Criptografia.EncryptQueryString(Query, Properties.Settings.Default.Encryp, "|");

                if (Criptografia.error == 0)
                {
                    respuesta = Proxy.QuerySQL(Query, conexion, "sendemail");
                    error = error  + Proxy.error;
                }
                if (respuesta.Rows.Count > 0)
                {
                    if (respuesta.Rows[0][0].ToString().Length > 0)
                    {
                        NotificationsMails = respuesta.Rows[0][0].ToString();

                        // DECLARA EL OBJETO PARA ENVIAR CORREOS
                        MailMessage objeto_mail = new MailMessage();
                        SmtpClient client = new SmtpClient();

                        //OBTIENE LOS PARAMETROS PARA ASIGNAR AL OBJETO SMTPCLIENT           
                        string MailServer = Properties.Settings.Default.MailServer;
                        int MailServerPort = Properties.Settings.Default.MailServerPort;

                        //OBTIENE LOS PARAMETROS PARA ASIGNAR AL OBJETO MAILMESSAGE  
                        string CorreoOrigen = Properties.Settings.Default.MailFrom;
                        string correodestino = NotificationsMails;
                        string[] cuenta = CorreoOrigen.Split('@');
                        string acount = cuenta[0];
                        string MailMsg = "El Usuario: " + Properties.Settings.Default.UsuarioLogueado + " ha realizado un débito por: Lps " + TxtDebito.Text + " al cliente : " + CboClientes.Text; //Properties.Settings.Default.MailMessage;

                        //ASIGNA LOS PARAMETROS AL OBJETO SMTPCLIENT
                        client.Host = MailServer;
                        client.Port = MailServerPort;
                        client.Timeout = 300;
                        client.DeliveryMethod = SmtpDeliveryMethod.Network;
                        client.UseDefaultCredentials = false;
                        client.Credentials = new System.Net.NetworkCredential(acount, "");

                        //ASIGNA LOS PARAMETROS AL OBJETO MAILMESSAGE
                        objeto_mail.From = new MailAddress(CorreoOrigen);
                        foreach (var address in correodestino.Split(';'))
                        {
                            objeto_mail.To.Add(new MailAddress(address, ""));
                        }
                        //objeto_mail.To.Add(new MailAddress(correodestino));
                        objeto_mail.Subject = "Debito Duplicado a cliente " + CboClientes.Text;
                        objeto_mail.Body = MailMsg;

                        ////ASIGNA LOS ARCHIVOS ADJUNTOS AL MENSAJE
                        //System.Net.Mail.Attachment attachment;
                        //attachment = new System.Net.Mail.Attachment(txt);
                        //objeto_mail.Attachments.Add(attachment);

                        //ENVIA EL MENSAJE POR EMAIL
                        client.Send(objeto_mail);
                    }
                }
            }
            catch (Exception ex)
            {
                log.Error("Error al enviar mensaje de Notificación ");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al enviar mensaje de Notificación " + ex.ToString());
                error++;

            }
        }

