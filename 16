using plantilla_microservicios_repository.Infrastructure.Data;
using plantilla_microservicios_repository.Models.Validations;
using plantilla_microservicios_repository.Repository.Interface;

namespace plantilla_microservicios_repository.Repository
{
    public class ValidationsRepositoryImp : IValidationsRepository
    {
        private readonly DBHelper _dbHelper;
        public ValidationsRepositoryImp(DBHelper dbHelper)
        {
            _dbHelper = dbHelper;
        }

        public async Task<Parametros> GetByCode(string clave)
        {
            try
            {
                using var reader = await _dbHelper.ExecuteReaderAsync("getParametroByClave",
                    new Dictionary<string, object> { { "@Clave", clave } });

                while (await reader.ReadAsync())
                {
                    return new Parametros
                    {
                        clave = reader.GetString(0),
                        valor = reader.GetString(1)
                    };  
                }
                return new Parametros();
            }
            catch (Exception ex)
            {
                throw new InvalidOperationException($"{ex.Message}");
            }
        }
    }
}




