namespace ApiPaymentPlan.Service
{
    public class KeyProvider : IHostedService
    {
        private readonly HttpClient _httpClient;
        private readonly ILogger<KeyProvider> _logger;
        private readonly string _endointApiKey;
        public static string Key { get; private set; } = string.Empty;

        public KeyProvider(HttpClient httpClient, ILogger<KeyProvider> logger, IConfiguration configuration)
        {
            _httpClient = httpClient;
            _logger = logger;
            _endointApiKey = configuration["ApiSettings:EndpointGeKey"]
                ?? throw new ArgumentNullException(nameof(configuration), "EndpointGeKey no puede ser nulo");
        }

        public async Task StartAsync(CancellationToken cancellationToken)
        {
            try
            {
                var response = await _httpClient.GetFromJsonAsync<KeyResponse>(
                    _endointApiKey,
                    cancellationToken);

                if (response != null)
                {
                    Key = response.authorization;
                    _logger.LogInformation("Key inicializada correctamente");
                }
            }
            catch (Exception ex)
            {
                // Se envuelve con contexto en vez de solo loguear y relanzar la misma excepción,
                // evitando log duplicado en niveles superiores.
                throw new InvalidOperationException("Error obteniendo la key al iniciar el servicio", ex);
            }
        }

        public Task StopAsync(CancellationToken cancellationToken) => Task.CompletedTask;
    }

    public class KeyResponse
    {
        public string authorization { get; set; } = string.Empty;
    }
}