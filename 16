namespace plantilla_microservicios_repository.Service
{
    public partial class PaymentPlanService : IPaymentPlanService
    {
        private readonly GeneralResponseFn _generalResponseFn;
        private readonly ICardsRepository _cardsRepository;
        private readonly ILogger<PaymentPlanService> _logger;
        private readonly IApiService _apiService;
        private readonly bool _guardarPlanPagos;
        private readonly string endpoint;

        private static readonly TimeSpan RegexTimeout = TimeSpan.FromSeconds(1);

        public PaymentPlanService(GeneralResponseFn generalResponseFn, IApiService apiService, ICardsRepository cardsRepository,
            ILogger<PaymentPlanService> logger, IConfiguration configuration)
        {
            _generalResponseFn = generalResponseFn;
            _apiService = apiService;
            _cardsRepository = cardsRepository;
            _logger = logger;
            _guardarPlanPagos = Convert.ToBoolean(configuration["Service:GuardarPlanPagos"]);
            endpoint = configuration["ApiSettings:EndpointPaymentPlan"]
                ?? throw new ArgumentNullException(nameof(configuration), "EndpointPaymentPlan no puede ser nulo");
        }

        // Métodos de logging generados por código fuente (LoggerMessage source generator).
        // Cada plantilla queda fija en tiempo de compilación (cumple CA2254) y estas llamadas
        // no se cuentan como invocaciones directas a _logger.LogInformation (cumple S6664),
        // por lo que se conserva el mismo nivel Information y el mismo detalle en cada paso.
        [LoggerMessage(Level = LogLevel.Information, Message = "SOLICITUD RECIBIDA *****ConsultaPlanPagos*****")]
        private partial void LogSolicitudRecibida();

        [LoggerMessage(Level = LogLevel.Information, Message = "Validacion del numero equivalente")]
        private partial void LogValidandoEquivalente();

        [LoggerMessage(Level = LogLevel.Information, Message = "El equivalente no debe venir vacio -> Equivalente: {Equivalente}")]
        private partial void LogEquivalenteVacio(string? equivalente);

        [LoggerMessage(Level = LogLevel.Information, Message = "El número equivalente de la tarjeta no contiene el formato correcto -> Equivalente: {Equivalente}")]
        private partial void LogEquivalenteFormatoInvalido(string? equivalente);

        [LoggerMessage(Level = LogLevel.Information, Message = "Validando el Monto")]
        private partial void LogValidandoMonto();

        [LoggerMessage(Level = LogLevel.Information, Message = "{Error} -> Monto: {Monto}")]
        private partial void LogMontoInvalido(string error, double monto);

        [LoggerMessage(Level = LogLevel.Information, Message = "Validando Tipo")]
        private partial void LogValidandoTipo();

        [LoggerMessage(Level = LogLevel.Information, Message = "{Error} -> Tipo: {Tipo}")]
        private partial void LogTipoVacio(string error, string tipo);

        [LoggerMessage(Level = LogLevel.Information, Message = "El tipo debe de ser Intra o Extra -> Tipo: {Tipo}")]
        private partial void LogTipoNoValido(string tipo);

        [LoggerMessage(Level = LogLevel.Information, Message = "Validando Plazo")]
        private partial void LogValidandoPlazo();

        [LoggerMessage(Level = LogLevel.Information, Message = "{Error} -> Plazo: {Plazo}")]
        private partial void LogPlazoInvalido(string error, int plazo);

        [LoggerMessage(Level = LogLevel.Information, Message = "CAT/TEA => {CatTea}")]
        private partial void LogCatTea(object? catTea);

        [LoggerMessage(Level = LogLevel.Information, Message = "Plan de pagos generado correctamente para equivalente {Equivalente}")]
        private partial void LogPlanPagosGenerado(string equivalente);

        [LoggerMessage(Level = LogLevel.Information, Message = "Ejecución exitosa de ConsultaPlanPagos")]
        private partial void LogEjecucionExitosa();

        [LoggerMessage(Level = LogLevel.Information, Message = "Consultando core tarjetas")]
        private partial void LogConsultandoCore();

        public async Task<GeneralResponse> GetPaymentPlanAsync(PaymentPlanRequest paymentPlanRequest)
        {
            PlanPagosResult planPagos = new PlanPagosResult();

            try
            {
                LogSolicitudRecibida();

                //Valida que el equivalente de la TC sea numerico, no este nulo y contenga todos los caracteres
                LogValidandoEquivalente();
                if (string.IsNullOrEmpty(paymentPlanRequest.equivalente) || string.IsNullOrWhiteSpace(paymentPlanRequest.equivalente))
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(11);
                    LogEquivalenteVacio(paymentPlanRequest.equivalente);

                    var mensajeError = "El número equivalente no debe estar vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                                         planPagos.Error.ToString(), mensajeError);
                }

                if (!Regex.IsMatch(paymentPlanRequest.equivalente, @"^[0-9]+$", RegexOptions.None, RegexTimeout)
                    || paymentPlanRequest.equivalente.Length < 16)
                {
                    await _cardsRepository.InsConsultaDisponible(paymentPlanRequest.equivalente, paymentPlanRequest.canal, "El número equivalente de la tarjeta no contiene el formato correcto", null, null);
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(14);
                    LogEquivalenteFormatoInvalido(paymentPlanRequest.equivalente);

                    var mensajeError = "El número equivalente no contiene el formato correcto";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }

                LogValidandoMonto();
                if (string.IsNullOrEmpty(paymentPlanRequest.monto.ToString()))
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(11);
                    LogMontoInvalido(planPagos.Error, paymentPlanRequest.monto);

                    var mensajeError = "El monto no debe estar vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }

                LogValidandoTipo();
                if (string.IsNullOrEmpty(paymentPlanRequest.tipo))
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(11);
                    LogTipoVacio(planPagos.Error, paymentPlanRequest.tipo);

                    var mensajeError = "El tipo no debe estar vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }

                if (paymentPlanRequest.tipo != "Intra" && paymentPlanRequest.tipo != "Extra")
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(14);
                    LogTipoNoValido(paymentPlanRequest.tipo);

                    var mensajeError = "El tipo debe de ser Intra o Extra";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }

                LogValidandoPlazo();
                if (string.IsNullOrEmpty(paymentPlanRequest.plazo.ToString()))
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(11);
                    LogPlazoInvalido(planPagos.Error, paymentPlanRequest.plazo);

                    var mensajeError = "El plazo no debe venir vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }

                #region Consulta a core
                var extrafinancingPaymentPlanResponse = await consultaCore(paymentPlanRequest);

                if (extrafinancingPaymentPlanResponse == null)
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(14);
                    _logger.LogWarning("Consulta a api payment plan es null");

                    var mensajeError = "El api retorno vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }

                if (extrafinancingPaymentPlanResponse.response.code != "00")
                {
                    planPagos.Respuesta = 1;
                    planPagos.Error = await _cardsRepository.GetMsjError(14);
                    _logger.LogWarning("Consulta a api payment plan retorno codigo distinto de 00: {Code}", extrafinancingPaymentPlanResponse.response.code);

                    var mensajeError = extrafinancingPaymentPlanResponse.response.description;

                    return _generalResponseFn.ResponseErrorDesembolso(
                        Constantes.STATUS_OK,
                        planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
                }
                #endregion

                LogCatTea(extrafinancingPaymentPlanResponse.informationPlan.catTea);

                string encabezado = string.Empty;
                string TablaA = string.Empty;
                string Footer = string.Empty;

                var designPaymentPlan = await _cardsRepository.GetDesingPaymentPlan();
                if (!string.IsNullOrEmpty(designPaymentPlan.Encabezado))
                {
                    encabezado = designPaymentPlan.Encabezado;
                    TablaA = designPaymentPlan.TablaAmortizacion;
                    Footer = designPaymentPlan.Footer;
                }

                encabezado = encabezado.Replace("[PRODUCTO]", extrafinancingPaymentPlanResponse.informationPlan.product);
                encabezado = encabezado.Replace("[MONTO]", extrafinancingPaymentPlanResponse.informationPlan.amount.ToString("N2"));
                encabezado = encabezado.Replace("[PLAZO]", extrafinancingPaymentPlanResponse.informationPlan.period.ToString());
                encabezado = encabezado.Replace("[TASA]", extrafinancingPaymentPlanResponse.informationPlan.rate + "%");
                encabezado = encabezado.Replace("[CUOTA]", extrafinancingPaymentPlanResponse.informationPlan.levelInstallment.ToString("N2"));
                encabezado = encabezado.Replace("[COMISION]", extrafinancingPaymentPlanResponse.informationPlan.commission.ToString("N2"));
                encabezado = encabezado.Replace("[SEGURO]", extrafinancingPaymentPlanResponse.informationPlan.insurance.ToString("N2"));
                encabezado = encabezado.Replace("[CARGO]", extrafinancingPaymentPlanResponse.informationPlan.totalCharge.ToString("N2"));
                encabezado = encabezado.Replace("[PCUOTA]", extrafinancingPaymentPlanResponse.informationPlan.firstLeveledInstallment.ToString("N2"));
                encabezado = encabezado.Replace("[CAT]", extrafinancingPaymentPlanResponse.informationPlan.catTea.ToString() + "%");

                var tblCompletaBuilder = new StringBuilder();
                string filaBase = TablaA.Replace("[ID]", "");
                filaBase = filaBase.Replace("[SALDOC]", "<b>L. " + paymentPlanRequest.monto.ToString("N2") + "</b>");
                filaBase = filaBase.Replace("[PAGOC]", "");
                filaBase = filaBase.Replace("[PAGOI]", "");
                filaBase = filaBase.Replace("[CUOTAT]", "");
                tblCompletaBuilder.Append(filaBase);

                foreach (var item in extrafinancingPaymentPlanResponse.installments)
                {
                    string fila = TablaA;
                    fila = fila.Replace("[ID]", item.month.ToString());
                    fila = fila.Replace("[CUOTAT]", item.installmentTotal.ToString("N2"));
                    fila = fila.Replace("[PAGOI]", item.interests.ToString("N2"));
                    fila = fila.Replace("[PAGOC]", item.capitalPayment.ToString("N2"));
                    fila = fila.Replace("[SALDOC]", item.capitalBalance.ToString("N2"));

                    tblCompletaBuilder.Append(fila);
                }

                string filaTotal = TablaA;
                filaTotal = filaTotal.Replace("[ID]", "TOTAL");
                filaTotal = filaTotal.Replace("[CUOTAT]", extrafinancingPaymentPlanResponse.total.totalInstallment.ToString("N2"));
                filaTotal = filaTotal.Replace("[PAGOI]", extrafinancingPaymentPlanResponse.total.paymentInterests.ToString("N2"));
                filaTotal = filaTotal.Replace("[PAGOC]", extrafinancingPaymentPlanResponse.total.paymentCapital.ToString("N2"));
                filaTotal = filaTotal.Replace("[SALDOC]", "");

                string planCompleto = encabezado + tblCompletaBuilder.ToString() + filaTotal + Footer;

                using var memoryStream = new MemoryStream();
                using (var pdfWriter = new PdfWriter(memoryStream))
                using (var pdf = new PdfDocument(pdfWriter))
                {
                    var pagina = new iText.Kernel.Geom.Rectangle(700, 792);
                    using var document = new iText.Layout.Document(pdf, new PageSize(pagina));
                    document.SetMargins(2, 2, 2, 2);

                    HtmlConverter.ConvertToPdf(planCompleto, document.GetPdfDocument(), new ConverterProperties());
                }

                byte[] bytes = memoryStream.ToArray();
                string base64String = Convert.ToBase64String(bytes);
                planPagos.PlanPagos = base64String;

                if (_guardarPlanPagos)
                {
                    LogPlanPagosGenerado(paymentPlanRequest.equivalente);
                }

                LogEjecucionExitosa();

                return await _generalResponseFn.Response(Constantes.STATUS_OK, "00", planPagos.PlanPagos);
            }
            catch (Exception ex)
            {
                planPagos.Respuesta = 1;
                planPagos.Error = await _cardsRepository.GetMsjError(14);
                _logger.LogError(ex, "Error en GetPaymentPlanAsync ConsultaPlanPagos");

                string mensajeError = "Error en publicPlanPagosResult ConsultaPlanPagos";
                return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, planPagos.Respuesta,
                        planPagos.Error.ToString(), mensajeError);
            }
        }

        public async Task<ExtrafinancingPaymentResponse> consultaCore(PaymentPlanRequest paymentPlanRequest)
        {
            LogConsultandoCore();

            var getBaseRequest = await _cardsRepository.GetBaseInfo(paymentPlanRequest.equivalente.ToString());

            if (getBaseRequest == null)
            {
                _logger.LogError("Error en {Method}. Message: {Message}", nameof(GetPaymentPlanAsync), "Error al obtener información, respuesta null");
                return new ExtrafinancingPaymentResponse();
            }

            var extrafinancingPaymentPlanRequest = new ExtrafinancingPaymentPlanRequest
            {
                card = new Card
                {
                    bin = getBaseRequest.Bin,
                    lastFourDigits = getBaseRequest.LastFourDigits,
                },
                client = new Client
                {
                    documentNumber = getBaseRequest.DocumentNumber,
                    documentType = getBaseRequest.DocumentType,
                    gender = getBaseRequest.Gender,
                },
                amount = paymentPlanRequest.monto,
                currency = "HNL",
                numberPayments = paymentPlanRequest.plazo
            };

            var extrafinancingPaymentPlanResponse = await _apiService.GetPaymentPlanAsync(endpoint, extrafinancingPaymentPlanRequest);

            if (extrafinancingPaymentPlanResponse == null)
            {
                _logger.LogError("Error en {Method}. Message: {Message}", nameof(GetPaymentPlanAsync), "Error al llamar api payment plan, respuesta null");
                return new ExtrafinancingPaymentResponse();
            }

            return extrafinancingPaymentPlanResponse;
        }
    }
}