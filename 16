        private DataTable ValidarTC(DataTable Fuente)
        {
            DataTable Answer = new DataTable();

            try
            {
                using (SqlConnection conection = new SqlConnection(Properties.Settings.Default.ConnectionDB))
                {
                    conection.Open();
                    using (SqlCommand cmd = new SqlCommand("Usp_ValidaTarjetas"))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Connection = conection;
                        cmd.CommandTimeout = 300;
                        cmd.Parameters.AddWithValue("@Tabla", Fuente);
                        cmd.ExecuteNonQuery();
                        using (SqlDataAdapter adp = new SqlDataAdapter(cmd))
                        {
                            adp.Fill(Answer);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                log.Error("Error al Validar Tarjetas de Crédito");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al Validar Tarjetas de Crédito " + ex.ToString());
                error++;
            }
            return Answer;
        }

        private void RecalcularDebito()
        {
            try
            {
                TotalCreditos = 0;
                TotalDebitos = 0;
                String conexion = Properties.Settings.Default.ConnectionDB;

                for (int i = 0; i < Detalle.Rows.Count; i++)//RECALCULA MONTO TOTAL DE LOS CREDITOS
                {
                    if (Convert.ToInt32(Detalle.Rows[i]["TipoTrx"].ToString()) == 1 && Detalle.Rows[i]["Status"].ToString() != "E")
                    {
                        TotalCreditos = TotalCreditos + Convert.ToDecimal(Detalle.Rows[i]["Monto"].ToString());
                    }
                }

                for (int i = 0; i < Detalle.Rows.Count; i++)//RECALCULA MONTO TOTAL DE LOS DEBITOS
                {
                    if (Convert.ToInt32(Detalle.Rows[i]["TipoTrx"].ToString()) == 2)
                    {
                        TotalDebitos = TotalCreditos;
                        foreach (DataRow row in dsFromXls.Tables[0].Rows)
                        {
                            if (row[0].ToString() == Detalle.Rows[i]["Correlativo"].ToString())
                            {
                                row["Monto"] = TotalDebitos;
                            }
                        }

                        Detalle.Rows[i]["Monto"] = TotalDebitos;
                        TxtCredito.Text = TotalCreditos.ToString();
                        TxtDebito.Text = TotalDebitos.ToString();
                    }
                }

                //*******************ACTUALIZA EN SQL EL VALOR DE DEBITOS A COBRAR /****************
                string Query = "UPDATE LotesPlanillas SET CobroParcial= {0} WHERE IdLote= {1}";

                Query = string.Format(Query, TotalDebitos, Lote);

                Query = Criptografia.EncryptQueryString(Query, Properties.Settings.Default.Encryp, "|");

                if (Criptografia.error == 0)
                {
                    Proxy.QuerySQL(Query, conexion, "RecalcularDebito");
                    error = error  + Proxy.error;
                }
                //**********************************************************************************

                if (error == 0)
                {
                    //*******************ACTUALIZA EN SQL EL VALOR DE DEBITOS A COBRAR /****************
                    Query = "UPDATE DetallePlanillas SET Monto= {0} WHERE IdLote= {1} AND TipoTrx=2";

                    Query = string.Format(Query, TotalDebitos, Lote);

                    Query = Criptografia.EncryptQueryString(Query, Properties.Settings.Default.Encryp, "|");

                    if (Criptografia.error == 0)
                    {
                        Proxy.QuerySQL(Query, conexion, "RecalcularDebito");
                        error = error  + Proxy.error;
                    }
                    //**********************************************************************************

                }
                this.ActualizaGrid();
            }
            catch (Exception ex)
            {
                log.Error("Error al recalcular Debito");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al recalcular Debito" + ex.ToString());
                error++;
