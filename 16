-- =====================================================================================
-- Script de pruebas manuales para fn_SiguienteFechaCorte y usp_SincronizarFechaCorte
-- Ejecutar cada bloque por separado y revisar resultados antes de correr el DTSX real.
-- IMPORTANTE: correr contra un ambiente de pruebas, no contra produccion.
-- =====================================================================================


-- -----------------------------------------------------------------
-- 1. Probar la funcion de forma aislada
-- -----------------------------------------------------------------
SELECT dbo.fn_SiguienteFechaCorte('2026-05-06') AS Esperado_2026_05_10;
SELECT dbo.fn_SiguienteFechaCorte('2026-05-27') AS Esperado_2026_06_06;
SELECT dbo.fn_SiguienteFechaCorte('2026-12-27') AS Esperado_2027_01_06;
SELECT dbo.fn_SiguienteFechaCorte('2026-05-15') AS Esperado_NULL_dia_invalido;


-- -----------------------------------------------------------------
-- 2. Ver el estado actual antes de cualquier prueba
-- -----------------------------------------------------------------
SELECT * FROM [dbo].[ParametrosCorte] ORDER BY FechaCorte;
SELECT DISTINCT FechaCorte FROM [dbo].[BandejaEstadoCuenta];


-- -----------------------------------------------------------------
-- 3. Caso NORMAL: la fecha de bandeja coincide con la activa
--    (No debe modificar ParametrosCorte, @EsReproceso debe salir en 0)
-- -----------------------------------------------------------------
DECLARE @EsReproceso BIT, @FechaCorteProceso DATE;

EXEC [dbo].[usp_SincronizarFechaCorte]
    @EsReproceso = @EsReproceso OUTPUT,
    @FechaCorteProceso = @FechaCorteProceso OUTPUT;

SELECT @EsReproceso AS EsReproceso, @FechaCorteProceso AS FechaCorteProceso;


