#########################################################
# TEMPLATE DINÁMICO POR POD (ARCHIVO POR POD)
#########################################################
template(name="dynFileByPod" type="list") {
    constant(value="/syslog/pu-procesadortc-bp/")
    property(name="$!kubernetes!pod_name")
    constant(value=".log")
}

#########################################################
# TEMPLATE FORMATO LEGIBLE
#########################################################
template(name="openshiftPrettyLogs" type="list") {
    property(name="timereported" dateFormat="rfc3339")
    constant(value=" ")
    property(name="$!kubernetes!pod_name")
    constant(value=" ")
    property(name="$!log")
    constant(value="\n")
}

#########################################################
# REGLA PRINCIPAL
#########################################################
if ($msg contains "pu-procesadortc-bp") then {
    action(
        type="omfile"
        dynaFile="dynFileByPod"
        template="openshiftPrettyLogs"
    )
    stop
}

