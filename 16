using ApiTerms.Models;
using ApiTerms.Models.Extrafinancing;
using ApiTerms.Repository.Interface;
using ApiTerms.Service.Interface;
using plantilla_microservicios_repository.DTOs.Response;
using plantilla_microservicios_repository.Models;
using plantilla_microservicios_repository.Models.Extrafinancing;
using plantilla_microservicios_repository.Service.Interface;
using plantilla_microservicios_repository.Utils;
using System.Text.RegularExpressions;

namespace plantilla_microservicios_repository.Service
{
    public class TermsService : ITermsService
    {
        private readonly GeneralResponseFn _generalResponseFn;
        private readonly IApiTerms _apiService;
        private readonly ICardsRepository _cardsRepository;
        private readonly ILogger<TermsService> _logger;
        private readonly string endpoint;

        private static readonly TimeSpan RegexTimeout = TimeSpan.FromSeconds(1);

        public TermsService(GeneralResponseFn generalResponseFn, IApiTerms apiService, ICardsRepository cardsRepository, ILogger<TermsService> logger, IConfiguration configuration)
        {
            _generalResponseFn = generalResponseFn;
            _apiService = apiService;
            _cardsRepository = cardsRepository;
            endpoint = configuration["ApiSettings:EndpoinTerms"]
                ?? throw new ArgumentNullException(nameof(configuration), "EndpoinTerms no puede ser nulo");
            _logger = logger;
        }

        // Se suprime S6664 (límite de llamadas Information por bloque) de forma intencional:
        // el flujo de validación necesita registrar cada paso para trazabilidad/auditoría.
        [System.Diagnostics.CodeAnalysis.SuppressMessage("SonarQube", "S6664:Limit logger calls",
            Justification = "Trazabilidad de auditoría requerida por el negocio en cada paso de validación.")]
        public async Task<GeneralResponse> GetTermsAsync(TermsRequest termsRequest)
        {
            ConsultaCuotaResult consultaCuota = new ConsultaCuotaResult();

            try
            {
                _logger.LogInformation("SOLICITUD RECIBIDA *******ConsultaCuota*******");
                _logger.LogInformation("Equivalente: {Equivalente} | Canal: {Canal} | Monto: {Monto} | Tipo: {Tipo} | Plazo: {Plazo}",
                    termsRequest.equivalente, termsRequest.canal, termsRequest.monto, termsRequest.tipo, termsRequest.plazo);

                #region Validacion de que todos los parametros traigan informacion
                _logger.LogInformation("Validacion de que todos los parametros traigan informacion");
                _logger.LogInformation("Validando CANAL");
                if (string.IsNullOrEmpty(termsRequest.canal))
                {
                    consultaCuota.Respuesta = 1;
                    consultaCuota.Error = await _cardsRepository.GetMsjError(11);
                    _logger.LogInformation("{Error} -> Canal: {Canal}", consultaCuota.Error, termsRequest.canal);

                    var mensajeError = "El canal no puede venir vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, consultaCuota.Respuesta, consultaCuota.Error.ToString(), mensajeError);
                }

                _logger.LogInformation("Validacion del numero equivalente");
                if (string.IsNullOrEmpty(termsRequest.equivalente) || string.IsNullOrWhiteSpace(termsRequest.equivalente))
                {
                    consultaCuota.Respuesta = 1;
                    consultaCuota.Error = await _cardsRepository.GetMsjError(11);
                    _logger.LogInformation("El equivalente no debe venir vacio -> Equivalente: {Equivalente}", termsRequest.equivalente);

                    var mensajeError = "El equivalente no puede venir vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, consultaCuota.Respuesta, consultaCuota.Error.ToString(), mensajeError);
                }

                if (!Regex.IsMatch(termsRequest.equivalente, @"^[0-9]+$", RegexOptions.None, RegexTimeout)
                    || termsRequest.equivalente.Length < 16)
                {
                    await _cardsRepository.InsConsultaDisponible(termsRequest.equivalente, termsRequest.canal, "El número equivalente de la tarjeta no contiene el formato correcto", null, null);
                    //Consultar si esta validacion devolveria msj estandar de error no contemplado
                    consultaCuota.Respuesta = 1;
                    consultaCuota.Error = await _cardsRepository.GetMsjError(14);
                    _logger.LogInformation("El número equivalente de la tarjeta no contiene el formato correcto -> Equivalente: {Equivalente}", termsRequest.equivalente);

                    var mensajeError = "El número equivalente de la tarjeta no contiene el formato correcto";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, consultaCuota.Respuesta, consultaCuota.Error.ToString(), mensajeError);
                }

                _logger.LogInformation("Validando el Monto");
                if (string.IsNullOrEmpty(termsRequest.monto.ToString()))
                {
                    consultaCuota.Respuesta = 1;
                    consultaCuota.Error = await _cardsRepository.GetMsjError(11);
                    _logger.LogInformation("{Error} -> Monto: {Monto}", consultaCuota.Error, termsRequest.monto);

                    var mensajeError = "El monto no puede venir vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, consultaCuota.Respuesta, consultaCuota.Error.ToString(), mensajeError);
                }

                _logger.LogInformation("Validando Tipo");
                if (string.IsNullOrEmpty(termsRequest.tipo))
                {
                    consultaCuota.Respuesta = 1;
                    consultaCuota.Error = await _cardsRepository.GetMsjError(11);
                    _logger.LogInformation("{Error} -> Tipo: {Tipo}", consultaCuota.Error, termsRequest.tipo);

                    var mensajeError = "El tipo no puede venir vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, consultaCuota.Respuesta, consultaCuota.Error.ToString(), mensajeError);
                }

                if (termsRequest.tipo != "Intra" && termsRequest.tipo != "Extra")
                {
                    consultaCuota.Respuesta = 1;
                    consultaCuota.Error = await _cardsRepository.GetMsjError(14);
                    _logger.LogInformation("El tipo debe de ser Intra o Extra -> Tipo: {Tipo}", termsRequest.tipo);

                    var mensajeError = "El tipo debe de ser Intra o Extra";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, consultaCuota.Respuesta, consultaCuota.Error.ToString(), mensajeError);
                }

                _logger.LogInformation("Validando Plazo");
                if (string.IsNullOrEmpty(termsRequest.plazo.ToString()))
                {
                    consultaCuota.Respuesta = 1;
                    consultaCuota.Error = await _cardsRepository.GetMsjError(11);
                    _logger.LogInformation("{Error} -> Plazo: {Plazo}", consultaCuota.Error, termsRequest.plazo);

                    var mensajeError = "El plazo no debe venir vacio";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, consultaCuota.Respuesta, consultaCuota.Error.ToString(), mensajeError);
                }
                #endregion

                #region Validacion de que exista la tarjeta equivalente
                _logger.LogInformation("Validacion de que exista la tarjeta equivalente");

                int existeTarjeta = await _cardsRepository.ValidaExistenciaTc(termsRequest.equivalente);
                if (existeTarjeta == 0)
                {
                    consultaCuota.Respuesta = 1;
                    consultaCuota.Error = await _cardsRepository.GetMsjError(14);
                    _logger.LogInformation("No existe la tarjeta equivalente consultada -> Equivalente: {Equivalente}", termsRequest.equivalente);

                    var mensajeError = "No existe la tarjeta equivalente consultada";
                    return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, consultaCuota.Respuesta, consultaCuota.Error.ToString(), mensajeError);
                }
                #endregion

                #region Obtener plazos
                var getBaseRequest = await _cardsRepository.GetBaseInfo(termsRequest.equivalente.ToString());

                if (getBaseRequest == null)
                {
                    _logger.LogError("Error en {Method}. Message: {Message}", nameof(GetTermsAsync), "Error al obtener información, respuesta null");
                    return await _generalResponseFn.ResponseError(
                            Constantes.STATUS_NOT_FOUND,
                            Constantes.CODE_SYSTEM_ERROR,
                            $"Error al obtener información base: respuesta null - no se encontró registro para equivalente: {termsRequest.equivalente}");
                }

                var extrafinancingTermsRequest = new ExtrafinancingTermsRequest
                {
                    card = new Card
                    {
                        bin = getBaseRequest.Bin,
                        lastFourDigits = getBaseRequest.LastFourDigits
                    },
                    client = new Client
                    {
                        documentNumber = getBaseRequest.DocumentNumber,
                        documentType = getBaseRequest.DocumentType,
                        gender = getBaseRequest.Gender
                    },
                    amount = termsRequest.monto,
                    numberPayments = termsRequest.plazo,
                    currency = "HNL"
                };

                var extrafinancingTermsResponse = await _apiService.GetTermsAsync(endpoint, extrafinancingTermsRequest);

                if (extrafinancingTermsResponse == null)
                {
                    _logger.LogError("Error en {Method}. Message: {Message}", nameof(GetTermsAsync), "Error al llamar api terms, respuesta null");
                    return await _generalResponseFn.ResponseError(
                        Constantes.STATUS_ERROR,
                        Constantes.CODE_SYSTEM_ERROR,
                        $"Error al llamar api {endpoint}");
                }

                var respuestaApi = extrafinancingTermsResponse.response;

                if (respuestaApi.code == "00")
                {
                    _logger.LogInformation("Exito en {Method}. Message: {Message}", nameof(GetTermsAsync), respuestaApi.description);

                    return await _generalResponseFn.Response(
                    Constantes.STATUS_OK,
                    "00",
                    extrafinancingTermsResponse.installmentDetails);
                }

                _logger.LogError("Respuesta obtenida en {Method}. Code: {Code} Message: {Message}", nameof(GetTermsAsync), respuestaApi.code, respuestaApi.description);
                return await _generalResponseFn.ResponseError(
                    Constantes.STATUS_OK,
                    respuestaApi.code,
                    respuestaApi.description);
                #endregion
            }
            catch (Exception ex)
            {
                consultaCuota.Respuesta = 1;
                consultaCuota.Error = await _cardsRepository.GetMsjError(14);
                _logger.LogError(ex, "Error en GetTermsAsync ConsultaCuota");

                var mensajeError = "Error en public ConsultaCuotaResult ConsultaCuota";
                return _generalResponseFn.ResponseErrorDesembolso(Constantes.BAD_REQUEST, consultaCuota.Respuesta, consultaCuota.Error.ToString(), mensajeError);
            }
        }
    }
}