SELECT a.* 
FROM DEstadoCuenta a WITH(NOLOCK)
INNER JOIN HEstadoCuenta b WITH(NOLOCK) 
    ON b.No_Cuenta = a.EC_DetalleNo_Cuenta 
    AND b.Fecha_Corte = a.Fecha_Corte
WHERE a.ProcesadorOrigen = 'LOCAL'
  AND b.Mensaje_5 IN (2, 3)
  AND a.Fecha_Corte = (
      SELECT TOP 1 Fecha_Corte 
      FROM DEstadoCuenta WITH(NOLOCK)
      WHERE ProcesadorOrigen = 'LOCAL'
      ORDER BY Fecha_Corte DESC
  );