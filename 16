    public class JobService : IJobService
    {
        private readonly IJobRespository _jobRespository;
        private readonly ILogger<JobService> _logger;
        public JobService(IJobRespository jobRespository, ILogger<JobService> logger) 
        {
            _jobRespository = jobRespository;   
            _logger = logger;   
        }

        public async Task<bool> ExecuteJobByJobNameAsync(string jobName)
        {
            int? isExecute = await _jobRespository.GetStatusJobExecuteAsync(jobName);

            if (!isExecute.HasValue || isExecute.Value != 1)
            {
                _logger.LogWarning("No se ejecutó el job: {jobName} de Abandoned Tokens restultado: {isExecute}", jobName, isExecute?.ToString() ?? "null");
                return false;
            }
            _logger.LogInformation("Se ejuctó correctamente el job {jobName}",jobName);
            return true;
        }
    }
}





using api_abandoned_token.Infraestructure.Data;
using api_abandoned_token.Repository.Interface;

namespace api_abandoned_token.Repository
{
    public class JobRespository : IJobRespository
    {
        private readonly DBHelper _dbHelper;
        private readonly ILogger<JobRespository> _logger;
        public JobRespository(DBHelper dBHelper, ILogger<JobRespository> logger) 
        {
            _dbHelper = dBHelper;
            _logger = logger;   
        }

        public async Task<int?> GetStatusJobExecuteAsync(string jobName)
        {
            try
            {
                int? status = await _dbHelper.ExecuteScalarAsync("usp_ExecJobs",
                    new Dictionary<string, object> { { "@JobName", jobName } });

                if (status == null || Convert.ToInt32(status) <= 0)
                {
                    _logger.LogWarning("No se inicializo correctamente el job {jobName} en DB", jobName);
                    return null;
                }

                _logger.LogInformation("Se inicializo correctamente el job {jobName} en DB", jobName);
                return status;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error de DB al ejecutar el job {jobName}", jobName);
                throw;
            }
        }
    }
}







