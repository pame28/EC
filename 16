                {
                    Status = 200, //errorContent.status,
                    HasError = true,
                    DisponibleAdelanto = 0,
                    Messages = new List<Messages>
                    {

                    }

                };


            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en {Method}. Message: {Message}", nameof(GetConsultaAdelanto), ex.Message);
                return default;
            }
        }
