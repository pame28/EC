        private void ProcesodeCarga()
        {
            int Duplicado = 0;
            ProgressBar.EditValue = 0;
            this.GetTransacciones();
            if (error == 0 && ContadorTC > 0)
                this.GetTransaccionTC();
            if (error == 0)
                this.ValidaBandejasAS400();
            if (error == 0)
                this.ValidaCuentaCif();
            if (error == 0)
                Duplicado = this.ValidaDebitoDuplicado();
            if (error == 0)
            {
                if (Duplicado > 0)
                {
                    var answer = MessageBox.Show("Ya se realizó un débito por el mismo valor en este día! \n\n Desea Continuar?", "Confirme Débito Duplicado", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
                    if (answer == DialogResult.Yes)
                    {
                        Dialoganswer = true;
                        duplicado = true;
                        this.InsertaLote();
                        if (error == 0)
                            this.InsertarDetalle();
                        if (error == 0)
                            this.ValidaTipoCuentaAS400();
                        if (error == 0)
                            BtnValidar.Enabled = true;
                    }
                    else
                    {
                        error++;
                        return;
                    }
                }
                else
                {
                    this.InsertaLote();
                    if (error == 0)
                        this.InsertarDetalle();
                    if (error == 0)
                        this.ValidaTipoCuentaAS400();
                    if (error == 0)
                        BtnValidar.Enabled = true;
                }
            }
            else
                return;
        }

