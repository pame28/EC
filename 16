-- =====================================================================================
-- Objeto:				[dbo].[fn_SiguienteFechaCorte]
-- Autor:				(completar)
-- Fecha creacion:		21-07-2026
-- Description:			Calcula la siguiente fecha de corte en la secuencia de negocio
--						(dias 06, 10, 18, 24, 27) a partir de una fecha de corte dada.
--						Es una funcion pura: no lee ni modifica ninguna tabla, por lo
--						que puede usarse dentro de un WHILE para caminar la secuencia
--						varios pasos hacia adelante (ver usp_SincronizarFechaCorte).
--****************************************************************************************
--						HISTORIAL DE MODIFICACIONES
--****************************************************************************************
--Nombre:			Descripcion												Fecha
-- (completar)       Se creo la funcion, extraida de la logica que antes		21-07-2026
--                   vivia en usp_ActualizarFechaCorte
-- =======================================================================================

CREATE FUNCTION [dbo].[fn_SiguienteFechaCorte]
(
    @FechaActual DATE
)
RETURNS DATE
AS
BEGIN
    DECLARE @Dia INT = DATEPART(DAY, @FechaActual);
    DECLARE @Mes INT = DATEPART(MONTH, @FechaActual);
    DECLARE @Anio INT = DATEPART(YEAR, @FechaActual);
    DECLARE @Siguiente DATE;

    IF @Dia = 6
        SET @Siguiente = DATEFROMPARTS(@Anio, @Mes, 10);
    ELSE IF @Dia = 10
        SET @Siguiente = DATEFROMPARTS(@Anio, @Mes, 18);
    ELSE IF @Dia = 18
        SET @Siguiente = DATEFROMPARTS(@Anio, @Mes, 24);
    ELSE IF @Dia = 24
        SET @Siguiente = DATEFROMPARTS(@Anio, @Mes, 27);
    ELSE IF @Dia = 27 AND @Mes < 12
        SET @Siguiente = DATEFROMPARTS(@Anio, @Mes + 1, 6);
    ELSE IF @Dia = 27 AND @Mes = 12
        SET @Siguiente = DATEFROMPARTS(@Anio + 1, 1, 6);
    ELSE
        RETURN NULL; -- Fecha que no corresponde a ningun dia de corte valido

    RETURN @Siguiente;
END
GO