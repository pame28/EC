kind: Deployment
apiVersion: apps/v1
metadata:
  name: api-token-notificav1
  labels:
    app: api-token-notificav1
    app.kubernetes.io/part-of: Tokenization
spec:
  replicas: 1
  selector:
    matchLabels:
      app: api-token-notificav1
  template:
    metadata:
      labels:
        app: api-token-notificav1
        deployment: api-token-notificav1
    spec:
      containers:
        - name: api-token-notificav1
          image: 
            image-registry.openshift-image-registry.svc:5000/pj-repositorybp-is/api-token-notifica:v1        
          env:
            - name: CONNECTIONSTRINGS__DEFAULTCONNECTION
              valueFrom:
                secretKeyRef:
                  name: tokenization-notify-secrets
                  key: CONNECTIONSTRINGS__DEFAULTCONNECTION
          envFrom:
            - configMapRef:
                name: configmap-api-token-notifica
          volumeMounts:
            - name: certificates-volume
              readOnly: true
              mountPath: /app/certificates
      volumes:
        - name: certificates-volume
          secret:
            secretName: certificates-secret
            defaultMode: 420
      restartPolicy: Always