                Detalle.Columns.Add("Trx", typeof(Int32));
                Detalle.Columns.Add("TipoTrx", typeof(Int32));
                Detalle.Columns.Add("NoReferencia", typeof(Int64));
                Detalle.Columns.Add("ReferenciaByte", typeof(Int64));
                Detalle.Columns.Add("NombreEmpleado", typeof(string));
                Detalle.Columns.Add("Status", typeof(string));
                Detalle.Columns.Add("CTSTA", typeof(string)).AllowDBNull = true;

                for (int i = 0; i < dsFromXls.Tables[0].Rows.Count; i++)
                {
                    DataRow dr = Detalle.NewRow();
