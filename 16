                {

                    valor = dsFromXls.Tables[0].Rows[i][2].ToString(); ;
                    if (valor.ToString().Length > 1)
                    {
                        DataRow dr = dsFromXls.Tables["errores"].NewRow();
                        dr["Secuencia"] = Convert.ToInt64(dsFromXls.Tables[0].Rows[i][0].ToString());
                        dr["Campo"] = Convert.ToString(dsFromXls.Tables[0].Columns[2].ColumnName);
                        dr["Descripcion"] = "Valor Incorrecto";
                        dsFromXls.Tables["errores"].Rows.Add(dr);
                        error++;
