        private void cargarexcel()//abre la conexion para cargar archivo
        {
            try
            {
                String _Path;

                OpenFileDialog openFileDialog1 = new OpenFileDialog();
                openFileDialog1.Filter = "Archivos Excel (*.xls;*.xlsx;*.ods)|*.xls; *.xlsx; *.ods|Archivos Encryptados (*.cfe;)|*.cfe;";
                if (openFileDialog1.ShowDialog() == DialogResult.OK)
                {
                    resp_open = true;
                    _Path = openFileDialog1.FileName.ToString();

                    if (_Path.Length > 0)
                    {
                        string ext = Path.GetExtension(_Path);
                        if (ext == ".cfe")//valida si es un arhivo encriptado por aplicativo CriptoForge
                        {
                            string sfile = Path.GetFileName(_Path);
                            string _PathOrigen = Path.GetDirectoryName(_Path);
                            string _file = _PathOrigen + @"\" + Path.GetFileName(_Path).Substring(0, sfile.Length - 4);
                            this.DesencriptarArchivo(_file, DirectoryCrypto, _PathOrigen, PasswordCripto, _Path);
                            if (error == 0)
                            {
                                _Path = _file;
                            }
                            else
                                return;
                        }

                        SpreadsheetGear.IWorkbook wbk = SpreadsheetGear.Factory.GetWorkbook(_Path, new System.Globalization.CultureInfo("es-HN"));     //Cargar Archivo de Excell
                        SpreadsheetGear.IWorksheet wst = wbk.Worksheets[0];
                        dsFromXls = wst.UsedRange.GetDataSet(SpreadsheetGear.Data.GetDataFlags.FormattedText);
                        dsFromXls.Tables[0].Columns.Add("Secuencia").SetOrdinal(0);//agregamos campo numero de fila 
                        dsFromXls.Tables[0].Columns.Add("TipoCuenta").SetOrdinal(5);//agregamos campo para tipo de cuenta 

                        int SecuenciaDebitoSeleccionada = 0;
                        for (int i = 0; i < dsFromXls.Tables[0].Rows.Count; i++)//llenamos campo numero de fila 
                        {
                            if (dsFromXls.Tables[0].Rows[i][2].ToString() == "2" && i > 0)//seleccionamos el registro del debito como secuencia 1 cuando no este en el primer registro
                            {
                                dsFromXls.Tables[0].Rows[i][0] = 1;
                                SecuenciaDebitoSeleccionada = 1;
                            }
                            else if (dsFromXls.Tables[0].Rows[i][2].ToString() == "2" && i == 0)//seleccionamos el registro del debito como secuencia 1 cuando este en el primer registro
                            {
                                dsFromXls.Tables[0].Rows[i][0] = 1;
                                SecuenciaDebitoSeleccionada = 1;
                            }
                            else if (SecuenciaDebitoSeleccionada == 1)//si ya seleccionamos la secuencia sumamos la secuencia + 1
                            {
                                dsFromXls.Tables[0].Rows[i][0] = i + 1;
                            }
                            else
                                dsFromXls.Tables[0].Rows[i][0] = i + 2;
                        }

                        if (ext == ".cfe")//si es un arhivo encriptado por aplicativo CriptoForge  elimina el archivo desencriptado
                            File.Delete(_Path);
                    }
                }
                else
                {
                    MessageBox.Show("No se ha seleccionado ningun archivo de planilla.", "Accion Cancelada", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    resp_open = false;
                }
            }
            catch (Exception ex)
            {
                log.Error("Error al importar archivo de excel con SpreadsheetGear");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al importar archivo de excel con SpreadsheetGear" + ex.ToString());
                error++;
            }
        }

