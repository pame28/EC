CREATE TABLE dbo.ControlLotes (
    FechaCorte  DATE         NOT NULL,
    NumeroLote  INT          NOT NULL DEFAULT 0,
    PRIMARY KEY (FechaCorte)
);





-- Incrementa atómicamente y retorna el nuevo valor
UPDATE dbo.ControlLotes
SET    @NumeroLote = NumeroLote = NumeroLote + 1
WHERE  FechaCorte = @FechaCorte;

-- Si no existe el registro para esta fecha lo crea
IF @NumeroLote IS NULL
BEGIN
    INSERT INTO dbo.ControlLotes (FechaCorte, NumeroLote)
    VALUES (@FechaCorte, 1);

    SET @NumeroLote = 1;
END