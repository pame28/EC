using System.Data;
using Microsoft.Data.SqlClient;

namespace api_abandoned_token.Infraestructure.Data
{
    public class JobDBHelper
    {
        private readonly string _connectionString;
        private readonly ILogger<JobDBHelper> _logger;

        public JobDBHelper(IConfiguration configuration, ILogger<JobDBHelper> logger)
        {
            _connectionString = configuration.GetConnectionString("JobConnection")!;
            _logger = logger;
        }

        public async Task<int> ExecuteScalarAsync(string storedProcedure, Dictionary<string, object>? parameters = null)
        {
            await using SqlConnection conn = new SqlConnection(_connectionString);
            await conn.OpenAsync();

            await using var cmd = new SqlCommand(storedProcedure, conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            if (parameters != null)
            {
                foreach (var param in parameters)
                {
                    cmd.Parameters.Add(new SqlParameter(param.Key, param.Value ?? DBNull.Value));
                }
            }

            var result = await cmd.ExecuteScalarAsync();
            int value = int.TryParse(result?.ToString(), out var parsed) ? parsed : 0;
            _logger.LogInformation("StoredProcedure {StoredProcedure} ejecutado correctamente con ExecuteScalarAsync(), resultado={Result}", storedProcedure, value);

            return value;
        }
    }
}









using api_abandoned_token.Infraestructure.Data;
using api_abandoned_token.Repository.Interface;

namespace api_abandoned_token.Repository
{
    public class JobRespository : IJobRespository
    {
        private readonly JobDBHelper _jobDBHelper;
        private readonly ILogger<JobRespository> _logger;

        public JobRespository(JobDBHelper jobDBHelper, ILogger<JobRespository> logger)
        {
            _jobDBHelper = jobDBHelper;
            _logger = logger;
        }

        public async Task<int?> GetStatusJobExecuteAsync(string jobName)
        {
            try
            {
                int? status = await _jobDBHelper.ExecuteScalarAsync("usp_ExecJobs",
                    new Dictionary<string, object> { { "@JobName", jobName } });

                if (status == null || Convert.ToInt32(status) <= 0)
                {
                    _logger.LogWarning("No se inicializo correctamente el job {jobName} en DB", jobName);
                    return null;
                }

                _logger.LogInformation("Se inicializo correctamente el job {jobName} en DB", jobName);
                return status;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error de DB al ejecutar el job {jobName}", jobName);
                throw;
            }
        }
    }
}
















