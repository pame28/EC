            try
            {
                if (File.Exists(file))
                {
                    File.Delete(file);
                }

                System.Diagnostics.Process procc = new System.Diagnostics.Process();
                procc.EnableRaisingEvents = false;
                procc.StartInfo.FileName = String.Format(@"""{0}""", RutaCriptoForge);
                procc.StartInfo.Arguments = " /d /sa:Leave /nim" + @"""/td:" + PathOrigen + @""" " + @"""/passw:" + LlaveArchivo + @""" " + "/lofr" + @" """ + ruta + @""" ";
                procc.Start();
                procc.WaitForExit();
                if (procc.ExitCode != 0)
                {
                    throw new Exception("Ocurrio un error desencriptando el archivo. ExitCode = " + procc.ExitCode.ToString());
                }
                procc.Dispose();
                procc.Close();
