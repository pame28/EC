ALTER PROCEDURE dbo.usp_ReporteHistoricoPorFecha
    @FechaCorte DATE = NULL,
    @Procesado CHAR(2) = NULL
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        NoCuenta,
        NoTarjeta,
        Nombre,
        Correo,
        FechaCorte,
        Origen,
        CASE 
            WHEN LTRIM(RTRIM(Procesado)) = '1' 
				THEN 'Procesado'
			WHEN LTRIM(RTRIM(Procesado)) = '0' 
				THEN 'No Procesado'
            ELSE 'Pendiente'
        END AS Procesado,
        FechaEjecucion
    FROM dbo.HistoricoMaestroEstadosCuentaJSON WITH (NOLOCK)
    WHERE
      FechaCorte = @FechaCorte
	AND   LTRIM(RTRIM(Procesado)) = @Procesado

    ORDER BY IdRow ASC;
END



