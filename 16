-- Description:	Actualiza el Tipo de cuentas de cada una de las cuentas cargadas en la planilla.
-- =============================================
ALTER PROCEDURE [dbo].[Usp_ActualizaDetalleLotesPlanillas] 

--------PARAMETROS----------
@Lote AS BIGINT

AS
BEGIN
	
-------------RECONSTRUYE EL INDICE DE LOTE ----------------
-- ALTER INDEX idx_IdLote ON dbo.DetallePlanillas REORGANIZE; 
 
--GET CUENTAS,PRODUCTOS,STATUS BY LOTE
 SELECT LTRIM(RTRIM(REPLACE(B.numCuenta,'-',''))) numcuenta, B.TIPPRO, B.CTSTA,B.PRTIPO,B.DPAGEN,B.DPCORR,B.DPDIVE
 INTO #temp FROM AS400_ClientesCuentas AS B
 WHERE EXISTS (SELECT 1 FROM DetallePlanillas as A WHERE a.Cuenta = LTRIM(RTRIM(REPLACE(B.numCuenta,'-',''))) AND a.IdLote = @Lote)	 
	
--ACTUALIZA TIPO DE CUENTA Y STATUS DE LA CUENTA DESDE LA TABLA DPCTAS
 UPDATE A
 SET A.[TipoCuenta] = B.TIPPRO,A.CTSTA = B.CTSTA  
 FROM DetallePlanillas as A
 INNER JOIN #temp AS B 
 ON A.Cuenta= B.numCuenta 
 WHERE A.IdLote = @Lote
 
--ACTUALIZA LA CUENTA,EL TIPO DE CUENTA Y EL STATUS DE LA CUENTA DESDE LA TABLA DPALIAS EN EL CASO QUE VENGAN CUENTAS VIEJAS
UPDATE A
SET CuentaByte  = LTRIM(RTRIM(REPLACE(C.numCuenta,'-',''))),A.[TipoCuenta] = C.TIPPRO,A.CTSTA = C.CTSTA
FROM DetallePlanillas AS A
INNER JOIN  AS400_DPALIAS AS B
ON CAST(CAST(LTRIM(RTRIM(A.Cuenta))AS NUMERIC(25))AS VARCHAR(25))=CAST(CAST(LTRIM(RTRIM(B.DPALIA))AS NUMERIC(25))AS VARCHAR(25))
INNER JOIN AS400_ClientesCuentas AS C
ON B.PRTIPO=C.PRTIPO AND B.DPAGEN=C.DPAGEN AND B.DPCORR=C.DPCORR AND B.DPDIVE = C.DPDIVE
WHERE  A.IdLote = @Lote 

--ACTUALIZA LA CUENTA BYTE DESDE LA TABLA INFOTC EN EL CASO QUE VENGAN TARJETAS
IF (SELECT COUNT(1) FROM DetallePlanillas WHERE IdLote = @Lote AND TipoCuenta = 6)>0
BEGIN 
UPDATE A
SET CuentaByte  = LTRIM(RTRIM(B.NumeroTarjeta))
FROM DetallePlanillas AS A
INNER JOIN  (SELECT MAX(NumeroTarjeta) AS NumeroTarjeta,NoUsuario FROM INFOTC WHERE CategoriaTarjeta='0' GROUP BY NoUsuario) AS B
 ON CAST(CAST(LTRIM(RTRIM(A.Cuenta))AS NUMERIC(25))AS VARCHAR(25))=CAST(CAST(LTRIM(RTRIM(B.NoUsuario))AS NUMERIC(25))AS VARCHAR(25))
WHERE  A.IdLote = @Lote 
END

--GET CUENTAS,NOMBRES DE LOS CLIENTES NATURALES BY LOTE
 SELECT LTRIM(RTRIM(REPLACE(B.numCuenta,'-',''))) AS numCuenta,C.nombreCliente
 INTO #temp2 FROM AS400_ClientesCuentas AS B
 INNER JOIN AS400_ClientesNaturales AS C
 ON B.cifCliente=C.cifCliente
 WHERE EXISTS (SELECT 1 FROM DetallePlanillas as A WHERE a.CuentaByte = LTRIM(RTRIM(REPLACE(B.numCuenta,'-',''))) AND a.IdLote = @Lote)	
 
 --ACTUALIZA NOMBRES DE LOS CLIENTES NATURALES
 UPDATE A
 SET A.NombreEmpleado=B.nombreCliente
 FROM DetallePlanillas as A
 INNER JOIN #temp2 AS B 
 ON A.CuentaByte=B.numCuenta
 WHERE A.IdLote = @Lote 
 
 --GET CUENTAS,NOMBRES DE LOS CLIENTES JURIDICOS BY LOTE 
 SELECT LTRIM(RTRIM(REPLACE(B.numCuenta,'-',''))) AS numCuenta,C.CLRAZS
 INTO #temp3 FROM AS400_ClientesCuentas AS B
 INNER JOIN AS400_ClientesJuridicos  AS C
 ON B.cifCliente=C.CLDOC
 WHERE EXISTS (SELECT 1 FROM DetallePlanillas as A WHERE a.CuentaByte = LTRIM(RTRIM(REPLACE(B.numCuenta,'-',''))) AND a.IdLote = @Lote) 

 --ACTUALIZA NOMBRE DE LOS CLIENTES JURIDICOS
 UPDATE A
 SET A.NombreEmpleado=B.CLRAZS
 FROM DetallePlanillas as A
 INNER JOIN #temp3 AS B 
 ON A.CuentaByte=B.numCuenta
 WHERE A.IdLote =@Lote

END

-------------SELECCIONAMOS DETALLE DEL LOTE CREADO ------------
SELECT A.[IdLote]
      ,A.[Correlativo]
      ,A.CuentaByte AS Cuenta
      ,CASE
      WHEN A.TipoCuenta IS NULL THEN 0       
      ELSE A.TipoCuenta
      END AS TipoCuenta
      ,A.[Monto]
      ,A.[Trx]
      ,A.[TipoTrx]
      ,A.[NoReferencia]
      ,A.[NombreEmpleado]
      ,A.[Status]
      ,A.CTSTA 
FROM  DetallePlanillas AS A
WHERE A.IdLote=@Lote
ORDER BY A.TipoTrx DESC

DROP TABLE #temp
DROP TABLE #temp2
DROP TABLE #temp3



 

