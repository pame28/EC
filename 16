# 1. ServiceAccount — este SÍ va en el namespace de la app
apiVersion: v1
kind: ServiceAccount
metadata:
  name: logcollector
  namespace: pu-procesadortc-bp
---
# 2. ClusterLogForwarder — va en openshift-logging
apiVersion: observability.openshift.io/v1
kind: ClusterLogForwarder
metadata:
  name: forward-pu-procesadortc-bp
  namespace: openshift-logging       # ← CAMBIO CLAVE
spec:
  managementState: Managed
  serviceAccount:
    name: logcollector

  filters:
    - name: detect-java-multiline
      type: detectMultilineException

  inputs:
    - name: application-logs
      type: application
      application:
        includes:
          - namespace: pu-procesadortc-bp

  outputs:
    - name: syslog-procesador
      type: syslog
      syslog:
        url: udp://10.100.206.87:514
        rfc: RFC5424
        facility: local3
        severity: info                 # ← CAMBIO
        enrichment: KubernetesMinimal
        payloadKey: '{.message}'       # ← AGREGADO

  pipelines:
    - name: pipeline-procesador
      inputRefs:
        - application-logs
      filterRefs:
        - detect-java-multiline
      outputRefs:
        - syslog-procesador