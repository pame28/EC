            w.WriteNumber("Disponible_Cta_MN", e.Disponible_Cta_MN);
            w.WriteNumber("Disponible_Cta_ME", e.Disponible_Cta_ME);
            w.WriteNumber("Disponible_Ret_MN", e.Disponible_Ret_MN);
