        private void BuildTextFile()
        {
            try
            {
                System.IO.FileStream wFile;
                byte[] byteData = new byte[0];

                FileName = "VS" + Service + Lote.ToString().PadLeft(10, '0') + ".TXT";
                Path = Properties.Settings.Default.Source;
                if (!Directory.Exists(Path))
                    Directory.CreateDirectory(Path);

                if (File.Exists(Path + @"\" + FileName))
                    File.Delete(Path + @"\" + FileName);

                wFile = new FileStream(Path + @"\" + FileName, FileMode.Append);
                //FOR QUE RECORRE EL DATATABLE DONDE SE ALMACENO LA RESPUESTA DEL QUERY EJECUTADO
                for (int i = 0; i < FileText.Rows.Count; i++)
                {
                    //FOR QUE RECORRE LAS COLUMNAS DEL DATATABLE DONDE SE ALMACENO LA RESPUESTA DEL QUERY EJECUTADO
                    for (int f = 0; f < FileText.Columns.Count; f++)
                    {
                        //VALIDA HASTA CUANDO ES LA PENULTIMA COLUMNA PARA INSERTAR EL SEPARADOR
                        if (f == (FileText.Columns.Count) - 1)
                        {
                            byteData = Encoding.ASCII.GetBytes(FileText.Rows[i][f].ToString());
                        }
                        //SINO LE INSERTA EL SEPARADOR A LAS COLUMNAS
                        else
                        {
                            byteData = Encoding.ASCII.GetBytes(FileText.Rows[i][f].ToString() + '|');
                        }
                        //ESCRIBE LOS DATOS DENTRO DE LA FILA
                        wFile.Write(byteData, 0, byteData.Length);
                        byteData = new byte[0];
                    }
                    //AGREGA UNA NUEVA FILA CUANDO HA RECORRIDO TODAS LAS COLUMNAS
                    byteData = Encoding.ASCII.GetBytes(Environment.NewLine);
                    wFile.Write(byteData, 0, byteData.Length);
                }
                wFile.Close();
            }
            catch (Exception ex)
            {
                log.Error("Error al Construir Archivo de Texto");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al Construir Archivo de Texto" + Environment.NewLine + ex.Message.ToString(), "", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private bool UploadToAS400(string FileName, string Extension, bool RemoveExistingFileAS400, bool IsFolderUnderRoot, string DestinationFile, string SourceFile, string ServidorDB2)
        {
            bool ProcesoExitoso = false;
            bool _SubidaArchivo = false;
            try
            {
                string sUserAS400 = sVal[0];
                string sPassAS400 = sVal[1];
                AS400FTP ftp = new AS400FTP();
                ftp.AS400FileExtension = Extension;
                ftp.RemoveExistingFile = RemoveExistingFileAS400;
                ftp.IsFolderUnderRoot = IsFolderUnderRoot;
                log.Info(string.Format("Colocando Archivo '{0}' en la Carpeta del AS400: '{1}'", FileName, DestinationFile));
                _SubidaArchivo = ftp.FTPPUT(DestinationFile, SourceFile,
                    new string[] { FileName }, ServidorDB2, sUserAS400, sPassAS400);

                if (_SubidaArchivo == true)
                {
                    File.Delete(FileName);
                    log.Info(string.Format("Archivo '{0}' Subido Correctamente", FileName));
                    ProcesoExitoso = true;
                }
                else
                {
                    File.Delete(FileName);
                    log.Info(string.Format("Error al Subir Archivo '{0}' al AS400", FileName));
                    MessageBox.Show(string.Format("Error al Subir Archivo '{0}' al AS400", FileName), "Error al subir Archivo al AS400", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    error++;
                }
            }
            catch (Exception ex)
            {
                error++;
                log.Error("Error al Subir Archivo al AS400");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al Subir Archivo al AS400" + Environment.NewLine + ex.Message.ToString(), "", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            return ProcesoExitoso;
        }

