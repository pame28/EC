                        {
                            Code = e.field,
                            Description = e.message
                        }).ToList() ?? new List<Messages>()

                    };
                   
                } 

                var accountDataSuccessResponse = await response.Content.ReadFromJsonAsync<AccountDataSuccessResponse>();

                _logger.LogInformation("***** Llamado completado {GetPeriodsAsync} *****", JsonSerializer.Serialize(response));

                if (accountDataSuccessResponse != null)
                {
                    return new GeneralResponse
