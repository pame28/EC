public void Main()
{
    try
    {
        // SSIS expone el mensaje de error en variables del sistema
        string mensajeError = Dts.Variables["System::ErrorDescription"].Value.ToString();
        string tareaError   = Dts.Variables["System::SourceName"].Value.ToString();

        Dts.Variables["User::MensajeError"].Value = 
            $"Tarea: {tareaError} — Error: {mensajeError}";

        Dts.TaskResult = (int)ScriptResults.Success;
    }
    catch (Exception ex)
    {
        Dts.Events.FireError(0, "Error captura mensaje", ex.Message, string.Empty, 0);
        Dts.TaskResult = (int)ScriptResults.Failure;
    }
}