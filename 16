using System.Text.Json.Serialization;

namespace transacciones_flotantes.DTOs.TransaccionesFlotantes
{
    public class ProveedorTransaccionesFlotantesResponseDto
    {
        public class ProveedorResponseDto
        {
            [JsonPropertyName("totalFloating")]
            public TotalesProveedorDto TotalFloating { get; set; } = new();

            [JsonPropertyName("authorizations")]
            public List<ProveedorAutorizacionDto> Authorizations { get; set; } = new();
        }

        public class TotalesProveedorDto
        {
            [JsonPropertyName("totalHNL")]
            public decimal TotalHNL { get; set; }

            [JsonPropertyName("totalUSD")]
            public decimal TotalUSD { get; set; }
        }

        public class ProveedorAutorizacionDto
        {
            [JsonPropertyName("transactionType")]
            public string TransactionType { get; set; } = string.Empty;
            [JsonPropertyName("date")]
            public string Date { get; set; }

            [JsonPropertyName("currency")]
            public string Currency { get; set; } = string.Empty;

            [JsonPropertyName("amount")]
            public decimal Amount { get; set; }

            [JsonPropertyName("merchantName")]
            public string MerchantName { get; set; } = string.Empty;


            [JsonPropertyName("reference")]
            public string? Reference { get; set; }

          

            [JsonPropertyName("movementType")]
            public string MovementType { get; set; } = string.Empty;
        }
    }
}







using transacciones_flotantes.Repository.Interface;
using transacciones_flotantes.Service.Interface;

namespace transacciones_flotantes.Service
{
    public class CurrencyService : ICurrencyService
    {
        private readonly ICurrencyRepository _repository;
        private readonly IConfiguration _configuration;

        public CurrencyService(ICurrencyRepository repository, IConfiguration configuration)
        {
            _repository = repository;
            _configuration = configuration;
        }

        public async Task<string> ResolverAsync(string monedaIso)
        {
            if (string.IsNullOrWhiteSpace(monedaIso))
                return monedaIso;

            bool usarMapeo = _configuration.GetValue<bool>("CurrencyMapping:Enabled");

            if (!usarMapeo)
                return monedaIso;

            var legacy = await _repository.ObtenerMonedaLegacyAsync(monedaIso);

            return legacy ?? monedaIso;
        }
    }
}

