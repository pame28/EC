        private void CredencialesAS400()
        {
            string connectionAs400 = string.Empty;

            try
            {

                connectionAs400 = Properties.Settings.Default.CnxAS400;

                string wsURLAS400 = Properties.Settings.Default.UrlWsAS400;
                int APPid = Properties.Settings.Default.Appid;
                Int16 EQPid = Properties.Settings.Default.Serverid;

                UA wsAs400 = new UA(wsURLAS400);
                wsAs400.PreAuthenticate = true;
                ICredentials credentials = CredentialCache.DefaultCredentials;
                wsAs400.Credentials = credentials;

                sVal = wsAs400.SolicitarUC(APPid, EQPid);
                OleDbConnectionStringBuilder strOleDBcsb = new OleDbConnectionStringBuilder(connectionAs400);


                if (sVal != null)
                {
                    strOleDBcsb["Password"] = sVal[1];
                    strOleDBcsb["User ID"] = sVal[0];
                    strOleDBcsb["Data Source"] = Properties.Settings.Default.ServidorDB2;

                    _cnnAS400 = strOleDBcsb.ConnectionString;
                }
            }
            catch (Exception ex)
            {
                log.Error("Error al Obtener Credenciales del AS400 ");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al Obtener Credenciales del AS400 " + ex.Message.ToString(), "Transacciones Bancarias", MessageBoxButtons.OK, MessageBoxIcon.Error);
                error++;
            }
        } // credenciales para conexion as400

        private void GetCajeroAgencia()
        {
            DataTable respuesta = new DataTable();

            try
            {
                string Query = "SELECT CAJCOD,DPAGEN FROM DP053DAT.DPCAJE WHERE TRIM(CAJUSR)= TRIM('{0}') AND TRIM(CAJSTA)='A'";

                Query = string.Format(Query, Properties.Settings.Default.Usuario525);

                Query = Criptografia.EncryptQueryString(Query, Properties.Settings.Default.Encryp, "|");

                if (Criptografia.error == 0)
                {
                    respuesta = Proxy.QueryAS400(Query, _cnnAS400, "GetCajeroAgencia");
                    error = error  + Proxy.error;
                }
                if (respuesta.Rows.Count > 0)
                {
                    Properties.Settings.Default.CodOficialAS400 = Convert.ToInt32(respuesta.Rows[0]["CAJCOD"].ToString());
                    Properties.Settings.Default.AgenciaCod = Convert.ToInt32(respuesta.Rows[0]["DPAGEN"].ToString());
                    BtnImportar.Enabled = true;
                }
                else
                {
                    MessageBox.Show("No se logro obtener Cajero y Agencia ", "Error al Obtener Parametros del AS400", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    BtnImportar.Enabled = false;
                }
            }
            catch (Exception ex)
            {
                log.Error("Error al obtener Cajero y Agencia ");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al obtener Cajero y Agencia " + ex.ToString());
                error++;
            }
        }

