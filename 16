        private void validacampocreditodebito()
        {
            object valor = string.Empty;

            try
            {
                for (int i = 0; i < dsFromXls.Tables[0].Rows.Count; i++)
                {
                    valor = dsFromXls.Tables[0].Rows[i][2].ToString(); ;
                    if (valor.ToString().Length > 1)
                    {
                        DataRow dr = dsFromXls.Tables["errores"].NewRow();
                        dr["Secuencia"] = Convert.ToInt64(dsFromXls.Tables[0].Rows[i][0].ToString());
                        dr["Campo"] = Convert.ToString(dsFromXls.Tables[0].Columns[2].ColumnName);
                        dr["Descripcion"] = "Valor Incorrecto";
                        dsFromXls.Tables["errores"].Rows.Add(dr);
                        error++;
                    }

                    if (Convert.ToInt64(valor) != 1 && Convert.ToInt64(valor) != 2)
                    {
                        DataRow dr = dsFromXls.Tables["errores"].NewRow();
                        dr["Secuencia"] = Convert.ToInt64(dsFromXls.Tables[0].Rows[i][0].ToString());
                        dr["Campo"] = Convert.ToString(dsFromXls.Tables[0].Columns[2].ColumnName);
                        dr["Descripcion"] = "Valor Incorrecto";
                        dsFromXls.Tables["errores"].Rows.Add(dr);
                        error++;
                    }
                }
            }
            catch (Exception ex)
            {
                log.Error("Error al validar credito o debito");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al validar credito o debito" + ex.ToString());
                error++;
                return;
            }
        }

