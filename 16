# Dar permisos a todos los servicios SSIS relevantes
$servicios = @(
    "NT Service\MsDtsServer160",
    "NT Service\SSISScaleOutMaster160",
    "NT Service\SSISScaleOutWorker160"
)

foreach ($servicio in $servicios) {
    $acl = Get-Acl "C:\EstadosCuenta"
    $rule = New-Object System.Security.AccessControl.FileSystemAccessRule(
        $servicio,"FullControl","ContainerInherit,ObjectInherit","None","Allow"
    )
    $acl.SetAccessRule($rule)
    Set-Acl "C:\EstadosCuenta" $acl
    Write-Host "Permisos asignados a: $servicio"
}





