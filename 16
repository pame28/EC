                                    Activo =Convert.ToBoolean(Parameters.Rows[0]["Activo"].ToString());
                                    TransaccionesBancarias.Properties.Settings.Default.AdministradorTrx = Convert.ToBoolean(Parameters.Rows[0]["AdministradorTrx"].ToString());
                                    TransaccionesBancarias.Properties.Settings.Default.Transferencias = Convert.ToBoolean(Parameters.Rows[0]["Transferencias"].ToString());
                                    TransaccionesBancarias.Properties.Settings.Default.Planillas = Convert.ToBoolean(Parameters.Rows[0]["Planillas"].ToString());
                                    TransaccionesBancarias.Properties.Settings.Default.CreditoDebito = Convert.ToBoolean(Parameters.Rows[0]["CreditoDebito"].ToString());
                                    TransaccionesBancarias.Properties.Settings.Default.PagoTc = Convert.ToBoolean(Parameters.Rows[0]["PagoTc"].ToString());
                                    TransaccionesBancarias.Properties.Settings.Default.Usuario525 = Parameters.Rows[0]["Usuario525"].ToString();
                                    TransaccionesBancarias.Properties.Settings.Default.Area = Convert.ToInt32(Parameters.Rows[0]["OficialArea"].ToString());
                                    TransaccionesBancarias.Properties.Settings.Default.Zona = Parameters.Rows[0]["Zona"].ToString();
                                    TransaccionesBancarias.Properties.Settings.Default.MontoMaximoLps = Convert.ToDecimal(Parameters.Rows[0]["MontoMaximoLps"].ToString());
                                    TransaccionesBancarias.Properties.Settings.Default.MontoMaximoDlrs = Convert.ToDecimal(Parameters.Rows[0]["MontoMaximoDlrs"].ToString());
                                    TransaccionesBancarias.Properties.Settings.Default.Encryp = Parameters.Rows[0]["Encryp"].ToString();
                            }
                            else
                                MessageBox.Show("No se encontraron parametros para el usuario Usuario" + loginControl1.txtUsuario.Text, "", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                                conexion.Close();
                        }
                    }
