        private DataTable GetErroresFromAS400(Int64 NoLote, string IdServicio, string Status)
        {
            string Query = string.Empty;
            DataTable respuesta = new DataTable();
            try
            {
                //Obtiene los errores del AS400 

                if (Status == "PR" || Status == "RV")//Si Status es Procesando o Reversando
                {

                    Query = @"SELECT A.Lote,A.Correlativo,'Cuenta' AS Campo,A.ERROR1||A.ERROR2 AS Error FROM (
                            SELECT A.NOLOTE003 as Lote
                            ,A.CORREL003 AS Correlativo                            
                            ,COALESCE((SELECT TB8DES FROM DP053DAT.DPTB08 WHERE TB8COD = A.ERRBP_003 FETCH FIRST ROW ONLY),'') AS ERROR1 
                            ,COALESCE((SELECT TB8DES FROM DP053DAT.DPTB08 WHERE TB8COD = A.RESPBY003 FETCH FIRST ROW ONLY),'') AS ERROR2 
                            FROM BPDAT.GAMAT003F AS A
                            WHERE (A.ERRBP_003<>0 OR A.RESPBY003<>0) AND A.NOLOTE003={0} AND APLCOD003='{1}') AS A";

                    Query = string.Format(Query, NoLote, IdServicio);

                    Query = Criptografia.EncryptQueryString(Query, Properties.Settings.Default.Encryp, "|");

                    if (Criptografia.error == 0)
                    {
                        respuesta = Proxy.QueryAS400(Query, _cnnAS400, "GetErroresFromAS400");
                        error = error  + Proxy.error;
                    }
                }

                if (Status == "VL")//Si Status es Validando
                {
                    Query = @"SELECT A.NOLOTE011 AS Lote,A.CORREL011 AS Correlativo,'Cuenta' AS Campo, B.TB8DES AS Error  FROM BPDAT.GAMAT011F AS A
                        LEFT JOIN DP053DAT.DPTB08 AS B
                        ON A.CODERR11=B.TB8COD
                        WHERE A.APLCOD011='{0}' AND A.NOLOTE011={1}";

                    Query = string.Format(Query, IdServicio, NoLote);

                    Query = Criptografia.EncryptQueryString(Query, Properties.Settings.Default.Encryp, "|");

                    if (Criptografia.error == 0)
                    {
                        respuesta = Proxy.QueryAS400(Query, _cnnAS400, "GetErroresFromAS400");
                        error = error  + Proxy.error;
                    }
                }
                return respuesta;
            }
            catch (Exception ex)
            {
                log.Error("Error al obtener Errores del Lote # : " + Lote.ToString());
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al obtener Errores del Lote # : " + Lote.ToString());
                error++;
                return respuesta;
            }

        }

