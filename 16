using EstadosCuentaTC.Repositories;
using Microsoft.Extensions.Logging;
using System;
using System.IO;
using System.Text;

namespace EstadosCuentaTC.Services
{
    public class GeneracionIndividualService
    {
        private readonly EstadoCuentaRepository _repo;
        private readonly ILogger<GeneracionIndividualService> _logger;

        public GeneracionIndividualService(
            EstadoCuentaRepository repo,
            ILogger<GeneracionIndividualService> logger)
        {
            _repo   = repo;
            _logger = logger;
        }

        public void Ejecutar(string rutaBase, string nombreArchivoBase, DateTime fechaCorte)
        {
            try
            {
                _logger.LogInformation("Inicio Generación Individual");

                var ruta = Path.Combine(rutaBase, fechaCorte.ToString("yyyy-MM-dd"));
                Directory.CreateDirectory(ruta);

                // ✅ Nombre parametrizado — viene de ParametrosGeneracionECDto.NombreArchivo
                var archivoJson = Path.Combine(
                    ruta,
                    $"{nombreArchivoBase}{fechaCorte:yyyyMMdd}.json"
                );

                int contador = 0;

                // ✅ StreamWriter mantiene el archivo abierto todo el proceso
                // bufferSize 64KB — acumula en memoria antes de escribir al disco
                using (var writer = new StreamWriter(archivoJson, false, Encoding.UTF8, bufferSize: 65536))
                {
                    writer.Write("{");

                    while (true)
                    {
                        var resultado = _repo.ProcesarSiguiente();

                        if (resultado == null)
                            break;

                        var (tarjeta, json) = resultado.Value;

                        if (string.IsNullOrWhiteSpace(json))
                            json = "{}";

                        // Coma separadora antes de cada elemento excepto el primero
                        if (contador > 0)
                            writer.Write(",");

                        writer.Write($"\"{tarjeta}\":{json}");

                        contador++;

                        _logger.LogInformation("Procesado: {Tarjeta}", tarjeta);
                    }

                    writer.Write("}");

                } // ← el using cierra y flushea al disco una sola vez

                _logger.LogInformation(
                    "Fin Generación Individual. Total procesados: {Contador}", contador);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en Generación Individual");
                throw;
            }
        }
    }
}