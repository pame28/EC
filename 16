using EstadosCuentaTC.Data;
using EstadosCuentaTC.Dtos;
using EstadosCuentaTC.Dtos.Generacion_JSON;
using EstadosCuentaTC.Dtos.Generacion_JSON_Lote;
using Microsoft.Data.SqlClient;
using Microsoft.Extensions.Logging;
using System;
using System.Collections.Generic;
using System.Data;
using System.Threading;

namespace EstadosCuentaTC.Repositories
{
    public class EstadoCuentaRepository
    {
        private readonly SqlExecutor _sql;
        private readonly ILogger<EstadoCuentaRepository> _logger;

        public EstadoCuentaRepository(SqlExecutor sql, ILogger<EstadoCuentaRepository> logger)
        {
            _sql    = sql;
            _logger = logger;
        }

        public (string tarjeta, string json)? ProcesarSiguiente()
        {
            using var conn = _sql.GetConnection();
            using var cmd  = new SqlCommand("usp_ProcesarSiguienteEstadoCuenta", conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            using var reader = cmd.ExecuteReader();

            if (!reader.Read())
                return null;

            return (
                reader["NoTarjeta"]?.ToString(),
                reader["JsonEstadoCuenta"]?.ToString()
            );
        }

        /// <summary>
        /// Obtiene un lote de tarjetas del SP con reintentos automáticos
        /// en caso de deadlock (error 1205 de SQL Server).
        /// </summary>
        public LoteDatosDto? ObtenerLote(int workerId)
        {
            int intentos    = 0;
            int maxIntentos = 3;

            while (intentos < maxIntentos)
            {
                try
                {
                    return EjecutarObtenerLote(workerId);
                }
                catch (SqlException ex) when (ex.Number == 1205) // deadlock
                {
                    intentos++;
                    _logger.LogWarning(
                        "Deadlock detectado en worker {WorkerId} — intento {Intento} de {Max}",
                        workerId, intentos, maxIntentos);

                    if (intentos >= maxIntentos)
                    {
                        _logger.LogError(
                            "Worker {WorkerId} alcanzó el máximo de reintentos por deadlock",
                            workerId);
                        throw;
                    }

                    // Espera aleatoria entre 500ms y 2000ms para evitar
                    // que los workers vuelvan a colisionar al mismo tiempo
                    int espera = new Random().Next(500, 2000);
                    _logger.LogInformation(
                        "Worker {WorkerId} esperando {Espera}ms antes de reintentar...",
                        workerId, espera);

                    Thread.Sleep(espera);
                }
            }

            return null;
        }

        private LoteDatosDto? EjecutarObtenerLote(int workerId)
        {
            using var conn = _sql.GetConnection();
            using var cmd  = new SqlCommand("usp_SBEstadoCuentaJsonMasivo", conn)
            {
                CommandType    = CommandType.StoredProcedure,
                CommandTimeout = 0
            };

            cmd.Parameters.AddWithValue("@WorkerId", workerId);

            if (conn.State != ConnectionState.Open)
                conn.Open();

            using var reader = cmd.ExecuteReader();

            // ── RS1: Encabezados ─────────────────────────────────────────────
            // Si el SP devuelve la señal de fin (col "Resultado") → bandeja vacía
            if (reader.FieldCount == 1 && reader.GetName(0) == "Resultado")
                return null;

            var encabezados = new List<EncabezadoDto>();
            int numeroLote  = 0;

            while (reader.Read())
            {
                var enc = MapEncabezado(reader);
                encabezados.Add(enc);

                if (numeroLote == 0)
                    numeroLote = enc.NumeroLote;
            }

            if (encabezados.Count == 0)
                return null;

            // ── RS2: Detalle ─────────────────────────────────────────────────
            var detalles = new List<DetalleDto>();
            reader.NextResult();

            while (reader.Read())
                detalles.Add(MapDetalle(reader));

            // ── RS3: Financiamientos ─────────────────────────────────────────
            var financiamientos = new List<FinanciamientoDto>();
            reader.NextResult();

            while (reader.Read())
                financiamientos.Add(MapFinanciamiento(reader));

            // ── RS4: Tarjetas del lote ───────────────────────────────────────
            var tarjetas = new List<string>();
            reader.NextResult();

            while (reader.Read())
                tarjetas.Add(reader.GetString(0));

            return new LoteDatosDto
            {
                Encabezados     = encabezados,
                Detalles        = detalles,
                Financiamientos = financiamientos,
                Tarjetas        = tarjetas,
                NumeroLote      = numeroLote
            };
        }

        public void ReiniciarControlLote(DateTime fechaCorte)
        {
            using var conn = _sql.GetConnection();
            using var cmd  = new SqlCommand("usp_ReiniciarControlLote", conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            cmd.Parameters.AddWithValue("@FechaCorte", fechaCorte.Date);

            if (conn.State != ConnectionState.Open)
                conn.Open();

            cmd.ExecuteNonQuery();
        }

        // ── Mappers ──────────────────────────────────────────────────────────

