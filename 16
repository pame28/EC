
        private void GetTransaccionTC()
        {
            try
            {
                DataTable respuesta = new DataTable();
                String conexion = Properties.Settings.Default.ConnectionDB;

                string Query = "EXEC Usp_GetTransacciones {0},{1},'{2}','{3}'";

                Query = string.Format(Query, 4, Properties.Settings.Default.Area, Properties.Settings.Default.Zona, CboMonedas.EditValue);

                Query = Criptografia.EncryptQueryString(Query, Properties.Settings.Default.Encryp, "|");

                if (Criptografia.error == 0)
                {
                    respuesta = Proxy.QuerySQL(Query, conexion, "GetTransaccionesTC");
                    error = error  + Proxy.error;
                }

                if (respuesta.Rows.Count > 0)
                {
                    if (respuesta.Rows.Count == 1)
                    {
                        for (int i = 0; i < respuesta.Rows.Count; i++)
                        {
                            if (Convert.ToInt64(respuesta.Rows[i]["TrxCredito"].ToString()) > 0)
                            {
                                CTCTRX = respuesta.Rows[i]["TrxCredito"].ToString();
                                MotivoCTC = Convert.ToInt32(respuesta.Rows[i]["Motivo"].ToString());
                            }
                        }
                        if (Convert.ToInt64(CTCTRX) > 0)
                        {
                            this.ActualizaProgressBar(15);
                        }
                        else if (Convert.ToInt64(CTCTRX) == 0)
                        {
                            MessageBox.Show("No existe transaccion  de Credito configurada para el Servicio mi Billetera", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                            error++;
                        }
                    }
                    else if (respuesta.Rows.Count > 1)
                    {
                        MessageBox.Show("Error en configuración de transacciones, existen mas transacciones de las permitidas por servicio mi Billetera", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                        error++;
                    }
                }
                else
                {
                    MessageBox.Show("No se encontraron Transacciones para servicio mi Billetera", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    error++;
                }
            }
            catch (Exception ex)
            {
                log.Error("Error al obtener las transacciones del servicio mi Billetera");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al obtener las transacciones del servicio mi Billetera" + ex.ToString());
                error++;
            }
        }








