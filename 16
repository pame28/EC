                            CIF = cuentaDto.CIF,
                            Nombre = cuentaDto.Nombre,
                            Equivalente = equivalente,
                            NoCuenta = cuentaDto.NoCuentaClaro,
                            Otp_Method_Type = requestDto.otp_method_type,
                            Contacto = phoneInformation.phoneNumber,
                            FechaAprovicionamiento = DateOnly.FromDateTime(DateTime.Now),
                            FechaVencimiento = DateOnly.FromDateTime(Convert.ToDateTime(requestDto.expiration_date)),
                            Estado = string.Empty,
                            Error = "No se encontró información",
                            Token_Requestor_Id = requestDto.token_requestor_id,
                            FechaRegistro = DateTime.Now,
                        };
                        await _reportService.InsertReportAsync(reportNoInfo);

                        return await _messageResponseFn.MessageResponse(Constantes.STATUS_NOT_FOUND, "01");
                    }
                }
            }
            return await _messageResponseFn.MessageResponse(Constantes.STATUS_UNPROCESSABLE_ENTITY, "11");
        }        
    }
}






using api_otp_notifica.DTOs.Response;
using api_otp_notifica.Service.Interface;
using api_otp_notifica.Utils;
using System.ServiceModel;
using wsBPTarjetas;

namespace api_otp_notifica.Service
{
    public class BPTarjetasService : IBPTarjetasService
    {
        private readonly TCGeneralesSoapClient _tCGeneralesSoapClient;
        private readonly ILogger<BPTarjetasService> _logger;
        public BPTarjetasService(MessageResponseFn messageResponseFn, ILogger<BPTarjetasService> logger)
        {
            _tCGeneralesSoapClient = new TCGeneralesSoapClient(TCGeneralesSoapClient.EndpointConfiguration.TCGeneralesSoap);
            _logger = logger;
        }

        public async Task<ResponseServicesDto<string>> EquivalenteAsync(string cardNumber)
        {
            string truncatedCardNumber = cardNumber.Substring(0, 6) + "XXXXXX" + cardNumber.Substring(12, 4);
            try
            {
                _logger.LogInformation("Iniciando solicitud del equivalente de tarjeta {truncatedCardNumber}", truncatedCardNumber);

                long equivalente = await _tCGeneralesSoapClient.Equivalente_TarjetaAsync(cardNumber);

                if (equivalente <= 0)
                {
                    _logger.LogError("No se encontró Equivalente de tarjeta {truncatedCardNumber}", truncatedCardNumber);
                    return new ResponseServicesDto<string>
                    {
                        Code = Constantes.STATUS_NOT_FOUND,
                        Value = "12"
                    };
                }
                _logger.LogInformation("Equivalente de tarjeta {truncatedCardNumber} es {equivalente}", truncatedCardNumber, equivalente);

                return new ResponseServicesDto<string>
                {
                    Code = Constantes.STATUS_OK,
                    Value = equivalente.ToString()
                };
            }
            catch (CommunicationException ex)
            {
                _logger.LogError(ex, "Error de comunicación con servicio wsBPTarjetas para tarjeta {truncatedCardNumber}", truncatedCardNumber);
                return new ResponseServicesDto<string>
                {
                    Code = Constantes.STATUS_SERVICE_UNAVAILABLE,
                    Value = "13"
                };
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error al consumir servicio wsBPTarjetas");
                throw;
            }
        }
    }
}







