﻿using Criptografia.Repositories.Interfaces;
using Criptografia.Services.Interfaces;
using Microsoft.Extensions.Configuration;
using System.Net.Http;
using System.Reflection.Metadata;
using System.Threading;

namespace Criptografia.Services
{
    public class AccessTokenByteService : IAccesTokenByte
    {
        //Agregadas para accessToken Byte
        private readonly HttpClient _httpClient;
        private AccessTokenCache _cache;
        private readonly string _endpoint;
        private readonly ILogger<AccessTokenByteService> _logger;
        private readonly IConfiguration _configuration;

        public AccessTokenByteService(HttpClient httpClient, AccessTokenCache cache, ILogger<AccessTokenByteService> logger, IConfiguration configuration)
        {
            _httpClient = httpClient;
            _cache = cache;
            _logger = logger;
            _endpoint = configuration["ApiSettings:EndpointAccessToken"]!;
        }

        public async Task<Models.Response.AccessTokenResponse> GetTokenAsync()
        {
            // Primera validación sin lock
            if (_cache.TryGetValid(out var cached))
                return new Models.Response.AccessTokenResponse
                {
                    accessToken = cached!.accessToken,
                    expiresIn = _cache.GetRemainingMs(),
                    refreshToken = cached!.refreshToken,
                    tokenType = cached!.tokenType,
                    scope = cached!.scope
                };

            await _cache.Lock.WaitAsync();
            try
            {
                // Segunda validación dentro del lock
                if (_cache.TryGetValid(out cached))
                    return new Models.Response.AccessTokenResponse
                    {
                        accessToken = cached!.accessToken,
                        expiresIn = _cache.GetRemainingMs(),
                        refreshToken = cached!.refreshToken,
                        tokenType = cached!.tokenType,
                        scope = cached!.scope
                    };

                _httpClient.DefaultRequestHeaders.Remove("Authorization");
                _httpClient.DefaultRequestHeaders.TryAddWithoutValidation("Authorization", KeyProvider.Key);

                var response = await _httpClient.GetAsync(_endpoint);

                if (!response.IsSuccessStatusCode)
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    _logger.LogError("Error obteniendo token en {Endpoint}. StatusCode: {StatusCode}, Body: {Body}",
                        _endpoint, response.StatusCode, errorContent);
                    throw new HttpRequestException($"Error obteniendo token en {_endpoint}. StatusCode: {response.StatusCode}");
                }

                var token = await response.Content.ReadFromJsonAsync<Models.Response.AccessTokenResponse>();

                if (token == null || string.IsNullOrEmpty(token.accessToken))
                    throw new InvalidOperationException("La respuesta del token es nula o no contiene accessToken.");

                var expiresInMs = Math.Max(token.expiresIn - 120_000, 10_000);
                var expiresAt = DateTime.UtcNow.AddMilliseconds(expiresInMs);

                _cache.Set(token, expiresAt);

                _logger.LogInformation("Token cacheado. Expira en: {ExpiresAt:u}", expiresAt);

                return new Models.Response.AccessTokenResponse
                {
                    accessToken  = token.accessToken,
                    expiresIn = expiresInMs,
                    refreshToken = token.refreshToken,
                    scope = token.scope,
                    tokenType = token.tokenType,
                };
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error obteniendo token en {Endpoint}", _endpoint);
                throw;
            }
            finally
            {
                _cache.Lock.Release();
            }
        }

        public async Task ForceRefreshToken()
        {
            await _cache.Lock.WaitAsync();
            try
            {
                _httpClient.DefaultRequestHeaders.Remove("Authorization");
                _httpClient.DefaultRequestHeaders.TryAddWithoutValidation("Authorization", KeyProvider.Key);

                var response = await _httpClient.GetAsync(_endpoint);

                if (!response.IsSuccessStatusCode)
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    _logger.LogError("Error renovando token {Endpoint}. StatusCode: {StatusCode}. Body: {Body}",
                        _endpoint, response.StatusCode, errorContent);

                    throw new HttpRequestException($"Error renovando token en {_endpoint}. StatusCode: {response.StatusCode}");

                }

                var token = await response.Content.ReadFromJsonAsync<Models.Response.AccessTokenResponse>();

                if (token == null || string.IsNullOrEmpty(token.accessToken))
                    throw new InvalidOperationException("La respuesta del token es null o no contiene data");

                var expiresIn = Math.Max(token.expiresIn - 120_000, 10_000);
                var expiresAt = DateTime.UtcNow.AddMilliseconds(expiresIn);

                _cache.Set(token, expiresAt);

                _logger.LogInformation("Token renovado proactivamente. Expira en {ExpiresAt:u}", expiresAt);
            }catch(Exception ex)
            {
                _logger.LogError(ex, "Error renovando token en {Endpoint}", _endpoint);
                throw;
            }
            finally
            {
                _cache.Lock.Release();
            }
        }
    }
}





﻿using Criptografia.Repositories.Interfaces;
using Criptografia.Services.Interfaces;
using Microsoft.AspNetCore.Authentication.BearerToken;
using Microsoft.AspNetCore.Diagnostics;
using Microsoft.Extensions.Logging;
using System.Net.Http;
using System.Security.Cryptography;
using System.Text;
using System.Threading;

namespace Criptografia.Services
{
    public class AccessTokenService : IAccessTokenService
    {
        private readonly IAccessTokenRepository _repository;
        private readonly IConfiguration _configuration;
        private readonly ILogger<AccessTokenService> _logger;

        public AccessTokenService(
            IAccessTokenRepository repository,
            IConfiguration configuration,
            ILogger<AccessTokenService> logger,
            HttpClient httpClient)
        {
            _repository = repository;
            _configuration = configuration;
            _logger = logger;
        }

        public async Task<string> GenerateAuthorizationAsync()
        {
            try
            {
                _logger.LogInformation("Iniciando generación de token de autorización.");

                var token = await _repository.GetTokenAsync();

                string credentials = $"{token.ClientId}:{token.SecretId}";

                _logger.LogInformation("Credenciales obtenidas, procediendo a convertir a Base64.");

                string base64Credentials = Convert.ToBase64String(
                    Encoding.UTF8.GetBytes(credentials)
                );

                string secretKey = _configuration["Security:SecretKey"]!;

                if (string.IsNullOrEmpty(secretKey))
                {
                    _logger.LogError("La clave Security:SecretKey no está configurada.");
                    throw new Exception("Clave de seguridad no configurada.");
                }

                _logger.LogInformation("Procediendo a encriptar las credenciales con AES256.");

                string encrypted = AES256Utils.Encrypt(base64Credentials, secretKey);

                _logger.LogInformation("Token generado correctamente.");

                return $"Basic {encrypted}";
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error generando el token de autorización.");
                throw;
            }
        }

        public static class AES256Utils
        {
            private const int IV_SIZE = 12;
            private const int TAG_SIZE = 16;

            public static string Encrypt(string plainText, string secretKey)
            {
                byte[] iv = RandomNumberGenerator.GetBytes(IV_SIZE);

                byte[] key = SHA256.HashData(Encoding.UTF8.GetBytes(secretKey));

                byte[] plaintextBytes = Encoding.UTF8.GetBytes(plainText);

                byte[] cipherText = new byte[plaintextBytes.Length];
                byte[] tag = new byte[TAG_SIZE];

                using var aes = new AesGcm(key);

                aes.Encrypt(iv, plaintextBytes, cipherText, tag);

                byte[] result = new byte[iv.Length + cipherText.Length + tag.Length];

                Buffer.BlockCopy(iv, 0, result, 0, iv.Length);
                Buffer.BlockCopy(cipherText, 0, result, iv.Length, cipherText.Length);
                Buffer.BlockCopy(tag, 0, result, iv.Length + cipherText.Length, tag.Length);

                return Convert.ToBase64String(result);
            }
        }
    }
}





﻿using System.Security.Cryptography.X509Certificates;

namespace Criptografia.Services
{
    public class AccessTokenCache
    {
        private readonly SemaphoreSlim _lock = new(1, 1);
        private Models.Response.AccessTokenResponse? _cachedToken;
        private DateTime _expiresAt = DateTime.MinValue;

        public bool TryGetValid(out Models.Response.AccessTokenResponse? token)
        {
            token = _cachedToken;
            return token != null && !string.IsNullOrEmpty(token.accessToken) && DateTime.UtcNow < _expiresAt;
        }

        public void Set(Models.Response.AccessTokenResponse token, DateTime expiresAt)
        {
            _cachedToken = token;
            _expiresAt = expiresAt;
        }

        public long GetRemainingMs() =>
            (long)Math.Max((_expiresAt - DateTime.UtcNow).TotalMilliseconds, 0);

        public SemaphoreSlim Lock => _lock;
    }
}





