namespace transacciones_flotantes.DTOs.Response
{
    public class ResponseDto
    {
        public class LegacyTransaccionesResponseDto
        {
            public ResultDto Result { get; set; } = new();

            public TotalFloatingDto? Total_Floating { get; set; }  // ← NUEVO

            public object Respuesta { get; set; } = 0;
        }

        public class ResultDto
        {
            public int Codigo { get; set; }
            public string Descripcion { get; set; } = string.Empty;
        }

        public class TotalFloatingDto  // ← NUEVO
        {
            public string Total_HNL { get; set; } = "0";
            public string Total_USD { get; set; } = "0";
        }

        public class LegacyAutorizacionDto
        {
            public string Date { get; set; } = string.Empty;
            public string merchant_name { get; set; } = string.Empty;  // ← renombrado
            public decimal Amount { get; set; }
            public string Currency { get; set; } = string.Empty;
            public string? Reference { get; set; }
            public string transaction_type { get; set; } = string.Empty;  // ← renombrado
        }
    }
}












var catalogo = await _catalogoErrores.GetCatalogoResponseAsync(1);

var autorizaciones = await Task.WhenAll(
    proveedorData.Authorizations.Select(async a =>
    {
        // Signo negativo si el movimiento es DEBITO
        var signo = a.MovementType?.Equals("DEBITO", StringComparison.OrdinalIgnoreCase) == true
            ? -1m : 1m;

        return new LegacyAutorizacionDto
        {
            Date           = a.Date,
            merchant_name  = a.MerchantName,
            Amount         = a.Amount * signo,
            Currency       = await _currencyService.ResolverAsync(a.Currency),
            Reference      = a.Reference,
            transaction_type = a.TransactionType
        };
    }));

// Totales: DEBITO = negativo
var totalHNL = -proveedorData.TotalFloating.TotalHNL;
var totalUSD = -proveedorData.TotalFloating.TotalUSD;

return new LegacyTransaccionesResponseDto
{
    Result =
    {
        Codigo     = catalogo.Codigo,
        Descripcion = catalogo.Descripcion
    },
    Total_Floating = new TotalFloatingDto
    {
        Total_HNL = totalHNL.ToString("0.#"),  // "0" si es cero, "-2300" o "-582.8" si tiene decimales
        Total_USD = totalUSD.ToString("0.#")
    },
    Respuesta = autorizaciones.ToList()
};