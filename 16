            w.WriteNumber("Pago_Contado_MN", e.Pago_Contado_MN);
            w.WriteNumber("Pago_Minimo_MN", e.Pago_Minimo_MN);
            w.WriteNumber("Saldo_Vencido_MN", e.Saldo_Vencido_MN);
