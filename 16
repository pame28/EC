using api_abandoned_token.Infraestructure.Data;
using api_abandoned_token.Repository;
using api_abandoned_token.Repository.Interface;
using api_abandoned_token.Service;
using api_abandoned_token.Service.Interface;
using api_abandoned_token.Utils;
using Microsoft.AspNetCore.Mvc;
using Serilog;
using System.Net.Security;
using System.Security.Cryptography.X509Certificates;

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddOpenApi();
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen();

builder.Services.Configure<ApiBehaviorOptions>(options =>
{
    options.SuppressModelStateInvalidFilter = true;
});

// DI SERVICIOS INTERNOS
builder.Services.AddScoped<DBHelper>();
builder.Services.AddSingleton<JobDBHelper>();
builder.Services.AddScoped<IParametrosRepository, ParametrosRepository>();
builder.Services.AddScoped<ITokenRequestorRepository, TokenRequestorRepository>();
builder.Services.AddScoped<IAbandonedTokenRepository, AbandonedTokenRepository>();
builder.Services.AddScoped<IJobRespository, JobRespository>();

builder.Services.AddScoped<IValidationService, ValidationServiceImp>();
builder.Services.AddScoped<IParametrosService, ParametrosService>();
builder.Services.AddScoped<IBPTarjetasService, BPTarjetasService>();
builder.Services.AddScoped<ITokenRequestorService, TokenRequestorService>();
builder.Services.AddScoped<IAbandonedTokenService, AbandonedTokenService>();
builder.Services.AddScoped<IJobService, JobService>();

builder.Services.AddScoped<MessageResponseFn>();

// HttpClient con validación de certificados corporativos desde el volumen
builder.Services.AddHttpClient("Seguras")
    .ConfigurePrimaryHttpMessageHandler(() =>
    {
        var handler = new SocketsHttpHandler();

        handler.SslOptions = new SslClientAuthenticationOptions
        {
            RemoteCertificateValidationCallback = (sender, cert, chain, errors) =>
            {
                try
                {
                    var certDir = Environment.GetEnvironmentVariable("CUSTOM_CERTS_DIR")
                                  ?? "/app/certificates";

                    var certFiles = Directory.EnumerateFiles(certDir)
                        .Where(f => f.EndsWith(".crt", StringComparison.OrdinalIgnoreCase)
                                 || f.EndsWith(".cer", StringComparison.OrdinalIgnoreCase))
                        .ToList();

                    if (certFiles.Count == 0)
                    {
                        Console.WriteLine($"[Certificados] No se encontró ningún certificado en {certDir}");
                        return false;
                    }

                    chain.ChainPolicy.TrustMode = X509ChainTrustMode.CustomRootTrust;
                    chain.ChainPolicy.RevocationMode = X509RevocationMode.NoCheck;

                    foreach (var certFile in certFiles)
                        chain.ChainPolicy.CustomTrustStore.Add(new X509Certificate2(certFile));

                    return chain.Build(new X509Certificate2(cert));
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Certificados] Error en validación SSL: {ex.Message}");
                    return false;
                }
            }
        };

        return handler;
    });

// Configuración de Serilog
builder.Host.UseSerilog((context, services, config) =>
    config.ReadFrom.Configuration(context.Configuration)
          .ReadFrom.Services(services));

// Opciones del CorrelationId
builder.Services.Configure<CorrelationIdOptions>(
    builder.Configuration.GetSection("CorrelationIdOptions"));

builder.Services.AddControllers();
builder.Services.AddAuthorization();

var app = builder.Build();

if (app.Environment.IsDevelopment())
{
    app.MapOpenApi();
    app.UseSwagger();
    app.UseSwaggerUI(c =>
    {
        c.SwaggerEndpoint("/openapi/v1.json", "api_autentication v1");
        c.RoutePrefix = "swagger";
    });
}

app.UseHttpsRedirection();
app.UseCorrelationId();
app.MapControllers();

app.Run();