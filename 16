            }
        }

        private void GetParamatersByUser()
        {
            if (Properties.Settings.Default.Profile != 1)
            {
                DataTable Parameters = new DataTable();

                try
                {
                    using (SqlConnection conexion = new SqlConnection(TransaccionesBancarias.Properties.Settings.Default.ConnectionDB))
                    {
                        conexion.Open();
                        using (SqlCommand cmd = new SqlCommand("Usp_GetUserParameters"))
                        {
                            cmd.CommandType = CommandType.StoredProcedure;
                            cmd.CommandTimeout = 300;
                            cmd.Parameters.AddWithValue("@usuario", usuario.ToLower());
                            cmd.Connection = conexion;
                            using (SqlDataAdapter adp = new SqlDataAdapter(cmd))
                            {
                                adp.Fill(Parameters);
                            }
                            contadorparametros = Parameters.Rows.Count;

                            if (contadorparametros > 0)
