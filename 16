SET @Siguiente = dbo.fn_SiguienteFechaCorte(@FechaCursor);

IF @Siguiente IS NULL
    THROW 50004, 'No se pudo calcular el siguiente corte, la fecha activa no corresponde a un día de corte válido.', 1;







CREATE FUNCTION [dbo].[fn_SiguienteFechaCorte]
(
    @FechaActual DATE
)
RETURNS DATE
AS
BEGIN
    DECLARE @Dia INT = DATEPART(DAY, @FechaActual);
    DECLARE @Mes INT = DATEPART(MONTH, @FechaActual);
    DECLARE @Anio INT = DATEPART(YEAR, @FechaActual);
    DECLARE @Siguiente DATE;

    IF @Dia = 6
        SET @Siguiente = DATEFROMPARTS(@Anio, @Mes, 10);
    ELSE IF @Dia = 10
        SET @Siguiente = DATEFROMPARTS(@Anio, @Mes, 18);
    ELSE IF @Dia = 18
        SET @Siguiente = DATEFROMPARTS(@Anio, @Mes, 24);
    ELSE IF @Dia = 24
        SET @Siguiente = DATEFROMPARTS(@Anio, @Mes, 27);
    ELSE IF @Dia = 27 AND @Mes < 12
        SET @Siguiente = DATEFROMPARTS(@Anio, @Mes + 1, 6);
    ELSE IF @Dia = 27 AND @Mes = 12
        SET @Siguiente = DATEFROMPARTS(@Anio + 1, 1, 6);
    ELSE
        RETURN NULL; -- fecha que no corresponde a ningún día de corte válido

    RETURN @Siguiente;
END