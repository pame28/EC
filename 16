# Ver con qué usuario corre el servicio de SQL Server Integration Services
Get-WmiObject Win32_Service | Where-Object {$_.Name -like "*SSIS*" -or $_.Name -like "*MsDts*"} | Select-Object Name, StartName





$acl = Get-Acl "C:\EstadosCuenta"
$rule = New-Object System.Security.AccessControl.FileSystemAccessRule(
    "NT Service\MsDtsServer160","FullControl","ContainerInherit,ObjectInherit","None","Allow"
)
$acl.SetAccessRule($rule)
Set-Acl "C:\EstadosCuenta" $acl