ALTER PROCEDURE [dbo].[Usp_ValidaInfoAS400] 
	
AS
BEGIN
	DECLARE @ContadorAGencias AS INT
	DECLARE	@ContadorCuentas AS INT
	DECLARE @ContadorClienteJuridicos AS INT
	DECLARE @ContadorNombresClientes AS INT
	DECLARE @ContadorDPALIAS AS INT
	DECLARE @TRX AS INT
	DECLARE @DPTB08 AS INT
	DECLARE @ESTATUS AS NVARCHAR(10)
	
	SELECT @ContadorAGencias = COUNT(*) FROM dbo.AS400_CLAGEN
	SELECT @ContadorCuentas = COUNT(*) FROM dbo.AS400_ClientesCuentas
	SELECT @ContadorClienteJuridicos = COUNT(*) FROM dbo.AS400_ClientesJuridicos
	SELECT @ContadorNombresClientes = COUNT(*) FROM dbo.AS400_ClientesNaturales acn
	SELECT @ContadorDPALIAS = COUNT(*) FROM dbo.AS400_DPALIAS
	SELECT @TRX = COUNT(*) FROM dbo.AS400_DPTRX
	SELECT @DPTB08 = COUNT(*) FROM dbo.AS400_DPTB08	
	
	IF @ContadorAGencias =0 OR @ContadorCuentas =0 OR @ContadorClienteJuridicos = 0 
	OR @ContadorNombresClientes = 0 OR @ContadorDPALIAS = 0 OR  @TRX = 0 OR @DPTB08 = 0
	BEGIN
		SET @ESTATUS = 'ERROR'
	END
	 
	 ELSE
	 BEGIN
	 	SET @ESTATUS = 'OK'
	 END
	 SELECT @ESTATUS
END




