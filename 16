		public SumaFlotantes GetSumaFlotantes(object lista)
        {
            SumaFlotantes sumaFlotantes = new SumaFlotantes();
            try
            {
                //Variables dentro de la funcion
                decimal accionSumarLempiras = 0;
                decimal accionRestarLempiras = 0;
                decimal accionSumarDolares = 0;
                decimal accionRestarDolares = 0;
                object parametros = null;

                _logger.Debug("Consultando si existen parametros en cache");
                if (memoryCacheFlotantes.Contains("FloatingParameters"))
                {
                    _logger.Debug("Existen los parametros en cache");
                    parametros = memoryCacheFlotantes.Get("FloatingParameters");
                }

                if (parametros == null)
                {
                    _logger.Debug("No existen parametros en cache");
                    parametros = _bd.paramFloat.FromSqlRaw("EXEC usp_parametrosFloat 1, null").ToList();
                    apiPrismaMemoryCacheParameters(parametros);
                }

                _logger.Debug("Asignando parametros a lista");
                List<AuthorizationResponseDto> DataFlotantes = lista as List<AuthorizationResponseDto>;              
                List<ParamTransaccionesFlotantes> parametrosTransacciones = parametros as List<ParamTransaccionesFlotantes>;

                _logger.Debug("Clasificando tipos de transacciones flotantes");
                //Sumar transacciones de creditos y restar debitos del total de flotantes - utilizar la referencia del mantenimiento. Contemplar la moneda y si está activa la acción.       
                // Preprocesar parámetros en un diccionario
                var parametrosPorTipo = (parametrosTransacciones ?? new List<ParamTransaccionesFlotantes>())
                   .Where(data2 => data2.Estado == "1")
                   .ToDictionary(data2 => data2.TipoTransaccion);

                // Iterar sobre datos flotantes
                foreach (var data in DataFlotantes)
                {
                    string transactionType = data.transaction_type.ToString();
                    decimal monto = Convert.ToDecimal(data.amount);
                    if (parametrosPorTipo.TryGetValue(transactionType, out var data2))
                    {
                        string accion = data2.TipoTotal;
                        string monedatrx = data2.TipoMoneda;
                        switch (monedatrx)
                        {
                            case "HNL":
                                if (accion == "D")
                                {
                                    accionRestarLempiras += monto;
                                }
                                else if (accion == "C")
                                {
                                    accionSumarLempiras += monto;
                                }
                                break;
                            case "USD":
                                if (accion == "D")
                                {
                                    accionRestarDolares += monto;
                                }
                                else if (accion == "C")
                                {
                                    accionSumarDolares += monto;
                                }
                                break;
                        }
                    }
                }

                //Realizar operación de suma y resta de flotantes obtenidos por monedas
                decimal totalFlotantesHNL = accionSumarLempiras - accionRestarLempiras;
                decimal totalFlotantesUSD = accionSumarDolares - accionRestarDolares;
                sumaFlotantes.total_HNL = totalFlotantesHNL.ToString();
                sumaFlotantes.total_USD = totalFlotantesUSD.ToString();
            }
            catch (Exception ex)
            {
                setLog("Error ClasificandoFlotantes", "Flotantes", ex.ToString());
                _logger.Error("Error al obtener los datos del error", ex);
            }
            return sumaFlotantes;
        }
