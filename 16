ALTER PROCEDURE [dbo].[usp_ExecJobs](@JobName VARCHAR(200))
AS
BEGIN

EXEC msdb.dbo.sp_start_job @JobName

SELECT 1
      FROM msdb.dbo.sysjobs J 
      JOIN msdb.dbo.sysjobactivity A 
          ON A.job_id=J.job_id 
      WHERE J.name=@JobName
      AND A.run_requested_date IS NOT NULL 
      AND A.stop_execution_date IS NULL
END







using System.Data;
using Microsoft.Data.SqlClient;

namespace api_abandoned_token.Infraestructure.Data
{
    public class DBHelper
    {
        private readonly string _connectionString;
        private readonly ILogger<DBHelper> _logger;

        public DBHelper(IConfiguration configuration, ILogger<DBHelper> logger)
        {
            _connectionString = configuration.GetConnectionString("DefaultConnection")!;
            _logger = logger;
        }


        // Ejecutar un stored procedure que devuelve un SqlDataReader (SELECT)
        public async Task<SqlDataReader> ExecuteReaderAsync(string storedProcedure, Dictionary<string, object>? parameters = null)
        {
            SqlConnection conn = new SqlConnection(_connectionString);
            await conn.OpenAsync();

            await using SqlCommand cmd = new SqlCommand(storedProcedure, conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            if (parameters != null)
            {
                foreach (var param in parameters)
                {
                    cmd.Parameters.AddWithValue(param.Key, param.Value ?? DBNull.Value);
                }
            }

            _logger.LogInformation("StoredProcedure {StoredProcedure} ejecutado correctamente con ExecuteReaderAsync()", storedProcedure);
            return await cmd.ExecuteReaderAsync(CommandBehavior.CloseConnection);
        }


        // Ejecutar un stored procedure que no devuelve datos (INSERT, UPDATE, DELETE)
        public async Task<int> ExecuteNonQueryAsync(string storedProcedure, Dictionary<string, object>? parameters = null)
        {
            await using SqlConnection conn = new SqlConnection(_connectionString);
            await conn.OpenAsync();

            await using SqlCommand cmd = new SqlCommand(storedProcedure, conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            if (parameters != null)
            {
                foreach (var param in parameters)
                {
                    cmd.Parameters.Add(new SqlParameter(param.Key, param.Value ?? DBNull.Value));
                }
            }

            var result = await cmd.ExecuteNonQueryAsync();
            _logger.LogInformation("StoredProcedure {StoredProcedure} ejecutado correctamente con ExecuteNonQueryAsync(), filas afectadas={Result}", storedProcedure, result);
            return result;
        }

        // Ejecutar un query escalar (ej. COUNT(*))
        public async Task<int> ExecuteScalarAsync(string storedProcedure, Dictionary<string, object>? parameters = null)
        {
            await using SqlConnection conn = new SqlConnection(_connectionString);
            await conn.OpenAsync();

            await using var cmd = new SqlCommand(storedProcedure, conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            if (parameters != null)
            {
                foreach (var param in parameters)
                {
                    cmd.Parameters.Add(new SqlParameter(param.Key, param.Value ?? DBNull.Value));
                }
            }

            var result = await cmd.ExecuteScalarAsync();
            int value = int.TryParse(result?.ToString(), out var parsed) ? parsed : 0;
            _logger.LogInformation("StoredProcedure {StoredProcedure} ejecutado correctamente con ExecuteScalarAsync(), resultado={Result}", storedProcedure, value);

            return value;
        }

        // Ejecutar un query escalar con SQL directo
        public async Task<object?> ExecuteScalarSqlAsync(string sql)
        {
            try
            {
                _logger.LogInformation("Ejecutando ExecuteScalarSqlAsync() - SQL={Sql}", sql);

                await using var conn = new SqlConnection(_connectionString);
                await conn.OpenAsync();

                await using var cmd = new SqlCommand(sql, conn)
                {
                    CommandType = CommandType.Text
                };

                var result = await cmd.ExecuteScalarAsync();
                _logger.LogInformation("SQL ejecutado correctamente con ExecuteScalarSqlAsync(), resultado={Result}", result);
                return result;
            }
            catch (SqlException ex)
            {
                _logger.LogError(ex, "Error en ExecuteScalarSqlAsync() - SQL={Sql}. Descripción: {Message}", sql, ex.Message);
                throw;
            }
        }
    }
}





