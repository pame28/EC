using api_abandoned_token.DTOs.Response;
using api_abandoned_token.Service.Interface;
using api_abandoned_token.Utils;
using System.ServiceModel;
using wsBPTarjetas;

namespace api_abandoned_token.Service
{
    public class BPTarjetasService : IBPTarjetasService
    {
        private readonly List<X509Certificate2> _serverCerts;
        
        private readonly string _endpointUrl;
        private readonly TCGeneralesSoapClient _tCGeneralesSoapClient;
        private readonly ILogger<BPTarjetasService> _logger;
        public BPTarjetasService(IConfiguration configuration, MessageResponseFn messageResponseFn, ILogger<BPTarjetasService> logger, List<X509Certificate2> serverCerts)
        {
            var binding = new BasicHttpBinding
            {
                Security = new BasicHttpSecurity
                {
                    Mode = BasicHttpSecurityMode.Transport
                },
                MaxReceivedMessageSize = 65536
            };

            _endpointUrl = configuration["ServiceEndpoints:WsBPTarjetasTcGenerales"] ?? throw new InvalidOperationException("Endpoint URL no configurado");

            var endpointAddress = new EndpointAddress(_endpointUrl);
            _tCGeneralesSoapClient = new TCGeneralesSoapClient(binding, endpointAddress);
            _logger = logger;
             _serverCerts = serverCerts;
        }

        public async Task<ResponseServicesDto<string>> EquivalenteAsync(string cardNumber)
        {
            string truncatedCardNumber = cardNumber.Substring(0, 6) + "XXXXXX" + cardNumber.Substring(12, 4);
            try
            {
                _logger.LogInformation("Iniciando solicitud del equivalente de tarjeta {truncatedCardNumber}", truncatedCardNumber);
            
             if (_serverCerts.Any())
                    {
                        client.ClientCredentials.ServiceCertificate.DefaultCertificate = _serverCerts.First();
                        client.ClientCredentials.ServiceCertificate.Authentication.CertificateValidationMode =
                            X509CertificateValidationMode.PeerOrChainTrust;
                    }


                long equivalente = await _tCGeneralesSoapClient.Equivalente_TarjetaAsync(cardNumber);

                if (equivalente <= 0)
                {
                    _logger.LogError("No se encontró Equivalente de tarjeta {truncatedCardNumber}", truncatedCardNumber);
                    return new ResponseServicesDto<string>
                    {
                        Code = Constantes.STATUS_NOT_FOUND,
                        Value = "12"
                    };
                }
                _logger.LogInformation("Equivalente de tarjeta {truncatedCardNumber} es {equivalente}", truncatedCardNumber, equivalente);

                return new ResponseServicesDto<string>
                {
                    Code = Constantes.STATUS_OK,
                    Value = equivalente.ToString()
                };
            }
            catch (CommunicationException ex)
            {
                _logger.LogError(ex, "Error de comunicación con servicio wsBPTarjetas para tarjeta {truncatedCardNumber}", truncatedCardNumber);
                return new ResponseServicesDto<string>
                {
                    Code = Constantes.STATUS_SERVICE_UNAVAILABLE,
                    Value = "13"
                };
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error al consumir servicio wsBPTarjetas");
                throw;
            }
        }
    }
}




