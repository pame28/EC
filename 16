                        dr["CuentaByte"] = 0;
                    else
                        dr["CuentaByte"] = dsFromXls.Tables[0].Rows[i][1].ToString();
                    dr["Monto"] = Convert.ToDecimal(dsFromXls.Tables[0].Rows[i][3].ToString());
                    if (Convert.ToInt64(dsFromXls.Tables[0].Rows[i][2].ToString()) == 2)
                        dr["Trx"] = DTRX;
                    if (Convert.ToInt64(dsFromXls.Tables[0].Rows[i][2].ToString()) == 1)
                    {
                        if (dsFromXls.Tables[0].Rows[i][1].ToString().Length <= LongitudCtas)
                            dr["Trx"] = CTRX;
                        if (dsFromXls.Tables[0].Rows[i][1].ToString().Length >= LongitudTC)
