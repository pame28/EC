        private void ValidaTipoCuentaAS400()
        {
            int product = 0;
            DataTable Respuesta = new DataTable();
            String conexion = Properties.Settings.Default.ConnectionDB;

            try
            {
                dsFromXls.Tables[0].Clear();

                for (int i = 0; i < Detalle.Rows.Count; i++)
                {
                    product = Convert.ToInt32(Detalle.Rows[i]["TipoCuenta"].ToString());
                    if (Detalle.Rows[i]["Cuenta"].ToString().Length <= LongitudCtas)//VALIDA SI REGISTRO ES UNA CUENTA
                    {
                        if (product == 0)//SI NO ENCONTRO PRODUCTO EN SQL ENTONCES VA AL AS400
                        {
                            Respuesta.Reset();
                            String Query = "SELECT DISTINCT TIPPRO FROM DP053DAT.DPCTAS WHERE TRIM(REPLACE(CTEDIT,'-','')) ='{0}'";
                            Query = string.Format(Query, Detalle.Rows[i]["Cuenta"].ToString());
                            Query = Criptografia.EncryptQueryString(Query, Properties.Settings.Default.Encryp, "|");

                            if (Criptografia.error == 0)
                            {
                                Respuesta = Proxy.QueryAS400(Query, _cnnAS400, "ValidaTipoCuentaAS400");
                                error = error  + Proxy.error;
                            }
                            if (Respuesta.Rows.Count > 0)//SI ENCONTRO TIPO DE PRODUCTO EN EL AS400 ENTONCES ACTUALIZA EN SQL
                            {
                                Detalle.Rows[i]["TipoCuenta"] = Convert.ToInt64(Respuesta.Rows[0][0].ToString());
                                product = Convert.ToInt32(Detalle.Rows[i]["TipoCuenta"].ToString());
                                Respuesta.Reset();
                                Query = @"UPDATE DetallePlanillas SET TipoCuenta = {0} WHERE IdLote={1} AND Correlativo={2}";
                                Query = string.Format(Query, product, Detalle.Rows[i]["IdLote"].ToString(), Detalle.Rows[i]["Correlativo"].ToString());
                                Query = Criptografia.EncryptQueryString(Query, Properties.Settings.Default.Encryp, "|");

                                if (Criptografia.error == 0)
                                {
                                    Proxy.QuerySQL(Query, conexion, "ValidaTipoCuentaAS400");
                                    error = error  + Proxy.error;
                                }
                            }
                            else//SINO INSERTA ERROR
                            {
                                DataRow dr = dsFromXls.Tables["errores"].NewRow();
                                dr["Lote"] = Lote;
                                dr["Secuencia"] = Convert.ToInt64(Detalle.Rows[i]["Correlativo"].ToString());
                                dr["Campo"] = Convert.ToString(Detalle.Columns["TipoCuenta"].ColumnName);
                                dr["Descripcion"] = "Cuenta No Existe";
                                dsFromXls.Tables["errores"].Rows.Add(dr);
                                error++;
                            }
                        }
                        if (product != 0)
                        {
                            //si la respuesta es 3(CDT´S) inserta un error en tabla de errores
                            if (product == 3)
                            {
                                DataRow dr = dsFromXls.Tables["errores"].NewRow();
                                dr["Lote"] = Lote;
                                dr["Secuencia"] = Convert.ToInt64(Detalle.Rows[i]["Correlativo"].ToString());
                                dr["Campo"] = Convert.ToString(Detalle.Columns["TipoCuenta"].ColumnName);
                                dr["Descripcion"] = "Cuenta CDT no permitida";
                                dsFromXls.Tables["errores"].Rows.Add(dr);
                                error++;
                            }
                        }
                    }

                    DataRow Fila = dsFromXls.Tables[0].NewRow();
                    Fila[0] = Detalle.Rows[i]["Correlativo"].ToString();
                    Fila[1] = Detalle.Rows[i]["Cuenta"].ToString();
                    Fila[2] = Detalle.Rows[i]["TipoTrx"].ToString();
                    Fila[3] = Detalle.Rows[i]["Monto"].ToString();
                    Fila[4] = Detalle.Rows[i]["NombreEmpleado"].ToString();
                    Fila[5] = Detalle.Rows[i]["TipoCuenta"].ToString();
                    dsFromXls.Tables[0].Rows.Add(Fila);
                }
                this.ActualizaGrid();
                this.ActualizaProgressBar(100);
            }

