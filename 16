namespace ST_ec7161d598a843879cd83252e69e7164
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]

    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };

        public void Main()
        {
            try
            {
              
                DateTime fechaCortedt = Convert.ToDateTime(Dts.Variables["User::FechaCorte"].Value);
                string fechaCorte = fechaCortedt.ToString("dd/MM/yyyy");
                string smtpServer = Dts.Variables["User::CorreoReporteSmtpServer"].Value.ToString();
                string mailFrom = Dts.Variables["User::CorreoReporteMailFrom"].Value.ToString();
                string mailSubject = Dts.Variables["User::CorreoReporteMailSubject"].Value.ToString();
                string correoDestino = Dts.Variables["User::CorreoReporteCorreoDestino"].Value.ToString();
                string plantillaHTML = Dts.Variables["User::CorreoReportePlantillaHTML"].Value.ToString();
                string rutaBase = Dts.Variables["User::RutaArchivoJson"].Value.ToString();
                string tipoGeneracion = Dts.Variables["User::TipoGeneracion"].Value.ToString();

     
                string rutaContador = Path.Combine(
                    rutaBase,
                    fechaCortedt.ToString("yyyy-MM-dd"),
                    "Contador.txt"
                );

                string totalProcesados = "No disponible";
                string fechaEjecucion = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
                string contenidoContador = Dts.Variables["User::ContenidoContador"].Value.ToString();

                // Y extraes los valores igual que antes
                foreach (string linea in contenidoContador.Split(new[] { Environment.NewLine }, StringSplitOptions.None))
                {
                    if (linea.StartsWith("Total Procesados"))
                        totalProcesados = linea.Split(':')[1].Trim();

                    if (linea.StartsWith("Fecha Ejecucion"))
                        fechaEjecucion = linea.Split(':')[1].Trim();
                }


                string body = plantillaHTML
                    .Replace("[FechaCorte]", fechaCorte)
                    .Replace("[TipoGeneracion]", tipoGeneracion)
                    .Replace("[FechaEjecucion]", fechaEjecucion)
                    .Replace("[TotalProcesados]", totalProcesados);

             
                MailMessage mensaje = new MailMessage();
                mensaje.From = new MailAddress(mailFrom);
                mensaje.Subject = mailSubject;
                mensaje.Body = body;
                mensaje.IsBodyHtml = true;

                foreach (string destinatario in correoDestino.Split(';'))
                {
                    if (!string.IsNullOrWhiteSpace(destinatario))
                        mensaje.To.Add(new MailAddress(destinatario.Trim()));
                }

                SmtpClient smtp = new SmtpClient(smtpServer);
                smtp.Send(mensaje);

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Error Envio Correo Reporte", ex.Message, string.Empty, 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

    }
