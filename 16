using System.Text.Json.Serialization;

namespace transacciones_flotantes.Models.AccessToken
{
    public class AccessTokenResponse
    {
        [JsonPropertyName("accessToken")]
        public string accessToken { get; set; } = string.Empty;

        [JsonPropertyName("expiresIn")]
        public long expiresIn { get; set; }

        [JsonPropertyName("tokenType")]
        public string tokenType { get; set; } = string.Empty;

        [JsonPropertyName("refreshToken")]
        public string refreshToken { get; set; } = string.Empty;

        [JsonPropertyName("scope")]
        public string scope { get; set; } = string.Empty;
    }
}













using Microsoft.Extensions.Caching.Memory;
using System.Net.Http;
using System.Text.Json;
using transacciones_flotantes.Models.AccessToken;
using transacciones_flotantes.Service.Interface;

namespace transacciones_flotantes.Service
{
    public class ProveedorTokenService : IProveedorTokenService
    {
        private readonly IHttpClientFactory _httpClientFactory;
        private readonly IMemoryCache _cache;
        private readonly IConfiguration _configuration;
        private readonly ILogger<ProveedorTokenService> _logger;

        private static readonly SemaphoreSlim _lock = new(1, 1);

        private const string CACHE_TOKEN = "ACCESS_TOKEN";

        public ProveedorTokenService(
            IHttpClientFactory httpClientFactory,
            IMemoryCache cache,
            IConfiguration configuration,
            ILogger<ProveedorTokenService> logger)
        {
            _httpClientFactory = httpClientFactory;
            _cache = cache;
            _configuration = configuration;
            _logger = logger;
        }

        public async Task<string> ObtenerAccessTokenAsync()
        {
            if (_cache.TryGetValue(CACHE_TOKEN, out string token))
            {
                return token;
            }

            await _lock.WaitAsync();

            try
            {
                // Double check para evitar race conditions
                if (_cache.TryGetValue(CACHE_TOKEN, out token))
                {
                    return token;
                }

                _logger.LogInformation("Generando nuevo accessToken...");

                var tokenResponse = await GenerarTokenAsync();

                // IMPORTANTE: expiresIn viene en MILISEGUNDOS desde el endpoint
                // centralizado (Criptografia ya le resta 120s de colchón antes
                // de devolverlo), por eso usamos AddMilliseconds y no restamos
                // nada extra aquí.
                var expiration = DateTime.UtcNow.AddMilliseconds(tokenResponse.expiresIn);

                _cache.Set(
                    CACHE_TOKEN,
                    tokenResponse.accessToken,
                    expiration
                );

                _logger.LogInformation("AccessToken generado y almacenado en cache. Expira en: {Expiration:u}", expiration);

                return tokenResponse.accessToken;
            }
            finally
            {
                _lock.Release();
            }
        }

        private async Task<AccessTokenResponse> GenerarTokenAsync()
        {
            try
            {
                var client = _httpClientFactory.CreateClient();

                var url = $"{_configuration["ApiSettings:EndpointAccessToken"]}";

                var request = new HttpRequestMessage(HttpMethod.Get, url);

                var response = await client.SendAsync(request);

                response.EnsureSuccessStatusCode();

                var json = await response.Content.ReadAsStringAsync();

                var tokenResponse = JsonSerializer.Deserialize<AccessTokenResponse>(json);

                if (tokenResponse == null || string.IsNullOrEmpty(tokenResponse.accessToken))
                {
                    throw new InvalidOperationException("La respuesta del endpoint de accessToken es nula o no contiene accessToken.");
                }

                return tokenResponse;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error obteniendo accessToken desde el endpoint centralizado.");
                throw;
            }
        }

        public void InvalidarToken()
        {
            _cache.Remove(CACHE_TOKEN);
            _logger.LogInformation("AccessToken Invalidado del cache");
        }
    }
}