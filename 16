        private void ValidaCuentaCif() // valida que la cuenta pertenezca al cliente
        {
            try
            {
                string Cuentas = string.Empty;

                //obtiene la(s) cuentas de debito
                foreach (DataRow row in this.dsFromXls.Tables[0].Rows)
                {
                    if (row[2].ToString() == "2")
                    {
                        if (Cuentas.Length > 0)
                            Cuentas = Cuentas + "," + row[1].ToString();
                        else
                            Cuentas = row[1].ToString();
                    }
                }

                //Valida que las cuentas pertenezcan al cliente
                foreach (var Cuenta in Cuentas.Split(','))
                {

                    DataTable respuesta = new DataTable();
                    String conexion = Properties.Settings.Default.ConnectionDB;

                    string Query = "EXEC Usp_ValidaCuentaCliente '{0}','{1}'";

                    Query = string.Format(Query, Cuenta, CboClientes.EditValue);

                    Query = Criptografia.EncryptQueryString(Query, Properties.Settings.Default.Encryp, "|");

                    if (Criptografia.error == 0)
                    {
                        respuesta = Proxy.QuerySQL(Query, conexion, "ValidaCuentaCif");
                        error = error  + Proxy.error;
                    }
                    if (Convert.ToInt64(respuesta.Rows[0][0].ToString()) == 0)
                    {
                        respuesta.Reset();

                        //SI LA CUENTA ES MANCOMUNADA VALIDA EN EL CLIENTE ESTE DENTRO DE LAS FIRMA AUTORIZADAS EN EL AS400 
                        Query = @"SELECT COUNT(*) FROM DP053DAT.DPCTAS AS A
                                INNER JOIN DP053DAT.DPCTAM03 AS B
                                ON A.PRTIPO= B.PRTIPO AND A.DPAGEN=B.DPAGEN AND A.DPCORR=B.DPCORR AND A.DPDIVE=B.DPDIVE
                                WHERE replace(A.ctedit,'-','')='{0}' AND B.CLDO1='{1}'";
                        Query = string.Format(Query, Cuenta, CboClientes.EditValue);

                        Query = Criptografia.EncryptQueryString(Query, Properties.Settings.Default.Encryp, "|");

                        if (Criptografia.error == 0)
                        {
                            respuesta = Proxy.QueryAS400(Query, _cnnAS400, "ValidaCuentaCif");
                            error = error  + Proxy.error;
                        }
                        if (Convert.ToInt64(respuesta.Rows[0][0].ToString()) == 0)
                        {
                            MessageBox.Show("Cuenta de débito : " + Cuenta + " no pertenece al cliente " + CboClientes.Text, "Error en Cuenta de Débito", MessageBoxButtons.OK, MessageBoxIcon.Error);
                            error++;
                            return;
                        }
                    }
                }
                this.ActualizaProgressBar(30);
            }
            catch (Exception ex)
            {
                log.Error("Error al Validar Cuenta - Cliente");
                log.Error("Mensaje " + ex.Message);
                log.Error("Source " + ex.Source);
                log.Error("StackTrace " + ex.StackTrace);
                MessageBox.Show("Error al Validar Cuenta - Cliente" + ex.ToString());
                error++;
            }

        }

