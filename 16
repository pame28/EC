        private string GetVersion()
        {
            string Version = string.Empty;
            try
            {
                using (SqlConnection conexion = new SqlConnection(TransaccionesBancarias.Properties.Settings.Default.ConnectionDB))
                {
                    conexion.Open();
                    using (SqlCommand cmd = new SqlCommand("SELECT Version FROM Versiones where Id = (select max(Id) from Versiones)"))
                    {
                        cmd.CommandType = CommandType.Text;
                        Object returnValue;
                        cmd.CommandTimeout = 300;
                        cmd.Connection = conexion;
                        returnValue = cmd.ExecuteScalar();
                        Version = returnValue.ToString();
                        conexion.Close();
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error al obtener versión del aplicativo" + Environment.NewLine + ex.Message.ToString(), "", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            return Version;
        }

