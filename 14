CREATE PROCEDURE dbo.usp_InsertarHistoricoECJson
(
    @FechaCorte DATE,
    @NoTarjeta CHAR(16),
    @NoCuenta VARCHAR(25),
    @NoCuentaVASA VARCHAR(25),
    @Nombre VARCHAR(255),
    @Correo VARCHAR(255),
    @Origen VARCHAR(4) = NULL,
    @Lote INT = NULL,
    @Procesado CHAR(2)
)
AS
BEGIN
    SET NOCOUNT ON;

    INSERT INTO dbo.HistoricoMaestroEstadosCuentaJSON
    (
        FechaCorte,
        NoTarjeta,
        NoCuenta,
        NoCuentaVASA,
        Nombre,
        Correo,
        Origen,
        Lote,
        Procesado,
        FechaEjecucion
    )
    VALUES
    (
        @FechaCorte,
        @NoTarjeta,
        @NoCuenta,
        ISNULL(@NoCuentaVASA, ''),
        ISNULL(@Nombre, ''),
        ISNULL(@Correo, ''),
        @Origen,
        @Lote,
        @Procesado,
        GETDATE()
    );
END
GO