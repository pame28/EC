public void InsertarHistorico(
    DateTime fechaCorte,
    string tarjeta,
    string cuenta,
    string correo,
    string nombre = "",
    string cuentaVasa = "",
    int? lote = null
)
{
    using var conn = _sql.GetConnection();

    using var cmd = new SqlCommand("usp_InsertarHistoricoECJson", conn)
    {
        CommandType = CommandType.StoredProcedure
    };

    cmd.Parameters.AddWithValue("@FechaCorte", fechaCorte);
    cmd.Parameters.AddWithValue("@NoTarjeta", tarjeta ?? "");
    cmd.Parameters.AddWithValue("@NoCuenta", cuenta ?? "");
    cmd.Parameters.AddWithValue("@NoCuentaVASA", cuentaVasa ?? "");
    cmd.Parameters.AddWithValue("@Nombre", nombre ?? "");
    cmd.Parameters.AddWithValue("@Correo", correo ?? "");
    cmd.Parameters.AddWithValue("@Origen", DBNull.Value);
    cmd.Parameters.AddWithValue("@Lote", lote ?? (object)DBNull.Value);
    cmd.Parameters.AddWithValue("@Procesado", "SI");

    cmd.ExecuteNonQuery();
}