using EstadosCuentaTC.Data;
using EstadosCuentaTC.Dtos;
using Microsoft.Data.SqlClient;
using System;
using System.Collections.Generic;
using System.Data;
using System.Text;

namespace EstadosCuentaTC.Repositories
{
    public class ConfigRepository
    {
        private readonly SqlExecutor _sql;

        public ConfigRepository(SqlExecutor sql)
        {
            _sql = sql;
        }

        public ConfigEmailDto ObtenerConfigEmail(string tipo)
        {
            using var conn = _sql.GetConnection();

            using var cmd = new SqlCommand("usp_ObtenerConfiguracionEmailPorTipo", conn)
            {
                CommandType = CommandType.StoredProcedure
            };

            cmd.Parameters.Add("@Tipo", SqlDbType.VarChar, 50).Value = tipo;


            using var reader = cmd.ExecuteReader();

            if (reader.Read())
            {
                return new ConfigEmailDto
                {

                    SmtpServer = reader["SmtpServer"]?.ToString(),
                    MailFrom = reader["MailFrom"]?.ToString(),
                    MailSubject = reader["MailSubject"]?.ToString(),
                    CorreoDestino = reader["CorreoDestino"]?.ToString(),
                    PlantillaHTML = reader["PlantillaHTML"]?.ToString()
                };
            }

            throw new Exception($"No existe configuración para tipo: {tipo}");
        }
    }
}


